@page "/auth/sign-in"
@inherits PreferenceAwareComponentBase
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>@Text("Sign in", "เข้าสู่ระบบ") - MALIEV</PageTitle>

<div class="auth-split">
    <div class="auth-brand-panel">
        <div class="auth-brand-content">
            <img class="auth-brand-logo" src="/images/logo.svg" width="180" height="41" alt="MALIEV" />
            <p class="auth-brand-tagline">@Text("Precision manufacturing on demand.", "งานผลิตความแม่นยำสูง ตามความต้องการ")</p>
            <ul class="auth-brand-features" aria-hidden="true">
                <li>@Text("CNC Machining", "งาน CNC")</li>
                <li>@Text("3D Printing — FDM, SLA, SLS, MJF", "พิมพ์ 3 มิติ — FDM, SLA, SLS, MJF")</li>
                <li>@Text("3D Scanning & Reverse Engineering", "สแกน 3 มิติ และ Reverse Engineering")</li>
                <li>@Text("Transparent pricing from CAD files", "ราคาโปร่งใสจากไฟล์ CAD")</li>
            </ul>
            <div class="auth-trust-row">
                <span class="auth-trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    @Text("256-bit SSL", "ความปลอดภัย SSL")
                </span>
                <span class="auth-trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    @Text("Data protected", "ข้อมูลได้รับการคุ้มครอง")
                </span>
                <span class="auth-trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>
                    @Text("GDPR compliant", "ปฏิบัติตาม GDPR")
                </span>
            </div>
        </div>
    </div>

    <div class="auth-form-panel">
        <div class="auth-form-inner">
            @if (_isSignUp)
            {
                <h1 class="auth-title">
                    <span>@Text("Create account", "สร้างบัญชี")</span>
                    <img class="auth-title-logo" src="/images/logo.svg" width="140" height="32" alt="MALIEV" />
                </h1>
                <p class="auth-form-subtitle">@Text("Google is the fastest path. Email and password is available when your team needs a separate login.", "Google เป็นวิธีที่เร็วที่สุด หรือใช้อีเมลและรหัสผ่านเมื่อทีมต้องการบัญชีแยก")</p>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="auth-error">@Error</div>
                }

                <AuthGoogleButton Href="@GoogleHref" Label="@Text("Continue with Google", "ดำเนินการต่อด้วย Google")" />

                <div class="auth-divider" role="separator">@Text("or", "หรือ")</div>

                <details class="auth-email-panel" open="@EmailPanelOpen">
                    <summary>@Text("Create with email", "สร้างด้วยอีเมล")</summary>
                    <div class="auth-form-wrapper">
                        <div class="auth-form-inner">
                            <form class="auth-form" method="post" action="/auth/sign-up/email">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
                                <div class="form-grid two">
                                    <label>
                                        @Text("First name", "ชื่อ")
                                        <input name="FirstName" autocomplete="given-name" required />
                                    </label>
                                    <label>
                                        @Text("Last name", "นามสกุล")
                                        <input name="LastName" autocomplete="family-name" required />
                                    </label>
                                </div>
                                <label>
                                    @Text("Email", "อีเมล")
                                    <input name="Email" type="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="sign-up-email-requirements" required />
                                    <small id="sign-up-email-requirements" class="auth-field-help">@Text("Use a full email address, for example name@company.com.", "ใช้อีเมลแบบเต็ม เช่น name@company.com")</small>
                                </label>
                                <label>
                                    @Text("Password", "รหัสผ่าน")
                                    <input name="Password" type="password" autocomplete="new-password" minlength="6" aria-describedby="sign-up-password-requirements" required />
                                    <small id="sign-up-password-requirements" class="auth-field-help">@Text("Password must be at least 6 characters.", "รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร")</small>
                                </label>
                                <button class="button primary" type="submit">@Text("Create account", "สร้างบัญชี")</button>
                            </form>
                        </div>
                    </div>
                </details>

                <div class="auth-links">
                    <a href="/auth/forgot-password">@Text("Forgot password?", "ลืมรหัสผ่าน?")</a>
                    <button type="button" class="auth-link-button" @onclick="ToggleMode">@Text("Already have an account?", "มีบัญชีอยู่แล้ว?")</button>
                </div>
            }
            else
            {
                <h1 class="auth-title">
                    <span>@Text("Sign in to", "เข้าสู่ระบบ")</span>
                    <img class="auth-title-logo" src="/images/logo.svg" width="140" height="32" alt="MALIEV" />
                </h1>
                <p class="auth-form-subtitle">@Text("Use your customer account for shop checkout, addresses, preferences, and order history. Manufacturing projects continue in the quote engine.", "ใช้บัญชีลูกค้าสำหรับชำระเงินร้านค้า ที่อยู่ การตั้งค่า และประวัติคำสั่งซื้อ ส่วนโปรเจกต์งานผลิตยังอยู่ในระบบราคา")</p>

                @if (!string.IsNullOrWhiteSpace(Status))
                {
                    <div class="auth-status">@Status</div>
                }
                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="auth-error">@Error</div>
                }

                <AuthGoogleButton Href="@GoogleHref" Label="@Text("Continue with Google", "ดำเนินการต่อด้วย Google")" />

                @if (_passkeyAvailable)
                {
                    <button type="button" class="auth-passkey-button" @onclick="SignInWithPasskey">
                        <span class="auth-passkey-icon">&#128273;</span>
                        @Text("Sign in with passkey", "เข้าสู่ระบบด้วย Passkey")
                    </button>

                    <div class="auth-divider" role="separator">
                        <span>@Text("OR", "หรือ")</span>
                    </div>
                }
                else
                {
                    <div class="auth-divider" role="separator">@Text("or", "หรือ")</div>
                }

                <details class="auth-email-panel" open="@EmailPanelOpen">
                    <summary>@Text("Use email instead", "ใช้อีเมลแทน")</summary>
                    <div class="auth-form-wrapper">
                        <div class="auth-form-inner">
                            <form class="auth-form" method="post" action="/auth/sign-in/email">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
                                <label>
                                    @Text("Email", "อีเมล")
                                    <input name="Email" type="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="sign-in-email-requirements" required />
                                    <small id="sign-in-email-requirements" class="auth-field-help">@Text("Use a full email address, for example name@company.com.", "ใช้อีเมลแบบเต็ม เช่น name@company.com")</small>
                                </label>
                                <label>
                                    @Text("Password", "รหัสผ่าน")
                                    <input name="Password" type="password" autocomplete="current-password" minlength="6" aria-describedby="sign-in-password-requirements" required />
                                    <small id="sign-in-password-requirements" class="auth-field-help">@Text("Password must be at least 6 characters.", "รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร")</small>
                                </label>
                                <button class="button primary" type="submit">@Text("Sign in", "เข้าสู่ระบบ")</button>
                            </form>
                        </div>
                    </div>
                </details>

                <div class="auth-links">
                    <a href="/auth/forgot-password">@Text("Forgot password?", "ลืมรหัสผ่าน?")</a>
                    <button type="button" class="auth-link-button" @onclick="ToggleMode">@Text("Create account", "สร้างบัญชี")</button>
                </div>

                <div class="auth-benefits-box">
                    <div class="auth-benefit-item">
                        <svg class="auth-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>
                        <span>@Text("Shared across website, quotes, and orders", "ใช้ร่วมกันระหว่างเว็บไซต์ ใบราคา และคำสั่งซื้อ")</span>
                    </div>
                    <div class="auth-benefit-item">
                        <svg class="auth-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span>@Text("Secured with Google authentication", "รักษาความปลอดภัยด้วยบัญชี Google")</span>
                    </div>
                    <div class="auth-benefit-item">
                        <svg class="auth-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                        <span>@Text("Manage addresses, orders, and preferences", "จัดการที่อยู่ คำสั่งซื้อ และการตั้งค่า")</span>
                    </div>
                    <div class="auth-benefit-item">
                        <svg class="auth-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        <span>@Text("Contact support from your account", "ติดต่อฝ่ายสนับสนุนจากบัญชีของคุณ")</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Mode { get; set; }

    private string SafeReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith("/", StringComparison.Ordinal)
        ? "/account"
        : ReturnUrl;

    private string GoogleHref => $"/auth/google?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
    private bool EmailPanelOpen => !string.IsNullOrWhiteSpace(Error);
    private bool _isSignUp;
    private bool _passkeyAvailable;

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        _isSignUp = string.Equals(Mode, "signup", StringComparison.OrdinalIgnoreCase);
        _passkeyAvailable = false;
        try
        {
            _passkeyAvailable = await JS.InvokeAsync<bool>("malievPasskey.isAvailable");
        }
        catch
        {
            // JS interop not available during prerendering
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _passkeyAvailable = await JS.InvokeAsync<bool>("malievPasskey.isAvailable");
                StateHasChanged();
            }
            catch { }
        }
    }

    private void ToggleMode()
    {
        _isSignUp = !_isSignUp;
    }

    private async Task SignInWithPasskey()
    {
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("malievPasskey.authenticatePasskey",
                "/auth/v1/passkey/auth/begin", "/auth/v1/passkey/auth/complete", (object?)null);
            if (result.TryGetProperty("success", out var success) && success.GetBoolean())
            {
                var principalId = result.TryGetProperty("principalId", out var pid) ? pid.GetGuid() : Guid.Empty;
                var email = result.TryGetProperty("email", out var em) ? em.GetString() : null;
                var csrfToken = await JS.InvokeAsync<string>("getAntiForgeryToken");
                await JS.InvokeVoidAsync("submitPasskeySignIn", "/auth/passkey-sign-in", principalId.ToString(), email, SafeReturnUrl, csrfToken);
            }
            else
            {
                PageNavigation.NavigateTo($"/auth/sign-in?error={Uri.EscapeDataString(result.TryGetProperty("error", out var err) ? err.GetString() ?? "Passkey authentication failed" : "Passkey authentication failed")}", true);
            }
        }
        catch (Exception ex)
        {
            PageNavigation.NavigateTo($"/auth/sign-in?error={Uri.EscapeDataString(ex.Message)}", true);
        }
    }

    private string Text(string en, string th) => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
}
