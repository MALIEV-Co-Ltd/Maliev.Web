@page "/auth/sign-in"
@inherits PreferenceAwareComponentBase
@using System.ComponentModel.DataAnnotations

<PageTitle>@Text("Sign in or sign up", "เข้าสู่ระบบหรือสมัครสมาชิก") - MALIEV</PageTitle>

<div class="auth-split">
    <div class="auth-brand-panel">
        <div class="auth-brand-content">
            <img class="auth-brand-logo" src="/images/logo.svg" width="180" height="41" alt="MALIEV" />
            <p class="auth-brand-tagline">@Text("Precision manufacturing on demand.", "งานผลิตความแม่นยำสูง ตามความต้องการ")</p>
            <ul class="auth-brand-features" aria-hidden="true">
                <li>@Text("CNC Machining", "งาน CNC")</li>
                <li>@Text("3D Printing — FDM, SLA, SLS, MJF", "พิมพ์ 3 มิติ — FDM, SLA, SLS, MJF")</li>
                <li>@Text("3D Scanning & Reverse Engineering", "สแกน 3 มิติ และ Reverse Engineering")</li>
                <li>@Text("Transparent pricing from CAD files", "ราคาโปร่งใสจากไฟล์ CAD")</li>
            </ul>
            <div class="auth-trust-row">
                <span class="auth-trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    @Text("256-bit SSL", "ความปลอดภัย SSL")
                </span>
                <span class="auth-trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    @Text("Data protected", "ข้อมูลได้รับการคุ้มครอง")
                </span>
                <span class="auth-trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>
                    @Text("GDPR compliant", "ปฏิบัติตาม GDPR")
                </span>
            </div>
        </div>
    </div>

    <div class="auth-form-panel">
        <div class="auth-form-inner">
            @if (ShowEmailStep)
            {
                <h1 class="auth-title">
                    <span>@Text("Sign in or sign up", "เข้าสู่ระบบหรือสมัครสมาชิก")</span>
                    <img class="auth-title-logo" src="/images/logo.svg" width="140" height="32" alt="MALIEV" />
                </h1>
                <p class="auth-form-subtitle">@Text("Google is the fastest way to use MALIEV. Email and password is available when your team needs a separate login.", "Google เป็นวิธีที่เร็วที่สุดในการใช้ MALIEV และยังใช้อีเมลกับรหัสผ่านได้เมื่อทีมต้องการบัญชีแยก")</p>

                @if (!string.IsNullOrWhiteSpace(Status))
                {
                    <div class="auth-status">@Status</div>
                }
                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="auth-error">@Error</div>
                }

                <form class="auth-email-entry-form auth-form" @onsubmit="ContinueWithEmail" @onsubmit:preventDefault>
                    <label>
                        @Text("Email address", "อีเมล")
                        <input id="auth-email-entry" name="Email" type="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="auth-email-entry-requirements" @bind="_email" @bind:event="oninput" required />
                    </label>
                    <ul id="auth-email-entry-requirements" class="auth-requirement-list" aria-live="polite">
                        <li class="@EmailRequirementClass">@Text("Enter a valid email address.", "กรอกอีเมลที่ถูกต้อง")</li>
                    </ul>
                    <button class="button primary" type="submit" disabled="@(!EmailLooksValid)">@Text("Continue", "ดำเนินการต่อ")</button>
                </form>

                <div class="auth-divider" role="separator">@Text("or", "หรือ")</div>

                <AuthGoogleButton Href="@GoogleHref" Label="@Text("Continue with Google", "ดำเนินการต่อด้วย Google")" />

                <div class="auth-links auth-mode-links">
                    @if (!_isSignUp)
                    {
                        <a href="/auth/forgot-password">@Text("Forgot password?", "ลืมรหัสผ่าน?")</a>
                    }
                    <button type="button" class="auth-link-button" @onclick="ToggleMode">@ModeSwitchLabel</button>
                </div>
            }
            else if (_isSignUp)
            {
                <h1 class="auth-title">
                    <span>@Text("Create account with email", "สร้างบัญชีด้วยอีเมล")</span>
                    <img class="auth-title-logo" src="/images/logo.svg" width="140" height="32" alt="MALIEV" />
                </h1>
                <p class="auth-form-subtitle">@Text("Add a password and we will send verification to this email address.", "เพิ่มรหัสผ่าน แล้วเราจะส่งการยืนยันไปยังอีเมลนี้")</p>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="auth-error">@Error</div>
                }

                <form class="auth-credential-form auth-form" method="post" action="/auth/sign-up/email">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
                    <label>
                        @Text("Email", "อีเมล")
                        <input name="Email" type="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="sign-up-email-requirements" @bind="_email" @bind:event="oninput" required />
                        <small id="sign-up-email-requirements" class="auth-field-help">@Text("Use a full email address, for example name@company.com.", "ใช้อีเมลแบบเต็ม เช่น name@company.com")</small>
                    </label>
                    <label>
                        @Text("Password", "รหัสผ่าน")
                        <input name="Password" type="password" autocomplete="new-password" minlength="6" aria-describedby="sign-up-password-requirements" @bind="_password" @bind:event="oninput" required />
                    </label>
                    <ul id="sign-up-password-requirements" class="auth-requirement-list" aria-live="polite">
                        <li class="@EmailRequirementClass">@Text("Valid email address.", "อีเมลถูกต้อง")</li>
                        <li class="@PasswordRequirementClass">@Text("Password has at least 6 characters.", "รหัสผ่านมีอย่างน้อย 6 ตัวอักษร")</li>
                    </ul>
                    <div class="auth-step-actions">
                        <button class="button primary" type="submit" disabled="@(!CredentialsReady)">@Text("Verify email address", "ยืนยันอีเมล")</button>
                        <button type="button" class="button secondary auth-back-button" @onclick="BackToEmailStep">@Text("Back", "กลับ")</button>
                    </div>
                </form>
            }
            else
            {
                <h1 class="auth-title">
                    <span>@Text("Sign in with email", "เข้าสู่ระบบด้วยอีเมล")</span>
                    <img class="auth-title-logo" src="/images/logo.svg" width="140" height="32" alt="MALIEV" />
                </h1>
                <p class="auth-form-subtitle">@Text("Enter your password to continue with your MALIEV account.", "กรอกรหัสผ่านเพื่อใช้งานบัญชี MALIEV ต่อ")</p>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="auth-error">@Error</div>
                }

                <form class="auth-credential-form auth-form" method="post" action="/auth/sign-in/email">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
                    <label>
                        @Text("Email", "อีเมล")
                        <input name="Email" type="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="sign-in-email-requirements" @bind="_email" @bind:event="oninput" required />
                        <small id="sign-in-email-requirements" class="auth-field-help">@Text("Use a full email address, for example name@company.com.", "ใช้อีเมลแบบเต็ม เช่น name@company.com")</small>
                    </label>
                    <label>
                        @Text("Password", "รหัสผ่าน")
                        <input name="Password" type="password" autocomplete="current-password" minlength="6" aria-describedby="sign-in-password-requirements" @bind="_password" @bind:event="oninput" required />
                    </label>
                    <ul id="sign-in-password-requirements" class="auth-requirement-list" aria-live="polite">
                        <li class="@EmailRequirementClass">@Text("Valid email address.", "อีเมลถูกต้อง")</li>
                        <li class="@PasswordRequirementClass">@Text("Password has at least 6 characters.", "รหัสผ่านมีอย่างน้อย 6 ตัวอักษร")</li>
                    </ul>
                    <div class="auth-step-actions">
                        <button class="button primary" type="submit" disabled="@(!CredentialsReady)">@Text("Sign in", "เข้าสู่ระบบ")</button>
                        <button type="button" class="button secondary auth-back-button" @onclick="BackToEmailStep">@Text("Back", "กลับ")</button>
                    </div>
                </form>

                <div class="auth-links">
                    <a href="/auth/forgot-password">@Text("Forgot password?", "ลืมรหัสผ่าน?")</a>
                    <button type="button" class="auth-link-button" @onclick="ToggleMode">@Text("Create account", "สร้างบัญชี")</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Mode { get; set; }

    private static readonly EmailAddressAttribute EmailValidator = new();

    private string SafeReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith("/", StringComparison.Ordinal)
        ? "/account"
        : ReturnUrl;

    private string GoogleHref => $"/auth/google?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
    private bool ShowEmailStep => _authStep == AuthStep.Email;
    private bool ShowCredentialStep => _authStep == AuthStep.Credentials;
    private bool EmailLooksValid => !string.IsNullOrWhiteSpace(_email) && EmailValidator.IsValid(_email.Trim());
    private bool PasswordMeetsRequirement => _password.Length >= 6;
    private bool CredentialsReady => EmailLooksValid && PasswordMeetsRequirement;
    private string EmailRequirementClass => EmailLooksValid ? "auth-requirement-item is-met" : "auth-requirement-item is-pending";
    private string PasswordRequirementClass => PasswordMeetsRequirement ? "auth-requirement-item is-met" : "auth-requirement-item is-pending";
    private string ModeSwitchLabel => _isSignUp
        ? Text("Already have an account?", "มีบัญชีอยู่แล้ว?")
        : Text("Create account", "สร้างบัญชี");

    private AuthStep _authStep = AuthStep.Email;
    private bool _isSignUp;
    private string _email = string.Empty;
    private string _password = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        _isSignUp = string.Equals(Mode, "signup", StringComparison.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(Error))
        {
            _authStep = AuthStep.Credentials;
        }
    }

    private void ContinueWithEmail()
    {
        if (!EmailLooksValid)
        {
            return;
        }

        _authStep = AuthStep.Credentials;
    }

    private void BackToEmailStep()
    {
        _authStep = AuthStep.Email;
    }

    private void ToggleMode()
    {
        _isSignUp = !_isSignUp;
        if (ShowCredentialStep)
        {
            _password = string.Empty;
        }
    }

    private string Text(string en, string th) => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;

    private enum AuthStep
    {
        Email,
        Credentials
    }
}
