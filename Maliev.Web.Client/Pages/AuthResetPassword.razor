@page "/auth/reset-password"
@inherits PreferenceAwareComponentBase

<PageTitle>@Text("Set new password", "ตั้งรหัสผ่านใหม่") - MALIEV</PageTitle>

<section class="auth-shell">
    <div class="auth-panel">
        <p class="eyebrow">@Text("Account recovery", "กู้คืนบัญชี")</p>
        <h1>@Text("Set a new password", "ตั้งรหัสผ่านใหม่")</h1>
        <p>@Text("Use the reset token from your email and choose a new password.", "ใช้โทเคนรีเซ็ตจากอีเมลและตั้งรหัสผ่านใหม่")</p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="auth-error">@Error</div>
        }

        <form class="auth-form" method="post" action="/auth/reset-password">
            <AntiforgeryToken />
            <label>
                @Text("Email", "อีเมล")
                <input name="Email" type="email" autocomplete="email" value="@Email" required />
            </label>
            <label>
                @Text("Reset token", "โทเคนรีเซ็ต")
                <input name="Token" value="@Token" required />
            </label>
            <label>
                @Text("New password", "รหัสผ่านใหม่")
                <input name="Password" type="password" autocomplete="new-password" minlength="12" required />
            </label>
            <button class="button primary" type="submit">@Text("Update password", "อัปเดตรหัสผ่าน")</button>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    private string Text(string en, string th) => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
}
