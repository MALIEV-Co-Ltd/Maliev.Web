@page "/account"
@attribute [Authorize]
@inherits PreferenceAwareComponentBase
@inject MalievApiClient Api

<PageTitle>@Text("Account", "บัญชี") - MALIEV</PageTitle>

<section class="page-hero compact account-hero">
    <h1>@Text("Your MALIEV account", "บัญชี MALIEV ของคุณ")</h1>
    <p>@Text("Manage your customer profile, delivery addresses, storefront orders, and preferences. Manufacturing projects stay in the quote engine using the same customer identity.", "จัดการโปรไฟล์ลูกค้า ที่อยู่จัดส่ง คำสั่งซื้อร้านค้า และการตั้งค่า โปรเจกต์งานผลิตยังอยู่ในระบบราคาโดยใช้ตัวตนลูกค้าเดียวกัน")</p>
</section>

<section class="section account-dashboard">
    @if (_loading)
    {
        <div class="account-loading-panel" role="status" aria-live="polite" aria-busy="true">
            <span class="account-loading-spinner" aria-hidden="true"></span>
            <div class="account-loading-copy">
                <h2>@Text("Preparing your account", "กำลังเตรียมบัญชีของคุณ")</h2>
                <p>@Text("Loading profile, saved addresses, orders, and preferences.", "กำลังโหลดโปรไฟล์ ที่อยู่ คำสั่งซื้อ และการตั้งค่า")</p>
            </div>
            <div class="account-loading-skeleton" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    }
    else if (_accountUnavailable)
    {
        <div class="account-unavailable-panel" role="alert">
            <span class="account-unavailable-icon" aria-hidden="true">!</span>
            <div class="account-unavailable-copy">
                <span class="card-meta">@Text("Account status", "สถานะบัญชี")</span>
                <h2>@Text("Account details are temporarily unavailable.", "รายละเอียดบัญชียังไม่พร้อมใช้งานชั่วคราว")</h2>
                <p>@Text("We could not load your account details right now. Please try again in a moment or sign in again.", "ขณะนี้ไม่สามารถโหลดรายละเอียดบัญชีได้ โปรดลองอีกครั้งในสักครู่หรือเข้าสู่ระบบใหม่")</p>
                <div class="account-unavailable-actions">
                    <a class="button secondary" href="/account">@Text("Try again", "ลองอีกครั้ง")</a>
                    <a class="button primary" href="/auth/sign-in">@Text("Sign in again", "เข้าสู่ระบบอีกครั้ง")</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="account-overview-card account-profile-card">
            <div class="account-profile-header">
                <div class="account-avatar" aria-hidden="true">@AvatarInitials</div>
                <div class="account-profile-identity">
                    <span class="card-meta">@Text("Signed in as", "เข้าสู่ระบบเป็น")</span>
                    <h2>@DisplayName</h2>
                    <p>@_profile?.Email</p>
                </div>
            </div>

            <div class="account-membership-pill">
                <span>@Text("Customer tier", "ระดับลูกค้า")</span>
                <strong>@CustomerTierLabel</strong>
            </div>

            <div class="account-profile-details">
                <div>
                    <span>@Text("Company", "บริษัท")</span>
                    <strong>@CompanyLabel</strong>
                </div>
                <div>
                    <span>@Text("Customer type", "ประเภทลูกค้า")</span>
                    <strong>@CustomerSegmentLabel</strong>
                </div>
                <div>
                    <span>@Text("Mobile", "โทรศัพท์มือถือ")</span>
                    <strong>@MobileLabel</strong>
                </div>
            </div>

            <div class="account-quick-actions">
                <a class="button primary" href="/account/profile">@Text("Edit profile", "แก้ไขโปรไฟล์")</a>
                <a class="button secondary" href="/account/profile">@Text("Change email", "เปลี่ยนอีเมล")</a>
                <a class="button secondary" href="@ResetPasswordHref">@Text("Reset password", "รีเซ็ตรหัสผ่าน")</a>
            </div>

            <form class="account-signout-form" method="post" action="/auth/sign-out">
                <AntiforgeryToken />
                <button type="submit" class="button secondary">@Text("Sign out", "ออกจากระบบ")</button>
            </form>
        </div>

        <div class="account-action-grid">
            <a class="account-action-card" href="/account/profile">
                <span class="card-meta">@Text("Profile", "โปรไฟล์")</span>
                <h3>@Text("Contact and company details", "ข้อมูลติดต่อและบริษัท")</h3>
                <p>@Text("Update name, email, phone, preferred language, and timezone.", "อัปเดตชื่อ อีเมล โทรศัพท์ ภาษา และเขตเวลา")</p>
            </a>
            <a class="account-action-card" href="/account/addresses">
                <span class="card-meta">@Text("Address book", "สมุดที่อยู่")</span>
                <h3>@Text("Billing and shipping", "ที่อยู่จัดส่งและออกบิล")</h3>
                <p>@Text("Keep delivery and billing addresses attached to the shared customer record.", "เก็บที่อยู่จัดส่งและออกบิลไว้กับข้อมูลลูกค้ากลาง")</p>
            </a>
            <a class="account-action-card" href="/account/orders">
                <span class="card-meta">@Text("Orders", "คำสั่งซื้อ")</span>
                <h3>@Text("Shop orders", "คำสั่งซื้อร้านค้า")</h3>
                <p>@Text("Review storefront orders separately from manufacturing projects.", "ดูคำสั่งซื้อร้านค้าแยกจากโปรเจกต์งานผลิต")</p>
            </a>
            <a class="account-action-card" href="@SiteContent.QuoteNdasUrl">
                <span class="card-meta">@Text("Confidentiality", "ความลับ")</span>
                <h3>@Text("NDA agreement", "ข้อตกลง NDA")</h3>
                <p>@NdaCardCopy</p>
                <span class="button secondary">@NdaActionLabel</span>
            </a>
            <a class="account-action-card" href="/account/preferences">
                <span class="card-meta">@Text("Preferences", "การตั้งค่า")</span>
                <h3>@Text("Language and display", "ภาษาและการแสดงผล")</h3>
                <p>@Text("Signed-in preferences are saved to your customer profile when supported, with browser cache as fallback.", "การตั้งค่าหลังเข้าสู่ระบบจะบันทึกในโปรไฟล์ลูกค้าเมื่อรองรับ และใช้แคชเบราว์เซอร์เป็นสำรอง")</p>
            </a>
        </div>
    }
</section>

@code {
    private CustomerAccountProfileDto? _profile;
    private bool _accountUnavailable;
    private bool _loading = true;
    private string DisplayName => string.IsNullOrWhiteSpace(_profile?.DisplayName) ? _profile?.Email ?? "MALIEV customer" : _profile.DisplayName;
    private string CustomerTierLabel => string.IsNullOrWhiteSpace(_profile?.Tier) ? Text("Member", "สมาชิก") : _profile.Tier;
    private string CustomerSegmentLabel => string.IsNullOrWhiteSpace(_profile?.Segment) ? Text("Customer", "ลูกค้า") : _profile.Segment;
    private string NdaStatusLabel => _profile?.NdaStatus?.Trim().ToUpperInvariant() switch
    {
        "SIGNED" or "ACTIVE" => Text("Signed NDA", "NDA ลงนามแล้ว"),
        "DRAFT" => Text("Draft NDA", "NDA ฉบับร่าง"),
        "EXPIRED" => Text("Expired NDA", "NDA หมดอายุ"),
        "REVOKED" => Text("Revoked NDA", "NDA ถูกยกเลิก"),
        _ => Text("No signed NDA", "ยังไม่มี NDA ที่ลงนาม")
    };
    private string NdaActionLabel => HasSignedNda ? Text("View NDA agreement", "ดูข้อตกลง NDA") : Text("Open NDA records", "เปิดรายการ NDA");
    private string NdaCardCopy => HasSignedNda
        ? Text(
            $"Protected by {NdaStatusLabel}. View your signed agreement in the quote portal.",
            $"ได้รับการคุ้มครองด้วยสถานะ {NdaStatusLabel} ดูข้อตกลงที่ลงนามในพอร์ทัลราคา")
        : Text(
            "NDA records and manufacturing documents are kept with your quote workspace.",
            "รายการ NDA และเอกสารงานผลิตจะอยู่กับพื้นที่เสนอราคาของคุณ");
    private bool HasSignedNda => IsSignedNdaStatus(_profile?.NdaStatus);
    private string CompanyLabel => string.IsNullOrWhiteSpace(_profile?.CompanyName) ? Text("Not linked", "ยังไม่ได้เชื่อมโยง") : _profile.CompanyName;
    private string MobileLabel => string.IsNullOrWhiteSpace(_profile?.Mobile) ? Text("Not added", "ยังไม่ได้เพิ่ม") : _profile.Mobile;
    private string ResetPasswordHref => string.IsNullOrWhiteSpace(_profile?.Email)
        ? "/auth/forgot-password"
        : $"/auth/forgot-password?email={Uri.EscapeDataString(_profile.Email)}";
    private string AvatarInitials
    {
        get
        {
            var source = DisplayName;
            var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var initials = parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}"
                : source.Length > 0 ? source[..1] : "M";

            return initials.ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        try
        {
            _profile = await Api.GetAccountProfileAsync();
        }
        catch (Exception)
        {
            _accountUnavailable = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private static bool IsSignedNdaStatus(string? status)
    {
        return string.Equals(status, "Signed", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase);
    }
}
