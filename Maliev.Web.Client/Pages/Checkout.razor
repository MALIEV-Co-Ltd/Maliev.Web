@page "/checkout"
@inherits PreferenceAwareComponentBase
@inject CartState ShoppingCart
@inject MalievApiClient Api

<PageTitle>Checkout - MALIEV</PageTitle>

<section class="page-hero compact">
    <h1>@Text("Checkout", "ชำระเงิน")</h1>
    <p>@Text("Confirm billing, shipping, company, and consent details before payment.", "ยืนยันข้อมูลออกบิล จัดส่ง บริษัท และความยินยอมก่อนชำระเงิน")</p>
</section>

<section class="section cart-layout checkout-layout">
    @if (ShoppingCart.Items.Count == 0)
    {
        <div class="empty-state">
            <h2>@Text("Your cart is empty", "ตะกร้ายังว่าง")</h2>
            <p>@Text("Add products before continuing to checkout.", "เพิ่มสินค้าก่อนดำเนินการชำระเงิน")</p>
            <a class="button primary" href="/shop">@Text("Shop products", "เลือกซื้อสินค้า")</a>
        </div>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="StartCheckoutAsync" FormName="checkout-details-form" class="account-form checkout-form">
            <DataAnnotationsValidator />

            <section class="account-form-section">
                <div class="account-form-section-head">
                    <h2>@Text("Contact and company", "ข้อมูลติดต่อและบริษัท")</h2>
                    <p>@Text("Use legal billing details for invoices and VAT records.", "ใช้ข้อมูลตามกฎหมายสำหรับใบกำกับภาษีและบันทึก VAT")</p>
                </div>
                <label>
                    @Text("Phone", "โทรศัพท์")
                    <input name="phone" autocomplete="tel" inputmode="tel" @bind="_form.Phone" required />
                </label>
                <label>
                    @Text("Company", "บริษัท")
                    <input name="companyName" autocomplete="organization" @bind="_form.CompanyName" />
                </label>
                <label>
                    @Text("VAT / tax ID", "เลขประจำตัวผู้เสียภาษี")
                    <input name="vatId" autocomplete="off" @bind="_form.VatId" />
                </label>
            </section>

            <section class="account-form-section">
                <div class="account-form-section-head">
                    <h2>@Text("Billing address", "ที่อยู่ออกบิล")</h2>
                    <p>@Text("Shown on invoices, receipts, and payment records.", "ใช้บนใบกำกับภาษี ใบเสร็จ และบันทึกการชำระเงิน")</p>
                </div>
                <label>
                    @Text("Billing address", "ที่อยู่ออกบิล")
                    <textarea name="billingAddress" autocomplete="billing street-address" rows="4" @bind="_form.BillingAddress" required></textarea>
                </label>
            </section>

            <section class="account-form-section">
                <div class="account-form-section-head">
                    <h2>@Text("Shipping address", "ที่อยู่จัดส่ง")</h2>
                    <p>@Text("Used for delivery planning, freight quote, and packing documents.", "ใช้สำหรับวางแผนจัดส่ง ค่าขนส่ง และเอกสารแพ็กสินค้า")</p>
                </div>
                <div class="checkout-shipping-grid">
                    <label>
                        @Text("Recipient name", "ชื่อผู้รับ")
                        <input name="shippingRecipientName" autocomplete="shipping name" @bind="_form.ShippingDetails.RecipientName" />
                    </label>
                    <label>
                        @Text("Recipient phone", "เบอร์ผู้รับ")
                        <input name="shippingPhone" autocomplete="shipping tel" inputmode="tel" @bind="_form.ShippingDetails.Phone" required />
                    </label>
                    <label class="span-2">
                        @Text("Address", "ที่อยู่")
                        <input name="shippingAddress" autocomplete="shipping street-address" @bind="_form.ShippingDetails.Address" required />
                    </label>
                    <label>
                        @Text("District", "ตำบล/แขวง")
                        <input name="shippingDistrict" @bind="_form.ShippingDetails.District" required />
                    </label>
                    <label>
                        @Text("State", "อำเภอ/เขต")
                        <input name="shippingState" @bind="_form.ShippingDetails.State" required />
                    </label>
                    <label>
                        @Text("Province", "จังหวัด")
                        <input name="shippingProvince" autocomplete="shipping address-level1" @bind="_form.ShippingDetails.Province" required />
                    </label>
                    <label>
                        @Text("Postal code", "รหัสไปรษณีย์")
                        <input name="shippingPostcode" autocomplete="shipping postal-code" inputmode="numeric" @bind="_form.ShippingDetails.Postcode" required />
                    </label>
                    <label>
                        @Text("Courier", "ขนส่ง")
                        <select @bind="_selectedCourierCode">
                            <option value="">@Text("Any available courier", "ขนส่งที่พร้อมให้บริการ")</option>
                            @foreach (var courier in _couriers)
                            {
                                <option value="@courier.CourierCode">@CourierLabel(courier)</option>
                            }
                        </select>
                    </label>
                    <label>
                        @Text("Weight (g)", "น้ำหนัก (กรัม)")
                        <input type="number" min="1" step="1" @bind="_form.ShippingDetails.WeightGrams" @bind:event="oninput" required />
                    </label>
                    <label>
                        @Text("Length (cm)", "ยาว (ซม.)")
                        <input type="number" min="0.1" step="0.1" @bind="_form.ShippingDetails.LengthCm" @bind:event="oninput" required />
                    </label>
                    <label>
                        @Text("Width (cm)", "กว้าง (ซม.)")
                        <input type="number" min="0.1" step="0.1" @bind="_form.ShippingDetails.WidthCm" @bind:event="oninput" required />
                    </label>
                    <label>
                        @Text("Height (cm)", "สูง (ซม.)")
                        <input type="number" min="0.1" step="0.1" @bind="_form.ShippingDetails.HeightCm" @bind:event="oninput" required />
                    </label>
                </div>
                <button type="button" class="button secondary checkout-rate-button" disabled="@_isFetchingRates" @onclick="FetchShippingRatesAsync">
                    @(_isFetchingRates ? Text("Checking courier rates...", "กำลังตรวจสอบค่าขนส่ง...") : Text("Get courier rates", "ดูราคาขนส่ง"))
                </button>
                @if (_shippingRates.Count > 0)
                {
                    <div class="checkout-rate-list">
                        @foreach (var rate in _shippingRates)
                        {
                            <button type="button"
                                    class="checkout-rate-option @(ReferenceEquals(rate, _selectedShippingRate) ? "is-selected" : "")"
                                    @onclick="@(() => SelectShippingRate(rate))">
                                <span>@rate.ProductName</span>
                                <strong>@FormatCurrency(rate.TotalPrice)</strong>
                                @if (!string.IsNullOrWhiteSpace(rate.EstimatedDeliveryDate))
                                {
                                    <small>@Text("ETA", "ถึงประมาณ") @rate.EstimatedDeliveryDate</small>
                                }
                            </button>
                        }
                    </div>
                }
            </section>

            <label class="checkout-consent">
                <input name="termsAccepted" type="checkbox" @bind="_form.TermsAccepted" required />
                <span>@Text("I accept MALIEV terms and consent to order, payment, delivery, and customer notifications.", "ฉันยอมรับข้อกำหนดของ MALIEV และยินยอมสำหรับคำสั่งซื้อ การชำระเงิน การจัดส่ง และการแจ้งเตือนลูกค้า")</span>
            </label>

            <div class="account-form-actions">
                <a class="button secondary" href="/cart">@Text("Back to cart", "กลับไปตะกร้า")</a>
                <button type="submit" class="button primary" disabled="@_isSubmitting">@Text("Continue to payment", "ดำเนินการชำระเงิน")</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <p class="@(_isError ? "auth-error account-form-alert" : "auth-status account-form-alert")">@_statusMessage</p>
            }
        </EditForm>

        <aside class="cart-panel cart-summary">
            <h2>@Text("Order summary", "สรุปคำสั่งซื้อ")</h2>
            <div class="quote-total">
                @foreach (var item in ShoppingCart.Items)
                {
                    <div><span>@DisplayTitle(item)</span><strong>@LineTotal(item)</strong></div>
                }
                <div><span>@Text("Shipping", "ค่าจัดส่ง")</span><strong>@ShippingSummaryText</strong></div>
                <div class="grand-total"><span>@Text("Estimated total", "ยอดรวมโดยประมาณ")</span><strong>@FormatCurrency(EstimatedTotal)</strong></div>
            </div>
        </aside>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "checkout")]
    public string? CheckoutStatus { get; set; }

    private readonly CheckoutDetailsForm _form = new();
    private bool _isSubmitting;
    private bool _isFetchingRates;
    private bool _isError;
    private string? _statusMessage;
    private IReadOnlyList<CheckoutShippingCourierDto> _couriers = [];
    private List<CheckoutShippingRateDto> _shippingRates = [];
    private CheckoutShippingRateDto? _selectedShippingRate;
    private string? _selectedCourierCode;

    private decimal Subtotal => ShoppingCart.Items.Sum(item => item.UnitPriceThb * Math.Max(1, item.Quantity));
    private decimal EstimatedTotal => Subtotal + (_selectedShippingRate?.TotalPrice ?? 0m);
    private string ShippingSummaryText => _selectedShippingRate is null
        ? Text("Choose a courier rate", "เลือกค่าขนส่ง")
        : $"{_selectedShippingRate.ProductName} · {FormatCurrency(_selectedShippingRate.TotalPrice)}";

    protected override async Task OnInitializedAsync()
    {
        await ShoppingCart.InitializeAsync();
        await Preferences.InitializeAsync();
        _couriers = await Api.GetShippingCouriersAsync();

        if (string.Equals(CheckoutStatus, "terms", StringComparison.OrdinalIgnoreCase))
        {
            _isError = true;
            _statusMessage = Text("Accept MALIEV terms before continuing.", "กรุณายอมรับข้อกำหนดของ MALIEV ก่อนดำเนินการต่อ");
        }
    }

    private async Task StartCheckoutAsync()
    {
        if (!_form.TermsAccepted)
        {
            _isError = true;
            _statusMessage = Text("Accept MALIEV terms before continuing.", "กรุณายอมรับข้อกำหนดของ MALIEV ก่อนดำเนินการต่อ");
            return;
        }

        _isSubmitting = true;
        _isError = false;
        _statusMessage = null;

        try
        {
            var checkout = await Api.CreateCheckoutDraftAsync(new CheckoutDraftRequest
            {
                Culture = Preferences.Culture,
                Phone = _form.Phone,
                CompanyName = _form.CompanyName,
                VatId = _form.VatId,
                BillingAddress = _form.BillingAddress,
                ShippingAddress = BuildShippingAddressText(),
                ShippingDetails = _form.ShippingDetails,
                SelectedShippingRate = _selectedShippingRate,
                TermsAccepted = _form.TermsAccepted,
                Items = ShoppingCart.Items.ToList()
            });

            _statusMessage = Text(
                $"Checkout draft {checkout.CheckoutId:N} is ready. Payment provider handoff will open next.",
                $"แบบร่างชำระเงิน {checkout.CheckoutId:N} พร้อมแล้ว ระบบจะเปิดขั้นตอนชำระเงินต่อไป");
        }
        catch (MalievApiException ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task FetchShippingRatesAsync()
    {
        var validationError = ValidateShippingDetails();
        if (validationError is not null)
        {
            _isError = true;
            _statusMessage = validationError;
            return;
        }

        _isFetchingRates = true;
        _isError = false;
        _statusMessage = null;
        _shippingRates = [];
        _selectedShippingRate = null;
        try
        {
            var response = await Api.GetShippingRatesAsync(new CheckoutShippingRateRequest
            {
                ShippingDetails = _form.ShippingDetails,
                CourierCodes = string.IsNullOrWhiteSpace(_selectedCourierCode) ? [] : [_selectedCourierCode]
            });
            _shippingRates = response.Rates;
            if (_shippingRates.Count == 0)
            {
                _isError = true;
                _statusMessage = Text("No courier rates are available for this address.", "ยังไม่มีราคาขนส่งสำหรับที่อยู่นี้");
            }
        }
        catch (MalievApiException ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isFetchingRates = false;
        }
    }

    private string? ValidateShippingDetails()
    {
        var details = _form.ShippingDetails;
        if (string.IsNullOrWhiteSpace(details.Phone) ||
            string.IsNullOrWhiteSpace(details.Address) ||
            string.IsNullOrWhiteSpace(details.District) ||
            string.IsNullOrWhiteSpace(details.State) ||
            string.IsNullOrWhiteSpace(details.Province) ||
            string.IsNullOrWhiteSpace(details.Postcode))
        {
            return Text("Enter destination phone, address, district, state, province, and postal code before checking courier rates.", "กรอกเบอร์ ที่อยู่ ตำบล อำเภอ จังหวัด และรหัสไปรษณีย์ก่อนตรวจสอบค่าขนส่ง");
        }

        if (details.WeightGrams <= 0 || details.LengthCm <= 0 || details.WidthCm <= 0 || details.HeightCm <= 0)
        {
            return Text("Enter positive parcel weight and dimensions before checking courier rates.", "กรอกน้ำหนักและขนาดพัสดุให้มากกว่าศูนย์ก่อนตรวจสอบค่าขนส่ง");
        }

        return null;
    }

    private void SelectShippingRate(CheckoutShippingRateDto rate)
    {
        _selectedShippingRate = rate;
        _isError = false;
        _statusMessage = null;
    }

    private string BuildShippingAddressText()
    {
        var details = _form.ShippingDetails;
        return string.Join(", ", new[]
        {
            details.Address,
            details.District,
            details.State,
            details.Province,
            details.Postcode
        }.Where(value => !string.IsNullOrWhiteSpace(value)).Select(value => value.Trim()));
    }

    private string CourierLabel(CheckoutShippingCourierDto courier)
    {
        var name = string.IsNullOrWhiteSpace(courier.CourierName) ? courier.CourierCode : courier.CourierName;
        return string.IsNullOrWhiteSpace(courier.Note) ? name : $"{name} - {courier.Note}";
    }

    private static string DisplayTitle(CartItemDto item) =>
        string.IsNullOrWhiteSpace(item.Title) ? item.ProductHandle : item.Title;

    private static string LineTotal(CartItemDto item) =>
        FormatCurrency(item.UnitPriceThb * Math.Max(1, item.Quantity));

    private static string FormatCurrency(decimal amount) =>
        string.Create(CultureInfo.GetCultureInfo("th-TH"), $"฿{amount:N2}");

    private string Text(string en, string th) =>
        Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;

    private sealed class CheckoutDetailsForm
    {
        public string Phone { get; set; } = string.Empty;

        public string CompanyName { get; set; } = string.Empty;

        public string VatId { get; set; } = string.Empty;

        public string BillingAddress { get; set; } = string.Empty;

        public string ShippingAddress { get; set; } = string.Empty;

        public CheckoutShippingDetailsDto ShippingDetails { get; set; } = new();

        public bool TermsAccepted { get; set; }
    }
}
