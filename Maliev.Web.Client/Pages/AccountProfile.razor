        new("Europe/Zurich", "Europe/Zurich (GMT+1/+2)"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var emailVerifiedClaim = state.User.FindFirst("email_verified")?.Value;
        _emailVerified = emailVerifiedClaim != "false";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var profile = await Api.GetAccountProfileAsync();
            _form.FirstName = profile.FirstName;
            _form.LastName = profile.LastName;
            _form.Email = profile.Email;
            _form.Mobile = profile.Mobile;
            _form.CompanyName = profile.CompanyName;
            _companySearchQuery = profile.CompanyName ?? string.Empty;
            _form.CompanyVatNumber = profile.CompanyVatNumber;
            _form.CompanyRegistrationNumber = profile.CompanyRegistrationNumber;
            _form.CompanyContactEmail = profile.CompanyContactEmail;
            _form.CompanyContactPhone = profile.CompanyContactPhone;
            _form.PreferredLanguage = NormalizeLanguage(profile.PreferredLanguage);
            _form.Timezone = NormalizeTimezone(profile.Timezone);
            _form.Version = profile.Version;
            _form.CompanyVersion = profile.CompanyVersion;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _status = null;
        try
        {
            _form.PreferredLanguage = NormalizeLanguage(_form.PreferredLanguage);
            _form.Timezone = NormalizeTimezone(_form.Timezone);
            var profile = await Api.UpdateAccountProfileAsync(_form);
            _form.Version = profile.Version;
            _form.CompanyName = profile.CompanyName;
            _form.CompanyVatNumber = profile.CompanyVatNumber;
            _form.CompanyRegistrationNumber = profile.CompanyRegistrationNumber;
            _form.CompanyContactEmail = profile.CompanyContactEmail;
            _form.CompanyContactPhone = profile.CompanyContactPhone;
            _form.CompanyVersion = profile.CompanyVersion;
            _status = Text("Profile saved.", "บันทึกโปรไฟล์แล้ว");
            _savedAt = DateTime.UtcNow;
            _relativeTimer?.Dispose();
            _relativeTimerTick = 0;
            _relativeTimer = new System.Threading.Timer(TickRelativeTimer, null,
                TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _savedAt = null;
            _relativeTimer?.Dispose();
            _relativeTimer = null;
        }
        finally
        {
            _saving = false;
        }
    }

    private void SelectBranchTypeHQ(ChangeEventArgs _)
    {
        _form.CompanyBranchType = "HQ";
        _form.CompanyBranchCode = null;
    }

    private void SelectBranchTypeBranch(ChangeEventArgs _)
    {
        _form.CompanyBranchType = "BRANCH";
    }

    private async Task SearchCompaniesAsync(ChangeEventArgs e)
    {
        var query = e.Value?.ToString() ?? string.Empty;
        _companySearchQuery = query;
        _form.CompanyName = string.IsNullOrWhiteSpace(query) ? null : query;
        _companySearched = false;
        var version = ++_companySearchVersion;

        _companySearchCts?.Cancel();
        _companySearchCts = new System.Threading.CancellationTokenSource();
        var cts = _companySearchCts;

        if (query.Length < 2)
        {
            _companyResults = [];
            _companySearching = false;
            return;
        }

        _companySearching = true;
        StateHasChanged();

        try
        {
            await Task.Delay(300, cts.Token);
            if (version != _companySearchVersion) return;

            var results = await Api.SearchCompaniesAsync(query, cts.Token);
            if (version == _companySearchVersion)
            {
                _companyResults = results;
                _companySearched = true;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // debounced away
        }
        catch
        {
            _companyResults = [];
        }
        finally
        {
            if (version == _companySearchVersion)
            {
                _companySearching = false;
            }
        }
    }

    private async Task ManualCompanySearchAsync()
    {
        if (_companySearching || _companySearchQuery.Length < 2) return;
        var version = ++_companySearchVersion;
        _companySearched = false;

        _companySearchCts?.Cancel();
        _companySearchCts = new System.Threading.CancellationTokenSource();
        var cts = _companySearchCts;

        _companySearching = true;
        StateHasChanged();

        try
        {
            var results = await Api.SearchCompaniesAsync(_companySearchQuery, cts.Token);
            if (version == _companySearchVersion)
            {
                _companyResults = results;
                _companySearched = true;
                StateHasChanged();
            }
        }
        catch
        {
            _companyResults = [];
        }
        finally
        {
            if (version == _companySearchVersion)
            {
                _companySearching = false;
            }
        }
    }

    private void ApplyCompanyResult(CompanySearchResultDto result)
    {
        _form.CompanyName = result.NameTh;
        _form.CompanyVatNumber = result.JuristicId;
        _form.CompanyRegistrationNumber = result.JuristicId;
        _companySearchQuery = result.NameTh;
        _companyResults = [];
        _companySearching = false;
    }

    public override void Dispose()
    {
        _companySearchCts?.Cancel();
        _companySearchCts?.Dispose();
        _relativeTimer?.Dispose();
        base.Dispose();
    }

    private string? RelativeSavedAt => _savedAt is null ? null : FormatRelative(_savedAt.Value);

    private static string? FormatRelative(DateTime savedAt)
    {
        var elapsed = DateTime.UtcNow - savedAt;
        if (elapsed.TotalSeconds < 30) return "a moment ago";
        if (elapsed.TotalSeconds < 60) return "a minute ago";
        if (elapsed.TotalMinutes < 2) return "a minute ago";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} minutes ago";
        if (elapsed.TotalHours < 2) return "an hour ago";
        return $"{(int)elapsed.TotalHours} hours ago";
    }

    private void TickRelativeTimer(object? state)
    {
        _relativeTimerTick++;
        InvokeAsync(StateHasChanged);
        var elapsed = _savedAt.HasValue ? DateTime.UtcNow - _savedAt.Value : TimeSpan.Zero;
        var nextTick = elapsed.TotalMinutes < 2 ? 10_000
            : elapsed.TotalMinutes < 5 ? 30_000
            : 60_000;
        _relativeTimer?.Change(nextTick, Timeout.Infinite);
    }

    private void StartEmailChange()
    {
        _emailChangeState = "editing";
        _newEmail = string.Empty;
        _pendingEmail = string.Empty;
        _emailChangeError = null;
    }

    private async Task SendVerificationAsync()
    {
        if (_sendingVerification) return;
        _emailChangeError = null;

        if (string.IsNullOrWhiteSpace(_newEmail))
        {
            _emailChangeError = Text("Please enter an email address.", "กรุณากรอกที่อยู่อีเมล");
            return;
        }

        _sendingVerification = true;
        try
        {
            await Api.InitiateEmailChangeAsync(_newEmail.Trim());
            _pendingEmail = _newEmail.Trim();
            _emailChangeState = "pending";
        }
        catch (MalievApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            _emailChangeError = ex.Message;
        }
        catch (MalievApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _emailChangeError = ex.Message;
        }
        catch (Exception ex)
        {
            _emailChangeError = ex.Message;
        }
        finally
        {
            _sendingVerification = false;
        }
    }

    private async Task ResendVerificationAsync()
    {
        if (_sendingVerification) return;
        _emailChangeError = null;

        _sendingVerification = true;
        try
        {
            await Api.ResendEmailChangeAsync();
            _status = Text("Verification email resent!", "ส่งอีเมลยืนยันอีกครั้งแล้ว!");
        }
        catch (Exception ex)
        {
            _emailChangeError = ex.Message;
        }
        finally
        {
            _sendingVerification = false;
        }
    }

    private void CancelEmailChange()
    {
        _emailChangeState = null;
        _newEmail = string.Empty;
        _pendingEmail = string.Empty;
        _emailChangeError = null;
    }

    private void HandleInvalidSubmit()
    {
        _status = null;
        _error = null;
    }

    private void DismissVerificationBanner(MudAlert _)
    {
