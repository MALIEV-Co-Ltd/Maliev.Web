        new("Asia/Singapore", "Asia/Singapore (GMT+8)"),
        new("Asia/Taipei", "Asia/Taipei (GMT+8)"),
        new("Asia/Tehran", "Asia/Tehran (GMT+3:30/+4:30)"),
        new("Asia/Tokyo", "Asia/Tokyo (GMT+9)"),
