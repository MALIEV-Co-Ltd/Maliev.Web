        new("America/Anchorage", "America/Anchorage (GMT-9/-8)"),
        new("America/Argentina/Buenos_Aires", "America/Buenos Aires (GMT-3)"),
        new("America/Bogota", "America/Bogota (GMT-5)"),
        new("America/Chicago", "America/Chicago (GMT-6/-5)"),
        new("America/Denver", "America/Denver (GMT-7/-6)"),
        new("America/Halifax", "America/Halifax (GMT-4/-3)"),
        new("America/Los_Angeles", "America/Los Angeles (GMT-8/-7)"),
        new("America/Mexico_City", "America/Mexico City (GMT-6/-5)"),
        new("America/New_York", "America/New York (GMT-5/-4)"),
