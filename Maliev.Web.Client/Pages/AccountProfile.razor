    private async Task ResendVerificationEmail()
    {
        if (_resending) return;
        _resending = true;
        try
        {
            var content = new FormUrlEncodedContent(new Dictionary<string, string>());
            await Http.PostAsync("/auth/resend-verification", content);
            _status = Text("Verification email sent! Check your inbox.", "ส่งอีเมลยืนยันแล้ว! ตรวจสอบกล่องจดหมายของคุณ");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _resending = false;
        }
    }

    private void ToggleLanguageDropdown()
    {
        _languageDropdownOpen = !_languageDropdownOpen;
    }

    private void SelectLanguage(string language)
    {
        _form.PreferredLanguage = NormalizeLanguage(language);
        _languageDropdownOpen = false;
        _status = null;
    }

    private bool IsLanguageSelected(string language)
    {
        return string.Equals(_form.PreferredLanguage, language, StringComparison.OrdinalIgnoreCase);
    }

    private string LanguageOptionClass(string language)
    {
        return IsLanguageSelected(language) ? "language-dropdown-item active" : "language-dropdown-item";
    }

    private LanguageOption SelectedLanguage =>
        LanguageOptions.FirstOrDefault(option => IsLanguageSelected(option.Value)) ?? LanguageOptions[0];

    private string NormalizeLanguage(string? language)
    {
        if (LanguageOptions.Any(option => string.Equals(option.Value, language, StringComparison.OrdinalIgnoreCase)))
        {
            return language!.ToLowerInvariant();
        }

        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en";
    }

    private static string NormalizeTimezone(string? timezone)
    {
        if (TimezoneOptions.Any(option => string.Equals(option.Value, timezone, StringComparison.OrdinalIgnoreCase)))
        {
            return timezone!;
        }

        return "Asia/Bangkok";
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private sealed record LanguageOption(string Value, string Code, string Label, string DescriptionEn, string DescriptionTh, string FlagIcon);

    private sealed record TimezoneOption(string Value, string Label);
}
