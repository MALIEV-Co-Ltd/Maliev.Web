@page "/auth/sign-up"
@inherits PreferenceAwareComponentBase
@inject NavigationManager Navigation

<PageTitle>@Text("Create account", "สร้างบัญชี") - MALIEV</PageTitle>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        var returnParam = string.IsNullOrWhiteSpace(ReturnUrl) ? string.Empty : $"&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        var errorParam = string.IsNullOrWhiteSpace(Error) ? string.Empty : $"&error={Uri.EscapeDataString(Error)}";
        Navigation.NavigateTo($"/auth/sign-in?mode=signup{returnParam}{errorParam}");
    }

    private string Text(string en, string th) => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
}
