@page "/account/addresses"
@attribute [Authorize(Policy = WebAuthorizationPolicies.CustomerAccount)]
@inherits PreferenceAwareComponentBase
@inject MalievApiClient Api

<PageTitle>@Text("Addresses", "ที่อยู่") - MALIEV</PageTitle>

<section class="page-hero compact account-hero">
    <h1>@Text("Billing and shipping addresses", "ที่อยู่ออกบิลและจัดส่ง")</h1>
    <p>@Text("Addresses are attached to the shared customer record. Choose separate shipping or billing countries for each address.", "ที่อยู่ผูกกับข้อมูลลูกค้ากลาง เลือกประเทศสำหรับที่อยู่จัดส่งหรือออกบิลแต่ละรายการได้")</p>
</section>

<section class="section account-two-column">
    <div class="account-nav-card">
        <a href="/account">@Text("Account home", "หน้าบัญชี")</a>
        <a href="/account/profile">@Text("Profile", "โปรไฟล์")</a>
        <a class="active" href="/account/addresses">@Text("Addresses", "ที่อยู่")</a>
        <a href="/account/orders">@Text("Orders", "คำสั่งซื้อ")</a>
        <a href="/account/preferences">@Text("Preferences", "การตั้งค่า")</a>
    </div>

    <div class="account-stack">
        <div class="account-panel">
            <div class="section-heading compact-heading">
                <div>
                    <h2>@Text("Customer address book", "สมุดที่อยู่ลูกค้า")</h2>
                </div>
                @if (!_showForm && !_editingAddressId.HasValue)
                {
                    <a class="button primary" href="/account/addresses?mode=add">@Text("Add address", "เพิ่มที่อยู่")</a>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <p class="success-message">@_status</p>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="load-message">@_error</p>
            }

            @if (_loading)
            {
                <p class="load-message">@Text("Loading addresses...", "กำลังโหลดที่อยู่...")</p>
            }
            else if (_addresses.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>@Text("No saved addresses yet", "ยังไม่มีที่อยู่ที่บันทึก")</h3>
                    <p>@Text("Add the address your team uses for checkout and delivery.", "เพิ่มที่อยู่ที่ทีมของคุณใช้สำหรับชำระเงินและจัดส่ง")</p>
                </div>
            }
            else
            {
                <div class="address-grid">
                    @foreach (var address in _addresses)
                    {
                        var mapUrl = MapUrl(address);
                        <article class="address-card">
                            <div class="address-card-header">
                                <div class="address-card-badges">
                                    <span class="card-meta">@address.Type</span>
                                    @if (!string.IsNullOrWhiteSpace(address.PlaceLabel))
                                    {
                                        <span class="card-meta card-meta--place">@(string.Equals(address.PlaceLabel, "Other", StringComparison.OrdinalIgnoreCase) ? (address.PlaceLabelOther ?? "Other") : address.PlaceLabel)</span>
                                    }
                                    @if (address.IsDefault)
                                    {
                                        <span class="card-meta card-meta--default">@Text("Default", "ค่าเริ่มต้น")</span>
                                    }
                                </div>
                                <h3>@AddressTitle(address)</h3>
                            </div>
                            @if (address.Latitude.HasValue && address.Longitude.HasValue)
                            {
                                <div class="address-card-map">
                                    <img src="@Api.BuildStaticMapUrl(address.Latitude.Value, address.Longitude.Value)"
                                         alt="@Text("Location map", "แผนที่ตำแหน่ง")"
                                         loading="lazy"
                                         width="320"
                                         height="160"
                                         class="address-card-map-img" />
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(address.GooglePlaceName))
                            {
                                <p class="address-card-place">📍 @address.GooglePlaceName</p>
                            }
                            <p class="address-card-lines">@AddressLines(address)</p>
                            @if (!string.IsNullOrWhiteSpace(address.RecipientPhone))
                            {
                                <p class="address-card-phone">📞 @address.RecipientPhone</p>
                            }
                            <div class="address-actions">
                                @if (!string.IsNullOrWhiteSpace(mapUrl))
                                {
                                    <a href="@mapUrl" target="_blank" rel="noopener noreferrer" class="button secondary">@Text("Map", "แผนที่")</a>
                                }
                                <button type="button" class="button secondary" @onclick="() => Edit(address)">@Text("Edit", "แก้ไข")</button>
                                <button type="button" class="button secondary danger" @onclick="() => DeleteAsync(address)">@Text("Delete", "ลบ")</button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        @if (_showForm || _editingAddressId.HasValue)
        {
            <div class="account-panel">
                <div class="section-heading compact-heading">
                    <div>
                        <h2>@(_editingAddressId.HasValue ? Text("Update address", "อัปเดตที่อยู่") : Text("Add address", "เพิ่มที่อยู่"))</h2>
                    </div>
                </div>

                <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit" FormName="account-address-form" class="account-form" novalidate>
                    <DataAnnotationsValidator />
                    <UnifiedAddressSearch Latitude="@_form.Latitude"
                                          Longitude="@_form.Longitude"
                                          FormattedAddress="@_form.FormattedAddress"
                                          Culture="@Preferences.Culture"
                                          SelectionChanged="ApplyGoogleAddressSelection"
                                          RegistrySelectionChanged="ApplyRegistryLocation" />
                    <div class="form-grid two">
                        <label>
                            @Text("Type", "ประเภท")
                            <InputSelect @bind-Value="FormAddressType">
                                <option value="Shipping">@Text("Shipping", "จัดส่ง")</option>
                                <option value="Billing">@Text("Billing", "ออกบิล")</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _form.Type)" class="field-validation-error" />
                        </label>
                        <label class="checkbox-label address-default-checkbox">
                            <InputCheckbox @bind-Value="_form.IsDefault" />
                            <span>@Text("Default address", "ที่อยู่เริ่มต้น")</span>
                        </label>
                    </div>
                    <div class="form-grid two">
                        <label>
                            @Text("Place name", "ชื่อสถานที่")
                            <InputSelect @bind-Value="_form.PlaceLabel">
                                <option value="Home">@Text("Home", "บ้าน")</option>
                                <option value="Work">@Text("Work", "ที่ทำงาน")</option>
                                <option value="Other">@Text("Other", "อื่นๆ")</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _form.PlaceLabel)" class="field-validation-error" />
                        </label>
                        @if (string.Equals(_form.PlaceLabel, "Other", StringComparison.OrdinalIgnoreCase))
                        {
                            <label>
                                @Text("Other place name", "ชื่อสถานที่อื่น")
                                <InputText @bind-Value="_form.PlaceLabelOther" name="placeLabelOther" aria-label="@Text("Other place name", "ชื่อสถานที่อื่น")" />
                                <ValidationMessage For="@(() => _form.PlaceLabelOther)" class="field-validation-error" />
                            </label>
                        }
                    </div>
                    <div class="form-grid two">
                        <label>
                            @Text("Recipient Name", "ชื่อผู้รับ")
                            <InputText @bind-Value="_form.RecipientName" name="recipientName" aria-label="@Text("Recipient Name", "ชื่อผู้รับ")" />
                            <ValidationMessage For="@(() => _form.RecipientName)" class="field-validation-error" />
                        </label>
                        <label>
                            @Text("Mobile Number", "เบอร์มือถือ")
                            <InputText @bind-Value="_form.RecipientPhone" name="recipientPhone" aria-label="@Text("Mobile Number", "เบอร์มือถือ")" />
                            <ValidationMessage For="@(() => _form.RecipientPhone)" class="field-validation-error" />
                        </label>
                    </div>
                    <label class="form-full">
                        @Text("Address No./Moo/Soi/Road", "บ้านเลขที่/หมู่/ซอย/ถนน")
                        <InputText @bind-Value="_form.AddressLine1" name="addressLine1" aria-label="@Text("Address No./Moo/Soi/Road", "บ้านเลขที่/หมู่/ซอย/ถนน")" />
                        <ValidationMessage For="@(() => _form.AddressLine1)" class="field-validation-error" />
                    </label>
                    <label class="form-full">
                        @Text("Address line 2", "ที่อยู่บรรทัดที่ 2")
                        <InputText @bind-Value="_form.AddressLine2" name="addressLine2" aria-label="@Text("Address line 2", "ที่อยู่บรรทัดที่ 2")" />
                        <ValidationMessage For="@(() => _form.AddressLine2)" class="field-validation-error" />
                    </label>
                    <div class="form-grid three">
                        <label>
                            @Text("Sub District", "แขวง/ตำบล")
                            <InputText @bind-Value="_form.District" name="district" aria-label="@Text("Sub District", "แขวง/ตำบล")" />
                            <ValidationMessage For="@(() => _form.District)" class="field-validation-error" />
                        </label>
                        <label>
                            @Text("District", "เขต/อำเภอ")
                            <InputText @bind-Value="_form.City" name="city" aria-label="@Text("District", "เขต/อำเภอ")" />
                            <ValidationMessage For="@(() => _form.City)" class="field-validation-error" />
                        </label>
                        <label>
                            @Text("Province", "จังหวัด")
                            <InputText @bind-Value="_form.StateProvince" name="stateProvince" disabled="@ProvinceLocked" aria-label="@Text("Province", "จังหวัด")" />
                            <ValidationMessage For="@(() => _form.StateProvince)" class="field-validation-error" />
                        </label>
                    </div>
                    <div class="form-grid two">
                        <label>
                            @Text("Country / region", "ประเทศ/ภูมิภาค")
                            <InputSelect @bind-Value="_form.CountryId" name="countryId" aria-label="@Text("Country / region", "ประเทศ/ภูมิภาค")">
                                @if (_countries.Count == 0)
                                {
                                    <option value="@Guid.Empty">@Text("Country list unavailable", "ไม่สามารถโหลดรายชื่อประเทศ")</option>
                                }
                                else
                                {
                                    @foreach (var country in _countries)
                                    {
                                        <option value="@country.Id">@country.Name (@country.Iso2)</option>
                                    }
                                }
                            </InputSelect>
                        </label>
                        <label>
                            @Text("Postal code", "รหัสไปรษณีย์")
                            <InputText @bind-Value="_form.PostalCode" name="postalCode" disabled="@PostalCodeLocked" aria-label="@Text("Postal code", "รหัสไปรษณีย์")" />
                            <ValidationMessage For="@(() => _form.PostalCode)" class="field-validation-error" />
                        </label>
                    </div>
                    @if (IsShippingAddress)
                    {
                        <label class="form-full">
                            @Text("Note to driver", "หมายเหตุถึงคนขับ")
                            <InputTextArea @bind-Value="_form.DriverNote" name="driverNote" aria-label="@Text("Note to driver", "หมายเหตุถึงคนขับ")" />
                            <ValidationMessage For="@(() => _form.DriverNote)" class="field-validation-error" />
                        </label>
                    }
                    <div class="account-form-actions">
                        <button class="button primary" type="submit" disabled="@_saving">@(_editingAddressId.HasValue ? Text("Save address", "บันทึกที่อยู่") : Text("Add address", "เพิ่มที่อยู่"))</button>
                        <button class="button secondary" type="button" @onclick="ResetForm">@Text("Cancel", "ยกเลิก")</button>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private readonly CustomerAddressUpsertRequest _form = new();
    private List<CustomerAddressDto> _addresses = [];
    private IReadOnlyList<AddressCountryOptionDto> _countries = [];
    private CustomerAccountProfileDto? _profile;
    private Guid? _editingAddressId;
    private bool _loading = true;
    private bool _saving;
    private bool _showForm;
    private bool _initialized;
    private string? _status;
    private string? _error;
    private bool IsGoogleAddress => string.Equals(_form.AddressSource, "GooglePlace", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_form.AddressSource, "GoogleMapPin", StringComparison.OrdinalIgnoreCase);
    private bool IsShippingAddress => string.Equals(_form.Type, "Shipping", StringComparison.OrdinalIgnoreCase);
    private bool ProvinceLocked => IsGoogleAddress && !string.IsNullOrWhiteSpace(_form.StateProvince);
    private bool PostalCodeLocked => IsGoogleAddress && !string.IsNullOrWhiteSpace(_form.PostalCode);
    private Guid DefaultCountryId => _countries.FirstOrDefault(country => string.Equals(country.Iso2, "TH", StringComparison.OrdinalIgnoreCase))?.Id
        ?? _countries.FirstOrDefault()?.Id
        ?? Guid.Empty;
    private string FormAddressType
    {
        get => _form.Type;
        set
        {
            _form.Type = string.IsNullOrWhiteSpace(value) ? "Shipping" : value;
            if (!IsShippingAddress)
            {
                _form.DriverNote = null;
            }
            if (!_editingAddressId.HasValue)
            {
                _form.IsDefault = !_addresses.Any(a => a.IsDefault && string.Equals(a.Type, _form.Type, StringComparison.OrdinalIgnoreCase));
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        await LoadProfileAsync();
        await LoadCountriesAsync();
        ResetForm();
        await LoadAsync();
        _initialized = true;
        ApplyQueryMode();
    }

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            ApplyQueryMode();
        }
    }

    private void ApplyQueryMode()
    {
        if (string.Equals(Mode, "add", StringComparison.OrdinalIgnoreCase)
            && !_showForm
            && !_editingAddressId.HasValue)
        {
            ShowAddForm();
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _profile = await Api.GetAccountProfileAsync();
        }
        catch
        {
            _profile = null;
        }
    }

    private async Task LoadCountriesAsync()
    {
        try
        {
            _countries = await Api.GetAddressCountriesAsync();
        }
        catch
        {
            _countries = [];
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _addresses = (await Api.GetAccountAddressesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _status = null;
        if (!IsShippingAddress)
        {
            _form.DriverNote = null;
        }

        try
        {
            if (_editingAddressId.HasValue)
            {
                await Api.UpdateAccountAddressAsync(_editingAddressId.Value, _form);
                _status = Text("Address updated.", "อัปเดตที่อยู่แล้ว");
            }
            else
            {
                await Api.CreateAccountAddressAsync(_form);
                _status = Text("Address added.", "เพิ่มที่อยู่แล้ว");
            }

            ResetForm();
            _addresses = (await Api.GetAccountAddressesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        _status = null;
        _error = null;
    }

    private async Task DeleteAsync(CustomerAddressDto address)
    {
        _error = null;
        _status = null;
        try
        {
            await Api.DeleteAccountAddressAsync(address.Id, address.Version);
            _addresses.Remove(address);
            _status = Text("Address deleted.", "ลบที่อยู่แล้ว");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ShowAddForm()
    {
        ResetForm();
        _showForm = true;
    }

    private void Edit(CustomerAddressDto address)
    {
        _showForm = true;
        _editingAddressId = address.Id;
        _form.Type = address.Type;
        _form.IsDefault = address.IsDefault;
        _form.PlaceLabel = string.IsNullOrWhiteSpace(address.PlaceLabel) ? "Home" : address.PlaceLabel;
        _form.PlaceLabelOther = address.PlaceLabelOther;
        _form.AddressLine1 = address.AddressLine1;
        _form.AddressLine2 = address.AddressLine2;
        _form.AddressLine3 = address.AddressLine3;
        _form.District = address.District;
        _form.City = address.City;
        _form.StateProvince = address.StateProvince;
        _form.PostalCode = address.PostalCode;
        _form.CountryId = address.CountryId == Guid.Empty ? DefaultCountryId : address.CountryId;
        _form.RecipientName = address.RecipientName;
        _form.RecipientPhone = address.RecipientPhone;
        _form.DriverNote = address.DriverNote;
        _form.AddressSource = string.IsNullOrWhiteSpace(address.AddressSource) ? "Manual" : address.AddressSource;
        _form.GooglePlaceId = address.GooglePlaceId;
        _form.GooglePlaceName = address.GooglePlaceName;
        _form.FormattedAddress = address.FormattedAddress;
        _form.Latitude = address.Latitude;
        _form.Longitude = address.Longitude;
        _form.Version = address.Version;
    }

    private void ResetForm()
    {
        _editingAddressId = null;
        _showForm = false;
        _form.Type = "Shipping";
        _form.IsDefault = !_addresses.Any(a => a.IsDefault && string.Equals(a.Type, _form.Type, StringComparison.OrdinalIgnoreCase));
        _form.PlaceLabel = "Home";
        _form.PlaceLabelOther = null;
        _form.AddressLine1 = string.Empty;
        _form.AddressLine2 = null;
        _form.AddressLine3 = null;
        _form.District = null;
        _form.City = string.Empty;
        _form.StateProvince = string.Empty;
        _form.PostalCode = string.Empty;
        _form.CountryId = DefaultCountryId;
        _form.RecipientName = _profile?.DisplayName;
        _form.RecipientPhone = _profile?.Mobile;
        _form.DriverNote = null;
        _form.AddressSource = "Manual";
        _form.GooglePlaceId = null;
        _form.GooglePlaceName = null;
        _form.FormattedAddress = null;
        _form.Latitude = null;
        _form.Longitude = null;
        _form.Version = 0;
    }

    private void ApplyGoogleAddressSelection(GoogleAddressSelection selection)
    {
        if (!string.IsNullOrWhiteSpace(selection.AddressLine1)) _form.AddressLine1 = selection.AddressLine1;
        if (!string.IsNullOrWhiteSpace(selection.District)) _form.District = selection.District;
        if (!string.IsNullOrWhiteSpace(selection.City)) _form.City = selection.City;
        if (!string.IsNullOrWhiteSpace(selection.StateProvince)) _form.StateProvince = selection.StateProvince;
        if (!string.IsNullOrWhiteSpace(selection.PostalCode)) _form.PostalCode = selection.PostalCode;
        if (!string.IsNullOrWhiteSpace(selection.CountryIso2))
        {
            var country = _countries.FirstOrDefault(item => string.Equals(item.Iso2, selection.CountryIso2, StringComparison.OrdinalIgnoreCase));
            if (country is not null)
            {
                _form.CountryId = country.Id;
            }
        }

        _form.AddressSource = string.IsNullOrWhiteSpace(selection.Source) ? "GooglePlace" : selection.Source;
        _form.GooglePlaceId = selection.PlaceId;
        _form.GooglePlaceName = selection.DisplayName;
        _form.FormattedAddress = selection.FormattedAddress;
        _form.Latitude = selection.Latitude;
        _form.Longitude = selection.Longitude;
    }

    private void ApplyRegistryLocation(ThaiAddressRegistryLocationDto location)
    {
        var useThai = UseThaiRegistryLabels();
        _form.District = RegistryText(useThai ? location.SubDistrictTh : location.SubDistrictEn, useThai ? location.SubDistrictEn : location.SubDistrictTh);
        _form.City = RegistryText(useThai ? location.DistrictTh : location.DistrictEn, useThai ? location.DistrictEn : location.DistrictTh);
        _form.StateProvince = RegistryText(useThai ? location.ProvinceTh : location.ProvinceEn, useThai ? location.ProvinceEn : location.ProvinceTh);
        _form.PostalCode = location.PostalCode;

        var thailand = _countries.FirstOrDefault(country => string.Equals(country.Iso2, "TH", StringComparison.OrdinalIgnoreCase));
        if (thailand is not null)
        {
            _form.CountryId = thailand.Id;
        }

        _form.AddressSource = "RegistryThaiLocation";
        _form.GooglePlaceId = null;
        _form.FormattedAddress = null;
        _form.Latitude = null;
        _form.Longitude = null;
    }

    private static string AddressTitle(CustomerAddressDto address)
    {
        return string.IsNullOrWhiteSpace(address.RecipientName) ? address.AddressLine1 : address.RecipientName;
    }

    private string AddressLines(CustomerAddressDto address)
    {
        return string.Join(", ", new[]
        {
            address.AddressLine1,
            address.AddressLine2,
            address.District,
            address.City,
            address.StateProvince,
            address.PostalCode,
            CountryName(address.CountryId)
        }.Where(part => !string.IsNullOrWhiteSpace(part)));
    }

    private string MapUrl(CustomerAddressDto address)
    {
        if (address.Latitude.HasValue && address.Longitude.HasValue)
            return $"https://www.openstreetmap.org/?mlat={address.Latitude.Value}&mlon={address.Longitude.Value}&zoom=16";

        var query = AddressLines(address);
        return string.IsNullOrWhiteSpace(query)
            ? string.Empty
            : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(query)}";
    }

    private string? CountryName(Guid countryId)
    {
        return _countries.FirstOrDefault(country => country.Id == countryId)?.Name;
    }

    private bool UseThaiRegistryLabels()
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase)
            || ContainsThai(_form.AddressLine1)
            || ContainsThai(_form.District)
            || ContainsThai(_form.City)
            || ContainsThai(_form.StateProvince);
    }

    private static string RegistryText(string? preferred, string? fallback)
    {
        return !string.IsNullOrWhiteSpace(preferred) ? preferred : fallback ?? string.Empty;
    }

    private static bool ContainsThai(string? value)
    {
        return value?.Any(character => character is >= '฀' and <= '๿') == true;
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }
}
