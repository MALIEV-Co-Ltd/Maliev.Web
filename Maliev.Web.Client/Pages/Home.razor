@page "/"
@inherits PreferenceAwareComponentBase
@inject PersistentComponentState ApplicationState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>MALIEV - Rapid manufacturing and workshop-made products</PageTitle>
<HeadContent>
    <meta name="description" content="@_heroCopy.MetaDescription.For(Preferences.Culture)" />
    <link rel="canonical" href="https://www.maliev.com/" />
</HeadContent>

<section class="landing-hero" data-screen-label="Home hero">
    <div class="landing-hero-copy">
        <h1>
            @_heroCopy.HeadlineLead.For(Preferences.Culture)
            <br />
            <span class="accent-blue">@_heroCopy.HeadlineAccent.For(Preferences.Culture)</span>
        </h1>
        <p>@_heroCopy.Body.For(Preferences.Culture)</p>
        <div class="landing-hero-actions">
            <QuoteDropzone Href="@SiteContent.QuoteNewProjectUrl"
                           Title="@QuoteDropzoneTitle"
                           Description="@QuoteDropzoneDescription"
                           ActionText="@QuoteDropzoneAction"
                           FormatsButtonText="@QuoteDropzoneFormatsButtonText"
                           FormatsPanelLabel="@QuoteDropzoneFormatsPanelLabel"
                           AriaLabel="@QuoteDropzoneAction" />
        </div>
        <div class="metric-strip" aria-label="MALIEV manufacturing metrics">
            @foreach (var metric in SiteContent.HeroMetrics)
            {
                <div>
                    @if (!string.IsNullOrWhiteSpace(metric.Suffix))
                    {
                        <strong data-count-up
                                data-count-target="@metric.CountTarget"
                                data-count-suffix="@metric.Suffix"
                                data-count-final="@metric.Value.For(Preferences.Culture)">@metric.Value.For(Preferences.Culture)</strong>
                    }
                    else
                    {
                        <strong>@metric.Value.For(Preferences.Culture)</strong>
                    }
                    <small>@metric.Label.For(Preferences.Culture)</small>
                </div>
            }
        </div>
    </div>
    <div class="landing-hero-visual" aria-label="@Text("Interactive MALIEV manufacturing model", "โมเดลสามมิติ MALIEV")">
        <ManufacturingGizmo Class="manufacturing-gizmo--landing"
                            @key="_heroModel.Key"
                            ModelUrl="@_heroModel.Url"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="@_heroModel.UsePlasticMaterial"
                            AriaLabel="@_heroModel.AriaLabel.For(Preferences.Culture)" />
    </div>
</section>

<section class="industry-sector-band" aria-labelledby="industry-sector-title">
    <div class="industry-sector-band-inner">
        <div class="industry-sector-copy">
            <h2 id="industry-sector-title">@Text("Major industries served", "อุตสาหกรรมหลักที่เราให้บริการ")</h2>
            <p>@Text("We help engineering teams move from prototype to usable production parts across demanding product categories.", "เราช่วยทีมวิศวกรรมเปลี่ยนจากต้นแบบไปสู่ชิ้นงานใช้งานจริงในกลุ่มผลิตภัณฑ์ที่ต้องการความละเอียดสูง")</p>
        </div>
        <ul class="industry-sector-list" aria-label="@Text("Industrial sectors served", "กลุ่มอุตสาหกรรมที่รองรับ")">
            @foreach (var sector in IndustrySectors)
            {
                <li>
                    <a class="industry-sector-card" href="@sector.LinkUrl">
                        <img class="industry-sector-image"
                             src="@sector.ImageUrl"
                             alt="@sector.ImageAlt.For(Preferences.Culture)"
                             loading="lazy" />
                        <span class="industry-sector-card-copy">
                            <span class="industry-sector-card-title">@sector.Title.For(Preferences.Culture)</span>
                            <span class="industry-sector-card-body">@sector.Body.For(Preferences.Culture)</span>
                            <span class="industry-sector-link">@Text("Learn more", "เรียนรู้เพิ่มเติม") <span aria-hidden="true">&rarr;</span></span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    </div>
</section>

<section class="section home-services-section" aria-labelledby="services-title">
    <div class="home-services-shell">
        <div class="home-services-head">
            <h2 id="services-title" class="home-services-title">@Text("Our manufacturing services", "บริการผลิตของเรา")</h2>
        </div>
        <div class="home-services-tabs" role="tablist" aria-label="@Text("Manufacturing services", "บริการผลิต")">
            @foreach (var service in _services)
            {
                <button class="@HomeServiceTabClass(service)"
                        id="@HomeServiceTabId(service)"
                        type="button"
                        role="tab"
                        aria-selected="@HomeServiceAriaSelected(service)"
                        aria-controls="home-services-panel"
                        @onclick="() => SelectHomeService(service)">
                    @service.Title.For(Preferences.Culture)
                </button>
            }
        </div>
        <div id="home-services-panel"
             class="home-services-panel"
             role="tabpanel"
             aria-labelledby="@HomeServiceTabId(SelectedHomeService)"
             data-chatbot-active-context="@HomeServiceChatbotContext">
            <div class="home-services-panel-copy">
                <h3>@SelectedHomeService.Title.For(Preferences.Culture)</h3>
                <p>@SelectedHomeService.Summary.For(Preferences.Culture)</p>
                <a class="home-services-cta" href="/services/@SelectedHomeService.Slug">@Text("Learn more", "เรียนรู้เพิ่มเติม")</a>
            </div>
            <ul class="home-services-proof-list" aria-label="@Text("Service highlights", "จุดเด่นของบริการ")">
                @foreach (var spec in SelectedHomeService.Specs)
                {
                    <li>@spec.For(Preferences.Culture)</li>
                }
            </ul>
            <figure class="home-services-media">
                <img src="@SelectedHomeService.ImageUrl"
                     alt="@SelectedHomeService.Title.For(Preferences.Culture)"
                     loading="lazy" />
                <figcaption>@SelectedHomeService.ProofTitle.For(Preferences.Culture)</figcaption>
            </figure>
        </div>
    </div>
</section>

<section id="workflow-carousel"
         @ref="_workflowCarousel"
         class="section process-section"
         aria-labelledby="process-title">
    <div class="section-lede process-lede">
        <h2 id="process-title">@Text("Quote to part, no friction", "จากใบเสนอราคาสู่ชิ้นงานอย่างลื่นไหล")</h2>
        <p>@Text("Upload CAD once, configure online, let MALIEV make it, and inspect or ship from the same workspace.", "อัปโหลด CAD ครั้งเดียว ตั้งค่างานออนไลน์ ให้ MALIEV ผลิต และตรวจหรือจัดส่งจากพื้นที่เดียว")</p>
    </div>
    <div class="process-grid" aria-label="@Text("Quote to part workflow", "ขั้นตอนจากใบเสนอราคาสู่ชิ้นงาน")">
        @foreach (var step in ProcessSteps)
        {
            <button class="@WorkflowStepClass(step)"
                    type="button"
                    data-workflow-accent="@step.Accent"
                    aria-current="@WorkflowAriaCurrent(step)"
                    @onclick="() => SelectWorkflowStepAsync(step, _machineFeaturePreview)">
                <span class="workflow-step-number">@step.Number</span>
                <h2>@step.Title.For(Preferences.Culture)</h2>
                <p>@step.Body.For(Preferences.Culture)</p>
            </button>
        }
    </div>
</section>

<div class="machine-feature-scroller">
<section id="machine-feature-preview"
         @ref="_machineFeaturePreview"
         class="feature-band machine-feature"
         aria-labelledby="imm-intro-title"
         data-selected-variant="@SelectedMachineVariant.Key"
         data-compressor-included="@MachineCompressorAriaPressed"
         data-machine-panel="intro">
    <img class="machine-feature-backdrop machine-feature-backdrop--light"
         @key="SelectedMachineImageKey"
         src="@SelectedMachineFeatureImageUrl"
         alt="@SelectedMachineFeatureImageAlt.For(Preferences.Culture)"
         loading="lazy" />
    <img class="machine-feature-backdrop machine-feature-backdrop--dark"
         src="@SelectedMachineDarkFeatureImageUrl"
         alt="@SelectedMachineFeatureImageAlt.For(Preferences.Culture)"
         loading="lazy" />
    <div class="machine-feature-panel">
        <div class="machine-feature-copy machine-feature-intro-copy" data-machine-content="intro">
            <h2 id="imm-intro-title" class="h-display machine-feature-title machine-feature-title--intro machine-feature-title--reveal">
                <span>@Text("Pneumatic", "เครื่องฉีดพลาสติก")</span>
                <span class="accent-blue">@Text("Injection Machine", "ระบบลม")</span>
            </h2>
        </div>
        <div class="machine-feature-copy machine-feature-details-copy" data-machine-content="details" aria-labelledby="imm-title">
            <h2 id="imm-title" class="h-display machine-feature-title">
                <span class="machine-feature-title-line machine-feature-title-lead">@Text("Pneumatic", "เครื่องฉีดพลาสติก")</span>
                <span class="machine-feature-title-line accent-blue">@Text("Injection Machine", "ระบบลม")</span>
            </h2>
            <p class="lede">@SelectedMachineVariant.Body.For(Preferences.Culture)</p>
            <div class="machine-stat-grid">
                @foreach (var stat in SelectedMachineVariant.Stats)
                {
                    <div><strong>@stat.Value.For(Preferences.Culture)</strong><small>@stat.Label.For(Preferences.Culture)</small></div>
                }
            </div>
            <div class="machine-configurator" aria-label="@Text("Machine configurator", "ตัวเลือกเครื่อง")">
                <div class="machine-configurator-group machine-configurator-group--variant">
                    <div class="machine-configurator-heading">
                        <span class="machine-configurator-step" aria-hidden="true">1</span>
                        <span class="machine-configurator-label">@Text("Choose machine size", "เลือกขนาดเครื่อง")</span>
                        <span class="machine-configurator-hint">@Text("Select one", "เลือก 1 รุ่น")</span>
                    </div>
                    <div class="machine-variant-options" role="radiogroup" aria-label="@Text("Select machine size", "เลือกขนาดเครื่อง")">
                        @foreach (var variant in MachineVariants)
                        {
                            <button class="@MachineVariantButtonClass(variant)"
                                    type="button"
                                    role="radio"
                                    aria-checked="@MachineVariantAriaChecked(variant)"
                                    data-machine-variant="@variant.Key"
                                    @onclick="() => SelectMachineVariant(variant)">
                                <span class="machine-variant-option-copy">
                                    <strong>@variant.Title.For(Preferences.Culture)</strong>
                                    <small>@variant.Subtitle.For(Preferences.Culture)</small>
                                </span>
                                <span class="machine-option-control" aria-hidden="true">
                                    <span class="machine-variant-option-check"></span>
                                    <span class="machine-option-action">@MachineVariantStateLabel(variant)</span>
                                </span>
                            </button>
                        }
                    </div>
                </div>
                <div class="machine-configurator-group machine-configurator-group--addon">
                    <div class="machine-configurator-heading">
                        <span class="machine-configurator-step" aria-hidden="true">2</span>
                        <span class="machine-configurator-label">@Text("Add air supply", "เพิ่มชุดลม")</span>
                        <span class="machine-configurator-hint">@Text("Optional", "ตัวเลือกเสริม")</span>
                    </div>
                    <button class="@MachineCompressorOptionClass"
                            type="button"
                            aria-pressed="@MachineCompressorAriaPressed"
                            aria-label="@MachineCompressorAriaLabel"
                            @onclick="ToggleMachineCompressor">
                        <span class="machine-addon-toggle" aria-hidden="true">
                            <span class="machine-addon-toggle-knob"></span>
                        </span>
                        <span class="machine-addon-copy">
                            <strong>@Text("25L air compressor", "ปั๊มลม 25L")</strong>
                            <small>@Text("Optional add-on for shops without stable air supply.", "ตัวเลือกเสริมสำหรับพื้นที่ที่ยังไม่มีลมที่เสถียร")</small>
                        </span>
                        <span class="machine-addon-state">@MachineCompressorStateLabel</span>
                    </button>
                </div>
                <div class="machine-config-summary" aria-live="polite">
                    <span>@Text("Configured package", "แพ็กเกจที่เลือก")</span>
                    <strong>@SelectedMachinePackageLabel</strong>
                </div>
            </div>
            <div class="quote-actions machine-actions">
                <a class="machine-tooling-link" href="/contact">@Text("Plan tooling with us", "วางแผนทูลลิ่งกับเรา")</a>
                <a class="button primary machine-configure-button" href="@SelectedMachineConfigurationHref">@Text("Configure", "ตั้งค่า")</a>
            </div>
        </div>
    </div>
</section>
</div>

<section class="section home-work-section" aria-labelledby="cases-title">
    <div class="section-heading home-work-heading">
        <h2 id="cases-title">@Text("What we've made lately", "ผลงานล่าสุดที่เราสร้าง")</h2>
        <a class="home-work-link" href="/case-studies">
            <span>@Text("All case studies", "ดูผลงานทั้งหมด")</span>
            <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
    <div class="case-grid">
        @foreach (var caseStudy in _caseStudies)
        {
            <a class="case-card home-work-card" href="/case-studies/@caseStudy.Slug">
                <div class="case-card-media">
                    <img src="@caseStudy.ImageUrl" alt="@caseStudy.Title.For(Preferences.Culture)" loading="lazy" />
                </div>
                <div class="case-card-body">
                    <span class="card-meta">@caseStudy.Meta</span>
                    <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                    <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">
                        <span>@caseStudy.Stat</span>
                        <span aria-hidden="true">&rarr;</span>
                    </span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section news-section" aria-labelledby="news-title">
    <div class="section-heading">
        <div>
            <h2 id="news-title">@Text("Practical notes before you order parts.", "เรื่องที่ควรรู้ก่อนสั่งผลิตชิ้นงาน")</h2>
        </div>
        <a class="section-link" href="/blog">@Text("All posts", "บทความทั้งหมด")</a>
    </div>
    <div class="blog-grid">
        @foreach (var post in _blogPosts)
        {
            <a class="blog-card" href="/blog/@post.Slug">
                <div class="blog-card-media">
                    <img src="@SiteContent.ResolveBlogImageUrl(post)" alt="@post.Title.For(Preferences.Culture)" loading="lazy" />
                </div>
                <div class="blog-card-body">
                    <span class="card-meta">@post.Category.For(Preferences.Culture)</span>
                    <h3>@post.Title.For(Preferences.Culture)</h3>
                    <p>@post.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@Text("Read note", "อ่านบทความ")</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section final-cta" aria-labelledby="final-cta-title">
    <div class="final-cta-copy">
        <h2 id="final-cta-title" class="h-display">@Text("Ready when you are.", "พร้อมเมื่อคุณพร้อม")</h2>
        <p class="lede">@Text("Configure tolerances, finishes, and quantities. See pricing update live. Ship to your door.", "ตั้งค่า tolerance ผิวงาน และจำนวน ดูราคาอัปเดตสด และจัดส่งถึงปลายทาง")</p>
    </div>
    <QuoteDropzone Href="@SiteContent.QuoteNewProjectUrl"
                   Class="final-dropzone"
                   Title="@QuoteDropzoneTitle"
                   Description="@QuoteDropzoneDescription"
                   ActionText="@QuoteDropzoneAction"
                   FormatsButtonText="@QuoteDropzoneFormatsButtonText"
                   FormatsPanelLabel="@QuoteDropzoneFormatsPanelLabel"
                   AriaLabel="@QuoteDropzoneAction" />
</section>

@code {
    private const string ServicesOrderStateKey = "home.services.order";
    private const string CaseStudiesOrderStateKey = "home.caseStudies.order";
    private const string BlogPostsOrderStateKey = "home.blogPosts.order";
    private const string HeroCopyStateKey = "home.hero.copy";
    private const string HeroModelStateKey = "home.hero.model";
    private const int HomeBlogPostCount = 3;
    private PersistingComponentStateSubscription? _persistingSubscription;
    private IReadOnlyList<ServicePageContent> _services = SiteContent.Services;
    private IReadOnlyList<CaseStudyContent> _caseStudies = SiteContent.CaseStudies;
    private IReadOnlyList<BlogPostContent> _blogPosts = SiteContent.BlogPosts.Take(HomeBlogPostCount).ToList();
    private HeroCopy _heroCopy = HeroCopyCatalog.Default;
    private HeroModelAsset _heroModel = HeroModelCatalog.Default;
    private string _heroTargetKey = HeroCopyCatalog.DefaultTargetKey;
    private string _heroServiceSlug = HeroCopyCatalog.ResolveServiceSlug(HeroCopyCatalog.DefaultTargetKey);
    private string _highlightServiceSlug = HeroCopyCatalog.ResolveServiceSlug(HeroCopyCatalog.DefaultTargetKey);
    private string _selectedHomeServiceSlug = SiteContent.Services[0].Slug;
    private bool _hasExplicitHeroTarget;
    private int _heroVariantIndex;
    private string _selectedWorkflowAccent = "upload";
    private string _selectedMachineVariantKey = "50g";
    private bool _includeAirCompressor;
    private ElementReference _machineFeaturePreview;
    private ElementReference _workflowCarousel;

    private static readonly IReadOnlyList<IndustrySector> IndustrySectors =
    [
        new(
            SiteContent.Text("Aerospace", "อากาศยาน"),
            SiteContent.Text("Lightweight prototypes, inspection aids, and production support parts for flight-adjacent engineering work.", "ต้นแบบน้ำหนักเบา อุปกรณ์ช่วยตรวจ และชิ้นส่วนสนับสนุนการผลิตสำหรับงานวิศวกรรมใกล้เคียงอากาศยาน"),
            "/images/blog/articles/instant-part-pricing-02.jpg",
            SiteContent.Text("Aircraft program hardware used as a visual reference for aerospace-adjacent engineering support", "ฮาร์ดแวร์ในโครงการอากาศยานที่ใช้เป็นภาพอ้างอิงสำหรับงานสนับสนุนวิศวกรรมใกล้เคียงอากาศยาน"),
            "/services/cnc-machining"),
        new(
            SiteContent.Text("Automotive", "ยานยนต์"),
            SiteContent.Text("Rapid fixtures, jig components, and validation samples for vehicle and mobility programs.", "ฟิกซ์เจอร์ จิ๊ก และชิ้นงานตัวอย่างสำหรับการตรวจยืนยันในโครงการยานยนต์และโมบิลิตี้"),
            "/images/blog/surface-text-labels.jpg",
            SiteContent.Text("Vehicle body and trim surface used as a visual reference for automotive prototype validation", "ตัวถังและผิวตกแต่งรถยนต์ที่ใช้เป็นภาพอ้างอิงสำหรับการตรวจยืนยันต้นแบบยานยนต์"),
            "/services/deviation-analysis"),
        new(
            SiteContent.Text("Consumer electronics", "อิเล็กทรอนิกส์ผู้บริโภค"),
            SiteContent.Text("Enclosures, inserts, fit-check models, and cosmetic prototypes for product teams.", "กล่อง อินเสิร์ต โมเดลเช็กการประกอบ และต้นแบบผิวภายนอกสำหรับทีมพัฒนาผลิตภัณฑ์"),
            "/images/blog/articles/enclosure-snap-fits-01.jpg",
            SiteContent.Text("Clear consumer electronics enclosure prototype with visible internal fit and fastening details", "ต้นแบบกล่องอิเล็กทรอนิกส์ใสที่เห็นรายละเอียดการประกอบและจุดยึดภายใน"),
            "/services/3d-design"),
        new(
            SiteContent.Text("Medical", "การแพทย์"),
            SiteContent.Text("Device housings, ergonomic prototypes, and cleanable workshop-built components for health-product development.", "ตัวเรือนอุปกรณ์ ต้นแบบด้านสรีรศาสตร์ และชิ้นส่วนเวิร์กช็อปที่ทำความสะอาดง่ายสำหรับการพัฒนาผลิตภัณฑ์สุขภาพ"),
            "/images/blog/instant-part-pricing.jpg",
            SiteContent.Text("Cleanroom product review scene representing medical device prototype handling and inspection", "ภาพการตรวจทบทวนผลิตภัณฑ์ในห้องสะอาดที่สื่อถึงการจัดการและตรวจต้นแบบอุปกรณ์การแพทย์"),
            "/services/rapid-prototyping")
    ];

    private MachineVariant SelectedMachineVariant => MachineVariants.FirstOrDefault(
        variant => string.Equals(variant.Key, _selectedMachineVariantKey, StringComparison.OrdinalIgnoreCase))
        ?? MachineVariants[0];

    private string SelectedMachineImageKey => $"{SelectedMachineVariant.Key}:{(_includeAirCompressor ? "compressor" : "machine")}";

    private string SelectedMachineFeatureImageUrl => _includeAirCompressor
        ? SelectedMachineVariant.CompressorFeatureImageUrl
        : SelectedMachineVariant.FeatureImageUrl;

    private string SelectedMachineDarkFeatureImageUrl => _includeAirCompressor
        ? SelectedMachineVariant.CompressorDarkFeatureImageUrl
        : SelectedMachineVariant.DarkFeatureImageUrl;

    private LocalizedText SelectedMachineFeatureImageAlt => _includeAirCompressor
        ? SelectedMachineVariant.CompressorFeatureImageAlt
        : SelectedMachineVariant.FeatureImageAlt;

    private readonly IReadOnlyList<MachineVariant> MachineVariants =
    [
        new(
            "30g",
            SiteContent.Text("30g machine", "เครื่อง 30g"),
            SiteContent.Text("Entry desktop trials", "ทดลองตั้งโต๊ะเริ่มต้น"),
            SiteContent.Text("Use the 30g pneumatic machine for first-shot validation, small inserts, material tests, and very compact home-workshop parts when minimum footprint matters most.", "ใช้เครื่องระบบลมรุ่น 30g สำหรับตรวจช็อตแรก อินเสิร์ตขนาดเล็ก ทดสอบวัสดุ และชิ้นงานเวิร์กช็อปที่กะทัดรัดมากเมื่อพื้นที่ติดตั้งสำคัญที่สุด"),
            "/images/products/pneumatic-injection-molding-machines.png",
            "/images/products/pneumatic-injection-molding-machines-dark.png",
            "/images/products/pneumatic-injection-molding-machines-compressor.png",
            "/images/products/pneumatic-injection-molding-machines-compressor-dark.png",
            SiteContent.Text("MALIEV 30g pneumatic injection molding machine", "เครื่องฉีดพลาสติกระบบลม MALIEV รุ่น 30g"),
            SiteContent.Text("MALIEV 30g pneumatic injection molding machine with 25L air compressor", "เครื่องฉีดพลาสติกระบบลม MALIEV รุ่น 30g พร้อมปั๊มลม 25L"),
            [
                new(SiteContent.Text("30g", "30g"), SiteContent.Text("shot capacity", "ปริมาตรฉีดต่อครั้ง")),
                new(SiteContent.Text("300°C", "300°C"), SiteContent.Text("max melt", "อุณหภูมิสูงสุด")),
                new(SiteContent.Text("7 bar", "7 bar"), SiteContent.Text("air supply", "แรงดันลม")),
                new(SiteContent.Text("30 days", "30 วัน"), SiteContent.Text("lead time", "ระยะเวลา"))
            ]),
        new(
            "50g",
