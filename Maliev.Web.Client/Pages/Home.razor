@page "/"
@inject IStringLocalizer<SharedResources> L
@inject MalievApiClient Api
@inject PreferenceService Preferences

<PageTitle>MALIEV - Manufacturing quotes and shop</PageTitle>

<section class="hero-band">
    <div class="hero-copy">
        <p class="eyebrow">3D printing · CNC · scanning · design · shop</p>
        <h1>@L["HeroTitle"]</h1>
        <p>@L["HeroSummary"]</p>
        <div class="hero-actions">
            <a class="button primary" href="/quote">@L["StartQuote"]</a>
            <a class="button secondary" href="/shop">@L["ShopProducts"]</a>
        </div>
        <div class="hero-quote">
            <InstantQuotePanel />
        </div>
    </div>
    <div class="hero-workspace gizmo-workspace">
        <ManufacturingGizmo />
    </div>
</section>

<section class="section split-section">
    <div>
        <p class="eyebrow">Manufacturing services</p>
        <h2>From prototype to low-volume production</h2>
    </div>
    <div class="service-list">
        @foreach (var service in Services)
        {
            <a class="service-row" href="/services/@service.Slug">
                <span>@service.Name.For(Preferences.Culture)</span>
                <small>@service.Summary.For(Preferences.Culture)</small>
            </a>
        }
    </div>
</section>

<section class="section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Shop MALIEV products</p>
            <h2>Machines, spares, tooling, and printed products</h2>
        </div>
        <a href="/shop">View all</a>
    </div>
    @if (_products.Count > 0)
    {
        <ProductGrid Products="@_products.Take(4).ToList()" />
    }
    else if (!string.IsNullOrWhiteSpace(_catalogError))
    {
        <p class="load-message">@_catalogError</p>
    }
    else
    {
        <div class="empty-state compact">
            <h2>Product listings are being prepared</h2>
            <p>Published machines, spare parts, and printed products will appear here as soon as they are added.</p>
            <a class="button secondary" href="/quote">Request custom manufacturing</a>
        </div>
    }
</section>

<section class="section proof-band">
    <img src="https://shop.maliev.com/cdn/shop/files/machine-portrait.21.png?v=1737116109&width=832" alt="MALIEV pneumatic injection molding machine" />
    <div>
        <p class="eyebrow">Build. Test. Produce.</p>
        <h2>Customer-facing quoting and commerce in one path</h2>
        <p>Upload custom parts for quotation, buy ready-to-ship items, and keep orders in one MALIEV customer workspace.</p>
        <a class="button primary" href="/quote">Start with a file</a>
    </div>
</section>

@code {
    private readonly List<ServiceLink> Services =
    [
        new("3d-printing", new() { En = "3D Printing", Th = "พิมพ์สามมิติ" }, new() { En = "FDM and resin parts for prototypes and fixtures.", Th = "งาน FDM และเรซินสำหรับต้นแบบและฟิกซ์เจอร์" }),
        new("cnc-machining", new() { En = "CNC Machining", Th = "CNC แมชชีนนิ่ง" }, new() { En = "Precision plastic and metal parts.", Th = "ชิ้นส่วนพลาสติกและโลหะความแม่นยำสูง" }),
        new("3d-scanning", new() { En = "3D Scanning", Th = "สแกนสามมิติ" }, new() { En = "Reverse engineering and inspection capture.", Th = "สแกนเพื่อรีเวิร์สเอนจิเนียริ่งและตรวจสอบชิ้นงาน" }),
        new("3d-design", new() { En = "3D Design", Th = "ออกแบบสามมิติ" }, new() { En = "CAD and design-for-manufacturing support.", Th = "ขึ้นแบบ CAD และปรับแบบเพื่อการผลิต" })
    ];

    private List<ProductSummaryDto> _products = [];
    private string? _catalogError;

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        try
        {
            _products = (await Api.GetProductsAsync()).ToList();
        }
        catch (MalievApiException ex)
        {
            _catalogError = ex.Message;
        }
    }

    private sealed record ServiceLink(string Slug, LocalizedText Name, LocalizedText Summary);
}
