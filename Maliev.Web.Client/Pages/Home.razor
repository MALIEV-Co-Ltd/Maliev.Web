@page "/"
@inject IStringLocalizer<SharedResources> L
@inject MalievApiClient Api
@inject PreferenceService Preferences

<PageTitle>MALIEV - Manufacturing quotes and shop</PageTitle>

<section class="landing-hero">
    <div class="landing-hero-copy hero-copy">
        <p class="eyebrow landing-hero-badge">3D printing · CNC · scanning · design · shop</p>
        <h1>@L["HeroTitle"]</h1>
        <p>@L["HeroSummary"]</p>
        <div class="landing-hero-actions">
            <MudButton Href="/quote"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       Class="landing-quote-dropzone"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       IconClass="landing-quote-dropzone-icon"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       aria-label="@L["StartQuote"]">
                <span class="landing-quote-dropzone-copy">
                    <strong>@L["QuoteDropzoneTitle"]</strong>
                    <small>@L["QuoteDropzoneMeta"]</small>
                </span>
                <span class="landing-quote-dropzone-action">@L["StartQuote"]</span>
            </MudButton>
            <MudButton Href="/shop"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       Class="landing-shop-button">
                @L["ShopProducts"]
            </MudButton>
        </div>
    </div>
    <div class="landing-hero-visual">
        <ManufacturingGizmo Class="manufacturing-gizmo--landing"
                            ModelUrl="/models/hero-3d.glb"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="true"
                            AriaLabel="MALIEV injection molded plastic part preview" />
    </div>
</section>

<section class="section split-section manufacturing-section" aria-labelledby="manufacturing-services-title">
    <div class="section-lede">
        <p class="eyebrow">Manufacturing services</p>
        <h2 id="manufacturing-services-title">From CAD files to production-ready parts</h2>
        <p>Prototype, reverse engineer, machine, and validate parts with one manufacturing partner.</p>
        <div class="service-stat-strip" aria-label="MALIEV manufacturing capabilities">
            <span>
                <strong>4</strong>
                <small>production routes</small>
            </span>
            <span>
                <strong>3D</strong>
                <small>scan to CAD</small>
            </span>
            <span>
                <strong>DFM</strong>
                <small>quote review</small>
            </span>
        </div>
    </div>
    <div class="service-list">
        @foreach (var service in Services)
        {
            <a class="service-row" href="/services/@service.Slug">
                <span class="service-card-icon">
                    <MudIcon Icon="@service.Icon" />
                </span>
                <span class="service-card-copy">
                    <strong>@service.Name.For(Preferences.Culture)</strong>
                    <small>@service.Summary.For(Preferences.Culture)</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Class="service-card-arrow" />
            </a>
        }
    </div>
</section>

<section class="section shop-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Shop MALIEV products</p>
            <h2>Machines, spares, tooling, and printed products</h2>
        </div>
        <a class="section-link" href="/shop">View all</a>
    </div>
    @if (_products.Count > 0)
    {
        <ProductGrid Products="@_products.Take(4).ToList()" />
    }
    else if (!string.IsNullOrWhiteSpace(_catalogError))
    {
        <p class="load-message">@_catalogError</p>
    }
    else
    {
        <div class="empty-state compact">
            <h2>Product listings are being prepared</h2>
            <p>Published machines, spare parts, and printed products will appear here as soon as they are added.</p>
            <a class="button secondary" href="/quote">Request custom manufacturing</a>
        </div>
    }
</section>

@code {
    private readonly List<ServiceLink> Services =
    [
        new("3d-printing", Icons.Material.Filled.ViewInAr, new() { En = "3D Printing", Th = "พิมพ์สามมิติ" }, new() { En = "FDM and resin parts for prototypes, fixtures, and end-use trials.", Th = "งาน FDM และเรซินสำหรับต้นแบบ ฟิกซ์เจอร์ และทดลองใช้งานจริง" }),
        new("cnc-machining", Icons.Material.Filled.PrecisionManufacturing, new() { En = "CNC Machining", Th = "CNC แมชชีนนิ่ง" }, new() { En = "Precision plastic and metal parts with production-minded tolerances.", Th = "ชิ้นส่วนพลาสติกและโลหะความแม่นยำสูงพร้อมแนวคิดการผลิตจริง" }),
        new("3d-scanning", Icons.Material.Filled.DocumentScanner, new() { En = "3D Scanning", Th = "สแกนสามมิติ" }, new() { En = "Reverse engineering and inspection capture for legacy or handmade parts.", Th = "สแกนเพื่อรีเวิร์สเอนจิเนียริ่งและตรวจสอบชิ้นงานเดิมหรือชิ้นงานทำมือ" }),
        new("3d-design", Icons.Material.Filled.DesignServices, new() { En = "3D Design", Th = "ออกแบบสามมิติ" }, new() { En = "CAD and design-for-manufacturing support before the first quote.", Th = "ขึ้นแบบ CAD และปรับแบบเพื่อการผลิตก่อนเริ่มใบเสนอราคา" })
    ];

    private List<ProductSummaryDto> _products = [];
    private string? _catalogError;

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        try
        {
            _products = (await Api.GetProductsAsync()).ToList();
        }
        catch (MalievApiException ex)
        {
            _catalogError = ex.Message;
        }
    }

    private sealed record ServiceLink(string Slug, string Icon, LocalizedText Name, LocalizedText Summary);
}
