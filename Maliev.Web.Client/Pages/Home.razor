@page "/"
@inject IStringLocalizer<SharedResources> L
@inject MalievApiClient Api
@inject PreferenceService Preferences

<PageTitle>MALIEV - Rapid manufacturing and workshop-made products</PageTitle>
<HeadContent>
    <meta name="description" content="@Text("Upload CAD files for rapid manufacturing quotes, explore MALIEV services, and shop workshop-made machines, spares, tooling, and 3D printed products.", "อัปโหลดไฟล์ CAD เพื่อขอใบเสนอราคางานผลิตรวดเร็ว สำรวจบริการ MALIEV และเลือกซื้อเครื่องจักร อะไหล่ ทูลลิ่ง และสินค้าพิมพ์สามมิติ")" />
    <link rel="canonical" href="https://www.maliev.com/" />
</HeadContent>

<section class="landing-hero" data-screen-label="Home hero">
    <div class="landing-hero-copy">
        <p class="eyebrow landing-hero-badge">@Text("Rapid manufacturing · quote in minutes", "งานผลิตรวดเร็ว · ขอราคาในไม่กี่นาที")</p>
        <h1>
            @Text("Parts in days,", "ชิ้นงานในไม่กี่วัน")
            <br />
            <span class="accent-blue">@Text("not quarters.", "ไม่ใช่หลายเดือน")</span>
        </h1>
        <p>@Text("Upload CAD, choose a manufacturing path, review DFM feedback, and continue to the quote engine for configurable pricing and order tracking.", "อัปโหลด CAD เลือกเส้นทางผลิต ตรวจ DFM แล้วไปต่อที่ระบบขอราคาเพื่อปรับราคาและติดตามงานผลิต")</p>
        <div class="landing-hero-actions">
            <MudButton Href="@SiteContent.QuoteNewUrl"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       Class="landing-quote-dropzone"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       IconClass="landing-quote-dropzone-icon"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       aria-label="@L["StartQuote"]">
                <span class="landing-quote-dropzone-copy">
                    <strong>@L["QuoteDropzoneTitle"]</strong>
                    <small>@L["QuoteDropzoneMeta"]</small>
                </span>
                <span class="landing-quote-dropzone-action">@L["StartQuote"]</span>
            </MudButton>
            <MudButton Href="/shop"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       Class="landing-shop-button">
                @L["ShopProducts"]
            </MudButton>
        </div>
        <div class="metric-strip" aria-label="MALIEV manufacturing metrics">
            @foreach (var metric in SiteContent.HeroMetrics)
            {
                <div>
                    <strong>@metric.Value</strong>
                    <small>@metric.Label.For(Preferences.Culture)</small>
                </div>
            }
        </div>
    </div>
    <div class="landing-hero-visual" aria-label="@Text("Interactive MALIEV manufacturing model", "โมเดลสามมิติ MALIEV")">
        <ManufacturingGizmo Class="manufacturing-gizmo--landing"
                            ModelUrl="/models/hero-3d.glb"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="true"
                            AriaLabel="MALIEV injection molded plastic part preview" />
    </div>
</section>

<section class="trust-band" aria-labelledby="trust-title">
    <div class="container">
        <p id="trust-title" class="eyebrow">@Text("Built for engineering and production teams", "สร้างมาเพื่อทีมวิศวกรรมและทีมผลิต")</p>
        <div class="trust-grid" aria-label="Customer team types">
            <span>FACTORY MAINTENANCE</span>
            <span>PRODUCT R&D</span>
            <span>EDUCATION</span>
            <span>MACHINE BUILDERS</span>
            <span>AUTOMATION</span>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="services-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text("What we make", "สิ่งที่เราผลิต")</p>
            <h2 id="services-title">@Text("Seven services. One workshop.", "เจ็ดบริการ หนึ่งเวิร์กช็อป")</h2>
        </div>
        <a class="section-link" href="/services">@Text("All capabilities", "ดูทุกความสามารถ")</a>
    </div>
    <div class="service-grid">
        @foreach (var service in SiteContent.Services)
        {
            <a class="@ServiceCardClass(service)" href="/services/@service.Slug">
                <div class="service-card-media">
                    <img src="@service.ImageUrl" alt="@service.Title.For(Preferences.Culture)" loading="lazy" />
                    @if (service.Primary)
                    {
                        <span class="chip">@Text("Primary service", "บริการหลัก")</span>
                    }
                </div>
                <div class="service-card-body">
                    <span class="card-meta">@service.Number</span>
                    <h3>@service.Title.For(Preferences.Culture)</h3>
                    <p>@service.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@Text("Explore", "ดูเพิ่มเติม")</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="feature-band" aria-labelledby="imm-title">
    <div class="feature-media">
        <img src="https://shop.maliev.com/cdn/shop/files/machine-portrait.21.png?v=1737116109&width=1200" alt="@Text("MALIEV pneumatic injection molding machine", "เครื่องฉีดพลาสติกระบบลม MALIEV")" loading="lazy" />
    </div>
    <div>
        <p class="eyebrow">@Text("Workshop-made equipment", "เครื่องจักรที่ผลิตในเวิร์กช็อป")</p>
        <h2 id="imm-title" class="h-display">
            @Text("Pneumatic injection", "เครื่องฉีดพลาสติก")
            <br />
            <span class="accent-blue">@Text("molding machine.", "ระบบลม")</span>
        </h2>
        <p class="lede">@Text("Bench-top air-driven injection molding for small-batch thermoplastic parts, tooling trials, makers, and R&D teams.", "เครื่องฉีดพลาสติกตั้งโต๊ะขับเคลื่อนด้วยลม สำหรับชิ้นงานเทอร์โมพลาสติกจำนวนน้อย ทดลองแม่พิมพ์ เมกเกอร์ และทีม R&D")</p>
        <div class="dark-stat-grid">
            <div><strong>50g</strong><small>@Text("shot capacity", "ความจุช็อต")</small></div>
            <div><strong>180°C</strong><small>@Text("max melt", "อุณหภูมิสูงสุด")</small></div>
            <div><strong>6 bar</strong><small>@Text("air supply", "แรงดันลม")</small></div>
            <div><strong>14d</strong><small>@Text("lead time", "ระยะเวลา")</small></div>
        </div>
        <div class="quote-actions">
            <a class="button primary" href="/shop/pneumatic-injection-molding-machine">@Text("Configure and buy", "ตั้งค่าและสั่งซื้อ")</a>
            <a class="button secondary" href="/contact">@Text("Ask about tooling", "สอบถามทูลลิ่ง")</a>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="process-title">
    <div class="section-lede">
        <p class="eyebrow">@Text("How it works", "ขั้นตอน")</p>
        <h2 id="process-title">@Text("Quote to part without vendor handoffs.", "จากใบเสนอราคาสู่ชิ้นงานโดยไม่ต้องส่งต่อหลายที่")</h2>
    </div>
    <div class="process-grid">
        @foreach (var step in ProcessSteps)
        {
            <article class="workflow-step">
                <span>@step.Number</span>
                <h2>@step.Title.For(Preferences.Culture)</h2>
                <p>@step.Body.For(Preferences.Culture)</p>
            </article>
        }
    </div>
</section>

<section class="section" aria-labelledby="cases-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text("Recent work", "ผลงานล่าสุด")</p>
            <h2 id="cases-title">@Text("What MALIEV has made lately.", "ตัวอย่างงานที่ MALIEV เพิ่งทำ")</h2>
        </div>
        <a class="section-link" href="/case-studies">@Text("All case studies", "ดูผลงานทั้งหมด")</a>
    </div>
    <div class="case-grid">
        @foreach (var caseStudy in SiteContent.CaseStudies)
        {
            <a class="case-card" href="/case-studies/@caseStudy.Slug">
                <div class="case-card-body">
                    <span class="card-meta">@caseStudy.Meta</span>
                    <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                    <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@caseStudy.Stat</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section final-cta" aria-labelledby="final-cta-title">
    <div>
        <p class="eyebrow">@Text("One file is enough to start", "เริ่มได้ด้วยไฟล์เดียว")</p>
        <h2 id="final-cta-title" class="h-display">@Text("Ready when your CAD is.", "พร้อมเมื่อไฟล์ CAD ของคุณพร้อม")</h2>
        <p class="lede">@Text("Send geometry to the quote engine, then configure process, material, finish, quantity, tolerance, and delivery expectations.", "ส่ง Geometry เข้าระบบขอราคา แล้วเลือกกระบวนการ วัสดุ ผิวงาน จำนวน tolerance และความคาดหวังเรื่องจัดส่ง")</p>
    </div>
    <a class="quote-dropzone" href="@SiteContent.QuoteNewUrl">
        <strong>@L["QuoteDropzoneTitle"]</strong>
        <small>@L["QuoteDropzoneMeta"]</small>
        <span class="button primary">@L["StartQuote"]</span>
    </a>
</section>

@if (_products.Count > 0)
{
    <section class="section shop-section" aria-labelledby="shop-preview-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Text("Shop MALIEV products", "ร้านค้า MALIEV")</p>
                <h2 id="shop-preview-title">@Text("Machines, spares, tooling, and printed products.", "เครื่องจักร อะไหล่ ทูลลิ่ง และสินค้าพิมพ์สามมิติ")</h2>
            </div>
            <a class="section-link" href="/shop">@Text("View all", "ดูทั้งหมด")</a>
        </div>
        <ProductGrid Products="@_products.Take(4).ToList()" />
    </section>
}
else if (!string.IsNullOrWhiteSpace(_catalogError))
{
    <section class="section shop-section">
        <p class="load-message">@_catalogError</p>
    </section>
}

@code {
    private readonly IReadOnlyList<ProcessStep> ProcessSteps =
    [
        new("01", SiteContent.Text("Drop your file", "วางไฟล์ของคุณ"), SiteContent.Text("STL, STEP, IGES, OBJ, and 3MF files move directly to the quote engine.", "ไฟล์ STL, STEP, IGES, OBJ และ 3MF จะถูกส่งต่อเข้าสู่ระบบขอราคา")),
        new("02", SiteContent.Text("Configure online", "ตั้งค่าออนไลน์"), SiteContent.Text("Choose process, material, finish, quantity, and tolerance expectations.", "เลือกกระบวนการ วัสดุ ผิวงาน จำนวน และ tolerance ที่ต้องการ")),
        new("03", SiteContent.Text("We make it", "เราผลิตให้"), SiteContent.Text("MALIEV routes the work through the right in-house or approved production path.", "MALIEV จัดเส้นทางงานผ่านเวิร์กช็อปหรือเส้นทางผลิตที่เหมาะสม")),
        new("04", SiteContent.Text("Inspect and ship", "ตรวจและจัดส่ง"), SiteContent.Text("Inspection and shipment details stay connected to the customer workspace.", "รายละเอียดการตรวจและจัดส่งอยู่ในพื้นที่ลูกค้าเดียวกัน"))
    ];

    private List<ProductSummaryDto> _products = [];
    private string? _catalogError;

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        try
        {
            _products = (await Api.GetProductsAsync()).ToList();
        }
        catch (MalievApiException ex)
        {
            _catalogError = ex.Message;
        }
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private static string ServiceCardClass(ServicePageContent service)
    {
        return service.Primary ? "service-card primary" : "service-card";
    }

    private sealed record ProcessStep(string Number, LocalizedText Title, LocalizedText Body);
}
