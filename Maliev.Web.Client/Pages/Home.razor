@page "/"
@inject PreferenceService Preferences

<PageTitle>MALIEV - Rapid manufacturing and workshop-made products</PageTitle>
<HeadContent>
    <meta name="description" content="@Text("Upload CAD files for rapid manufacturing, review DFM feedback, see live part pricing, and order custom parts through MALIEV.", "อัปโหลดไฟล์ CAD สำหรับงานผลิตรวดเร็ว ตรวจ DFM ดูราคาชิ้นงานทันที และสั่งผลิตชิ้นงานเฉพาะกับ MALIEV")" />
    <link rel="canonical" href="https://www.maliev.com/" />
</HeadContent>

<section class="landing-hero" data-screen-label="Home hero">
    <div class="landing-hero-copy">
        <p class="eyebrow landing-hero-badge">@Text("Rapid manufacturing · live part pricing", "งานผลิตรวดเร็ว · ดูราคาชิ้นงานทันที")</p>
        <h1>
            @Text("Parts in days,", "ชิ้นงานในไม่กี่วัน")
            <br />
            <span class="accent-blue">@Text("not quarters.", "ไม่ใช่หลายเดือน")</span>
        </h1>
        <p>@Text("Upload CAD, review DFM feedback, adjust process, material, finish, and quantity, then continue straight into production ordering.", "อัปโหลด CAD ตรวจ DFM ปรับกระบวนการ วัสดุ ผิวงาน และจำนวน แล้วสั่งผลิตต่อได้ทันทีเมื่อพร้อม")</p>
        <div class="landing-hero-actions">
            <MudButton Href="@SiteContent.QuoteNewUrl"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       Class="landing-quote-dropzone"
                       aria-label="@Text("Get part price", "ดูราคาชิ้นงาน")">
                <span class="landing-quote-dropzone-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Medium" />
                </span>
                <span class="landing-quote-dropzone-copy">
                    <strong>@Text("Upload CAD to price your part", "อัปโหลด CAD เพื่อดูราคาชิ้นงาน")</strong>
                    <small>@Text("STL, STEP, STP, OBJ, 3MF. Review DFM, live pricing, and order when ready.", "รองรับ STL, STEP, STP, OBJ, 3MF พร้อมตรวจ DFM ราคาอัปเดตทันที และสั่งผลิตต่อได้")</small>
                </span>
                <span class="landing-quote-dropzone-action">
                    <span>@Text("Get part price", "ดูราคาชิ้นงาน")</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </span>
            </MudButton>
        </div>
        <div class="metric-strip" aria-label="MALIEV manufacturing metrics">
            @foreach (var metric in SiteContent.HeroMetrics)
            {
                <div>
                    <strong>@metric.Value.For(Preferences.Culture)</strong>
                    <small>@metric.Label.For(Preferences.Culture)</small>
                </div>
            }
        </div>
    </div>
    <div class="landing-hero-visual" aria-label="@Text("Interactive MALIEV manufacturing model", "โมเดลสามมิติ MALIEV")">
        <ManufacturingGizmo Class="manufacturing-gizmo--landing"
                            ModelUrl="/models/hero-3d.glb"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="true"
                            AriaLabel="MALIEV injection molded plastic part preview" />
    </div>
</section>

<section class="quote-flow-band" aria-labelledby="flow-title">
    <div class="container">
        <p id="flow-title" class="eyebrow">@Text("From file to order", "จากไฟล์สู่คำสั่งผลิต")</p>
        <div class="quote-flow-grid" aria-label="@Text("Quote engine workflow", "ขั้นตอนระบบราคาชิ้นงาน")">
            <span>@Text("Upload CAD", "อัปโหลด CAD")</span>
            <span>@Text("DFM feedback", "ตรวจ DFM")</span>
            <span>@Text("Live pricing", "ราคาอัปเดตทันที")</span>
            <span>@Text("Order tracking", "ติดตามงานผลิต")</span>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="services-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text("Manufacturing capabilities", "ความสามารถงานผลิต")</p>
            <h2 id="services-title">@Text("One workflow for custom parts.", "ผลิตชิ้นงานเฉพาะในขั้นตอนเดียว")</h2>
        </div>
        <a class="section-link" href="/services">@Text("All capabilities", "ดูทุกความสามารถ")</a>
    </div>
    <div class="service-grid">
        @foreach (var service in SiteContent.Services)
        {
            <a class="@ServiceCardClass(service)" href="/services/@service.Slug">
                <div class="service-card-media">
                    <img src="@service.ImageUrl" alt="@service.Title.For(Preferences.Culture)" loading="lazy" />
                    @if (service.Primary)
                    {
                        <span class="chip">@Text("Primary service", "บริการหลัก")</span>
                    }
                </div>
                <div class="service-card-body">
                    <span class="card-meta">@service.Number</span>
                    <h3>@service.Title.For(Preferences.Culture)</h3>
                    <p>@service.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@Text("Explore", "ดูเพิ่มเติม")</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="feature-band" aria-labelledby="imm-title">
    <div class="feature-media">
        <img src="https://shop.maliev.com/cdn/shop/files/machine-portrait.21.png?v=1737116109&width=1200" alt="@Text("MALIEV pneumatic injection molding machine", "เครื่องฉีดพลาสติกระบบลม MALIEV")" loading="lazy" />
    </div>
    <div>
        <p class="eyebrow">@Text("Workshop-made equipment", "เครื่องจักรที่ผลิตในเวิร์กช็อป")</p>
        <h2 id="imm-title" class="h-display">
            @Text("Pneumatic injection", "เครื่องฉีดพลาสติก")
            <br />
            <span class="accent-blue">@Text("molding machine.", "ระบบลม")</span>
        </h2>
        <p class="lede">@Text("Bench-top air-driven injection molding for small-batch thermoplastic parts, tooling trials, makers, and R&D teams.", "เครื่องฉีดพลาสติกตั้งโต๊ะขับเคลื่อนด้วยลม สำหรับชิ้นงานเทอร์โมพลาสติกจำนวนน้อย ทดลองแม่พิมพ์ เมกเกอร์ และทีม R&D")</p>
        <div class="dark-stat-grid">
            <div><strong>50g</strong><small>@Text("shot capacity", "ปริมาตรฉีดต่อครั้ง")</small></div>
            <div><strong>180°C</strong><small>@Text("max melt", "อุณหภูมิสูงสุด")</small></div>
            <div><strong>6 bar</strong><small>@Text("air supply", "แรงดันลม")</small></div>
            <div><strong>14d</strong><small>@Text("lead time", "ระยะเวลา")</small></div>
        </div>
        <div class="quote-actions">
            <a class="button primary" href="/shop/pneumatic-injection-molding-machine">@Text("Configure and buy", "ตั้งค่าและสั่งซื้อ")</a>
            <a class="button secondary" href="/contact">@Text("Ask about tooling", "สอบถามทูลลิ่ง")</a>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="process-title">
    <div class="section-lede">
        <p class="eyebrow">@Text("How it works", "ขั้นตอน")</p>
        <h2 id="process-title">@Text("Price, validate, and order without vendor handoffs.", "ดูราคา ตรวจความพร้อม และสั่งผลิตโดยไม่ต้องส่งต่อหลายที่")</h2>
    </div>
    <div class="process-grid">
        @foreach (var step in ProcessSteps)
        {
            <article class="workflow-step">
                <span>@step.Number</span>
                <h2>@step.Title.For(Preferences.Culture)</h2>
                <p>@step.Body.For(Preferences.Culture)</p>
            </article>
        }
    </div>
</section>

<section class="section" aria-labelledby="cases-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text("Recent work", "ผลงานล่าสุด")</p>
            <h2 id="cases-title" class="logo-heading">
                <span>@Text("Recent work from", "ผลงานล่าสุดจาก")</span>
                <img src="/images/logo.svg" alt="MALIEV" />
            </h2>
        </div>
        <a class="section-link" href="/case-studies">@Text("All case studies", "ดูผลงานทั้งหมด")</a>
    </div>
    <div class="case-grid">
        @foreach (var caseStudy in SiteContent.CaseStudies)
        {
            <a class="case-card" href="/case-studies/@caseStudy.Slug">
                <div class="case-card-media">
                    <img src="@caseStudy.ImageUrl" alt="@caseStudy.Title.For(Preferences.Culture)" loading="lazy" />
                </div>
                <div class="case-card-body">
                    <span class="card-meta">@caseStudy.Meta</span>
                    <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                    <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@caseStudy.Stat</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section news-section" aria-labelledby="news-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text("Journal and updates", "บทความและอัปเดต")</p>
            <h2 id="news-title">@Text("Practical notes before you order parts.", "เรื่องที่ควรรู้ก่อนสั่งผลิตชิ้นงาน")</h2>
        </div>
        <a class="section-link" href="/blog">@Text("All posts", "บทความทั้งหมด")</a>
    </div>
    <div class="blog-grid">
        @foreach (var post in SiteContent.BlogPosts)
        {
            <a class="blog-card" href="/blog/@post.Slug">
                <div class="blog-card-media">
                    <img src="@post.ImageUrl" alt="@post.Title.For(Preferences.Culture)" loading="lazy" />
                </div>
                <div class="blog-card-body">
                    <span class="card-meta">@post.Category.For(Preferences.Culture)</span>
                    <h3>@post.Title.For(Preferences.Culture)</h3>
                    <p>@post.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@Text("Read note", "อ่านบทความ")</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section final-cta" aria-labelledby="final-cta-title">
    <div>
        <p class="eyebrow">@Text("One file is enough to start", "เริ่มได้ด้วยไฟล์เดียว")</p>
        <h2 id="final-cta-title" class="h-display">@Text("Ready when your CAD is.", "พร้อมเมื่อไฟล์ CAD ของคุณพร้อม")</h2>
        <p class="lede">@Text("Send geometry to the quote engine, then configure process, material, finish, quantity, tolerance, and delivery expectations.", "ส่ง Geometry เข้าระบบราคา แล้วเลือกกระบวนการ วัสดุ ผิวงาน จำนวน tolerance และความคาดหวังเรื่องจัดส่ง")</p>
    </div>
    <a class="quote-dropzone final-dropzone" href="@SiteContent.QuoteNewUrl">
        <span class="final-dropzone-icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Medium" />
        </span>
        <span class="final-dropzone-copy">
            <strong>@Text("Upload CAD to price your part", "อัปโหลด CAD เพื่อดูราคาชิ้นงาน")</strong>
            <small>@Text("STL, STEP, STP, OBJ, 3MF. Review DFM, live pricing, and order when ready.", "รองรับ STL, STEP, STP, OBJ, 3MF พร้อมตรวจ DFM ราคาอัปเดตทันที และสั่งผลิตต่อได้")</small>
        </span>
        <span class="final-dropzone-arrow" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" />
        </span>
    </a>
</section>

@code {
    private readonly IReadOnlyList<ProcessStep> ProcessSteps =
    [
        new("01", SiteContent.Text("Upload your file", "อัปโหลดไฟล์"), SiteContent.Text("STL, STEP, IGES, OBJ, and 3MF files move directly to the pricing workspace.", "ไฟล์ STL, STEP, IGES, OBJ และ 3MF เข้าสู่พื้นที่คำนวณราคาโดยตรง")),
        new("02", SiteContent.Text("Review DFM", "ตรวจ DFM"), SiteContent.Text("Manufacturability feedback helps you catch risks before placing an order.", "ผลตรวจความเหมาะสมช่วยให้เห็นความเสี่ยงก่อนสั่งผลิต")),
        new("03", SiteContent.Text("Adjust price", "ปรับราคา"), SiteContent.Text("Choose process, material, finish, quantity, tolerance, and delivery expectations online.", "เลือกกระบวนการ วัสดุ ผิวงาน จำนวน tolerance และการจัดส่งออนไลน์")),
        new("04", SiteContent.Text("Order and track", "สั่งผลิตและติดตาม"), SiteContent.Text("Accepted work continues into production tracking from the same customer workspace.", "งานที่ยืนยันแล้วติดตามการผลิตต่อได้ในพื้นที่ลูกค้าเดียวกัน"))
    ];

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private static string ServiceCardClass(ServicePageContent service)
    {
        return service.Primary ? "service-card primary" : "service-card";
    }

    private sealed record ProcessStep(string Number, LocalizedText Title, LocalizedText Body);
}
