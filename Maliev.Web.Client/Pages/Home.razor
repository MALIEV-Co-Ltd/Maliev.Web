            return;
        }

        await JS.InvokeVoidAsync("malievScroll.bindMachineFeatureHandoff", _machineFeaturePreview);
        await JS.InvokeVoidAsync("malievScroll.bindWorkflowStepReveal", _workflowCarousel);
    }

