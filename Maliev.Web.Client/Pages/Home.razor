@page "/"
@inherits PreferenceAwareComponentBase
@inject PersistentComponentState ApplicationState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>MALIEV - Rapid manufacturing and workshop-made products</PageTitle>
<HeadContent>
    <meta name="description" content="@_heroCopy.MetaDescription.For(Preferences.Culture)" />
    <link rel="canonical" href="https://www.maliev.com/" />
</HeadContent>

<section class="landing-hero" data-screen-label="Home hero">
    <div class="landing-hero-copy">
        <h1>
            @_heroCopy.HeadlineLead.For(Preferences.Culture)
            <br />
            <span class="accent-blue">@_heroCopy.HeadlineAccent.For(Preferences.Culture)</span>
        </h1>
        <p>@_heroCopy.Body.For(Preferences.Culture)</p>
        <div class="landing-hero-actions">
            <QuoteDropzone Href="@SiteContent.QuoteNewUrl"
                           Title="@QuoteDropzoneTitle"
                           Description="@QuoteDropzoneDescription"
                           ActionText="@QuoteDropzoneAction"
                           AriaLabel="@QuoteDropzoneAction" />
        </div>
        <div class="metric-strip" aria-label="MALIEV manufacturing metrics">
            @foreach (var metric in SiteContent.HeroMetrics)
            {
                <div>
                    @if (!string.IsNullOrWhiteSpace(metric.Suffix))
                    {
                        <strong data-count-up
                                data-count-target="@metric.CountTarget"
                                data-count-suffix="@metric.Suffix"
                                data-count-final="@metric.Value.For(Preferences.Culture)">@metric.Value.For(Preferences.Culture)</strong>
                    }
                    else
                    {
                        <strong>@metric.Value.For(Preferences.Culture)</strong>
                    }
                    <small>@metric.Label.For(Preferences.Culture)</small>
                </div>
            }
        </div>
    </div>
    <div class="landing-hero-visual" aria-label="@Text("Interactive MALIEV manufacturing model", "โมเดลสามมิติ MALIEV")">
        <ManufacturingGizmo Class="manufacturing-gizmo--landing"
                            @key="_heroModel.Key"
                            ModelUrl="@_heroModel.Url"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="@_heroModel.UsePlasticMaterial"
                            AriaLabel="@_heroModel.AriaLabel.For(Preferences.Culture)" />
    </div>
</section>

<section class="section home-services-section" aria-labelledby="services-title">
    <div class="section-heading">
        <div>
            <h2 id="services-title">@Text("One workflow for custom parts.", "ผลิตชิ้นงานเฉพาะในขั้นตอนเดียว")</h2>
        </div>
        <a class="section-link" href="/services">@Text("All capabilities", "ดูทุกความสามารถ")</a>
    </div>
    <div class="service-grid">
        @foreach (var service in _services)
        {
            <a class="@ServiceCardClass(service)" href="/services/@service.Slug">
                <div class="service-card-media">
                    <img src="@service.ImageUrl" alt="@service.Title.For(Preferences.Culture)" loading="lazy" />
                    @if (IsPrimaryService(service))
                    {
                        <span class="chip">@Text("Primary service", "บริการหลัก")</span>
                    }
                </div>
                <div class="service-card-body">
                    <h3>@service.Title.For(Preferences.Culture)</h3>
                    <p>@service.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@Text("Explore", "ดูเพิ่มเติม")</span>
                </div>
            </a>
        }
    </div>
</section>

<section id="machine-feature-preview"
         @ref="_machineFeaturePreview"
         class="feature-band machine-feature"
         aria-labelledby="imm-title"
         data-selected-feature="@SelectedWorkflowStep.Accent">
    <img class="machine-feature-backdrop"
         @key="SelectedWorkflowStep.Accent"
         src="@SelectedWorkflowStep.FeatureImageUrl"
         alt="@SelectedWorkflowStep.FeatureImageAlt.For(Preferences.Culture)"
         loading="lazy" />
    <div class="machine-feature-copy">
        <h2 id="imm-title" class="h-display machine-feature-title">
            <span class="machine-feature-title-line machine-feature-title-lead">@Text("Pneumatic injection", "เครื่องฉีดระบบลม")</span>
            <span class="machine-feature-title-line accent-blue">@Text("machines.", "สำหรับล็อตเล็ก")</span>
        </h2>
        <p class="lede">@Text("Two pneumatic machines we built for in-house thermoplastic trials and paid small-batch runs: the 30g variant reaches 300°C, the 50g variant reaches 350°C, and both run from 7 bar shop air.", "เครื่องฉีดระบบลมที่เราผลิตเองสำหรับทดลองเทอร์โมพลาสติกและผลิตล็อตเล็ก: รุ่น 30g สูงสุด 300°C, รุ่น 50g สูงสุด 350°C และทั้งสองรุ่นใช้ลมโรงงาน 7 bar")</p>
        <div class="machine-stat-grid">
            <div><strong>30g/50g</strong><small>@Text("shot capacity", "ปริมาตรฉีดต่อครั้ง")</small></div>
            <div><strong>300/350°C</strong><small>@Text("max melt", "อุณหภูมิสูงสุด")</small></div>
            <div><strong>7 bar</strong><small>@Text("air supply", "แรงดันลม")</small></div>
            <div><strong>@Text("30 days", "30 วัน")</strong><small>@Text("lead time", "ระยะเวลา")</small></div>
        </div>
        <div class="machine-feature-points" aria-label="@Text("Machine fit", "ความเหมาะสมของเครื่อง")">
            @foreach (var step in ProcessSteps)
            {
                <button class="@MachineFeaturePointClass(step)"
                        type="button"
                        data-workflow-accent="@step.Accent"
                        aria-current="@WorkflowAriaCurrent(step)"
                        @onclick="() => SelectWorkflowStepAsync(step, _workflowCarousel)">
                    <span class="machine-feature-point-number">@step.Number</span>
                    <span>@step.Title.For(Preferences.Culture)</span>
                </button>
            }
        </div>
        <div class="quote-actions machine-actions">
            <a class="button primary" href="/shop/pneumatic-injection-molding-machine">@Text("Configure machine", "ตั้งค่าเครื่อง")</a>
            <a class="button secondary" href="/contact">@Text("Plan tooling with us", "วางแผนทูลลิ่งกับเรา")</a>
        </div>
    </div>
</section>

<section id="workflow-carousel"
         @ref="_workflowCarousel"
         class="section process-section"
         aria-labelledby="process-title">
    <div class="section-lede process-lede">
        <h2 id="process-title">@Text("From CAD file to production order, in one workspace.", "จากไฟล์ CAD สู่คำสั่งผลิตในพื้นที่เดียว")</h2>
        <p>@Text("Visual checks, DFM feedback, pricing choices, and production tracking stay connected so teams can move faster with fewer handoffs.", "การตรวจไฟล์ DFM ตัวเลือกราคา และการติดตามผลิตอยู่ในขั้นตอนเดียว ทีมจึงเดินงานได้เร็วขึ้นและส่งต่อน้อยลง")</p>
    </div>
    <div class="process-grid" aria-label="@Text("Production workflow carousel", "คารูเซลขั้นตอนการผลิต")">
        @foreach (var step in ProcessSteps)
        {
            <button class="@WorkflowStepClass(step)"
                    type="button"
                    data-workflow-accent="@step.Accent"
                    aria-current="@WorkflowAriaCurrent(step)"
                    @onclick="() => SelectWorkflowStepAsync(step, _machineFeaturePreview)">
                <span class="workflow-step-number">@step.Number</span>
                <div class="workflow-step-visual" aria-hidden="true">
                    <MudIcon Icon="@step.Icon" Size="Size.Large" />
                </div>
                <h2>@step.Title.For(Preferences.Culture)</h2>
                <p>@step.Body.For(Preferences.Culture)</p>
            </button>
        }
    </div>
</section>

<section class="section" aria-labelledby="cases-title">
    <div class="section-heading">
        <div>
            <h2 id="cases-title" class="logo-heading">
                <span>@Text("Recent work from", "ผลงานล่าสุดจาก")</span>
                <img src="/images/logo.svg" alt="MALIEV" />
            </h2>
        </div>
        <a class="section-link" href="/case-studies">@Text("All case studies", "ดูผลงานทั้งหมด")</a>
    </div>
    <div class="case-grid">
        @foreach (var caseStudy in _caseStudies)
        {
            <a class="case-card" href="/case-studies/@caseStudy.Slug">
                <div class="case-card-media">
                    <img src="@caseStudy.ImageUrl" alt="@caseStudy.Title.For(Preferences.Culture)" loading="lazy" />
                </div>
                <div class="case-card-body">
                    <span class="card-meta">@caseStudy.Meta</span>
                    <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                    <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@caseStudy.Stat</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section news-section" aria-labelledby="news-title">
    <div class="section-heading">
        <div>
            <h2 id="news-title">@Text("Practical notes before you order parts.", "เรื่องที่ควรรู้ก่อนสั่งผลิตชิ้นงาน")</h2>
        </div>
        <a class="section-link" href="/blog">@Text("All posts", "บทความทั้งหมด")</a>
    </div>
    <div class="blog-grid">
        @foreach (var post in _blogPosts)
        {
            <a class="blog-card" href="/blog/@post.Slug">
                <div class="blog-card-media">
                    <img src="@post.ImageUrl" alt="@post.Title.For(Preferences.Culture)" loading="lazy" />
                </div>
                <div class="blog-card-body">
                    <span class="card-meta">@post.Category.For(Preferences.Culture)</span>
                    <h3>@post.Title.For(Preferences.Culture)</h3>
                    <p>@post.Summary.For(Preferences.Culture)</p>
                    <span class="card-link">@Text("Read note", "อ่านบทความ")</span>
                </div>
            </a>
        }
    </div>
</section>

<section class="section final-cta" aria-labelledby="final-cta-title">
    <div>
        <h2 id="final-cta-title" class="h-display">@Text("Ready when your CAD is.", "พร้อมเมื่อไฟล์ CAD ของคุณพร้อม")</h2>
        <p class="lede">@Text("Send geometry to the quote engine, then configure process, material, finish, quantity, tolerance, and delivery expectations.", "ส่ง Geometry เข้าระบบราคา แล้วเลือกกระบวนการ วัสดุ ผิวงาน จำนวน tolerance และความคาดหวังเรื่องจัดส่ง")</p>
    </div>
    <QuoteDropzone Href="@SiteContent.QuoteNewUrl"
                   Class="final-dropzone"
                   Title="@QuoteDropzoneTitle"
                   Description="@QuoteDropzoneDescription"
                   ActionText="@QuoteDropzoneAction"
                   AriaLabel="@QuoteDropzoneAction" />
</section>

@code {
    private const string ServicesOrderStateKey = "home.services.order";
    private const string CaseStudiesOrderStateKey = "home.caseStudies.order";
    private const string BlogPostsOrderStateKey = "home.blogPosts.order";
    private const string HeroCopyStateKey = "home.hero.copy";
    private const string HeroModelStateKey = "home.hero.model";
    private PersistingComponentStateSubscription? _persistingSubscription;
    private IReadOnlyList<ServicePageContent> _services = SiteContent.Services;
    private IReadOnlyList<CaseStudyContent> _caseStudies = SiteContent.CaseStudies;
    private IReadOnlyList<BlogPostContent> _blogPosts = SiteContent.BlogPosts;
    private HeroCopy _heroCopy = HeroCopyCatalog.Default;
    private HeroModelAsset _heroModel = HeroModelCatalog.Default;
    private string _heroTargetKey = HeroCopyCatalog.DefaultTargetKey;
    private string _heroServiceSlug = HeroCopyCatalog.ResolveServiceSlug(HeroCopyCatalog.DefaultTargetKey);
    private string _highlightServiceSlug = HeroCopyCatalog.ResolveServiceSlug(HeroCopyCatalog.DefaultTargetKey);
    private bool _hasExplicitHeroTarget;
    private int _heroVariantIndex;
    private string _selectedWorkflowAccent = "upload";
    private ElementReference _machineFeaturePreview;
    private ElementReference _workflowCarousel;

    private ProcessStep SelectedWorkflowStep => ProcessSteps.FirstOrDefault(
        step => string.Equals(step.Accent, _selectedWorkflowAccent, StringComparison.OrdinalIgnoreCase))
        ?? ProcessSteps[0];

    private readonly IReadOnlyList<ProcessStep> ProcessSteps =
    [
        new(
            "01",
            "upload",
            Icons.Material.Filled.UploadFile,
            SiteContent.Text("Upload your file", "อัปโหลดไฟล์"),
            SiteContent.Text("STL, STEP, IGES, OBJ, and 3MF files move directly to the pricing workspace.", "ไฟล์ STL, STEP, IGES, OBJ และ 3MF เข้าสู่พื้นที่คำนวณราคาโดยตรง"),
            "/images/products/pneumatic-injection-molding-machines.png",
            SiteContent.Text("MALIEV 30g and 50g pneumatic injection molding machine variants", "เครื่องฉีดพลาสติกระบบลม MALIEV รุ่น 30g และ 50g")),
        new(
            "02",
            "dfm",
            Icons.Material.Filled.FactCheck,
            SiteContent.Text("Review DFM", "ตรวจ DFM"),
            SiteContent.Text("Manufacturability feedback helps you catch risks before placing an order.", "ผลตรวจความเหมาะสมช่วยให้เห็นความเสี่ยงก่อนสั่งผลิต"),
            SiteContent.CaliperInspectionImageUrl,
            SiteContent.Text("Caliper inspection for DFM and dimensional review", "การตรวจวัดด้วยเวอร์เนียร์สำหรับ DFM และมิติสำคัญ")),
        new(
            "03",
            "price",
            Icons.Material.Filled.PriceChange,
            SiteContent.Text("Adjust price", "ปรับราคา"),
            SiteContent.Text("Choose process, material, finish, quantity, tolerance, and delivery expectations online.", "เลือกกระบวนการ วัสดุ ผิวงาน จำนวน tolerance และการจัดส่งออนไลน์"),
            SiteContent.DesignPlanningImageUrl,
            SiteContent.Text("Manufacturing planning workspace for pricing decisions", "พื้นที่วางแผนการผลิตสำหรับตัดสินใจด้านราคา")),
        new(
            "04",
            "order",
            Icons.Material.Filled.Inventory2,
            SiteContent.Text("Order and track", "สั่งผลิตและติดตาม"),
            SiteContent.Text("Accepted work continues into production tracking from the same customer workspace.", "งานที่ยืนยันแล้วติดตามการผลิตต่อได้ในพื้นที่ลูกค้าเดียวกัน"),
            SiteContent.InjectionMoldingLineImageUrl,
            SiteContent.Text("Production line ready for tracked manufacturing orders", "ไลน์ผลิตที่พร้อมสำหรับคำสั่งผลิตและการติดตามงาน"))
    ];

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        InitializeHeroCopy();
        InitializeHeroModel();
        InitializeRandomizedHomeContent();
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistRandomizedHomeContent);
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private string QuoteDropzoneTitle => Text("Upload CAD to price your part", "อัปโหลด CAD เพื่อดูราคาชิ้นงาน");

    private string QuoteDropzoneDescription => Text(
        "STL, STEP, STP, OBJ, 3MF. Review DFM, live pricing, and order when ready.",
        "รองรับ STL, STEP, STP, OBJ, 3MF พร้อมตรวจ DFM ราคาอัปเดตทันที และสั่งผลิตต่อได้");

    private string QuoteDropzoneAction => Text("Get part price", "ดูราคาชิ้นงาน");

    private string ServiceCardClass(ServicePageContent service)
    {
        return IsPrimaryService(service) ? "service-card primary" : "service-card";
    }

    private bool IsPrimaryService(ServicePageContent service)
    {
        return string.Equals(service.Slug, _highlightServiceSlug, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SelectWorkflowStepAsync(ProcessStep step, ElementReference scrollTarget)
    {
        _selectedWorkflowAccent = step.Accent;
        await JS.InvokeVoidAsync("malievScroll.scrollIntoView", scrollTarget);
    }

    private bool IsSelectedWorkflowStep(ProcessStep step)
    {
        return string.Equals(step.Accent, _selectedWorkflowAccent, StringComparison.OrdinalIgnoreCase);
    }

    private string? WorkflowAriaCurrent(ProcessStep step)
    {
        return IsSelectedWorkflowStep(step) ? "step" : null;
    }

    private string MachineFeaturePointClass(ProcessStep step)
    {
        return IsSelectedWorkflowStep(step) ? "machine-feature-point-button is-active" : "machine-feature-point-button";
    }

    private string WorkflowStepClass(ProcessStep step)
    {
        var classes = $"workflow-step workflow-step--{step.Accent}";
        return IsSelectedWorkflowStep(step) ? $"{classes} is-active" : classes;
    }

    private void InitializeRandomizedHomeContent()
    {
        _services = ApplicationState.TryTakeFromJson<string[]>(ServicesOrderStateKey, out var serviceOrder) && serviceOrder is not null
            ? PromoteHighlightedService(OrderByPersistedKeys(SiteContent.Services, serviceOrder, service => service.Slug))
            : PromoteHighlightedService(RandomizeSupportingServices());

        _caseStudies = ApplicationState.TryTakeFromJson<string[]>(CaseStudiesOrderStateKey, out var caseStudyOrder) && caseStudyOrder is not null
            ? OrderByPersistedKeys(SiteContent.CaseStudies, caseStudyOrder, caseStudy => caseStudy.Slug)
            : Shuffle(SiteContent.CaseStudies);

        _blogPosts = ApplicationState.TryTakeFromJson<string[]>(BlogPostsOrderStateKey, out var blogPostOrder) && blogPostOrder is not null
            ? OrderByPersistedKeys(SiteContent.BlogPosts, blogPostOrder, post => post.Slug)
            : Shuffle(SiteContent.BlogPosts);
    }

    private void InitializeHeroCopy()
    {
        var explicitTargetKey = HeroCopyCatalog.ResolveExplicitTargetKey(Navigation.Uri);
        _hasExplicitHeroTarget = !string.IsNullOrWhiteSpace(explicitTargetKey);
        var targetKey = explicitTargetKey ?? HeroCopyCatalog.DefaultTargetKey;
        if (ApplicationState.TryTakeFromJson<HeroCopyState>(HeroCopyStateKey, out var persisted) &&
            persisted is not null &&
            string.Equals(persisted.TargetKey, targetKey, StringComparison.OrdinalIgnoreCase))
        {
            ApplyHeroTarget(persisted.TargetKey);
            _heroVariantIndex = persisted.VariantIndex;
            _heroCopy = HeroCopyCatalog.GetVariant(_heroTargetKey, _heroVariantIndex);
            return;
        }

        ApplyHeroTarget(targetKey);
        _heroCopy = HeroCopyCatalog.SelectRandom(_heroTargetKey);
        _heroVariantIndex = _heroCopy.VariantIndex;
    }

    private void ApplyHeroTarget(string targetKey)
    {
        _heroTargetKey = targetKey;
        _heroServiceSlug = HeroCopyCatalog.ResolveServiceSlug(_heroTargetKey);
        _highlightServiceSlug = _heroServiceSlug;
    }

    private void InitializeHeroModel()
    {
        if (ApplicationState.TryTakeFromJson<HeroModelState>(HeroModelStateKey, out var persisted) &&
            persisted is not null &&
            string.Equals(persisted.ServiceSlug, _heroServiceSlug, StringComparison.OrdinalIgnoreCase))
        {
            _heroModel = HeroModelCatalog.Resolve(persisted.ModelKey);
            return;
        }

        _heroModel = HeroModelCatalog.SelectRandomForService(_heroServiceSlug);
    }

    private IReadOnlyList<ServicePageContent> RandomizeSupportingServices()
    {
        return Shuffle(SiteContent.Services);
    }

    private IReadOnlyList<ServicePageContent> PromoteHighlightedService(IReadOnlyList<ServicePageContent> services)
    {
        var selected = _hasExplicitHeroTarget
            ? services.FirstOrDefault(service => string.Equals(service.Slug, _heroServiceSlug, StringComparison.OrdinalIgnoreCase))
            : SelectRotatingHighlightedService(services);

        selected ??= services.FirstOrDefault(service => service.Primary)
            ?? services.FirstOrDefault();

        _highlightServiceSlug = selected?.Slug ?? _heroServiceSlug;

        if (selected is null)
        {
            return services;
        }

        return
        [
            selected,
            .. services.Where(service => !string.Equals(service.Slug, selected.Slug, StringComparison.OrdinalIgnoreCase))
        ];
    }

    private ServicePageContent? SelectRotatingHighlightedService(IReadOnlyList<ServicePageContent> services)
    {
        return services.FirstOrDefault(service => !string.IsNullOrWhiteSpace(service.Slug))
            ?? services.FirstOrDefault(service => service.Primary)
            ?? services.FirstOrDefault();
    }

    private Task PersistRandomizedHomeContent()
    {
        ApplicationState.PersistAsJson(HeroCopyStateKey, new HeroCopyState(_heroTargetKey, _heroVariantIndex));
        ApplicationState.PersistAsJson(HeroModelStateKey, new HeroModelState(_heroServiceSlug, _heroModel.Key));
        ApplicationState.PersistAsJson(ServicesOrderStateKey, _services.Select(service => service.Slug).ToArray());
        ApplicationState.PersistAsJson(CaseStudiesOrderStateKey, _caseStudies.Select(caseStudy => caseStudy.Slug).ToArray());
        ApplicationState.PersistAsJson(BlogPostsOrderStateKey, _blogPosts.Select(post => post.Slug).ToArray());
        return Task.CompletedTask;
    }

    private static IReadOnlyList<T> OrderByPersistedKeys<T>(IReadOnlyList<T> source, IReadOnlyList<string> keys, Func<T, string> keySelector)
    {
        var sourceByKey = source.ToDictionary(keySelector, StringComparer.OrdinalIgnoreCase);
        var ordered = keys
            .Where(sourceByKey.ContainsKey)
            .Select(key => sourceByKey[key])
            .ToList();

        ordered.AddRange(source.Where(item => !keys.Contains(keySelector(item), StringComparer.OrdinalIgnoreCase)));
        return ordered;
    }

    private static IReadOnlyList<T> Shuffle<T>(IEnumerable<T> source)
    {
        var items = source.ToArray();
        for (var index = items.Length - 1; index > 0; index--)
        {
            var swapIndex = System.Security.Cryptography.RandomNumberGenerator.GetInt32(index + 1);
            (items[index], items[swapIndex]) = (items[swapIndex], items[index]);
        }

        return items;
    }

    public override void Dispose()
    {
        base.Dispose();
        _persistingSubscription?.Dispose();
    }

    private sealed record ProcessStep(
        string Number,
        string Accent,
        string Icon,
        LocalizedText Title,
        LocalizedText Body,
        string FeatureImageUrl,
        LocalizedText FeatureImageAlt);

    private sealed record HeroCopyState(string TargetKey, int VariantIndex);

    private sealed record HeroModelState(string ServiceSlug, string ModelKey);
}
