@page "/quote"
@inherits PreferenceAwareComponentBase

<PageTitle>Custom manufacturing quote - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="Start a MALIEV custom manufacturing quote at quote.maliev.com for CAD upload, DFM review, deterministic pricing, and order tracking." />
    <link rel="canonical" href="https://www.maliev.com/quote" />
    <meta http-equiv="refresh" content="5; url=@SiteContent.QuoteNewUrl" />
</HeadContent>

<section class="hero-band quote-hero">
    <div class="hero-copy">
        <h1>Custom quotes now run in the dedicated quote engine.</h1>
        <p>@Text("Upload CAD files, configure parts, review manufacturability, request a formal quote, and track custom manufacturing orders at quote.maliev.com.", "อัปโหลดไฟล์ CAD ตั้งค่าชิ้นงาน ตรวจความเหมาะสมการผลิต ขอใบเสนอราคาอย่างเป็นทางการ และติดตามคำสั่งผลิตที่ quote.maliev.com")</p>
        <div class="quote-actions">
            <a class="button primary" href="@SiteContent.QuoteNewUrl">@Text("Open quote engine", "เปิดระบบราคาชิ้นงาน")</a>
            <a class="button secondary" href="/services">@Text("Review services", "ดูบริการ")</a>
        </div>
    </div>
    <div class="hero-workspace gizmo-workspace">
        <ManufacturingGizmo />
    </div>
</section>

@code {
    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }
}
