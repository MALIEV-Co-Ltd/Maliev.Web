@page "/quote"

<PageTitle>Instant quotation - MALIEV</PageTitle>

<section class="hero-band quote-hero">
    <div class="hero-copy">
        <p class="eyebrow">Instant quotation</p>
        <h1>Upload, analyze, configure, quote</h1>
        <p>Upload a 3D model, choose the manufacturing route, review manufacturability notes, and continue with a MALIEV quotation.</p>
        <div class="hero-quote quote-engine-mock">
            <section class="quote-panel quote-engine-panel">
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Class="quote-engine-dropzone"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           IconClass="quote-engine-dropzone-icon"
                           aria-label="Drop or choose 3D model files">
                    <span class="quote-engine-dropzone-copy">
                        <strong>Drop or choose 3D model files</strong>
                        <small>STL, STEP, STP, OBJ, 3MF. Materials, DFM, pricing</small>
                    </span>
                </MudButton>
                <div class="quote-engine-steps">
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Class="quote-engine-step-icon" />
                        <span>Process</span>
                        <small>Manufacturing route</small>
                    </div>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Class="quote-engine-step-icon" />
                        <span>DFM</span>
                        <small>Part review</small>
                    </div>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="quote-engine-step-icon" />
                        <span>Quote</span>
                        <small>Pricing summary</small>
                    </div>
                </div>
            </section>
        </div>
    </div>
    <div class="hero-workspace gizmo-workspace">
        <ManufacturingGizmo />
    </div>
</section>
