@page "/quote"
@inherits PreferenceAwareComponentBase

<PageTitle>Custom manufacturing quote - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="MALIEV custom manufacturing online quote intake is temporarily unavailable while the MVP workflow is prepared." />
    <link rel="canonical" href="https://www.maliev.com/quote" />
</HeadContent>

<section class="hero-band quote-hero">
    <div class="hero-copy">
        <h1>@SiteContent.QuoteDisabledTitle.For(Preferences.Culture)</h1>
        <p>@SiteContent.QuoteDisabledBody.For(Preferences.Culture)</p>
        <div class="quote-actions">
            <button type="button" class="@QuoteDisabledButtonClass" disabled title="@SiteContent.QuoteDisabledTitle.For(Preferences.Culture)">@Text("Try demo", "ทดลองดูตัวอย่าง")</button>
            <button type="button" class="button secondary is-disabled" disabled title="@SiteContent.QuoteDisabledTitle.For(Preferences.Culture)">@Text("Start project", "เริ่มโปรเจกต์")</button>
            <a class="button secondary" href="/services">@Text("Review services", "ดูบริการ")</a>
        </div>
    </div>
    <div class="hero-workspace gizmo-workspace">
        <ManufacturingGizmo />
    </div>
</section>

@code {
    private string QuoteDisabledButtonClass => "button primary is-disabled";

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }
}
