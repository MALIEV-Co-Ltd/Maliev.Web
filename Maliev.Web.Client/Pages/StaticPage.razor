@page "/about"
@page "/contact"
@page "/faq"
@page "/shipping-returns"
@page "/privacy"
@page "/terms"
@page "/cookie-policy"
@page "/refund-policy"
@page "/warranty-policy"
@page "/industries"
@page "/case-studies"
@page "/case-studies/{Slug}"
@page "/blog"
@page "/blog/{Slug}"
@page "/account/quotes"
@inherits PreferenceAwareComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MalievApiClient Api

<PageTitle>@Title - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:title" content="@Title - MALIEV" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@CanonicalUrl" />
</HeadContent>

@if (ShouldRenderPageHero)
{
    <section class="@PageHeroClass">
        <h1>@Title</h1>
        <p>@Body</p>
        @if (ShouldRenderPageHeroActions)
        {
            <div class="quote-actions">
                <a class="button primary" href="@PrimaryHref">@PrimaryAction</a>
                <a class="button secondary" href="@SecondaryHref" aria-label="@SecondaryAction">
                    @if (SecondaryActionUsesLogo)
                    {
                        <span>@SecondaryActionPrefix</span>
                        <img class="button-logo-mark" src="/images/logo.svg" alt="" aria-hidden="true" />
                    }
                    else
                    {
                        @SecondaryAction
                    }
                </a>
            </div>
        }
    </section>
}

@if (Path == "case-studies")
{
    <section class="section">
        <div class="case-grid">
            @foreach (var caseStudy in SiteContent.CaseStudies)
            {
                <a class="case-card" href="/case-studies/@caseStudy.Slug">
                    <div class="case-card-media">
                        <img src="@caseStudy.ImageUrl" alt="@caseStudy.Title.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="case-card-body">
                        <span class="card-meta">@caseStudy.Meta</span>
                        <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                        <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                        <span class="card-link">@caseStudy.Stat</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
else if (Path == "blog")
{
    <section class="section blog-library-section" aria-labelledby="blog-library-title">
        <div class="blog-library-tools">
            <div>
                <span class="card-meta">@Text("Manufacturing notes", "บันทึกงานผลิต")</span>
                <h1 id="blog-library-title">@Text("Practical Notes", "บทความเชิงปฏิบัติ")</h1>
                <p>@Text("Search the full library by process, material, fit, quoting, or production topic.", "ค้นหาคลังบทความตามกระบวนการ วัสดุ การประกอบ การเสนอราคา หรือหัวข้องานผลิต")</p>
            </div>
            <form class="blog-search-form" action="/blog" method="get" role="search">
                <label for="blog-search">@Text("Search posts", "ค้นหาบทความ")</label>
                @if (HasActiveBlogCategory)
                {
                    <input type="hidden" name="category" value="@BlogCategoryQueryValue" />
                }
                <div class="blog-search-row">
                    <input id="blog-search"
                           name="q"
                           type="search"
                           value="@BlogSearch"
                           placeholder="@Text("Search CNC, resin, tolerance...", "ค้นหา CNC, เรซิน, tolerance...")" />
                    <button type="submit" class="button primary">@Text("Search", "ค้นหา")</button>
                    @if (!string.IsNullOrWhiteSpace(BlogSearch))
                    {
                        <a class="button secondary" href="@BlogSearchClearHref">@Text("Clear", "ล้าง")</a>
                    }
                </div>
            </form>
            <div class="blog-category-filter" aria-label="@Text("Filter practical notes by topic", "กรองบทความตามหัวข้อ")">
                <div class="blog-category-filter-head">
                    <span class="blog-category-filter-label">@Text("Filter by topic", "กรองตามหัวข้อ")</span>
                    @if (HasActiveBlogCategory)
                    {
                        <a class="blog-category-clear" href="@BuildBlogCategoryHref(AllBlogCategoryFilter)">@Text("Clear filters", "ล้างตัวกรอง")</a>
                    }
                    else
                    {
                        <span class="blog-category-hint">@Text("Select one or more", "เลือกได้มากกว่าหนึ่ง")</span>
                    }
                </div>
                <div class="blog-category-list">
                    @foreach (var filter in BlogCategoryFilters)
                    {
                        <a class="@BlogCategoryFilterClass(filter)"
                           href="@BuildBlogCategoryHref(filter.Key)"
                           aria-pressed="@BlogCategoryFilterIsActive(filter).ToString().ToLowerInvariant()">
                            <span class="blog-category-chip-dot" aria-hidden="true"></span>
                            @filter.Label.For(Preferences.Culture)
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="blog-library-status" role="status">
            @Text($"{FilteredBlogPosts.Count} notes found", $"พบบทความ {FilteredBlogPosts.Count} รายการ")
        </div>
        <div class="blog-grid">
            @foreach (var post in PagedBlogPosts)
            {
                <a class="blog-card" href="/blog/@post.Slug">
                    <div class="blog-card-media">
                        <img src="@SiteContent.ResolveBlogImageUrl(post)" alt="@post.Title.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="blog-card-body">
                        <span class="card-meta">@post.Category.For(Preferences.Culture)</span>
                        <h3>@post.Title.For(Preferences.Culture)</h3>
                        <p>@post.Summary.For(Preferences.Culture)</p>
                        <span class="card-link">@Text("Read note", "อ่านบทความ")</span>
                    </div>
                </a>
            }
        </div>
        @if (TotalBlogPages > 1)
        {
            <nav class="pagination blog-pagination" aria-label="@Text("Blog pages", "หน้าบทความ")">
                <a class="@PaginationLinkClass(BlogPage <= 1)"
                   href="@BuildBlogPageHref(BlogPage - 1)"
                   aria-disabled="@(BlogPage <= 1)">@Text("Previous", "ก่อนหน้า")</a>
                @foreach (var pageNumber in VisibleBlogPages)
                {
                    <a class="@PaginationPageClass(pageNumber)"
                       href="@BuildBlogPageHref(pageNumber)"
                       aria-current="@(pageNumber == BlogPage ? "page" : null)">@pageNumber.ToString(CultureInfo.InvariantCulture)</a>
                }
                <a class="@PaginationLinkClass(BlogPage >= TotalBlogPages)"
                   href="@BuildBlogPageHref(BlogPage + 1)"
                   aria-disabled="@(BlogPage >= TotalBlogPages)">@Text("Next", "ถัดไป")</a>
            </nav>
        }
    </section>
}
else if (CurrentCaseStudy is { } caseStudyDetail)
{
    <section class="section article-detail-layout case-study-detail">
        <article class="article-detail-body">
            <div class="article-detail-media">
                <img src="@caseStudyDetail.ImageUrl" alt="@caseStudyDetail.Title.For(Preferences.Culture)" loading="lazy" />
            </div>
            <div class="content-stack">
                @foreach (var item in caseStudyDetail.Sections)
                {
                    <article class="detail-section">
                        <h2>@item.Title.For(Preferences.Culture)</h2>
                        <p>@item.Body.For(Preferences.Culture)</p>
                        @if (item.Image is { } image)
                        {
                            <figure class="article-section-media">
                                <img src="@image.Url" alt="@image.Alt.For(Preferences.Culture)" loading="lazy" />
                                <figcaption>@image.Caption.For(Preferences.Culture)</figcaption>
                            </figure>
                        }
                        @if (item.Items.Count > 0)
                        {
                            <ul>
                                @foreach (var point in item.Items)
                                {
                                    <li>@point.For(Preferences.Culture)</li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        </article>
        <aside class="detail-sidebar">
            <span class="card-meta">@caseStudyDetail.Meta</span>
            <strong>@caseStudyDetail.Stat</strong>
            <h2>@Text("What changed", "สิ่งที่เปลี่ยน")</h2>
            <ul>
                @foreach (var outcome in caseStudyDetail.Outcomes)
                {
                    <li>@outcome.For(Preferences.Culture)</li>
                }
            </ul>
            <a class="button primary" href="@SiteContent.MakeStudioUrl">@Text("Start a similar quote", "เริ่มขอราคางานคล้ายกัน")</a>
        </aside>
    </section>
}
else if (CurrentBlogPost is { } blogPost)
{
    <section class="section article-detail-layout blog-detail">
        <article class="article-detail-body">
            <div class="article-detail-media">
                <img src="@SiteContent.ResolveBlogImageUrl(blogPost)" alt="@blogPost.Title.For(Preferences.Culture)" loading="lazy" />
            </div>
            <div class="content-stack">
                @foreach (var item in blogPost.Sections)
                {
                    var isChecklistSection = IsBlogChecklistSection(item);
                    <article class="@BlogDetailSectionClass(isChecklistSection)">
                        <h2>@item.Title.For(Preferences.Culture)</h2>
                        <p>@item.Body.For(Preferences.Culture)</p>
                        @if (item.Image is { } image)
                        {
                            <figure class="article-section-media">
                                <img src="@image.Url" alt="@image.Alt.For(Preferences.Culture)" loading="lazy" />
                                <figcaption>@image.Caption.For(Preferences.Culture)</figcaption>
                            </figure>
                        }
                        @if (item.Items.Count > 0)
                        {
                            <ul class="@(isChecklistSection ? "article-checklist" : null)">
                                @foreach (var point in item.Items)
                                {
                                    <li>@point.For(Preferences.Culture)</li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        </article>
        <aside class="detail-sidebar">
            <span class="card-meta">@blogPost.Category.For(Preferences.Culture)</span>
            <h2>@Text("Before you upload", "ก่อนอัปโหลด")</h2>
            <ul>
                @foreach (var takeaway in blogPost.Takeaways)
                {
                    <li>@takeaway.For(Preferences.Culture)</li>
                }
            </ul>
            <div class="detail-sidebar-actions" aria-label="@Text("Blog sidebar actions", "ปุ่มดำเนินการในแถบบทความ")">
                <a class="button primary" href="@SiteContent.MakeStudioUrl">@Text("Get part price", "ดูราคาชิ้นงาน")</a>
                <a class="button secondary" href="/materials">@Text("Compare materials", "เปรียบเทียบวัสดุ")</a>
                <button type="button" class="button secondary blog-pdf-button @(_pdfDownloading ? "is-loading" : "")"
                        @onclick="() => DownloadPdfAsync(blogPost)" disabled="@_pdfDownloading"
                        aria-label="@Text("Download PDF", "ดาวน์โหลด PDF")">
                    @if (_pdfDownloading)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span>@Text("Downloading…", "กำลังดาวน์โหลด…")</span>
                    }
                    else
                    {
                        @Text("Download PDF", "ดาวน์โหลด PDF")
                    }
                </button>
            </div>
        </aside>
    </section>
}
else if (Path == "contact")
{
    <section class="section contact-layout">
        <div class="contact-details">
            <div class="contact-business-panel" aria-label='@Text("MALIEV contact channels", "ช่องทางติดต่อ MALIEV")'>
                <article class="contact-business-section contact-business-section--sales">
                    <div class="contact-section-head">
                        <div>
                            <h2>@Text("Sales and quotations", "ฝ่ายขายและใบเสนอราคา")</h2>
                            <p>@Text("Send product questions, drawings, 3D files, or project notes. We will confirm the manufacturing route, lead time, and next commercial step.", "ส่งคำถามสินค้า Drawing ไฟล์ 3D หรือหมายเหตุโปรเจกต์ เราจะยืนยันเส้นทางผลิต ระยะเวลา และขั้นตอนการค้า")</p>
                        </div>
                    </div>
                    <dl class="contact-info-rows">
