    private async Task SubmitContactAsync()
    {
        if (_submittingContact)
        {
            return;
        }

        _submittingContact = true;
        ClearContactStatus();
        await InvokeAsync(StateHasChanged);
        try
        {
            _contact.Files = _contactFileUploads
                .Where(file => file.CanSubmit)
                .Select(file => new ContactAttachmentDto
                {
                    FileName = file.FileName,
                    ContentType = file.ContentType,
                    Base64Content = Convert.ToBase64String(file.RawContent)
                })
                .ToList();
            SetContactFileStage(ContactFileUploadStage.Sending);
            await InvokeAsync(StateHasChanged);

            var response = await Api.SubmitContactMessageAsync(_contact);
            SetContactFileStage(ContactFileUploadStage.Submitted);
            var publicReference = ResolveContactReference(response);

            SetContactStatus(
                Text("Request received", "ได้รับคำขอแล้ว"),
                Text(
                    $"We sent a confirmation copy to {_contact.Email}. Your request {publicReference} is now in the MALIEV contact queue.",
                    $"เราส่งสำเนายืนยันไปที่ {_contact.Email} แล้ว คำขอ {publicReference} อยู่ในคิวติดต่อของ MALIEV"),
                ContactFormStatus.Success);
        }
        catch (Exception)
        {
            SetContactFileStage(ContactFileUploadStage.Ready);
            SetContactStatus(
                Text("Message was not sent", "ยังส่งข้อความไม่ได้"),
                Text(
                    "We could not send the message right now. Please try again, or email info@maliev.com / LINE @maliev if this is urgent.",
                    "ขณะนี้ยังส่งข้อความไม่ได้ กรุณาลองใหม่อีกครั้ง หรืออีเมล info@maliev.com / LINE @maliev หากเป็นเรื่องเร่งด่วน"),
                ContactFormStatus.Error);
        }
        finally
        {
            _submittingContact = false;
        }
    }

    private async Task HandleContactFilesAsync(InputFileChangeEventArgs args)
    {
        ClearContactStatus();
        _contact.Files.Clear();
        _contactFileUploads.Clear();

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(MaxContactFiles);
        }
        catch (InvalidOperationException)
        {
            SetContactStatus(
                Text("Too many files selected", "เลือกไฟล์มากเกินไป"),
                Text($"Select up to {MaxContactFiles} support files. Send larger RFQ packages through Make Studio.", $"เลือกไฟล์ประกอบได้สูงสุด {MaxContactFiles} ไฟล์ หากเป็นชุดไฟล์ขอราคาขนาดใหญ่ให้ส่งผ่าน Make Studio"),
                ContactFormStatus.Error);
            return;
        }

        foreach (var file in files)
        {
            var fileUpload = new ContactFileUploadState(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                file.Size);
            _contactFileUploads.Add(fileUpload);
            await InvokeAsync(StateHasChanged);

            if (file.Size > MaxContactFileBytes)
            {
                fileUpload.MarkFailed();
                SetContactStatus(
                    Text("File is too large", "ไฟล์ใหญ่เกินไป"),
                    Text($"File {file.Name} is larger than {MaxContactFileMegabytes} MB. Please send large CAD packages through Make Studio.", $"ไฟล์ {file.Name} มีขนาดเกิน {MaxContactFileMegabytes} MB กรุณาส่งชุดไฟล์ CAD ขนาดใหญ่ผ่าน Make Studio"),
                    ContactFormStatus.Error);
                _contact.Files.Clear();
                return;
            }

            await using var stream = file.OpenReadStream(MaxContactFileBytes);
            using var buffer = new MemoryStream();
            var readBuffer = new byte[64 * 1024];
            long totalRead = 0;
            int bytesRead;

            while ((bytesRead = await stream.ReadAsync(readBuffer)) > 0)
            {
                await buffer.WriteAsync(readBuffer.AsMemory(0, bytesRead));
                totalRead += bytesRead;
                fileUpload.UpdateProgress(file.Size == 0 ? 100 : (int)Math.Min(100, totalRead * 100 / file.Size));
                await InvokeAsync(StateHasChanged);
            }

            fileUpload.MarkReady(buffer.ToArray());
        }
    }

    private void ClearContactStatus()
    {
        _contactStatusTitle = null;
        _contactStatus = null;
        _contactStatusKind = ContactFormStatus.None;
    }

    private void SetContactStatus(string title, string status, ContactFormStatus kind)
    {
        _contactStatusTitle = title;
        _contactStatus = status;
        _contactStatusKind = kind;
    }

    private void SetContactFileStage(ContactFileUploadStage stage)
    {
        foreach (var file in _contactFileUploads.Where(file => file.CanChangeSubmitStage))
        {
            file.SetStage(stage);
        }
    }

    private static string ResolveContactReference(ContactMessageResponse response)
    {
        if (!string.IsNullOrWhiteSpace(response.PublicReference))
        {
            return response.PublicReference;
        }

        return int.TryParse(response.MessageId, NumberStyles.Integer, CultureInfo.InvariantCulture, out var numericId)
            ? FormattableString.Invariant($"MLV-C-{numericId:000000}")
            : response.MessageId;
    }

    private enum ContactFormStatus
    {
        None,
        Success,
        Error
    }

    private enum ContactFileUploadStage
    {
        Preparing,
        Ready,
        Sending,
        Submitted,
        Failed
    }

    private sealed class ContactFileUploadState(string fileName, string contentType, long size)
    {
        public string FileName { get; } = fileName;

        public string ContentType { get; } = contentType;

        public long Size { get; } = size;

        public byte[] RawContent { get; private set; } = [];

        public int Progress { get; private set; }

        public ContactFileUploadStage Stage { get; private set; } = ContactFileUploadStage.Preparing;

        public string Summary => $"{FileName} ({FormatBytes(Size)})";

        public bool IsIndeterminate => Stage == ContactFileUploadStage.Sending;

        public bool CanSubmit => Stage is ContactFileUploadStage.Ready or ContactFileUploadStage.Submitted;

        public bool CanChangeSubmitStage => Stage is
            ContactFileUploadStage.Ready or
            ContactFileUploadStage.Sending or
            ContactFileUploadStage.Submitted;

        public string StatusTextEn => Stage switch
        {
            ContactFileUploadStage.Preparing => $"Preparing {Progress}%",
            ContactFileUploadStage.Ready => "Ready to send",
            ContactFileUploadStage.Sending => "Sending with message",
            ContactFileUploadStage.Submitted => "Sent",
            ContactFileUploadStage.Failed => "Cannot attach",
            _ => "Ready"
        };

        public string StatusTextTh => Stage switch
        {
            ContactFileUploadStage.Preparing => $"กำลังเตรียม {Progress}%",
            ContactFileUploadStage.Ready => "พร้อมส่ง",
            ContactFileUploadStage.Sending => "กำลังส่งพร้อมข้อความ",
            ContactFileUploadStage.Submitted => "ส่งแล้ว",
            ContactFileUploadStage.Failed => "แนบไฟล์ไม่ได้",
            _ => "พร้อมส่ง"
        };

        public void UpdateProgress(int progress)
        {
            Progress = Math.Clamp(progress, 0, 100);
        }

        public void MarkReady(byte[] rawContent)
        {
            RawContent = rawContent;
            Progress = 100;
            Stage = ContactFileUploadStage.Ready;
        }

        public void MarkFailed()
        {
            Progress = 100;
            Stage = ContactFileUploadStage.Failed;
        }

        public void SetStage(ContactFileUploadStage stage)
        {
            Stage = stage;
            if (stage is ContactFileUploadStage.Ready or ContactFileUploadStage.Submitted)
            {
                Progress = 100;
            }
        }
    }

    private bool IsThaiCulture => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase);

    private static string BlogDetailSectionClass(bool isChecklistSection)
    {
        return isChecklistSection ? "detail-section detail-section--checklist" : "detail-section";
    }

    private static bool IsBlogChecklistSection(ArticleSectionContent section)
    {
        return section.Title.En.Contains("checklist", StringComparison.OrdinalIgnoreCase)
            || section.Title.Th.Contains("เช็กลิสต์", StringComparison.OrdinalIgnoreCase);
    }

    private string Text(string en, string th)
    {
        return IsThaiCulture ? th : en;
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:0.#} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes} B";
    }

    private static ContentSection Section(string titleEn, string titleTh, string bodyEn, string bodyTh, params (string En, string Th)[] items)
    {
        return new ContentSection(
            SiteContent.Text(titleEn, titleTh),
            SiteContent.Text(bodyEn, bodyTh),
            items.Select(item => SiteContent.Text(item.En, item.Th)).ToList());
    }

    private sealed record ContentSection(LocalizedText Title, LocalizedText Body, IReadOnlyList<LocalizedText> Items);

    private sealed record BlogCategoryFilter(string Key, LocalizedText Label, IReadOnlyList<string> Terms);
