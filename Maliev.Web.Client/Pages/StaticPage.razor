@page "/about"
@page "/contact"
@page "/faq"
@page "/shipping-returns"
@page "/privacy"
@page "/terms"
@page "/materials"
@page "/industries"
@page "/case-studies"
@page "/case-studies/{Slug}"
@page "/blog"
@page "/blog/{Slug}"
@page "/account/quotes"
@page "/account/orders"
@page "/account/preferences"
@inject NavigationManager Navigation
@inject MalievApiClient Api
@inject PreferenceService Preferences

<PageTitle>@Title - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:title" content="@Title - MALIEV" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@CanonicalUrl" />
</HeadContent>

<section class="page-hero compact">
    <p class="eyebrow">@Eyebrow</p>
    <h1>@Title</h1>
    <p>@Body</p>
    <div class="quote-actions">
        <a class="button primary" href="@PrimaryHref">@PrimaryAction</a>
        <a class="button secondary" href="@SecondaryHref">@SecondaryAction</a>
    </div>
</section>

@if (Path == "materials")
{
    <section class="section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Text("Material library", "ห้องสมุดวัสดุ")</p>
                <h2>@Text("Choose by process, use case, and finishing expectation.", "เลือกจากกระบวนการ การใช้งาน และความคาดหวังเรื่องผิวงาน")</h2>
            </div>
        </div>
        <div class="material-grid">
            @foreach (var material in Materials)
            {
                <article class="material-card">
                    <div class="material-card-media">
                        <img src="@material.ImageUrl" alt="@material.ImageAlt.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="material-card-body">
                        <span class="card-meta">@material.Process</span>
                        <h3>@material.Name</h3>
                        <p>@material.Body.For(Preferences.Culture)</p>
                        <div class="material-card-tags">
                            @foreach (var tag in material.Tags)
                            {
                                <span class="chip">@tag.For(Preferences.Culture)</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
}
else if (Path == "case-studies")
{
    <section class="section">
        <div class="case-grid">
            @foreach (var caseStudy in SiteContent.CaseStudies)
            {
                <a class="case-card" href="/case-studies/@caseStudy.Slug">
                    <div class="case-card-media">
                        <img src="@caseStudy.ImageUrl" alt="@caseStudy.Title.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="case-card-body">
                        <span class="card-meta">@caseStudy.Meta</span>
                        <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                        <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                        <span class="card-link">@caseStudy.Stat</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
else if (Path == "blog")
{
    <section class="section">
        <div class="blog-grid">
            @foreach (var post in SiteContent.BlogPosts)
            {
                <a class="blog-card" href="/blog/@post.Slug">
                    <div class="blog-card-media">
                        <img src="@post.ImageUrl" alt="@post.Title.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="blog-card-body">
                        <span class="card-meta">@post.Category.For(Preferences.Culture)</span>
                        <h3>@post.Title.For(Preferences.Culture)</h3>
                        <p>@post.Summary.For(Preferences.Culture)</p>
                        <span class="card-link">@Text("Read note", "อ่านบทความ")</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
else if (Path.StartsWith("case-studies/", StringComparison.Ordinal))
{
    <section class="section text-section">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>
}
else if (Path == "contact")
{
    <section class="section contact-layout">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
        <EditForm Model="_contact" OnValidSubmit="SubmitContactAsync" FormName="contact-form" class="contact-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <label>@Text("Full name", "ชื่อ-นามสกุล") <InputText @bind-Value="_contact.FullName" /></label>
                <label>@Text("Email", "อีเมล") <InputText type="email" @bind-Value="_contact.Email" /></label>
                <label>@Text("Phone", "โทรศัพท์") <InputText @bind-Value="_contact.PhoneNumber" /></label>
                <label>@Text("Company", "บริษัท") <InputText @bind-Value="_contact.Company" /></label>
                <label class="wide">@Text("Subject", "หัวข้อ") <InputText @bind-Value="_contact.Subject" /></label>
                <label class="wide">@Text("Message", "ข้อความ") <InputTextArea @bind-Value="_contact.Message" /></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_contactStatus))
            {
                <p class="form-status">@_contactStatus</p>
            }
            <button class="button primary" type="submit" disabled="@_submittingContact">@Text("Send message", "ส่งข้อความ")</button>
        </EditForm>
    </section>
}
else
{
    <section class="section text-section">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private readonly ContactMessageRequest _contact = new()
    {
        ContactType = "Website",
        Subject = "Manufacturing inquiry"
    };

    private bool _submittingContact;
    private string? _contactStatus;
    private string Path => new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    private string CanonicalUrl => $"https://www.maliev.com/{Path}".TrimEnd('/');

    private string Eyebrow => Path switch
    {
        "account/preferences" or "account/quotes" or "account/orders" => Text("Quote engine", "ระบบขอราคา"),
        var path when path.StartsWith("blog/", StringComparison.Ordinal) => Text("MALIEV Journal", "บทความ MALIEV"),
        var path when path.StartsWith("case-studies/", StringComparison.Ordinal) => Text("Case study", "ผลงาน"),
        "materials" => Text("Materials", "วัสดุ"),
        "case-studies" => Text("Case studies", "ผลงาน"),
        _ => "MALIEV"
    };

    private string Title => Path switch
    {
        "contact" => Text("Contact", "ติดต่อ"),
        "faq" => "FAQ",
        "shipping-returns" => Text("Shipping and returns", "การจัดส่งและการคืนสินค้า"),
        "privacy" => Text("Privacy", "ความเป็นส่วนตัว"),
        "terms" => Text("Terms", "เงื่อนไข"),
        "materials" => Text("Materials", "วัสดุ"),
        "industries" => Text("Industries", "อุตสาหกรรม"),
        "case-studies" => Text("Case studies", "ผลงาน"),
        "blog" => Text("MALIEV Journal", "บทความ MALIEV"),
        "account/quotes" => Text("Saved quotes", "ใบเสนอราคาที่บันทึกไว้"),
        "account/orders" => Text("Orders", "คำสั่งซื้อ"),
        "account/preferences" => Text("Preferences", "การตั้งค่า"),
