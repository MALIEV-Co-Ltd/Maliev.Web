    };

    private IReadOnlyList<ContentSection> Sections => Path switch
    {
        "industries" =>
        [
            Section("Factories and maintenance teams", "โรงงานและทีมซ่อมบำรุง", "Jigs, fixtures, replacement parts, guards, brackets, adapters, and troubleshooting support for production environments.", "จิ๊ก ฟิกซ์เจอร์ ชิ้นส่วนทดแทน การ์ด ขายึด อะแดปเตอร์ และการสนับสนุนการแก้ปัญหาในสภาพแวดล้อมการผลิต"),
