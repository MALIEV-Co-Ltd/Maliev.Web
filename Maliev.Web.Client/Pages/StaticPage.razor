        "account/preferences" or "account/quotes" or "account/orders" =>
        [
            Section("Dedicated quote portal", "พอร์ทัลราคาชิ้นงานโดยเฉพาะ", "Custom manufacturing account features live at quote.maliev.com so files, quotes, orders, NDAs, and documents stay together.", "ฟีเจอร์บัญชีงานผลิตเฉพาะอยู่ที่ quote.maliev.com เพื่อให้ไฟล์ ใบเสนอราคา คำสั่งซื้อ NDA และเอกสารอยู่ด้วยกัน"),
            Section("Product shop", "ร้านค้าสินค้า", "Product shopping remains on www.maliev.com and keeps a separate cart flow.", "การซื้อสินค้ายังอยู่ที่ www.maliev.com และใช้ตะกร้าแยกต่างหาก")
        ],
