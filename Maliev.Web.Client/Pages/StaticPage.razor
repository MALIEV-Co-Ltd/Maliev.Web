                    <div class="contact-section-actions">
                        <a class="button secondary" href="mailto:support@maliev.com">@Text("Email support", "อีเมลฝ่ายสนับสนุน")</a>
                    </div>
                </article>
            </div>
            <article class="contact-map-section">
                <div class="contact-map-heading">
                    <div>
                        <h2 class="contact-map-title">
                            <span>@Text("Visit", "เข้ามาที่")</span>
                            <img class="contact-map-title-logo" src="/images/logo.svg" alt="MALIEV" />
                        </h2>
                        <p>@Text("Preview the workshop location for deliveries, pickups, parking, and route planning before visiting.", "ดูตำแหน่งเวิร์กช็อปสำหรับส่งของ รับสินค้า ที่จอดรถ และวางแผนเส้นทางก่อนเข้ามา")</p>
                    </div>
                </div>
                <iframe class="contact-map-preview"
                        src="@MalievMapEmbedUrl"
                        title='@Text("Google Maps location preview for MALIEV", "แผนที่ Google Maps ของ MALIEV")'
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                <div class="contact-map-actions">
                    <button class="button secondary" type="button" @onclick="OpenContactMapDialog">
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                        @Text("Open larger map", "เปิดแผนที่ขนาดใหญ่")
                    </button>
                </div>
            </article>
        </div>
        <EditForm Model="_contact" OnValidSubmit="SubmitContactAsync" FormName="contact-form" class="contact-form" aria-busy="@_submittingContact">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                @if (ShowContactProfileCard)
                {
                    <div class="wide account-overview-card account-profile-card contact-identity-card">
                        <div class="account-profile-header">
                            @if (!string.IsNullOrWhiteSpace(_contactProfile?.ProfileImageUrl))
                            {
                                <img class="account-avatar account-avatar-image"
                                     src="@_contactProfile.ProfileImageUrl"
                                     alt=""
                                     aria-hidden="true"
                                     referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <div class="account-avatar" aria-hidden="true">@ContactAvatarInitials</div>
                            }
                            <div class="account-profile-identity">
                                <span class="card-meta">@Text("Sending as", "ส่งในชื่อ")</span>
                                <h3>@ContactDisplayName</h3>
                                <p>@_contactProfile?.Email</p>
                            </div>
                        </div>
                        <div class="account-profile-details">
                            <div>
                                <span>@Text("Company", "บริษัท")</span>
                                <strong>@ContactCompanyLabel</strong>
                            </div>
                            <div>
                                <span>@Text("Mobile", "โทรศัพท์มือถือ")</span>
                                <strong>@ContactMobileLabel</strong>
                            </div>
                        </div>
                        <div>
                            <button type="button" class="button secondary" @onclick="() => _useManualContactDetails = true">
                                @Text("Use different contact details", "ใช้ข้อมูลติดต่ออื่น")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <label>@Text("Full name", "ชื่อ-นามสกุล") <InputText @bind-Value="_contact.FullName" /></label>
                    <label>@Text("Email", "อีเมล") <InputText type="email" @bind-Value="_contact.Email" /></label>
                    <label>@Text("Phone", "โทรศัพท์") <InputText @bind-Value="_contact.PhoneNumber" /></label>
                    <label>@Text("Company", "บริษัท") <InputText @bind-Value="_contact.Company" /></label>
                    @if (_contactProfile is not null)
                    {
                        <div class="wide">
                            <button type="button" class="button secondary" @onclick="() => _useManualContactDetails = false">
                                @Text("Use my profile details", "ใช้ข้อมูลโปรไฟล์ของฉัน")
                            </button>
                        </div>
                    }
                }
                <label class="wide">@Text("Subject", "หัวข้อ") <InputText @bind-Value="_contact.Subject" /></label>
                <label class="wide">@Text("Message", "ข้อความ") <InputTextArea @bind-Value="_contact.Message" /></label>
            </div>
            <div class="contact-rfq-notice">
                <span class="contact-rfq-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                </span>
                <div>
                    <strong>@Text("This form is not the RFQ workspace.", "แบบฟอร์มนี้ไม่ใช่พื้นที่ขอใบเสนอราคา")</strong>
                    <p>
                        @Text("Attach small support references here. For CAD upload, price checks, lead time, and production RFQ, use the", "แนบไฟล์อ้างอิงขนาดเล็กสำหรับงานสนับสนุนที่นี่ หากต้องอัปโหลด CAD เช็กราคา ระยะเวลา หรือขอใบเสนอราคางานผลิต ให้ใช้")
                        <a class="inline-link" href="@SiteContent.MakeStudioUrl">@Text("Make Studio", "Make Studio")</a>.
                    </p>
                </div>
            </div>
            <label class="contact-upload-panel">
                <InputFile OnChange="HandleContactFilesAsync"
                           multiple
                           accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.zip,.stl,.step,.stp,.obj,.3mf"
                           disabled="@_submittingContact" />
                <span class="contact-upload-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Medium" />
                </span>
                <span class="contact-upload-copy">
                    <strong>@Text("Attach support files", "แนบไฟล์ประกอบ")</strong>
                    <small>@Text($"Up to {MaxContactFiles} files, {MaxContactFileMegabytes} MB each. Use Make Studio for RFQ CAD packages.", $"สูงสุด {MaxContactFiles} ไฟล์ ไฟล์ละ {MaxContactFileMegabytes} MB หากเป็นชุดไฟล์ CAD เพื่อขอราคาให้ใช้ Make Studio")</small>
                </span>
            </label>
            @if (_contactFileUploads.Count > 0)
            {
                <ul class="contact-file-list" aria-label='@Text("Selected support files", "ไฟล์ประกอบที่เลือก")'>
                    @foreach (var file in _contactFileUploads)
                    {
                        <li>
                            <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                            <span class="contact-file-copy">
                                <span>@file.Summary</span>
                                <small>@Text(file.StatusTextEn, file.StatusTextTh)</small>
                            </span>
                            <span class="contact-file-progress @(file.IsIndeterminate ? "is-indeterminate" : null)"
                                  role="progressbar"
                                  aria-label='@Text($"File upload progress for {file.FileName}", $"ความคืบหน้าไฟล์ {file.FileName}")'
                                  aria-valuemin="0"
                                  aria-valuemax="100"
                                  aria-valuenow="@(file.IsIndeterminate ? null : file.Progress)">
                                <span style="width: @file.Progress%"></span>
                            </span>
                        </li>
                    }
                </ul>
            }
            @if (!string.IsNullOrWhiteSpace(_contactStatus))
            {
                <div class="@ContactStatusClass" role="@ContactStatusRole">
                    <span class="contact-status-icon" aria-hidden="true">
                        <MudIcon Icon="@ContactStatusIcon" Size="Size.Small" />
                    </span>
                    <span class="contact-status-copy">
                        <strong>@ContactStatusTitle</strong>
                        <span>@_contactStatus</span>
                    </span>
                </div>
            }
            <button class="button primary contact-submit-button" type="submit" disabled="@_submittingContact" aria-live="polite">
                @if (_submittingContact)
                {
                    <span class="button-busy-indicator" aria-hidden="true"></span>
                }
                <span>@ContactSubmitLabel</span>
            </button>
        </EditForm>
    </section>
    @if (_showContactMapDialog)
    {
        <div class="contact-map-dialog-backdrop" role="presentation" @onclick="CloseContactMapDialog">
            <section class="contact-map-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-map-dialog-title" @onclick:stopPropagation>
                <header class="contact-map-dialog-header">
                    <div class="contact-map-dialog-copy">
                        <h2 id="contact-map-dialog-title" class="contact-map-dialog-title" aria-label='@Text("MALIEV location", "ตำแหน่ง MALIEV")'>
                            @if (IsThaiCulture)
                            {
                                <span>@Text("location", "ตำแหน่ง")</span>
                                <img class="contact-map-dialog-logo" src="/images/logo.svg" alt="" aria-hidden="true" />
                            }
                            else
                            {
                                <img class="contact-map-dialog-logo" src="/images/logo.svg" alt="" aria-hidden="true" />
                                <span>@Text("location", "ตำแหน่ง")</span>
                            }
                        </h2>
                        <p>@Text("Use the larger preview for route planning, pickups, deliveries, and visitor parking.", "ใช้แผนที่ขนาดใหญ่สำหรับวางแผนเส้นทาง รับสินค้า ส่งของ และที่จอดรถผู้มาติดต่อ")</p>
                    </div>
                    <button class="contact-map-dialog-close" type="button" @onclick="CloseContactMapDialog" aria-label='@Text("Close map", "ปิดแผนที่")'>
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </header>
                <iframe class="contact-map-dialog-frame"
                        src="@MalievMapEmbedUrl"
                        title='@Text("Large Google Maps view for MALIEV", "แผนที่ Google Maps ขนาดใหญ่ของ MALIEV")'
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                <div class="contact-map-dialog-actions">
                    <a class="button primary" href="@MalievMapUrl" target="_blank" rel="noopener noreferrer">
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                        @Text("Open in Google Maps", "เปิดใน Google Maps")
                    </a>
                    <button class="button secondary" type="button" @onclick="CloseContactMapDialog">@Text("Close", "ปิด")</button>
                </div>
            </section>
        </div>
    }
}
else
{
    <section class="section text-section">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                    @if (item.Items.Count > 0)
                    {
                        <ul>
                            @foreach (var point in item.Items)
                            {
                                <li>@point.For(Preferences.Culture)</li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private readonly ContactMessageRequest _contact = new()
    {
        ContactType = "Website",
        Subject = "Manufacturing inquiry"
    };

    private const int MaxContactFiles = 5;
    private const long MaxContactFileBytes = 10 * 1024 * 1024;
    private const int MaxContactFileMegabytes = 10;
    private const int BlogPageSize = 12;
    private const string AllBlogCategoryFilter = "all";
    private const string MalievMapUrl = "https://www.google.com/maps?q=MALIEV%20Co.%2C%20Ltd.%2036%2F1%20Moo%203%20Khlong%20Khoi%20Pak%20Kret%20Nonthaburi%2011120%20Thailand";
    private const string MalievMapEmbedUrl = MalievMapUrl + "&output=embed";
    private readonly List<ContactFileUploadState> _contactFileUploads = [];
    private bool _pdfDownloading;
    private bool _submittingContact;
    private bool _showContactMapDialog;
    private string? _contactStatusTitle;
    private string? _contactStatus;
    private ContactFormStatus _contactStatusKind = ContactFormStatus.None;
    private CustomerAccountProfileDto? _contactProfile;
    private bool _useManualContactDetails;
    private bool _contactProfileLoadAttempted;
    private string Path => new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    private string CanonicalUrl => $"https://www.maliev.com/{Path}".TrimEnd('/');
    private string BlogSearch => ReadQueryStringValue("q").Trim();
    private IReadOnlyList<string> BlogCategoryKeys => NormalizeBlogCategoryKeys(ReadQueryStringValue("category"));
    private IReadOnlyList<BlogCategoryFilter> SelectedBlogCategoryFilters =>
        BlogCategoryFilters
            .Where(filter => BlogCategoryKeys.Contains(filter.Key, StringComparer.Ordinal))
            .ToList();
    private bool HasActiveBlogCategory => BlogCategoryKeys.Count > 0;
    private string BlogCategoryQueryValue => string.Join(",", BlogCategoryKeys);
    private string BlogSearchClearHref => BuildBlogHref(string.Empty, BlogCategoryKeys, 1);
    private int BlogPage
    {
        get
        {
            var rawPage = ReadQueryStringValue("page");
            return int.TryParse(rawPage, NumberStyles.Integer, CultureInfo.InvariantCulture, out var page)
                ? Math.Clamp(page, 1, TotalBlogPages)
                : 1;
        }
    }

    private IReadOnlyList<BlogPostContent> FilteredBlogPosts
    {
        get
        {
            var query = BlogSearch;
            var categories = SelectedBlogCategoryFilters;

            return SiteContent.BlogPosts
                .Where(post =>
                    (string.IsNullOrWhiteSpace(query) || BlogPostMatchesSearch(post, query))
                    && (categories.Count == 0 || categories.Any(category => BlogPostMatchesCategory(post, category))))
                .ToList();
        }
    }

    private IReadOnlyList<BlogCategoryFilter> BlogCategoryFilters =>
    [
        new(AllBlogCategoryFilter, SiteContent.Text("All", "ทั้งหมด"), []),
        new("cnc", SiteContent.Text("CNC", "CNC"), ["cnc"]),
        new("design", SiteContent.Text("Design / DFM", "ออกแบบ / DFM"), ["design", "dfm", "cad", "drawing", "enclosure", "manufacturability"]),
        new("materials", SiteContent.Text("Materials", "วัสดุ"), ["material", "materials", "pla", "petg", "abs", "asa", "nylon", "resin", "heat", "chemical", "aluminum"]),
        new("3d-printing", SiteContent.Text("3D printing", "พิมพ์ 3 มิติ"), ["3d printing", "fdm", "print", "printed", "sls", "mjf", "sla", "powder"]),
        new("resin", SiteContent.Text("Resin", "เรซิน"), ["resin", "sla", "support marks", "post-cure"]),
        new("assembly", SiteContent.Text("Fit / assembly", "ประกอบ / ฟิต"), ["assembly", "fit", "insert", "screw", "thread", "clearance", "bearing"]),
        new("finishing", SiteContent.Text("Finishing", "ผิวงาน"), ["finish", "finishing", "surface", "cosmetic", "painting", "layer lines"]),
        new("quoting", SiteContent.Text("Quoting", "ใบเสนอราคา"), ["quote", "pricing", "order", "quantity", "lead time", "acceptance"]),
        new("scanning", SiteContent.Text("Scanning", "สแกน"), ["scan", "scanning", "deviation", "measurement", "cad comparison"])
    ];

    private IReadOnlyList<BlogPostContent> PagedBlogPosts =>
        FilteredBlogPosts
            .Skip((BlogPage - 1) * BlogPageSize)
            .Take(BlogPageSize)
            .ToList();

    private int TotalBlogPages => Math.Max(1, (int)Math.Ceiling(FilteredBlogPosts.Count / (double)BlogPageSize));

    private IEnumerable<int> VisibleBlogPages
    {
        get
        {
            var start = Math.Max(1, BlogPage - 2);
            var end = Math.Min(TotalBlogPages, start + 4);
            start = Math.Max(1, end - 4);

            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    private BlogPostContent? CurrentBlogPost => Path.StartsWith("blog/", StringComparison.Ordinal)
        ? SiteContent.BlogPosts.FirstOrDefault(item => item.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase))
        : null;
    private CaseStudyContent? CurrentCaseStudy => Path.StartsWith("case-studies/", StringComparison.Ordinal)
        ? SiteContent.CaseStudies.FirstOrDefault(item => item.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase))
        : null;

    private string Title => Path switch
    {
        "contact" => Text("Contact", "ติดต่อ"),
