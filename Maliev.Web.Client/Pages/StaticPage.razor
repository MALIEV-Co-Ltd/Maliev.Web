        var path when path.StartsWith("case-studies/", StringComparison.Ordinal) => CaseStudyTitle,
        _ => Text("About MALIEV", "เกี่ยวกับ MALIEV")
    };

    private string BlogPostTitle => CurrentBlogPost?.Title.For(Preferences.Culture)
