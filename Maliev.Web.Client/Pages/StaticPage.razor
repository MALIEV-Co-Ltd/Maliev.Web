        1 => Text("Select one or two more materials.", "เลือกเพิ่มอีกหนึ่งหรือสองวัสดุ"),
        _ => Text($"{SelectedMaterialComparisons.Count} materials selected.", $"เลือกแล้ว {SelectedMaterialComparisons.Count} วัสดุ")
    };

    private string CompareMatrixStyle => $"--compare-columns: {Math.Max(SelectedMaterialComparisons.Count, 1)};";

    private bool IsMaterialSelected(MaterialComparisonItem material)
    {
        return _selectedMaterialNames.Contains(material.Name);
    }

    private bool CanToggleMaterial(MaterialComparisonItem material)
    {
        return IsMaterialSelected(material) || _selectedMaterialNames.Count < 3;
    }

    private void ToggleMaterialComparison(MaterialComparisonItem material)
    {
        if (!_selectedMaterialNames.Add(material.Name))
        {
            _selectedMaterialNames.Remove(material.Name);
        }
    }

    private void ClearMaterialComparison()
    {
        _selectedMaterialNames.Clear();
    }

    private string MaterialSelectButtonText(MaterialComparisonItem material)
    {
        if (IsMaterialSelected(material))
        {
            return Text("Selected", "เลือกแล้ว");
        }

        return _selectedMaterialNames.Count >= 3
            ? Text("Max 3", "สูงสุด 3")
            : Text("Compare", "เทียบ");
    }

    private string MaterialSelectButtonClass(MaterialComparisonItem material)
    {
        return IsMaterialSelected(material) ? "material-select-button selected" : "material-select-button";
    }

    private string MaterialSelectionCardClass(MaterialComparisonItem material)
    {
        return IsMaterialSelected(material) ? "material-mobile-card selected" : "material-mobile-card";
    }

