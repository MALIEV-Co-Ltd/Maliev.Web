@page "/about"
@page "/contact"
@page "/faq"
@page "/shipping-returns"
@page "/privacy"
@page "/terms"
@page "/materials"
@page "/industries"
@page "/case-studies"
@page "/case-studies/{Slug}"
@page "/blog"
@page "/blog/{Slug}"
@page "/account/quotes"
@page "/account/orders"
@page "/account/preferences"
@inherits PreferenceAwareComponentBase
@inject NavigationManager Navigation
@inject MalievApiClient Api

<PageTitle>@Title - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:title" content="@Title - MALIEV" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@CanonicalUrl" />
</HeadContent>

<section class="page-hero compact">
    <p class="eyebrow">@Eyebrow</p>
    <h1>@Title</h1>
    <p>@Body</p>
    <div class="quote-actions">
        <a class="button primary" href="@PrimaryHref">@PrimaryAction</a>
        <a class="button secondary" href="@SecondaryHref">@SecondaryAction</a>
    </div>
</section>

@if (Path == "materials")
{
    <section class="section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Text("Material library", "ห้องสมุดวัสดุ")</p>
                <h2>@Text("Choose by process, use case, and finishing expectation.", "เลือกจากกระบวนการ การใช้งาน และความคาดหวังเรื่องผิวงาน")</h2>
            </div>
        </div>
        <div class="material-category-grid">
            @foreach (var category in MaterialCategories)
            {
                <article class="material-category-card">
                    <div class="material-category-media">
                        <img src="@category.ImageUrl" alt="@category.ImageAlt.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="material-category-body">
                        <span class="card-meta">@category.Process</span>
                        <h3>@category.Title.For(Preferences.Culture)</h3>
                        <p>@category.Body.For(Preferences.Culture)</p>
                        <div class="material-category-tags">
                            @foreach (var highlight in category.Highlights)
                            {
                                <span class="chip">@highlight.For(Preferences.Culture)</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="section material-comparison-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Text("Material comparison", "ตารางเปรียบเทียบวัสดุ")</p>
                <h2>@Text("Compare strength, heat, chemistry, finish, and trade-offs before uploading CAD.", "เปรียบเทียบความแข็งแรง ความร้อน สารเคมี ผิวงาน และข้อแลกเปลี่ยนก่อนอัปโหลด CAD")</h2>
            </div>
            <p>@Text("Values are practical selection bands. Final material grade, orientation, finish, and test requirements are confirmed during quotation.", "ข้อมูลเป็นช่วงสำหรับเลือกวัสดุเบื้องต้น เกรด ทิศทางการผลิต ผิวงาน และข้อกำหนดการทดสอบจะยืนยันระหว่างขอราคา")</p>
        </div>

        <div class="material-comparison-panel">
            <div class="material-filter-block" aria-label="@Text("Material comparison filters", "ตัวกรองตารางเปรียบเทียบวัสดุ")">
                <div>
                    <span class="material-filter-label">@Text("Process", "กระบวนการ")</span>
                    <div class="material-filter-row">
                        @foreach (var filter in MaterialProcessFilters)
                        {
                            <button class="@MaterialFilterClass(_materialProcessFilter, filter.Key)" type="button" @onclick="() => _materialProcessFilter = filter.Key">
                                @filter.Label.For(Preferences.Culture)
                            </button>
                        }
                    </div>
                </div>
                <div>
                    <span class="material-filter-label">@Text("Use case", "การใช้งาน")</span>
                    <div class="material-filter-row">
                        @foreach (var filter in MaterialUseFilters)
                        {
                            <button class="@MaterialFilterClass(_materialUseFilter, filter.Key)" type="button" @onclick="() => _materialUseFilter = filter.Key">
                                @filter.Label.For(Preferences.Culture)
                            </button>
                        }
                    </div>
                </div>
                <span class="material-comparison-count">@Text($"{FilteredMaterialComparisons.Count} materials shown", $"แสดง {FilteredMaterialComparisons.Count} วัสดุ")</span>
            </div>

            <div class="material-compare-workbench">
                <div class="material-compare-toolbar">
                    <div>
                        <span class="material-filter-label">@Text("Direct comparison", "เปรียบเทียบโดยตรง")</span>
                        <strong>@CompareGuidance</strong>
                    </div>
                    @if (SelectedMaterialComparisons.Count > 0)
                    {
                        <button class="material-clear-selection" type="button" @onclick="ClearMaterialComparison">@Text("Clear", "ล้าง")</button>
                    }
                </div>

                @if (SelectedMaterialComparisons.Count > 0)
                {
                    <div class="material-compare-matrix" style="@CompareMatrixStyle">
                        <div class="material-compare-row material-compare-head">
                            <span>@Text("Property", "คุณสมบัติ")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <strong>
                                    @material.Name
                                    <em>@material.Process.For(Preferences.Culture)</em>
                                </strong>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Best fit", "เหมาะกับ")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.BestFor.For(Preferences.Culture)</span>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Mechanical", "เชิงกล")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.Mechanical.For(Preferences.Culture)</span>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Heat", "ความร้อน")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.Heat.For(Preferences.Culture)</span>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Chemical", "สารเคมี")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.Chemical.For(Preferences.Culture)</span>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Finish", "ผิวงาน")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.Finish.For(Preferences.Culture)</span>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Pros", "ข้อดี")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.Pros.For(Preferences.Culture)</span>
                            }
                        </div>
                        <div class="material-compare-row">
                            <span class="material-compare-label">@Text("Watch", "ระวัง")</span>
                            @foreach (var material in SelectedMaterialComparisons)
                            {
                                <span>@material.Cons.For(Preferences.Culture)</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="material-mobile-list" aria-label="@Text("Selectable material cards", "การ์ดวัสดุสำหรับเลือกเปรียบเทียบ")">
                @foreach (var material in FilteredMaterialComparisons)
                {
                    <article class="@MaterialSelectionCardClass(material)">
                        <div class="material-mobile-card-head">
                            <div>
                                <strong>@material.Name</strong>
                                <span>@material.Family.For(Preferences.Culture)</span>
                            </div>
                            <button class="@MaterialSelectButtonClass(material)" type="button" aria-pressed="@IsMaterialSelected(material)" disabled="@(!CanToggleMaterial(material))" @onclick="() => ToggleMaterialComparison(material)">
                                @MaterialSelectButtonText(material)
                            </button>
                        </div>
                        <div class="material-mobile-card-meta">
                            <span class="material-process-pill">@material.Process.For(Preferences.Culture)</span>
                            <span>@material.BestFor.For(Preferences.Culture)</span>
                        </div>
                        <dl class="material-mobile-specs">
                            <div>
                                <dt>@Text("Mechanical", "เชิงกล")</dt>
                                <dd>@material.Mechanical.For(Preferences.Culture)</dd>
                            </div>
                            <div>
                                <dt>@Text("Heat", "ความร้อน")</dt>
                                <dd>@material.Heat.For(Preferences.Culture)</dd>
                            </div>
                            <div>
                                <dt>@Text("Chemical", "สารเคมี")</dt>
                                <dd>@material.Chemical.For(Preferences.Culture)</dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>

            <div class="material-table-shell" tabindex="0" aria-label="@Text("Scrollable material comparison table", "ตารางเปรียบเทียบวัสดุแบบเลื่อนแนวนอน")">
                <table class="material-comparison-table">
                    <thead>
                        <tr>
                            <th>@Text("Compare", "เปรียบเทียบ")</th>
                            <th>@Text("Material", "วัสดุ")</th>
                            <th>@Text("Process", "กระบวนการ")</th>
                            <th>@Text("Best fit", "เหมาะกับ")</th>
                            <th>@Text("Mechanical", "เชิงกล")</th>
                            <th>@Text("Heat", "ความร้อน")</th>
                            <th>@Text("Chemical", "สารเคมี")</th>
                            <th>@Text("Finish", "ผิวงาน")</th>
                            <th>@Text("Pros / cons", "ข้อดี / ข้อจำกัด")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in FilteredMaterialComparisons)
                        {
                            <tr>
                                <td>
                                    <button class="@MaterialSelectButtonClass(material)" type="button" aria-pressed="@IsMaterialSelected(material)" disabled="@(!CanToggleMaterial(material))" @onclick="() => ToggleMaterialComparison(material)">
                                        @MaterialSelectButtonText(material)
                                    </button>
                                </td>
                                <th scope="row">
                                    <strong>@material.Name</strong>
                                    <span>@material.Family.For(Preferences.Culture)</span>
                                </th>
                                <td><span class="material-process-pill">@material.Process.For(Preferences.Culture)</span></td>
                                <td>@material.BestFor.For(Preferences.Culture)</td>
                                <td>@material.Mechanical.For(Preferences.Culture)</td>
                                <td>@material.Heat.For(Preferences.Culture)</td>
                                <td>@material.Chemical.For(Preferences.Culture)</td>
                                <td>@material.Finish.For(Preferences.Culture)</td>
                                <td>
                                    <div class="material-pro-con">
                                        <span><strong>@Text("Pro", "ข้อดี"):</strong> @material.Pros.For(Preferences.Culture)</span>
                                        <span><strong>@Text("Watch", "ระวัง"):</strong> @material.Cons.For(Preferences.Culture)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
else if (Path == "case-studies")
{
    <section class="section">
        <div class="case-grid">
            @foreach (var caseStudy in SiteContent.CaseStudies)
            {
                <a class="case-card" href="/case-studies/@caseStudy.Slug">
                    <div class="case-card-media">
                        <img src="@caseStudy.ImageUrl" alt="@caseStudy.Title.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="case-card-body">
                        <span class="card-meta">@caseStudy.Meta</span>
                        <h3>@caseStudy.Title.For(Preferences.Culture)</h3>
                        <p>@caseStudy.Summary.For(Preferences.Culture)</p>
                        <span class="card-link">@caseStudy.Stat</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
else if (Path == "blog")
{
    <section class="section">
        <div class="blog-grid">
            @foreach (var post in SiteContent.BlogPosts)
            {
                <a class="blog-card" href="/blog/@post.Slug">
                    <div class="blog-card-media">
                        <img src="@post.ImageUrl" alt="@post.Title.For(Preferences.Culture)" loading="lazy" />
                    </div>
                    <div class="blog-card-body">
                        <span class="card-meta">@post.Category.For(Preferences.Culture)</span>
                        <h3>@post.Title.For(Preferences.Culture)</h3>
                        <p>@post.Summary.For(Preferences.Culture)</p>
                        <span class="card-link">@Text("Read note", "อ่านบทความ")</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
else if (Path.StartsWith("case-studies/", StringComparison.Ordinal))
{
    <section class="section text-section">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>
}
else if (Path == "contact")
{
    <section class="section contact-layout">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
        <EditForm Model="_contact" OnValidSubmit="SubmitContactAsync" FormName="contact-form" class="contact-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <label>@Text("Full name", "ชื่อ-นามสกุล") <InputText @bind-Value="_contact.FullName" /></label>
                <label>@Text("Email", "อีเมล") <InputText type="email" @bind-Value="_contact.Email" /></label>
                <label>@Text("Phone", "โทรศัพท์") <InputText @bind-Value="_contact.PhoneNumber" /></label>
                <label>@Text("Company", "บริษัท") <InputText @bind-Value="_contact.Company" /></label>
                <label class="wide">@Text("Subject", "หัวข้อ") <InputText @bind-Value="_contact.Subject" /></label>
                <label class="wide">@Text("Message", "ข้อความ") <InputTextArea @bind-Value="_contact.Message" /></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_contactStatus))
            {
                <p class="form-status">@_contactStatus</p>
            }
            <button class="button primary" type="submit" disabled="@_submittingContact">@Text("Send message", "ส่งข้อความ")</button>
        </EditForm>
    </section>
}
else
{
    <section class="section text-section">
        <div class="content-stack">
            @foreach (var item in Sections)
            {
                <article>
                    <h2>@item.Title.For(Preferences.Culture)</h2>
                    <p>@item.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private readonly ContactMessageRequest _contact = new()
    {
        ContactType = "Website",
        Subject = "Manufacturing inquiry"
    };

    private bool _submittingContact;
    private string? _contactStatus;
    private const string AllMaterialsFilter = "all";
    private readonly HashSet<string> _selectedMaterialNames = new(StringComparer.Ordinal);
    private string _materialProcessFilter = AllMaterialsFilter;
    private string _materialUseFilter = AllMaterialsFilter;
    private string Path => new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    private string CanonicalUrl => $"https://www.maliev.com/{Path}".TrimEnd('/');

    private string Eyebrow => Path switch
    {
        "account/preferences" or "account/quotes" or "account/orders" => Text("Quote engine", "ระบบขอราคา"),
        var path when path.StartsWith("blog/", StringComparison.Ordinal) => Text("MALIEV Journal", "บทความ MALIEV"),
        var path when path.StartsWith("case-studies/", StringComparison.Ordinal) => Text("Case study", "ผลงาน"),
        "materials" => Text("Materials", "วัสดุ"),
        "case-studies" => Text("Case studies", "ผลงาน"),
        _ => "MALIEV"
    };

    private string Title => Path switch
    {
        "contact" => Text("Contact", "ติดต่อ"),
        "faq" => "FAQ",
        "shipping-returns" => Text("Shipping and returns", "การจัดส่งและการคืนสินค้า"),
        "privacy" => Text("Privacy", "ความเป็นส่วนตัว"),
        "terms" => Text("Terms", "เงื่อนไข"),
        "materials" => Text("Materials", "วัสดุ"),
        "industries" => Text("Industries", "อุตสาหกรรม"),
        "case-studies" => Text("Case studies", "ผลงาน"),
        "blog" => Text("MALIEV Journal", "บทความ MALIEV"),
        "account/quotes" => Text("Saved quotes", "ใบเสนอราคาที่บันทึกไว้"),
        "account/orders" => Text("Orders", "คำสั่งซื้อ"),
        "account/preferences" => Text("Preferences", "การตั้งค่า"),
        var path when path.StartsWith("blog/", StringComparison.Ordinal) => BlogPostTitle,
        var path when path.StartsWith("case-studies/", StringComparison.Ordinal) => CaseStudyTitle,
        _ => Text("About MALIEV", "เกี่ยวกับ MALIEV")
    };

    private string BlogPostTitle => SiteContent.BlogPosts.FirstOrDefault(item => item.Slug == Slug)?.Title.For(Preferences.Culture)
        ?? Text("Manufacturing notes from MALIEV", "บันทึกงานผลิตจาก MALIEV");

    private string CaseStudyTitle => SiteContent.CaseStudies.FirstOrDefault(item => item.Slug == Slug)?.Title.For(Preferences.Culture)
        ?? Text("MALIEV case study", "ผลงาน MALIEV");

    private string Description => Body;

    private string Body => Path switch
    {
        "contact" => Text("Send product questions, machine support issues, drawings, 3D files, or manufacturing context.", "ส่งคำถามสินค้า ปัญหาเครื่องจักร Drawing ไฟล์ 3D หรือบริบทงานผลิต"),
        "faq" => Text("Answers for product orders, custom parts, and preparing files for quotation.", "คำตอบสำหรับการสั่งซื้อสินค้า งานเฉพาะแบบ และการเตรียมไฟล์เพื่อขอราคา"),
        "shipping-returns" => Text("How MALIEV prepares, ships, and supports product orders after delivery.", "วิธีที่ MALIEV เตรียม จัดส่ง และดูแลคำสั่งซื้อหลังส่งมอบ"),
        "privacy" => Text("How MALIEV handles customer files, product orders, account preferences, and communication records.", "วิธีที่ MALIEV จัดการไฟล์ลูกค้า คำสั่งซื้อ การตั้งค่าบัญชี และประวัติการสื่อสาร"),
        "terms" => Text("Commercial terms for product orders, custom manufacturing requests, and quotation acceptance.", "เงื่อนไขการค้าสำหรับคำสั่งซื้อสินค้า งานผลิตเฉพาะแบบ และการอนุมัติใบเสนอราคา"),
        "materials" => Text("Compare materials by process, use case, finishing expectation, and quoting readiness.", "เปรียบเทียบวัสดุตามกระบวนการ การใช้งาน ผิวงาน และความพร้อมในการขอราคา"),
        "industries" => Text("MALIEV supports factories, designers, product builders, educators, and maintenance teams.", "MALIEV สนับสนุนโรงงาน นักออกแบบ ทีมพัฒนาสินค้า สถาบันการศึกษา และทีมซ่อมบำรุง"),
        "case-studies" => Text("Representative workflows for custom parts, fixtures, small-batch products, and machine support.", "ตัวอย่างเวิร์กโฟลว์สำหรับชิ้นงานเฉพาะ ฟิกซ์เจอร์ งานจำนวนน้อย และการสนับสนุนเครื่องจักร"),
        "blog" => Text("Practical notes for preparing manufacturable parts and ordering from MALIEV.", "บันทึกเชิงปฏิบัติสำหรับเตรียมชิ้นงานให้ผลิตได้และสั่งงานกับ MALIEV"),
        "account/preferences" => Text("Manage language and customer portal preferences in the quote engine.", "จัดการภาษาและการตั้งค่าพอร์ทัลลูกค้าในระบบราคา"),
        "account/quotes" => Text("Saved custom manufacturing quotes now live in the dedicated quote engine.", "ใบเสนอราคางานผลิตเฉพาะแบบอยู่ในระบบราคาโดยเฉพาะ"),
        "account/orders" => Text("Custom manufacturing orders now live in the dedicated quote engine.", "คำสั่งผลิตเฉพาะแบบอยู่ในระบบราคาโดยเฉพาะ"),
        var path when path.StartsWith("blog/", StringComparison.Ordinal) => Text("Manufacturing guidance for customers preparing custom parts and product work.", "คำแนะนำงานผลิตสำหรับลูกค้าที่เตรียมชิ้นงานเฉพาะและงานสินค้า"),
        var path when path.StartsWith("case-studies/", StringComparison.Ordinal) => Text("How MALIEV turns files, samples, and requirements into production-ready work.", "วิธีที่ MALIEV เปลี่ยนไฟล์ ตัวอย่าง และความต้องการให้เป็นงานพร้อมผลิต"),
        _ => Text("MALIEV builds manufacturing tools, machines, printed products, and custom parts from Nonthaburi, Thailand.", "MALIEV ผลิตเครื่องมือ เครื่องจักร สินค้าพิมพ์สามมิติ และชิ้นงานเฉพาะจากนนทบุรี ประเทศไทย")
    };

    private IReadOnlyList<ContentSection> Sections => Path switch
    {
        "industries" =>
        [
