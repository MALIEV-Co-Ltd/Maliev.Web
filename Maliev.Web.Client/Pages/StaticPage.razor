    private string ReadQueryStringValue(string key)
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Length <= 1)
        {
            return string.Empty;
        }

        var pairs = query[1..].Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var pair in pairs)
        {
            var separatorIndex = pair.IndexOf('=', StringComparison.Ordinal);
            var rawKey = separatorIndex >= 0 ? pair[..separatorIndex] : pair;
            if (!string.Equals(Uri.UnescapeDataString(rawKey.Replace("+", " ")), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var rawValue = separatorIndex >= 0 ? pair[(separatorIndex + 1)..] : string.Empty;
            return Uri.UnescapeDataString(rawValue.Replace("+", " "));
        }

        return string.Empty;
    }

    private async Task DownloadPdfAsync(BlogPostContent post)
    {
        if (_pdfDownloading) return;
        _pdfDownloading = true;
        var href = BuildBlogPdfHref(post);
        var filename = BuildBlogPdfFileName(post);
        await JS.InvokeVoidAsync("malievBlog.downloadFile", href, filename);
        await Task.Delay(2000);
        _pdfDownloading = false;
    }

