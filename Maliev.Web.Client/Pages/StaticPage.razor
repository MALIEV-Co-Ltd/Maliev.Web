        _ => Text("Get part price", "ดูราคาชิ้นงาน")
    };

    private string PrimaryHref => Path switch
    {
        "account/orders" => SiteContent.QuoteOrdersUrl,
        "account/preferences" => SiteContent.QuoteProfileUrl,
        _ => SiteContent.QuoteNewUrl
    };
    private string SecondaryAction => Path == "contact" ? Text("Shop products", "เลือกซื้อสินค้า") : Text("Contact MALIEV", "ติดต่อ MALIEV");
    private string SecondaryHref => Path == "contact" ? "/shop" : "/contact";

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    private async Task SubmitContactAsync()
    {
        _submittingContact = true;
        _contactStatus = null;
        try
        {
            var response = await Api.SubmitContactMessageAsync(_contact);
            _contactStatus = Text($"Message received. Reference {response.MessageId}.", $"ได้รับข้อความแล้ว เลขอ้างอิง {response.MessageId}");
        }
        catch (Exception ex)
        {
            _contactStatus = ex.Message;
        }
        finally
        {
            _submittingContact = false;
        }
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private static ContentSection Section(string titleEn, string titleTh, string bodyEn, string bodyTh)
    {
        return new ContentSection(SiteContent.Text(titleEn, titleTh), SiteContent.Text(bodyEn, bodyTh));
    }

    private sealed record ContentSection(LocalizedText Title, LocalizedText Body);

    private sealed record MaterialItem(string Name, string Process, LocalizedText Body, string ImageUrl, LocalizedText ImageAlt, IReadOnlyList<LocalizedText> Tags);
