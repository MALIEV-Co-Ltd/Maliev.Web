    private async Task LoadContactProfileAsync()
    {
        try
        {
            var session = await Api.GetAccountSessionAsync();
            if (!session.IsAuthenticated)
            {
                return;
            }

            if (string.IsNullOrWhiteSpace(_contact.FullName))
            {
                _contact.FullName = session.DisplayName;
            }

            if (string.IsNullOrWhiteSpace(_contact.Email))
            {
                _contact.Email = session.Email;
            }

            try
            {
                _contactProfile = await Api.GetAccountProfileAsync();
                _contact.FullName = string.IsNullOrWhiteSpace(_contactProfile.DisplayName)
                    ? session.DisplayName
                    : _contactProfile.DisplayName;
                _contact.Email = _contactProfile.Email;
                _contact.PhoneNumber = _contactProfile.Mobile ?? string.Empty;
                _contact.Company = _contactProfile.CompanyName ?? string.Empty;

                if (string.IsNullOrWhiteSpace(_contact.FullName) || string.IsNullOrWhiteSpace(_contact.Email))
                {
                    _useManualContactDetails = true;
                }
            }
            catch
            {
                _contactProfile = null;
            }
        }
        catch
        {
            // Session call failed; leave form at defaults
        }
    }

