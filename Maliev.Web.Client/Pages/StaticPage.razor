    private string MaterialFilterClass(string activeFilter, string filter)
    {
        return activeFilter == filter ? "material-filter active" : "material-filter";
    }

    private string PrimaryAction => Path switch
    {
        var path when path.StartsWith("account/", StringComparison.Ordinal) => Text("Open quote engine", "เปิดระบบราคา"),
        var path when IsPolicyPage(path) => Text("Contact MALIEV", "ติดต่อ MALIEV"),
        _ => Text("Get part price", "ดูราคาชิ้นงาน")
    };

    private string PrimaryHref => Path switch
    {
        var path when IsPolicyPage(path) => "/contact",
        _ => SiteContent.QuoteNewUrl
    };
    private string SecondaryAction => Path switch
    {
        "contact" => Text("Shop products", "เลือกซื้อสินค้า"),
        var path when IsPolicyPage(path) => "FAQ",
        _ => Text("Contact MALIEV", "ติดต่อ MALIEV")
    };
    private string SecondaryHref => Path switch
    {
        "contact" => "/shop",
        var path when IsPolicyPage(path) => "/faq",
        _ => "/contact"
    };

    private static bool IsPolicyPage(string path)
    {
        return path is "shipping-returns" or "privacy" or "terms" or "cookie-policy" or "refund-policy" or "warranty-policy";
    }

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    private async Task SubmitContactAsync()
    {
        _submittingContact = true;
        _contactStatus = null;
        try
        {
            var response = await Api.SubmitContactMessageAsync(_contact);
            _contactStatus = Text($"Message received. Reference {response.MessageId}.", $"ได้รับข้อความแล้ว เลขอ้างอิง {response.MessageId}");
        }
        catch (Exception ex)
        {
            _contactStatus = ex.Message;
        }
        finally
        {
            _submittingContact = false;
        }
    }

    private bool IsThaiCulture => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase);

    private string Text(string en, string th)
    {
        return IsThaiCulture ? th : en;
    }

    private static ContentSection Section(string titleEn, string titleTh, string bodyEn, string bodyTh, params (string En, string Th)[] items)
    {
        return new ContentSection(
            SiteContent.Text(titleEn, titleTh),
            SiteContent.Text(bodyEn, bodyTh),
            items.Select(item => SiteContent.Text(item.En, item.Th)).ToList());
    }

    private sealed record ContentSection(LocalizedText Title, LocalizedText Body, IReadOnlyList<LocalizedText> Items);

    private sealed record MaterialCategory(LocalizedText Title, string Process, LocalizedText Body, string ImageUrl, LocalizedText ImageAlt, IReadOnlyList<LocalizedText> Highlights);

    private sealed record MaterialFilter(string Key, LocalizedText Label);

    private sealed record MaterialComparisonItem(
        string Name,
        string ImageUrl,
        LocalizedText ImageAlt,
        string ProcessKey,
        LocalizedText Family,
        LocalizedText Process,
        LocalizedText BestFor,
        LocalizedText Mechanical,
        LocalizedText Heat,
        LocalizedText Chemical,
        LocalizedText Finish,
        LocalizedText Pros,
        LocalizedText Cons,
        IReadOnlyList<string> UseKeys);
}
