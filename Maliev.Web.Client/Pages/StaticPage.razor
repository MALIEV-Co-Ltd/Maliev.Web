    private static bool BlogPostMatchesSearch(BlogPostContent post, string query)
    {
        return ContainsSearch(post.Slug, query)
            || ContainsSearch(post.Title.En, query)
            || ContainsSearch(post.Title.Th, query)
            || ContainsSearch(post.Summary.En, query)
            || ContainsSearch(post.Summary.Th, query)
            || ContainsSearch(post.Category.En, query)
            || ContainsSearch(post.Category.Th, query)
            || post.Sections.Any(section =>
                ContainsSearch(section.Title.En, query)
                || ContainsSearch(section.Title.Th, query)
                || ContainsSearch(section.Body.En, query)
                || ContainsSearch(section.Body.Th, query));
    }

    private static bool BlogPostMatchesCategory(BlogPostContent post, BlogCategoryFilter filter)
    {
        return filter.Key == AllBlogCategoryFilter
            || filter.Terms.Any(term =>
                ContainsSearch(post.Slug, term)
                || ContainsSearch(post.Title.En, term)
                || ContainsSearch(post.Title.Th, term)
                || ContainsSearch(post.Summary.En, term)
                || ContainsSearch(post.Summary.Th, term)
                || ContainsSearch(post.Category.En, term)
                || ContainsSearch(post.Category.Th, term));
    }

    private static bool ContainsSearch(string value, string query)
    {
        return value.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string BuildBlogPageHref(int page)
    {
        var safePage = Math.Clamp(page, 1, TotalBlogPages);
        return BuildBlogHref(BlogSearch, BlogCategoryKeys, safePage);
    }

    private string BuildBlogCategoryHref(string categoryKey)
    {
        var normalizedCategoryKey = categoryKey.Trim().ToLowerInvariant();
        if (normalizedCategoryKey == AllBlogCategoryFilter)
        {
            return BuildBlogHref(BlogSearch, [], 1);
        }

        if (!BlogCategoryFilters.Any(filter => filter.Key == normalizedCategoryKey && filter.Key != AllBlogCategoryFilter))
        {
            return BuildBlogHref(BlogSearch, BlogCategoryKeys, 1);
        }

        var selectedCategoryKeys = BlogCategoryKeys.ToList();
        var existingIndex = selectedCategoryKeys.FindIndex(key => key.Equals(normalizedCategoryKey, StringComparison.Ordinal));
        if (existingIndex >= 0)
        {
            selectedCategoryKeys.RemoveAt(existingIndex);
        }
        else
        {
            selectedCategoryKeys.Add(normalizedCategoryKey);
        }

        return BuildBlogHref(BlogSearch, selectedCategoryKeys, 1);
    }

    private string BuildBlogHref(string search, IEnumerable<string> categoryKeys, int page)
    {
        var segments = new List<string>();
        var normalizedCategoryKeys = NormalizeBlogCategoryKeys(string.Join(",", categoryKeys));
        if (!string.IsNullOrWhiteSpace(search))
        {
            segments.Add($"q={Uri.EscapeDataString(search.Trim())}");
        }

        if (normalizedCategoryKeys.Count > 0)
        {
            segments.Add($"category={Uri.EscapeDataString(string.Join(",", normalizedCategoryKeys))}");
        }

        if (page > 1)
        {
            segments.Add($"page={page.ToString(CultureInfo.InvariantCulture)}");
        }

        return segments.Count == 0 ? "/blog" : $"/blog?{string.Join("&", segments)}";
    }

    private IReadOnlyList<string> NormalizeBlogCategoryKeys(string categoryKeys)
    {
        var requestedKeys = categoryKeys
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(key => key.ToLowerInvariant())
            .Where(key => key != AllBlogCategoryFilter)
            .ToHashSet(StringComparer.Ordinal);

        return BlogCategoryFilters
            .Where(filter => filter.Key != AllBlogCategoryFilter && requestedKeys.Contains(filter.Key))
            .Select(filter => filter.Key)
            .ToList();
    }

    private string BlogCategoryFilterClass(BlogCategoryFilter filter)
    {
        return BlogCategoryFilterIsActive(filter) ? "blog-category-chip is-active" : "blog-category-chip";
    }

    private bool BlogCategoryFilterIsActive(BlogCategoryFilter filter)
    {
        return filter.Key == AllBlogCategoryFilter
            ? !HasActiveBlogCategory
            : BlogCategoryKeys.Contains(filter.Key, StringComparer.Ordinal);
    }

