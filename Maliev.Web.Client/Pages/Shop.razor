@page "/shop"
@inherits PreferenceAwareComponentBase
@inject MalievApiClient Api

<PageTitle>Shop - MALIEV</PageTitle>

<section class="shop-masthead" aria-labelledby="shop-title">
    <div class="shop-masthead-copy">
        <span class="shop-masthead-rule" aria-hidden="true"></span>
        <h1 id="shop-title">@Text("Shop", "ร้านค้า")</h1>
    </div>
    <label class="shop-search">
        <span class="sr-only">@Text("Search products", "ค้นหาสินค้า")</span>
        <input type="search" @bind="_searchTerm" @bind:event="oninput" placeholder="@Text("Search product", "ค้นหาสินค้า")" />
    </label>
</section>

@if (FeaturedProduct is not null)
{
    <section class="shop-feature-band" aria-labelledby="shop-feature-title">
        <div class="shop-feature-copy">
            <span class="shop-feature-kicker">@Text("Featured · Bestseller", "สินค้าแนะนำ · ขายดี")</span>
            <h2 id="shop-feature-title">@FeaturedProduct.Title.For(Preferences.Culture)</h2>
            <p>@FeaturedProduct.Summary.For(Preferences.Culture)</p>
        </div>
        <a class="button primary shop-feature-action" href="/shop/@FeaturedProduct.Handle">
            <span>@Text("View product", "ดูสินค้า")</span>
            <span aria-hidden="true">&rarr;</span>
        </a>
    </section>
}

<section class="section shop-section" aria-label="@Text("Shop catalog", "แค็ตตาล็อกร้านค้า")">
    <aside class="shop-category-rail" aria-label="@Text("Product categories", "หมวดหมู่สินค้า")">
        <span class="shop-category-label">@Text("Category", "หมวดหมู่")</span>
        <div class="shop-category-list">
            <button class="@CollectionClass(null)" type="button" @onclick="() => SelectCollectionAsync(null)">@Text("All products", "สินค้าทั้งหมด")</button>
            @foreach (var collection in _collections)
            {
                <button class="@CollectionClass(collection.Slug)" type="button" @onclick="() => SelectCollectionAsync(collection.Slug)">
                    @if (!string.IsNullOrWhiteSpace(collection.ImageUrl))
                    {
                        <span class="shop-collection-image">
                            <img src="@collection.ImageUrl" alt="@collection.ImageAltText.For(Preferences.Culture)" loading="lazy" />
                        </span>
                    }
                    <span class="shop-collection-copy">
                        <span class="shop-collection-name">@collection.Name.For(Preferences.Culture)</span>
                        @if (!string.IsNullOrWhiteSpace(collection.Summary.For(Preferences.Culture)))
                        {
                            <span class="shop-collection-summary">@collection.Summary.For(Preferences.Culture)</span>
                        }
                    </span>
                </button>
            }
        </div>
    </aside>

    <div class="shop-catalog-stage">
        <div class="shop-catalog-intro">
            <h2>@Text("Ready-made workshop catalog", "แค็ตตาล็อกสินค้าพร้อมขาย")</h2>
            <p>@Text("Published machines, spare parts, tooling blanks, samples, and consumables appear here when inventory is ready.", "เครื่องจักร อะไหล่ ทูลลิ่ง ตัวอย่างวัสดุ และวัสดุสิ้นเปลืองจะแสดงเมื่อสินค้าพร้อมขาย")</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <p class="load-message">@_loadError</p>
        }
        else
        {
            var visibleProducts = FilteredProducts.ToList();
            @if (visibleProducts.Count == 0)
            {
                <div class="empty-state shop-empty-state">
                    <h2>@Text("No products listed yet", "ยังไม่มีสินค้า")</h2>
                    <p>@Text("New items will appear here after they are published. For custom parts, upload a model and request a manufacturing quote.", "สินค้าจะปรากฏที่นี่เมื่อพร้อมจำหน่าย หากเป็นชิ้นงานเฉพาะแบบ ให้อัปโหลดโมเดลเพื่อขอใบเสนอราคา")</p>
                    <button type="button" class="@QuoteDisabledButtonClass" disabled title="@QuoteDisabledTitle">@Text("Get part price", "ดูราคาชิ้นงาน")</button>
                </div>
            }
            else
            {
                <ProductGrid Products="@visibleProducts" FeaturedHandle="@FeaturedProduct?.Handle" />
            }
        }
    </div>
</section>

@code {
    private IReadOnlyList<ProductCollectionDto> _collections = [];
    private IReadOnlyList<ProductSummaryDto> _products = [];
    private string? _selectedCollection;
    private string? _loadError;
    private string _searchTerm = string.Empty;
    private ProductSummaryDto? FeaturedProduct => _products
        .OrderByDescending(product => product.PriceThb)
        .FirstOrDefault(product => !string.IsNullOrWhiteSpace(product.ImageUrl));

    private IEnumerable<ProductSummaryDto> FilteredProducts =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _products
            : _products.Where(product =>
                product.Title.For(Preferences.Culture).Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                product.Summary.For(Preferences.Culture).Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                product.CollectionSlug.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        try
        {
            _collections = await Api.GetCollectionsAsync();
            _products = await Api.GetProductsAsync();
        }
        catch (MalievApiException ex)
        {
            _loadError = ex.Message;
        }
    }

    private async Task SelectCollectionAsync(string? collection)
    {
        _selectedCollection = collection;
        try
        {
            _products = await Api.GetProductsAsync(collection);
            _loadError = null;
        }
        catch (MalievApiException ex)
        {
            _loadError = ex.Message;
        }
    }

    private string CollectionClass(string? collection)
    {
        return collection == _selectedCollection ? "filter-chip shop-collection-card active" : "filter-chip shop-collection-card";
    }

    private string QuoteDisabledButtonClass => "button primary is-disabled";

    private string QuoteDisabledTitle => SiteContent.QuoteDisabledTitle.For(Preferences.Culture);

    private string Price(ProductSummaryDto product)
    {
        var prefix = product.PriceStartsAt ? Text("From ", "เริ่มต้น ") : string.Empty;
        return product.PriceThb <= 0 ? Text("Request quote", "ขอใบเสนอราคา") : string.Create(CultureInfo.GetCultureInfo("th-TH"), $"{prefix}฿{product.PriceThb:N2}");
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private string InventoryStatus(string status)
    {
        return status switch
        {
            "Available" => Text("Available", "พร้อมจำหน่าย"),
            "Low stock" => Text("Low stock", "สินค้าเหลือน้อย"),
            "Made to order" => Text("Made to order", "ผลิตตามสั่ง"),
            _ => status
        };
    }
}
