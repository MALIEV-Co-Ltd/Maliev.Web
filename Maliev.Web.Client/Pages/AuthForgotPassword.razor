@page "/auth/forgot-password"
@inherits PreferenceAwareComponentBase

<PageTitle>@Text("Reset password", "รีเซ็ตรหัสผ่าน") - MALIEV</PageTitle>

<section class="auth-shell">
    <div class="auth-panel">
        <p class="eyebrow">@Text("Account recovery", "กู้คืนบัญชี")</p>
        <h1>@Text("Reset your password", "รีเซ็ตรหัสผ่าน")</h1>
        <p>@Text("Enter the customer account email. We will send reset instructions when the account exists.", "กรอกอีเมลบัญชีลูกค้า เราจะส่งขั้นตอนรีเซ็ตรหัสผ่านเมื่อมีบัญชีนี้อยู่")</p>

        @if (!string.IsNullOrWhiteSpace(Status))
        {
            <div class="auth-status">@Status</div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="auth-error">@Error</div>
        }

        <form class="auth-form" method="post" action="/auth/forgot-password">
            <AntiforgeryToken />
            <label>
                @Text("Email", "อีเมล")
                <input name="Email" type="email" autocomplete="email" required />
            </label>
            <button class="button primary" type="submit">@Text("Send reset instructions", "ส่งขั้นตอนรีเซ็ต")</button>
        </form>
        <div class="auth-links">
            <a href="/auth/sign-in">@Text("Back to sign in", "กลับไปเข้าสู่ระบบ")</a>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    private string Text(string en, string th) => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
}
