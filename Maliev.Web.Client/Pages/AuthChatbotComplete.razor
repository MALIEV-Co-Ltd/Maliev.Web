@page "/auth/chatbot-complete"
@inherits PreferenceAwareComponentBase
@inject IJSRuntime JS

<PageTitle>@Text("Sign-in complete", "เข้าสู่ระบบสำเร็จ") - MALIEV</PageTitle>

<section class="auth-shell">
    <div class="auth-panel auth-panel-compact">
        <h1>@Text("Sign-in complete", "เข้าสู่ระบบสำเร็จ")</h1>
        <p>@Text("You can return to the MALIEV assistant. This window will close automatically when the browser allows it.", "กลับไปคุยกับผู้ช่วย MALIEV ต่อได้เลยค่ะ หน้าต่างนี้จะปิดเองเมื่อเบราว์เซอร์อนุญาต")</p>
    </div>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("malievChatbot.notifyAuthenticationComplete");
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException)
        {
        }
    }

    private string Text(string en, string th) => Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
}
