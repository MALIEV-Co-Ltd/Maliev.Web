@page "/cart"
@inherits PreferenceAwareComponentBase
@inject CartState ShoppingCart
@using System.Text.Json

<PageTitle>Cart - MALIEV</PageTitle>

<section class="page-hero compact">
    <h1>@Text("Cart", "ตะกร้าสินค้า")</h1>
    <p>@Text("Review items, quantities, and estimated total before signing in to complete checkout.", "ตรวจสอบสินค้า จำนวน และยอดรวมโดยประมาณก่อนเข้าสู่ระบบเพื่อดำเนินการชำระเงิน")</p>
</section>

<section class="section cart-layout">
    @if (ShoppingCart.Items.Count == 0)
    {
        <div class="empty-state">
            <h2>@Text("Your cart is empty", "ตะกร้ายังว่าง")</h2>
            <p>@Text("Add machines, spare parts, or printed products to continue.", "เพิ่มเครื่องจักร อะไหล่ หรือสินค้าพิมพ์สามมิติเพื่อดำเนินการต่อ")</p>
            <a class="button primary" href="/shop">@Text("Shop products", "เลือกซื้อสินค้า")</a>
        </div>
    }
    else
    {
        <div class="cart-panel">
            @foreach (var item in ShoppingCart.Items)
            {
                <article class="cart-line">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="" aria-hidden="true" />
                    }
                    <div>
                        <strong>@DisplayTitle(item)</strong>
                        <span>@item.VariantTitle</span>
                    </div>
                    <input type="number" min="0" max="999" value="@item.Quantity" @onchange="args => UpdateQuantity(item, args.Value)" aria-label="@Text("Quantity", "จำนวน")" />
                    <strong>@LineTotal(item)</strong>
                    <button type="button" class="button secondary danger" @onclick="() => ShoppingCart.Remove(item)">@Text("Remove", "ลบ")</button>
                </article>
            }
        </div>

        <aside class="cart-panel cart-summary">
            <h2>@Text("Order summary", "สรุปคำสั่งซื้อ")</h2>
            <div class="quote-total">
                <div><span>@Text("Subtotal", "ยอดสินค้า")</span><strong>@FormatCurrency(Subtotal)</strong></div>
                <div><span>@Text("Shipping", "ค่าจัดส่ง")</span><strong>@Text("Calculated at checkout", "คำนวณในขั้นตอนชำระเงิน")</strong></div>
                <div class="grand-total"><span>@Text("Estimated total", "ยอดรวมโดยประมาณ")</span><strong>@FormatCurrency(Subtotal)</strong></div>
            </div>
            <form method="post" action="/web/v1/checkout/draft-form" onsubmit="return window.malievCart?.syncCheckoutForm(this) ?? true">
                <AntiforgeryToken />
                <input type="hidden" name="Culture" value="@Preferences.Culture" />
                <input type="hidden" name="ItemsJson" value="@CartItemsJson" />
                <button type="submit" class="button primary">@Text("Continue to checkout", "ดำเนินการชำระเงิน")</button>
            </form>
            @if (IsCheckoutReady)
            {
                <p class="success-message">@Text("Checkout is ready. Sign in to confirm delivery and payment.", "พร้อมดำเนินการชำระเงินแล้ว กรุณาเข้าสู่ระบบเพื่อยืนยันการจัดส่งและการชำระเงิน")</p>
            }
            @if (!string.IsNullOrWhiteSpace(CurrentError))
            {
                <p class="load-message">@CurrentError</p>
            }
        </aside>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "checkout")]
    public string? CheckoutStatus { get; set; }

    private decimal Subtotal => ShoppingCart.Items.Sum(item => item.UnitPriceThb * Math.Max(1, item.Quantity));
    private bool IsCheckoutReady => string.Equals(CheckoutStatus, "ready", StringComparison.OrdinalIgnoreCase);
    private string? CurrentError => string.Equals(CheckoutStatus, "unavailable", StringComparison.OrdinalIgnoreCase)
        ? Text("We could not prepare checkout right now. Please refresh the page or contact MALIEV.", "ไม่สามารถเตรียมการชำระเงินได้ในขณะนี้ กรุณารีเฟรชหน้าหรือติดต่อ MALIEV")
        : null;
    private string CartItemsJson => JsonSerializer.Serialize(ShoppingCart.Items);

    protected override async Task OnInitializedAsync()
    {
        await ShoppingCart.InitializeAsync();
        await Preferences.InitializeAsync();
    }

    private void UpdateQuantity(CartItemDto item, object? value)
    {
        var quantity = int.TryParse(value?.ToString(), out var parsed) ? parsed : item.Quantity;
        ShoppingCart.UpdateQuantity(item, quantity);
    }

    private static string DisplayTitle(CartItemDto item)
    {
        return string.IsNullOrWhiteSpace(item.Title) ? item.ProductHandle : item.Title;
    }

    private static string LineTotal(CartItemDto item)
    {
        return FormatCurrency(item.UnitPriceThb * Math.Max(1, item.Quantity));
    }

    private static string FormatCurrency(decimal amount)
    {
        return string.Create(CultureInfo.GetCultureInfo("th-TH"), $"฿{amount:N2}");
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }
}
