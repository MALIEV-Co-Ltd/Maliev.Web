@page "/services/{Slug}"
@inject PreferenceService Preferences

<PageTitle>@Service.SeoTitle - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="@Service.Summary.For(Preferences.Culture)" />
    <link rel="canonical" href="@CanonicalUrl" />
</HeadContent>

<section class="page-hero compact">
    <p class="eyebrow">@Text("Manufacturing services", "บริการผลิต")</p>
    <h1>@Service.Title.For(Preferences.Culture)</h1>
    <p>@Service.Summary.For(Preferences.Culture)</p>
    <div class="quote-actions">
        <a class="button primary" href="@SiteContent.QuoteNewUrl">@Text("Start quote", "เริ่มขอราคา")</a>
        <a class="button secondary" href="/services">@Text("All services", "บริการทั้งหมด")</a>
    </div>
</section>

<section class="section feature-band">
    <div class="feature-media">
        <img src="@Service.ImageUrl" alt="@Service.Title.For(Preferences.Culture)" loading="lazy" />
    </div>
    <div>
        <p class="eyebrow">@Service.Number / @Text("Capability", "ความสามารถ")</p>
        <h2 class="h-display">@Service.ProofTitle.For(Preferences.Culture)</h2>
        <p class="lede">@Service.ProofText.For(Preferences.Culture)</p>
    </div>
</section>

<section class="section" aria-labelledby="service-specs-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text("Service profile", "ข้อมูลบริการ")</p>
            <h2 id="service-specs-title">@Text("What to prepare before quotation.", "สิ่งที่ควรเตรียมก่อนขอราคา")</h2>
        </div>
        <a class="section-link" href="@SiteContent.QuoteNewUrl">@Text("Upload files", "อัปโหลดไฟล์")</a>
    </div>
    <div class="service-detail-grid">
        @for (var index = 0; index < Service.Specs.Count; index++)
        {
            <article class="workflow-step">
                <span>@((index + 1).ToString("00", CultureInfo.InvariantCulture))</span>
                <h2>@Service.Specs[index].For(Preferences.Culture)</h2>
                <p>@SpecHelp(index)</p>
            </article>
        }
    </div>
</section>

<section class="section final-cta">
    <div>
        <p class="eyebrow">@Text("Next step", "ขั้นตอนถัดไป")</p>
        <h2 class="h-display">@Text("Send the real requirement, not a vague request.", "ส่งความต้องการจริง ไม่ใช่คำขอกว้างๆ")</h2>
        <p class="lede">@Text("The fastest path is a file plus material, quantity, tolerance, finish, deadline, and the reason the part matters.", "เส้นทางที่เร็วที่สุดคือไฟล์พร้อมวัสดุ จำนวน tolerance ผิวงาน กำหนดเวลา และเหตุผลที่ชิ้นงานนี้สำคัญ")</p>
    </div>
    <a class="quote-dropzone" href="@SiteContent.QuoteNewUrl">
        <strong>@Text("Open the quote engine", "เปิดระบบขอราคา")</strong>
        <small>@Text("CAD upload, configuration, and order tracking continue at quote.maliev.com.", "อัปโหลด CAD ตั้งค่า และติดตามงานต่อที่ quote.maliev.com")</small>
        <span class="button primary">@Text("Start quote", "เริ่มขอราคา")</span>
    </a>
</section>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private ServicePageContent Service => SiteContent.GetService(Slug);
    private string CanonicalUrl => $"https://www.maliev.com/services/{Service.Slug}";

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private string SpecHelp(int index)
    {
        return index switch
        {
            0 => Text("Use this to choose the best process before spending time on drawings.", "ใช้ข้อมูลนี้เพื่อเลือกกระบวนการก่อนเสียเวลาทำแบบละเอียด"),
            1 => Text("Lead time depends on file readiness, production load, and review clarity.", "ระยะเวลาขึ้นกับความพร้อมของไฟล์ งานในคิว และความชัดเจนของข้อมูล"),
            _ => Text("Send the detail with your quote request so MALIEV can price the work correctly.", "แนบรายละเอียดนี้ในคำขอราคาเพื่อให้ MALIEV ประเมินงานได้ถูกต้อง")
        };
    }
}
