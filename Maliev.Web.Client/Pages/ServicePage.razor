@page "/services/{Slug}"
@inherits PreferenceAwareComponentBase
@inject PersistentComponentState ApplicationState

<PageTitle>@Service.SeoTitle - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="@Service.Summary.For(Preferences.Culture)" />
    <link rel="canonical" href="@CanonicalUrl" />
</HeadContent>

<section class="page-hero compact service-page-hero">
    <div class="service-page-hero-copy">
        <h1>@Service.Title.For(Preferences.Culture)</h1>
        <p>@Service.Summary.For(Preferences.Culture)</p>
        <div class="quote-actions">
            <a class="button primary" href="@SiteContent.QuoteNewUrl">@Text("Get part price", "ดูราคาชิ้นงาน")</a>
            <a class="button secondary" href="/services">@Text("All services", "บริการทั้งหมด")</a>
        </div>
    </div>
    <div class="service-page-hero-visual" aria-label="@_heroModel.AriaLabel.For(Preferences.Culture)">
        <ManufacturingGizmo Class="manufacturing-gizmo--service"
                            @key="_heroModel.Key"
                            ModelUrl="@_heroModel.Url"
                            ModelScale="@_heroModel.DisplayScale"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="@_heroModel.UsePlasticMaterial"
                            AriaLabel="@_heroModel.AriaLabel.For(Preferences.Culture)" />
    </div>
</section>

<section class="section feature-band">
    <div class="feature-media">
        <img src="@Service.ImageUrl" alt="@Service.Title.For(Preferences.Culture)" loading="lazy" />
    </div>
    <div>
        <h2 class="h-display">@Service.ProofTitle.For(Preferences.Culture)</h2>
        <p class="lede">@Service.ProofText.For(Preferences.Culture)</p>
    </div>
</section>

<section class="section service-detail-section" aria-labelledby="service-detail-title">
    <div class="section-heading service-detail-heading">
        <div>
            <h2 id="service-detail-title">@Detail.Title.For(Preferences.Culture)</h2>
            <p>@Detail.Intro.For(Preferences.Culture)</p>
        </div>
        <a class="section-link" href="@SiteContent.QuoteNewUrl">@Text("Upload files", "อัปโหลดไฟล์")</a>
    </div>

    <div class="service-brief-grid">
        <article class="service-brief-copy">
            <span class="service-detail-label">@Text("Service brief", "ภาพรวมบริการ")</span>
            <h3>@Detail.BriefTitle.For(Preferences.Culture)</h3>
            <p>@Detail.BriefBody.For(Preferences.Culture)</p>
            <div class="service-supported-files" aria-label="@Text("Supported file formats", "ประเภทไฟล์ที่รองรับ")">
                @foreach (var file in Detail.SupportedFiles)
                {
                    <span class="service-file-chip">
                        <strong>@file.Title.For(Preferences.Culture)</strong>
                        <small>@file.Body.For(Preferences.Culture)</small>
                    </span>
                }
            </div>
        </article>

        <aside class="service-checklist-panel">
            <span class="service-detail-label">@Text("Quote-ready checklist", "เช็กลิสต์ก่อนขอราคา")</span>
            <h3>@Text("Send enough context for a real manufacturing answer.", "ส่งบริบทให้พอสำหรับคำตอบงานผลิตจริง")</h3>
            <ul>
                @foreach (var item in Detail.QuoteChecklist)
                {
                    <li>@item.For(Preferences.Culture)</li>
                }
            </ul>
        </aside>
    </div>

    <section class="service-detail-block" aria-labelledby="service-materials-title">
        <div class="service-block-heading">
            <span class="service-detail-label">@Text("Materials and processes", "วัสดุและกระบวนการ")</span>
            <h3 id="service-materials-title">@Text("Available material routes for this service.", "เส้นทางวัสดุที่ใช้ได้กับบริการนี้")</h3>
        </div>
        <div class="service-material-route-grid">
            @foreach (var route in Detail.MaterialRoutes)
            {
                <article class="@MaterialRouteCardClass(route)">
                    @if (!string.IsNullOrWhiteSpace(route.ImageUrl))
                    {
                        <figure class="service-material-route-media">
                            <img src="@route.ImageUrl" alt="@MaterialRouteImageAlt(route)" loading="lazy" />
                        </figure>
                    }
                    else
                    {
                        <div class="service-detail-icon" aria-hidden="true">
                            <MudIcon Icon="@DetailIcon(route.IconKey)" Size="Size.Medium" />
                        </div>
                    }
                    <div>
                        <span>@route.Meta.For(Preferences.Culture)</span>
                        <h4>@route.Title.For(Preferences.Culture)</h4>
                        <p>@route.Body.For(Preferences.Culture)</p>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="service-detail-block" aria-labelledby="service-dfm-title">
        <div class="service-block-heading">
            <span class="service-detail-label">@Text("DFM gates", "จุดตรวจ DFM")</span>
            <h3 id="service-dfm-title">@Text("What MALIEV checks before a quotation becomes production work.", "สิ่งที่ MALIEV ตรวจ ก่อนใบเสนอราคากลายเป็นงานผลิต")</h3>
        </div>
        <div class="service-dfm-grid">
            @foreach (var gate in Detail.DfmGates)
            {
                <article class="service-dfm-card">
                    <div class="service-detail-icon" aria-hidden="true">
                        <MudIcon Icon="@DetailIcon(gate.IconKey)" Size="Size.Medium" />
                    </div>
                    <h4>@gate.Title.For(Preferences.Culture)</h4>
                    <p>@gate.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>

    <section class="service-detail-block service-ordering-block" aria-labelledby="service-ordering-title">
        <div class="service-block-heading">
            <span class="service-detail-label">@Text("Ordering workflow", "ขั้นตอนสั่งงาน")</span>
            <h3 id="service-ordering-title">@Text("How ordering with MALIEV works.", "ขั้นตอนการสั่งงานกับ MALIEV")</h3>
        </div>
        <div class="service-ordering-grid">
            @for (var index = 0; index < Detail.OrderingSteps.Count; index++)
            {
                var step = Detail.OrderingSteps[index];
                <article class="service-ordering-step">
                    <span>@((index + 1).ToString("00", CultureInfo.InvariantCulture))</span>
                    <div class="service-detail-icon" aria-hidden="true">
                        <MudIcon Icon="@DetailIcon(step.IconKey)" Size="Size.Medium" />
                    </div>
                    <h4>@step.Title.For(Preferences.Culture)</h4>
                    <p>@step.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>
</section>

<section class="section final-cta">
    <div>
        <h2 class="h-display">@Text("Send the real requirement, not a vague request.", "ส่งความต้องการจริง ไม่ใช่คำขอกว้างๆ")</h2>
        <p class="lede">@Text("The fastest path is a file plus material, quantity, tolerance, finish, deadline, and the reason the part matters.", "เส้นทางที่เร็วที่สุดคือไฟล์พร้อมวัสดุ จำนวน tolerance ผิวงาน กำหนดเวลา และเหตุผลที่ชิ้นงานนี้สำคัญ")</p>
    </div>
    <QuoteDropzone Href="@SiteContent.QuoteNewUrl"
                   Class="final-dropzone"
                   Title="@Text("Open the quote engine", "เปิดระบบราคาชิ้นงาน")"
                   Description="@Text("CAD upload, configuration, and order tracking continue at quote.maliev.com.", "อัปโหลด CAD ตั้งค่า และติดตามงานต่อที่ quote.maliev.com")"
                   ActionText="@Text("Get part price", "ดูราคาชิ้นงาน")"
                   AriaLabel="@Text("Get part price", "ดูราคาชิ้นงาน")" />
</section>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private PersistingComponentStateSubscription? _persistingSubscription;
    private HeroModelAsset _heroModel = HeroModelCatalog.Default;
    private ServicePageContent Service => SiteContent.GetService(Slug);
    private ServiceDetailProfile Detail => SiteContent.GetServiceDetail(Service.Slug);
    private string CanonicalUrl => $"https://www.maliev.com/services/{Service.Slug}";
    private string HeroModelStateKey => $"service.hero.model.{Service.Slug}";

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistHeroModel);
    }

    protected override void OnParametersSet()
    {
        InitializeHeroModel();
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private string MaterialRouteImageAlt(ServiceDetailItem route)
    {
        return $"{route.Meta.For(Preferences.Culture)} - {route.Title.For(Preferences.Culture)}";
    }

    private static string MaterialRouteCardClass(ServiceDetailItem route)
    {
        return string.IsNullOrWhiteSpace(route.ImageUrl)
            ? "service-material-route-card"
            : "service-material-route-card has-media";
    }

    private static string DetailIcon(string iconKey)
    {
        return iconKey switch
        {
            "cad" => Icons.Material.Filled.ViewInAr,
            "chemical" => Icons.Material.Filled.Science,
            "delivery" => Icons.Material.Filled.LocalShipping,
            "environment" => Icons.Material.Filled.Thermostat,
            "file" => Icons.Material.Filled.InsertDriveFile,
            "finish" => Icons.Material.Filled.AutoFixHigh,
            "fit" => Icons.Material.Filled.FactCheck,
            "mold" => Icons.Material.Filled.PrecisionManufacturing,
            "nylon" => Icons.Material.Filled.Inventory2,
            "orientation" => Icons.Material.Filled.ScreenRotationAlt,
            "price" => Icons.Material.Filled.PriceChange,
            "quantity" => Icons.Material.Filled.FormatListNumbered,
            "resin" => Icons.Material.Filled.WaterDrop,
            "review" => Icons.Material.Filled.AssignmentTurnedIn,
            "thermoplastic" => Icons.Material.Filled.Layers,
            "upload" => Icons.Material.Filled.UploadFile,
            "wall" => Icons.Material.Filled.Straighten,
            _ => Icons.Material.Filled.CheckCircle
        };
    }

    private void InitializeHeroModel()
    {
        if (ApplicationState.TryTakeFromJson<string>(HeroModelStateKey, out var modelKey) &&
            !string.IsNullOrWhiteSpace(modelKey))
        {
            _heroModel = HeroModelCatalog.Resolve(modelKey);
            return;
        }

        _heroModel = HeroModelCatalog.SelectRandomForService(Service.Slug);
    }

    private Task PersistHeroModel()
    {
        ApplicationState.PersistAsJson(HeroModelStateKey, _heroModel.Key);
        return Task.CompletedTask;
    }

    public override void Dispose()
    {
        base.Dispose();
        _persistingSubscription?.Dispose();
    }
}
