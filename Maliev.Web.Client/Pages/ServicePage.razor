@page "/services/{Slug}"
@inherits PreferenceAwareComponentBase
@inject PersistentComponentState ApplicationState

<PageTitle>@Service.SeoTitle - MALIEV</PageTitle>
<HeadContent>
    <meta name="description" content="@Service.Summary.For(Preferences.Culture)" />
    <link rel="canonical" href="@CanonicalUrl" />
</HeadContent>

<section class="page-hero compact service-page-hero">
    <div class="service-page-hero-copy">
        <h1>@Service.Title.For(Preferences.Culture)</h1>
        <p>@Service.Summary.For(Preferences.Culture)</p>
        <div class="quote-actions">
            <button type="button" class="@QuoteDisabledButtonClass" disabled title="@QuoteDisabledTitle">@Text("Get part price", "ดูราคาชิ้นงาน")</button>
            <a class="button secondary" href="/services">@Text("All services", "บริการทั้งหมด")</a>
        </div>
    </div>
    <div class="service-page-hero-visual" aria-label="@_heroModel.AriaLabel.For(Preferences.Culture)">
        <ManufacturingGizmo Class="manufacturing-gizmo--service"
                            @key="_heroModel.Key"
                            ModelUrl="@_heroModel.Url"
                            EnableHoverMotion="true"
                            UsePlasticMaterial="@_heroModel.UsePlasticMaterial"
                            AriaLabel="@_heroModel.AriaLabel.For(Preferences.Culture)" />
    </div>
</section>

<section class="section feature-band">
    <div class="feature-media">
        <img src="@Service.ImageUrl" alt="@Service.Title.For(Preferences.Culture)" loading="lazy" />
    </div>
    <div>
        <h2 class="h-display">@Service.ProofTitle.For(Preferences.Culture)</h2>
        <p class="lede">@Service.ProofText.For(Preferences.Culture)</p>
    </div>
</section>

<section class="@ServiceDetailSectionClass" aria-labelledby="service-detail-title">
    <div class="service-answer-hero">
        <div class="service-answer-hero-copy">
            <span class="service-detail-label">@Text("Manufacturing answer path", "เส้นทางคำตอบงานผลิต")</span>
            <h2 id="service-detail-title">@Detail.Title.For(Preferences.Culture)</h2>
            <p>@Detail.Intro.For(Preferences.Culture)</p>
        </div>
        <span class="section-link is-disabled" role="link" aria-disabled="true" title="@QuoteDisabledTitle">@Text("Upload files", "อัปโหลดไฟล์")</span>
    </div>

    <div class="service-answer-frame">
        <article class="service-answer-lead">
            <span class="service-detail-label">@Text("Start here", "เริ่มจากตรงนี้")</span>
            <h3>@Detail.BriefTitle.For(Preferences.Culture)</h3>
            <p>@Detail.BriefBody.For(Preferences.Culture)</p>
        </article>

        <aside class="service-answer-prep">
            <span class="service-detail-label">@Text("Send this context", "ส่งบริบทนี้")</span>
            <div class="service-supported-files" aria-label="@Text("Supported file formats and reference inputs", "ประเภทไฟล์และข้อมูลอ้างอิงที่รองรับ")">
                @foreach (var file in Detail.SupportedFiles)
                {
                    <span class="service-file-chip">
                        <strong>@file.Title.For(Preferences.Culture)</strong>
                        <small>@file.Body.For(Preferences.Culture)</small>
                    </span>
                }
            </div>
            <ul class="service-answer-checklist">
                @foreach (var item in Detail.QuoteChecklist)
                {
                    <li>@item.For(Preferences.Culture)</li>
                }
            </ul>
        </aside>
    </div>

    <section class="service-answer-block service-answer-block--routes" aria-labelledby="service-routes-title">
        <div class="service-answer-block-copy">
            <span class="service-detail-label">@Text("Route selection", "การเลือกเส้นทางผลิต")</span>
            <h3 id="service-routes-title">@Text("We narrow the process from the part's job, not from a generic menu.", "เราเลือกกระบวนการจากหน้าที่ของชิ้นงาน ไม่ใช่เมนูทั่วไป")</h3>
            <p>@Text("These are the routes customers usually compare before quotation. The final choice still depends on geometry, quantity, finish, tolerance, and risk.", "นี่คือเส้นทางที่ลูกค้ามักเปรียบเทียบก่อนเสนอราคา การเลือกสุดท้ายยังขึ้นกับ Geometry จำนวน ผิวงาน tolerance และความเสี่ยง")</p>
        </div>
        <div class="service-answer-card-grid service-answer-card-grid--routes">
            @foreach (var route in Detail.MaterialRoutes)
            {
                <article class="service-answer-card">
                    <div>
                        <span class="service-answer-meta">@route.Meta.For(Preferences.Culture)</span>
                        <h4>@route.Title.For(Preferences.Culture)</h4>
                        <p>@route.Body.For(Preferences.Culture)</p>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="service-answer-block service-answer-block--checks" aria-labelledby="service-checks-title">
        <div class="service-answer-block-copy">
            <span class="service-detail-label">@Text("Before quotation", "ก่อนเสนอราคา")</span>
            <h3 id="service-checks-title">@Text("The review explains what can be made, what must change, and what needs customer confirmation.", "การตรวจจะบอกว่าสิ่งใดผลิตได้ สิ่งใดควรแก้ และสิ่งใดต้องให้ลูกค้ายืนยัน")</h3>
        </div>
        <div class="service-answer-card-grid service-answer-card-grid--checks">
            @foreach (var gate in Detail.DfmGates)
            {
                <article class="service-answer-card service-answer-card--check">
                    <h4>@gate.Title.For(Preferences.Culture)</h4>
                    <p>@gate.Body.For(Preferences.Culture)</p>
                </article>
            }
        </div>
    </section>

    <section class="service-answer-block service-answer-block--steps" aria-labelledby="service-steps-title">
        <div class="service-answer-block-copy">
            <span class="service-detail-label">@Text("From file to order", "จากไฟล์สู่งานสั่งผลิต")</span>
            <h3 id="service-steps-title">@Text("Customers can follow the path without guessing what happens after upload.", "ลูกค้าตามขั้นตอนได้โดยไม่ต้องเดาว่าหลังอัปโหลดเกิดอะไรขึ้น")</h3>
        </div>
        <ol class="service-answer-steps">
            @for (var index = 0; index < Detail.OrderingSteps.Count; index++)
            {
                var step = Detail.OrderingSteps[index];
                <li class="service-answer-step">
                    <span class="service-answer-step-number">@((index + 1).ToString("00", CultureInfo.InvariantCulture))</span>
                    <div>
                        <h4>@step.Title.For(Preferences.Culture)</h4>
                        <p>@step.Body.For(Preferences.Culture)</p>
                    </div>
                </li>
            }
        </ol>
    </section>
</section>

<section class="section final-cta">
    <div>
        <h2 class="h-display">@Text("Send the real requirement, not a vague request.", "ส่งความต้องการจริง ไม่ใช่คำขอกว้างๆ")</h2>
        <p class="lede">@Text("The fastest path is a file plus material, quantity, tolerance, finish, deadline, and the reason the part matters.", "เส้นทางที่เร็วที่สุดคือไฟล์พร้อมวัสดุ จำนวน tolerance ผิวงาน กำหนดเวลา และเหตุผลที่ชิ้นงานนี้สำคัญ")</p>
    </div>
    <QuoteDropzone Href="@SiteContent.QuoteNewProjectUrl"
                   Class="final-dropzone"
                   Title="@Text("Open the quote engine", "เปิดระบบราคาชิ้นงาน")"
                   Description="@Text("CAD upload, configuration, and order tracking continue at quote.maliev.com.", "อัปโหลด CAD ตั้งค่า และติดตามงานต่อที่ quote.maliev.com")"
                   ActionText="@Text("Get part price", "ดูราคาชิ้นงาน")"
                   Disabled="@SiteContent.QuoteEntryDisabled"
                   DisabledText="@QuoteDropzoneDisabledText"
                   FormatsButtonText="@Text("Supported formats", "ไฟล์ที่รองรับ")"
                   FormatsPanelLabel="@Text("Supported QuoteEngine file formats", "รายการไฟล์ที่ QuoteEngine รองรับ")"
                   AriaLabel="@Text("Get part price", "ดูราคาชิ้นงาน")" />
</section>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private PersistingComponentStateSubscription? _persistingSubscription;
    private HeroModelAsset _heroModel = HeroModelCatalog.Default;
    private ServicePageContent Service => SiteContent.GetService(Slug);
    private ServiceDetailProfile Detail => SiteContent.GetServiceDetail(Service.Slug);
    private string CanonicalUrl => $"https://www.maliev.com/services/{Service.Slug}";
    private string HeroModelStateKey => $"service.hero.model.{Service.Slug}";
    private string ServiceDetailSectionClass => $"section service-detail-section service-detail-section--{Service.Slug}";
    private string QuoteDisabledButtonClass => "button primary is-disabled";
    private string QuoteDisabledTitle => SiteContent.QuoteDisabledTitle.For(Preferences.Culture);
    private string QuoteDropzoneDisabledText => SiteContent.QuoteDisabledAction.For(Preferences.Culture);

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistHeroModel);
    }

    protected override void OnParametersSet()
    {
        InitializeHeroModel();
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private void InitializeHeroModel()
    {
        if (ApplicationState.TryTakeFromJson<string>(HeroModelStateKey, out var modelKey) &&
            !string.IsNullOrWhiteSpace(modelKey))
        {
            _heroModel = HeroModelCatalog.Resolve(modelKey);
            return;
        }

        _heroModel = HeroModelCatalog.SelectRandomForService(Service.Slug);
    }

    private Task PersistHeroModel()
    {
        ApplicationState.PersistAsJson(HeroModelStateKey, _heroModel.Key);
        return Task.CompletedTask;
    }

    public override void Dispose()
    {
        base.Dispose();
        _persistingSubscription?.Dispose();
    }
}
