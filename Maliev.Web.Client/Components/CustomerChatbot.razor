    private IReadOnlyList<CustomerChatAction> MapResponseActions(IReadOnlyList<CustomerChatbotActionDto> actions)
    {
        if (actions.Count == 0)
        {
            return [];
        }

        return actions
            .Select(action =>
            {
                if (string.Equals(action.Action, ChatActionSignIn, StringComparison.OrdinalIgnoreCase))
                {
                    return CreateSignInAction();
                }

                var href = ResolveResponseActionHref(action);
                return string.IsNullOrWhiteSpace(href)
                    ? null
                    : CreateLinkAction(action.Label, href, Icons.Material.Filled.OpenInNew, false);
            })
            .Where(action => action is not null)
            .Select(action => action!)
            .ToList();
    }

    private static CustomerChatAction CreateLinkAction(string label, string href, string icon, bool primary)
    {
        var target = IsInternalHref(href) ? null : "_blank";
        var rel = target is null ? null : "noopener";
        return new CustomerChatAction(label, ChatActionLink, href, target, rel, icon, primary);
    }

    private static string? ResolveResponseActionHref(CustomerChatbotActionDto action)
    {
        var actionType = CleanOneLine(action.Action, 80)?.ToLowerInvariant() ?? string.Empty;
        return actionType switch
        {
            ChatActionViewServices => ResolveServicesHref(action.Data),
            ChatActionContact => "/contact",
            ChatActionRequestQuote => SiteContent.QuoteNewUrl,
            _ => TryNormalizeExplicitHref(action.Data)
        };
    }

    private static string ResolveServicesHref(string? data)
    {
        var slug = (CleanOneLine(data, 120) ?? string.Empty)
            .Replace('_', '-')
            .ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(slug) || slug is "all" or "general" or "services")
        {
            return "/services";
        }

        return SiteContent.Services.Any(service => service.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase))
            ? $"/services/{slug}"
            : "/services";
    }

    private static string? TryNormalizeExplicitHref(string? href)
    {
        var cleaned = CleanOneLine(href, 2048);
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return null;
        }

        if (cleaned.StartsWith("/", StringComparison.Ordinal) && !cleaned.StartsWith("//", StringComparison.Ordinal))
        {
            return cleaned;
        }

        return Uri.TryCreate(cleaned, UriKind.Absolute, out var uri)
            && uri.Scheme is "http" or "https" or "mailto" or "tel"
            ? uri.ToString()
            : null;
    }

    private static bool IsInternalHref(string href)
    {
        return href.StartsWith("/", StringComparison.Ordinal) && !href.StartsWith("//", StringComparison.Ordinal);
    }

