    private void BeginPendingState(bool isStartingSession)
    {
        CancelPendingDelay();
        _isSending = true;
        _isStartingSession = isStartingSession;
        _isWaitingLong = false;
        var operationId = Interlocked.Increment(ref _pendingOperationId);
        var cts = new CancellationTokenSource();
        _pendingDelayCts = cts;
        _ = ShowLongWaitingStateAsync(operationId, cts.Token);
    }

    private void EndPendingState()
    {
        CancelPendingDelay();
        _isSending = false;
        _isStartingSession = false;
        _isWaitingLong = false;
    }

    private async Task ShowLongWaitingStateAsync(long operationId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(AssistantWaitingDelay, cancellationToken);
            if (cancellationToken.IsCancellationRequested || operationId != _pendingOperationId || !_isSending)
            {
                return;
            }

            _isWaitingLong = true;
            QueueMessageScroll(true);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelPendingDelay()
    {
        _pendingDelayCts?.Cancel();
        _pendingDelayCts?.Dispose();
        _pendingDelayCts = null;
    }

    private static CustomerChatbotMemory NormalizeMemory(CustomerChatbotMemory memory)
    {
        memory.Name = CleanOneLine(memory.Name, 80);
        memory.Email = CleanOneLine(memory.Email, 120);
        memory.Company = CleanOneLine(memory.Company, 120);
        memory.Addresses = NormalizeList(memory.Addresses, MaxStoredItems, 180);
        memory.ServiceInterests = NormalizeList(memory.ServiceInterests, MaxStoredItems, 80);
        memory.Preferences = NormalizeList(memory.Preferences, MaxStoredItems, 100);
        memory.Messages = memory.Messages
            .Where(message => !string.IsNullOrWhiteSpace(message.Content))
            .Select(message => new StoredChatMessage
            {
                Role = string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase) ? "user" : "assistant",
                Content = CleanMultiline(message.Content, 1400)
            })
            .Where(message => !IsGeneratedGreeting(message))
            .TakeLast(MaxStoredMessages)
            .ToList();
        memory.UnreadCount = Math.Clamp(memory.UnreadCount, 0, 99);
        return memory;
    }

    private static List<string> NormalizeList(IEnumerable<string>? values, int limit, int maxLength)
    {
        return (values ?? [])
            .Select(value => CleanOneLine(value, maxLength))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(limit)
            .ToList();
    }

    private static void AddDistinct(List<string> list, string value, int limit, int maxLength)
    {
        var cleaned = CleanOneLine(value, maxLength);
        if (string.IsNullOrWhiteSpace(cleaned) || list.Any(item => string.Equals(item, cleaned, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        list.Insert(0, cleaned);
        if (list.Count > limit)
        {
            list.RemoveRange(limit, list.Count - limit);
        }
    }

    private static string? MatchFirst(string input, params string[] patterns)
    {
        foreach (var pattern in patterns)
        {
            var match = Regex.Match(input, pattern, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
            if (match.Success)
            {
                return CleanOneLine(match.Groups[1].Value, 80);
            }
        }

        return null;
    }

    private static string BuildStorageKey(CustomerChatbotIdentity identity)
    {
        if (!identity.IsAuthenticated || string.IsNullOrWhiteSpace(identity.UserKey))
        {
            return $"{PersonalizationStoragePrefix}:guest";
        }

        return $"{PersonalizationStoragePrefix}:{Uri.EscapeDataString(identity.UserKey.ToLowerInvariant())}";
    }

    private string? GetPersonalGreetingName(CustomerChatbotIdentity identity)
    {
        return FirstNonEmpty(_memory.Name, identity.DisplayName, identity.Email);
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        return values.Select(value => CleanOneLine(value, 120)).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
    }

    private static string JoinName(string firstName, string lastName)
    {
        return CleanOneLine($"{firstName} {lastName}", 100) ?? string.Empty;
    }

    private static string FormatAddress(CustomerAddressDto address)
    {
        return string.Join(", ", new[]
        {
            address.RecipientName,
            address.AddressLine1,
            address.AddressLine2,
            address.AddressLine3,
            address.District,
            address.City,
            address.StateProvince,
            address.PostalCode
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private string FormatAddressPreview(IReadOnlyList<CustomerAddressDto> addresses)
    {
        var defaults = addresses
            .Where(address => address.IsDefault)
            .Select(address => $"{address.Type}: {FormatAddress(address)}")
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Take(2)
            .ToList();
        if (defaults.Count > 0)
        {
            return Text(
                $"Default address preview: {string.Join(" / ", defaults)}",
                $"ตัวอย่างที่อยู่หลัก: {string.Join(" / ", defaults)}");
        }

        var first = FormatAddress(addresses[0]);
        return string.IsNullOrWhiteSpace(first)
            ? string.Empty
            : Text($"First saved address: {first}", $"ที่อยู่รายการแรก: {first}");
    }

    private string BuildProfileSummary(CustomerAccountProfileDto profile)
    {
        var lines = new List<string>();
        AddMarkdownLine(lines, Text("Name", "ชื่อ"), FirstNonEmpty(profile.DisplayName, JoinName(profile.FirstName, profile.LastName)));
        AddMarkdownLine(lines, Text("Email", "อีเมล"), profile.Email);
        AddMarkdownLine(lines, Text("Phone", "โทรศัพท์"), profile.Mobile);
        AddMarkdownLine(lines, Text("Company", "บริษัท"), profile.CompanyName);
        AddMarkdownLine(lines, Text("Preferred language", "ภาษาที่ใช้"), profile.PreferredLanguage);
        return lines.Count == 0
            ? Text("No profile details are available yet.", "ยังไม่มีรายละเอียดโปรไฟล์ค่ะ")
            : string.Join("\n", lines);
    }

    private string BuildOrderSummary(CustomerOrdersResponse? orders)
    {
        if (orders is null)
        {
            return Text(
                "Account order data is temporarily unavailable. You can still open the account area or Quote Engine.",
                "ข้อมูลคำสั่งซื้อยังไม่พร้อมใช้งานชั่วคราว แต่ยังเปิดหน้าบัญชีหรือระบบราคาได้ค่ะ");
        }

        if (orders.ShopOrders.Count == 0)
        {
            return Text(
                "I do not see storefront shop orders in this Web account yet. Manufacturing quotes, receipts, and production orders are available from the Quote Engine.",
                "ยังไม่พบคำสั่งซื้อร้านค้าในบัญชี Web นี้ค่ะ ใบเสนอราคา ใบเสร็จ และคำสั่งผลิตอยู่ในระบบราคาค่ะ");
        }

        var latest = orders.ShopOrders
            .OrderByDescending(order => order.CreatedAt)
            .First();
        return Text(
            $"I found {orders.ShopOrders.Count} storefront order{(orders.ShopOrders.Count == 1 ? string.Empty : "s")}. Latest: **{latest.OrderNumber}** ({latest.Status}). Manufacturing quotes, receipts, and production orders stay in the Quote Engine.",
            $"พบคำสั่งซื้อร้านค้า {orders.ShopOrders.Count} รายการค่ะ ล่าสุด: **{latest.OrderNumber}** ({latest.Status}) ส่วนใบเสนอราคา ใบเสร็จ และคำสั่งผลิตอยู่ในระบบราคาค่ะ");
    }

    private static void AddMarkdownLine(List<string> lines, string label, string? value)
    {
        var cleaned = CleanOneLine(value, 180);
        if (!string.IsNullOrWhiteSpace(cleaned))
        {
            lines.Add($"- **{label}:** {cleaned}");
        }
    }

    private static void AddContextPart(List<string> parts, string label, string? value)
    {
        var cleaned = CleanOneLine(value, 220);
        if (!string.IsNullOrWhiteSpace(cleaned))
        {
            parts.Add($"{label}: {cleaned}");
        }
    }

    private static string? JoinList(IEnumerable<string> values)
    {
        var joined = string.Join("; ", values.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(joined) ? null : joined;
    }

    private static string? CleanOneLine(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var cleaned = string.Join(" ", value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries))
            .Replace("\u0000", string.Empty, StringComparison.Ordinal)
            .Trim();
        return cleaned.Length > maxLength ? cleaned[..maxLength].Trim() : cleaned;
    }

    private static string CleanMultiline(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var cleaned = new string(value.Where(ch => !char.IsControl(ch) || ch is '\r' or '\n' or '\t').ToArray()).Trim();
        return cleaned.Length > maxLength ? cleaned[..maxLength].Trim() : cleaned;
    }

