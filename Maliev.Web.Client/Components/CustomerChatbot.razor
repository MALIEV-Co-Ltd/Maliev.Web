    private async Task<CustomerChatbotIdentity> ResolveFreshIdentityAsync()
    {
        var browserIdentity = await ResolveBrowserSessionIdentityAsync();
        return browserIdentity.IsAuthenticated ? browserIdentity : await ResolveIdentityAsync();
    }

    private async Task<CustomerChatbotIdentity> ResolveBrowserSessionIdentityAsync()
    {
        var session = await ReadBrowserJsonAsync<CustomerAccountSessionDto>("/web/v1/account/session");
        if (session?.IsAuthenticated != true)
        {
            return new CustomerChatbotIdentity(false, null, null, null);
        }

        var key = session.CustomerId?.ToString("D")
            ?? session.PrincipalId?.ToString("D")
            ?? session.Email;
        return new CustomerChatbotIdentity(
            true,
            CleanOneLine(key, 140),
            CleanOneLine(session.DisplayName, 80),
            CleanOneLine(session.Email, 120));
    }

    private async Task<CustomerChatbotIdentity> ResolveIdentityAsync()
    {
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated != true)
            {
                return new CustomerChatbotIdentity(false, null, null, null);
            }

            var email = CleanOneLine(user.FindFirstValue(ClaimTypes.Email) ?? user.FindFirstValue("email"), 120);
            var displayName = CleanOneLine(
                user.FindFirstValue(ClaimTypes.Name)
                ?? user.FindFirstValue("name")
                ?? user.FindFirstValue("given_name")
                ?? email,
                80);
            var key = user.FindFirstValue("customer_id")
                ?? user.FindFirstValue("principal_id")
                ?? user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? email;

            return new CustomerChatbotIdentity(true, CleanOneLine(key, 140), displayName, email);
        }
        catch (InvalidOperationException)
        {
            return new CustomerChatbotIdentity(false, null, null, null);
        }
    }

