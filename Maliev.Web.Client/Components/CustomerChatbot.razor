@using Ganss.Xss
@using Markdig
@using System.Security.Claims
@using System.Text.Json
@using System.Text.RegularExpressions
@implements IDisposable
@inject MalievApiClient ApiClient
@inject PreferenceService Preferences
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<aside class="customer-chatbot" aria-label="@Text("Customer manufacturing assistant", "ผู้ช่วยงานผลิตสำหรับลูกค้า")">
    @if (_isOpen)
    {
        <section class="customer-chatbot-panel" aria-live="polite">
            <header class="customer-chatbot-header">
                <div class="customer-chatbot-profile">
                    <span class="customer-chatbot-gemini-icon" aria-hidden="true">
                        <img src="/images/gemini-icon.svg" alt="" />
                    </span>
                    <div class="customer-chatbot-title">
                        <span>@Text("MALIEV manufacturing assistant", "ผู้ช่วยงานผลิต MALIEV")</span>
                        <small>@Text("Materials, quotes, orders, and delivery", "วัสดุ ใบเสนอราคา คำสั่งซื้อ และการจัดส่ง")</small>
                    </div>
                </div>
                <div class="customer-chatbot-header-actions">
                    <button type="button"
                            class="customer-chatbot-reset"
                            aria-label="@Text("Reset chat", "รีเซ็ตแชท")"
                            title="@Text("Reset chat", "รีเซ็ตแชท")"
                            @onclick="ResetChatAsync"
                            disabled="@_isSending">
                        <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" />
                    </button>
                    <button type="button" class="customer-chatbot-close" aria-label="@Text("Close chat", "ปิดแชท")" @onclick="ToggleOpenAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            </header>

            <div class="customer-chatbot-messages-wrap">
                <div class="customer-chatbot-messages" @ref="_messagesContainer" @onscroll="OnMessagesScrolledAsync">
                    @foreach (var message in _messages)
                    {
                        <div class="@MessageClass(message.Role)">
                            <div class="customer-chatbot-message-rich">
                                @RenderMessageContent(message.Content)
                            </div>
                            @if (message.Actions.Count > 0)
                            {
                                <div class="customer-chatbot-actions">
                                    @foreach (var action in message.Actions)
                                    {
                                        var actionClass = ActionClass(action);
                                        if (string.Equals(action.Kind, ChatActionSignInGoogle, StringComparison.Ordinal))
                                        {
                                            <button type="button" class="auth-google customer-chatbot-auth-google" @onclick="BeginGoogleChatSignInAsync" disabled="@_isAwaitingSignIn">
                                                <span class="auth-google-icon" aria-hidden="true">
                                                    <svg viewBox="0 0 18 18" focusable="false">
                                                        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.08-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.87 2.69-6.62z" />
                                                        <path fill="#34A853" d="M9 18c2.43 0 4.47-.81 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.33C2.44 15.98 5.48 18 9 18z" />
                                                        <path fill="#FBBC05" d="M3.96 10.71A5.41 5.41 0 0 1 3.68 9c0-.59.1-1.17.28-1.71V4.96H.96A8.96 8.96 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3-2.33z" />
                                                        <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l3 2.33C4.67 5.16 6.66 3.58 9 3.58z" />
                                                    </svg>
                                                </span>
                                                <span>@action.Label</span>
                                            </button>
                                        }
                                        else if (string.Equals(action.Kind, ChatActionSignInEmail, StringComparison.Ordinal)
                                            || string.Equals(action.Kind, ChatActionSignIn, StringComparison.Ordinal))
                                        {
                                            <button type="button" class="customer-chatbot-auth-email" @onclick="BeginEmailChatSignInAsync" disabled="@_isAwaitingSignIn">
                                                <MudIcon Icon="@action.Icon" Size="Size.Small" />
                                                <span>@action.Label</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="@actionClass" href="@action.Href" target="@action.Target" rel="@action.Rel">
                                                <MudIcon Icon="@action.Icon" Size="Size.Small" />
                                                <span>@action.Label</span>
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_isSending)
                    {
                        <div class="customer-chatbot-message assistant pending">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    }
                </div>

                @if (_showJumpToLatest)
                {
                    <button type="button" class="customer-chatbot-jump-latest" aria-label="@Text("Jump to latest message", "ไปยังข้อความล่าสุด")" @onclick="JumpToLatestAsync">
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                        <span class="customer-chatbot-jump-badge">@LatestUnreadBadgeText</span>
                    </button>
                }
            </div>

            <div class="customer-chatbot-prompts" aria-label="@Text("Suggested topics", "หัวข้อแนะนำ")">
                @foreach (var prompt in SuggestedPrompts)
                {
                    <button type="button" @onclick="() => SendSuggestionAsync(prompt.Value.For(Preferences.Culture))" disabled="@(!CanInteract)">
                        @prompt.Label.For(Preferences.Culture)
                    </button>
                }
            </div>

            <div class="customer-chatbot-composer">
                <textarea @ref="_draftInput"
                          rows="1"
                          maxlength="1000"
                          placeholder="@Text("Ask about materials, quotes, or delivery", "ถามเรื่องวัสดุ ราคา หรือจัดส่ง")"
                          value="@_draft"
                          @oninput="OnDraftInputAsync"
                          disabled="@(!CanInteract)"></textarea>
                <button @ref="_sendButton" type="button" aria-label="@Text("Send message", "ส่งข้อความ")" @onclick="SendDraftAsync" disabled="@(!CanSend)">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                </button>
            </div>
        </section>
    }
    else if (_showPopout)
    {
        <button type="button" class="customer-chatbot-popout" @onclick="OpenFromPopoutAsync">
            <strong>@Text("MALIEV assistant", "ผู้ช่วย MALIEV")</strong>
            <span>@_popoutMessage</span>
        </button>
    }

    <button type="button"
            class="@ToggleButtonClass"
            aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
            aria-label="@Text("Open customer manufacturing assistant", "เปิดผู้ช่วยงานผลิตสำหรับลูกค้า")"
            @onclick="ToggleOpenAsync">
        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Medium" />
        @if (_unreadCount > 0)
        {
            <span class="customer-chatbot-unread-badge" aria-label="@UnreadBadgeAriaLabel">@UnreadBadgeText</span>
        }
    </button>
</aside>

@code {
    private const string PersonalizationStoragePrefix = "maliev.chatbot.personalization.v1";
    private const string SharedSessionStorageKey = "maliev.customerAssistant.session.v1";
    private const string ChatbotCompleteReturnUrl = "/auth/chatbot-complete";
    private const string ChatActionSignIn = "signin";
    private const string ChatActionSignInGoogle = "signin-google";
    private const string ChatActionSignInEmail = "signin-email";
    private const string ChatActionLink = "link";
    private const string ChatActionViewServices = "view_services";
    private const string ChatActionContact = "contact";
    private const string ChatActionRequestQuote = "request_quote";
    private const int MaxStoredMessages = 24;
    private const int MaxStoredItems = 6;
    private const int SignInPollAttempts = 60;
    private static readonly TimeSpan SignInPollInterval = TimeSpan.FromSeconds(2);
    private static readonly JsonSerializerOptions StorageJson = new(JsonSerializerDefaults.Web);
    private static readonly Regex DangerousHtmlBlockPattern = new(
        @"<\s*(script|style|iframe|object|embed|svg|math)\b[^>]*>.*?<\s*/\s*\1\s*>",
        RegexOptions.IgnoreCase | RegexOptions.Singleline | RegexOptions.Compiled);
    private static readonly Regex DangerousHtmlTagPattern = new(
        @"<\s*/?\s*(script|style|iframe|object|embed|svg|math)\b[^>]*>",
        RegexOptions.IgnoreCase | RegexOptions.Compiled);
    private static readonly MarkdownPipeline MessageMarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();
    private static readonly HtmlSanitizer MessageHtmlSanitizer = CreateMessageHtmlSanitizer();
    private static readonly string[] AccountSensitiveTerms =
    [
        "my order", "my orders", "order status", "track order", "my quote", "my quotes", "quote status",
        "receipt", "invoice", "tax invoice", "payment", "profile", "my profile", "personal information",
        "personal info", "my account", "address book", "my address", "shipping address", "billing address",
        "update address", "change address", "delivery address", "คำสั่งซื้อของฉัน", "คำสั่งซื้อ", "ติดตามงาน",
        "ใบเสนอราคาของฉัน", "ใบเสนอราคา", "ใบเสร็จ", "ใบกำกับภาษี", "บัญชีของฉัน", "โปรไฟล์",
        "ข้อมูลส่วนตัว", "ที่อยู่ของฉัน", "เปลี่ยนที่อยู่", "แก้ไขที่อยู่", "ที่อยู่จัดส่ง", "ที่อยู่ออกบิล"
    ];
    private static readonly string[] ProfileIntentTerms =
    [
        "profile", "personal information", "personal info", "my account", "email", "phone", "company",
        "โปรไฟล์", "ข้อมูลส่วนตัว", "บัญชีของฉัน", "อีเมล", "โทร", "บริษัท"
    ];
    private static readonly string[] AddressIntentTerms =
    [
        "address", "address book", "shipping address", "billing address", "update address", "change address",
        "delivery address", "ที่อยู่", "ที่อยู่จัดส่ง", "ที่อยู่ออกบิล", "เปลี่ยนที่อยู่", "แก้ไขที่อยู่"
    ];
    private static readonly string[] OrderIntentTerms =
    [
        "order", "orders", "order status", "track order", "receipt", "invoice", "tax invoice", "payment",
        "quote", "quotes", "quotation", "คำสั่งซื้อ", "ติดตามงาน", "ใบเสร็จ", "ใบกำกับภาษี", "ใบเสนอราคา", "การชำระเงิน"
    ];

    private readonly List<CustomerChatMessage> _messages = [];
    private CustomerChatbotMemory _memory = new();
    private CustomerChatbotIdentity _identity = new(false, null, null, null);
    private ElementReference _draftInput;
    private ElementReference _sendButton;
    private ElementReference _messagesContainer;
    private Guid? _sessionId;
    private string _draft = string.Empty;
    private string _storageKey = $"{PersonalizationStoragePrefix}:guest";
    private string _popoutMessage = string.Empty;
    private bool _isOpen;
    private bool _isSending;
    private bool _storageReady;
    private bool _showPopout;
    private bool _composerResizePending;
    private bool _messageScrollPending;
    private bool _messageScrollSmooth;
    private bool _showJumpToLatest;
    private bool _isAwaitingSignIn;
    private int _unreadCount;
    private int _latestUnreadCount;
    private CancellationTokenSource? _popoutCts;
    private CancellationTokenSource? _signInPollCts;

    private bool CanInteract => !_isSending && _sessionId.HasValue;
    private bool CanSend => CanInteract && !string.IsNullOrWhiteSpace(_draft);
    private string ToggleButtonClass => _unreadCount > 0 ? "customer-chatbot-toggle has-unread" : "customer-chatbot-toggle";
    private string UnreadBadgeText => _unreadCount > 9 ? "9+" : _unreadCount.ToString(CultureInfo.InvariantCulture);
    private string UnreadBadgeAriaLabel => Text($"{_unreadCount} unread assistant messages", $"{_unreadCount} ข้อความจากผู้ช่วยที่ยังไม่ได้อ่าน");
    private string LatestUnreadBadgeText => _latestUnreadCount > 9 ? "9+" : Math.Max(_latestUnreadCount, 1).ToString(CultureInfo.InvariantCulture);

    private IReadOnlyList<CustomerChatPrompt> SuggestedPrompts =>
    [
        new(Localized("Materials", "วัสดุ"), Localized("Which material should I use for a heat-resistant prototype?", "ควรใช้วัสดุอะไรสำหรับต้นแบบที่ทนความร้อน")),
        new(Localized("Lead time", "ระยะเวลา"), Localized("What lead time should I expect for 3D printed parts?", "งานพิมพ์ 3D ใช้เวลาประมาณกี่วัน")),
        new(Localized("Molding", "เครื่องฉีด"), Localized("What is the difference between the 30g and 50g machine variants?", "รุ่น 30g และ 50g ต่างกันอย่างไร")),
        new(Localized("My orders", "คำสั่งซื้อของฉัน"), Localized("Can you help me check my quotes and orders?", "ช่วยตรวจใบเสนอราคาและคำสั่งซื้อของฉันได้ไหม"))
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializePersonalizationAsync();
        }

        if (_composerResizePending && _isOpen)
        {
            _composerResizePending = false;
            await FitComposerAsync();
        }

        if (_messageScrollPending && _isOpen)
        {
            var smooth = _messageScrollSmooth;
            _messageScrollPending = false;
            _messageScrollSmooth = false;
            await ScrollMessagesToBottomAsync(smooth);
        }
    }

    private async Task InitializePersonalizationAsync()
    {
        await Preferences.InitializeAsync();
        var identity = await ResolveFreshIdentityAsync();
        _identity = identity;
        _storageKey = BuildStorageKey(identity);

        var storedMemory = await ReadMemoryAsync(_storageKey);
        if (storedMemory is null && identity.IsAuthenticated)
        {
            storedMemory = await ReadMemoryAsync($"{PersonalizationStoragePrefix}:guest");
        }

        _memory = NormalizeMemory(storedMemory ?? new CustomerChatbotMemory());
        _memory.Messages.Clear();
        _memory.LastSessionId = null;
        _memory.UnreadCount = 0;
        ApplyIdentityToMemory(identity);
        await EnrichMemoryFromAccountAsync(identity);

        _sessionId = null;
        _unreadCount = 0;
        _storageReady = true;
        ResetDisplayedConversation();
        await ClearSharedSessionAsync();
        await PersistMemoryAsync();

        StateHasChanged();
    }

    private async Task ToggleOpenAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _showPopout = false;
            _composerResizePending = true;
            _showJumpToLatest = false;
            _latestUnreadCount = 0;
            QueueMessageScroll(false);
            CancelPopoutTimer();
            _unreadCount = 0;
            _memory.UnreadCount = 0;
            await PersistMemoryAsync();
            await EnsureChatSessionStartedAsync();
        }
    }

    private async Task OpenFromPopoutAsync()
    {
        if (!_isOpen)
        {
            await ToggleOpenAsync();
        }
    }

    private async Task FitComposerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("malievChatbot.initComposerKeys", _draftInput, _sendButton);
            await JS.InvokeVoidAsync("malievChatbot.fitComposer", _draftInput);
        }
        catch (InvalidOperationException)
        {
            // The textarea can disappear while the chat panel is closing.
        }
        catch (JSDisconnectedException)
        {
            // Ignore browser disconnects during shutdown or preview reloads.
        }
    }

    private async Task OnDraftInputAsync(ChangeEventArgs args)
    {
        _draft = args.Value?.ToString() ?? string.Empty;
        await FitComposerAsync();
    }

    private async Task OnMessagesScrolledAsync()
    {
        if (!_showJumpToLatest || !_isOpen)
        {
            return;
        }

        if (await IsMessagesNearBottomAsync())
        {
            _showJumpToLatest = false;
            _latestUnreadCount = 0;
            StateHasChanged();
        }
    }

    private async Task JumpToLatestAsync()
    {
        _showJumpToLatest = false;
        _latestUnreadCount = 0;
        QueueMessageScroll(true);
        await ScrollMessagesToBottomAsync(true);
    }

    private async Task SendDraftAsync()
    {
        var message = _draft;
        _draft = string.Empty;
        await FitComposerAsync();
        await SendAsync(message);
    }

    private async Task ResetChatAsync()
    {
        CancelPopoutTimer();
        CancelSignInMonitor();
        _memory = new CustomerChatbotMemory();
        _sessionId = null;
        _draft = string.Empty;
        _unreadCount = 0;
        _latestUnreadCount = 0;
        _showJumpToLatest = false;
        _showPopout = false;
        _isAwaitingSignIn = false;
        ResetDisplayedConversation();
        QueueMessageScroll(false);
        await ClearStoredChatAsync();
        await FitComposerAsync();
        if (_isOpen)
        {
            await EnsureChatSessionStartedAsync(forceNew: true);
        }
    }

    private Task SendSuggestionAsync(string message)
    {
        return SendAsync(message);
    }

    private async Task EnsureChatSessionStartedAsync(bool forceNew = false)
    {
        if (_isSending || (!forceNew && _sessionId.HasValue))
        {
            return;
        }

        _isSending = true;
        _showJumpToLatest = false;
        _latestUnreadCount = 0;
        QueueMessageScroll(false);
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await ApiClient.StartChatbotSessionAsync(new CustomerChatbotStartRequest
            {
                Language = Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en"
            });

            if (!response.SessionId.HasValue || response.SessionId.Value == Guid.Empty)
            {
                await AddAssistantMessageAsync(
                    "assistant",
                    Text(
                        "The MALIEV assistant could not open a verified session yet. Please try again in a moment.",
                        "ผู้ช่วย MALIEV ยังเปิดเซสชันที่ยืนยันแล้วไม่ได้ค่ะ กรุณาลองอีกครั้งในอีกสักครู่"));
                return;
            }

            _sessionId = response.SessionId;
            var content = string.IsNullOrWhiteSpace(response.Content)
                ? Text(
                    "Hi, Mali here. I am connected and ready to help with your MALIEV project.",
                    "สวัสดีค่ะ น้องมะลิเชื่อมต่อแล้ว พร้อมช่วยเรื่องโปรเจกต์ MALIEV ค่ะ")
                : response.Content;
            await AddAssistantMessageAsync(response.Role, content, MapResponseActions(response.SuggestedActions));
        }
        catch (MalievApiException ex)
        {
            await AddAssistantMessageAsync("assistant", ex.Message);
        }
        finally
        {
            _isSending = false;
            if (_isOpen && !_showJumpToLatest)
            {
                QueueMessageScroll(true);
            }

            await PersistMemoryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message) || _isSending)
        {
            return;
        }

        if (!_sessionId.HasValue)
        {
            await EnsureChatSessionStartedAsync();
            if (!_sessionId.HasValue)
            {
                return;
            }
        }

        var trimmed = message.Trim();
        _messages.Add(new CustomerChatMessage("user", trimmed));
        LearnFromCustomerMessage(trimmed);
        _isSending = true;
        _showJumpToLatest = false;
        _latestUnreadCount = 0;
        QueueMessageScroll(true);
        await PersistMemoryAsync();
        await InvokeAsync(StateHasChanged);

        try
        {
            if (IsAccountSpecificIntent(trimmed))
            {
                var identity = await RefreshIdentityAsync();
                if (!identity.IsAuthenticated)
                {
                    await AddSignInRequiredMessagesAsync();
                    return;
                }

                await AddAuthenticatedAccountResponseAsync(trimmed, identity);
                return;
            }

            var response = await ApiClient.SendChatbotMessageAsync(new CustomerChatbotRequest
            {
                SessionId = _sessionId,
                Message = trimmed,
                CustomerContext = BuildCustomerContext(),
                Language = Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en"
            });
            _sessionId = response.SessionId ?? _sessionId;
            await AddAssistantMessageAsync(response.Role, response.Content, MapResponseActions(response.SuggestedActions));
        }
        catch (MalievApiException ex)
        {
            await AddAssistantMessageAsync("assistant", ex.Message);
        }
        finally
        {
            _isSending = false;
            if (_isOpen && !_showJumpToLatest)
            {
                QueueMessageScroll(true);
            }

            await PersistMemoryAsync();
        }
    }

    private async Task AddAssistantMessageAsync(string role, string content, IReadOnlyList<CustomerChatAction>? actions = null)
    {
        var shouldAutoScroll = _isOpen && await IsMessagesNearBottomAsync();
        _messages.Add(new CustomerChatMessage(role, content) { Actions = actions ?? [] });
        if (!_isOpen)
        {
            _unreadCount = Math.Clamp(_unreadCount + 1, 0, 99);
            _memory.UnreadCount = _unreadCount;
            _ = ShowPopoutTemporarilyAsync(Text("The assistant replied. Open the chat to continue.", "ผู้ช่วยตอบแล้ว เปิดแชทเพื่อคุยต่อได้ค่ะ"));
        }
        else if (shouldAutoScroll)
        {
            _showJumpToLatest = false;
            _latestUnreadCount = 0;
            QueueMessageScroll(true);
        }
        else
        {
            _showJumpToLatest = true;
            _latestUnreadCount = Math.Clamp(_latestUnreadCount + 1, 1, 99);
        }

        await PersistMemoryAsync();
    }

    private async Task AddSignInRequiredMessagesAsync()
    {
        await AddAssistantMessageAsync("assistant", CreateSignInRequiredMessage());
        await AddSignInChoiceMessageAsync();
    }

    private Task AddSignInChoiceMessageAsync()
    {
        return AddAssistantMessageAsync(
            "assistant",
            Text(
                "Choose a sign-in method. Google is fastest, or use your email and password.",
                "เลือกวิธีเข้าสู่ระบบค่ะ ใช้ Google ได้เร็วที่สุด หรือใช้อีเมลและรหัสผ่าน"),
            CreateSignInActions());
    }

    private async Task AddAuthenticatedAccountResponseAsync(string message, CustomerChatbotIdentity identity)
    {
        var normalized = message.ToLowerInvariant();
        var profile = await GetSignedInProfileAsync();
        var displayName = FirstNonEmpty(profile?.DisplayName, JoinName(profile?.FirstName ?? string.Empty, profile?.LastName ?? string.Empty), identity.DisplayName, identity.Email);
        var actions = CreateAccountActions(normalized);

        if (ContainsAnyTerm(normalized, AddressIntentTerms))
        {
            var addresses = await GetSignedInAddressesAsync();
            var addressSummary = addresses.Count == 0
                ? Text("I do not see a saved address in this Web account yet.", "ยังไม่พบที่อยู่ที่บันทึกไว้ในบัญชี Web นี้ค่ะ")
                : Text(
                    $"I found {addresses.Count} saved address{(addresses.Count == 1 ? string.Empty : "es")}. {FormatAddressPreview(addresses)}",
                    $"พบที่อยู่ที่บันทึกไว้ {addresses.Count} รายการค่ะ {FormatAddressPreview(addresses)}");

            await AddAssistantMessageAsync(
                "assistant",
                Text(
                    $"Hi {displayName ?? "there"}, I can help with your address book after sign-in.\n\n{addressSummary}\n\nFor security, address changes still need confirmation in the account address page.",
                    $"สวัสดีค่ะ {displayName ?? "คุณลูกค้า"} น้องมะลิช่วยดูสมุดที่อยู่หลังยืนยันตัวตนได้ค่ะ\n\n{addressSummary}\n\nเพื่อความปลอดภัย การแก้ไขที่อยู่ยังต้องยืนยันในหน้าสมุดที่อยู่ของบัญชีค่ะ"),
                actions);
            return;
        }

        if (ContainsAnyTerm(normalized, ProfileIntentTerms))
        {
            var profileSummary = profile is null
                ? Text("Your profile service is temporarily unavailable, but your signed-in session is active.", "ระบบโปรไฟล์ยังไม่พร้อมใช้งานชั่วคราว แต่สถานะเข้าสู่ระบบของคุณใช้งานอยู่ค่ะ")
                : BuildProfileSummary(profile);

            await AddAssistantMessageAsync(
                "assistant",
                Text(
                    $"Hi {displayName ?? "there"}, I can help with your MALIEV customer profile.\n\n{profileSummary}\n\nOpen the profile page when you want to update contact, company, or language details.",
                    $"สวัสดีค่ะ {displayName ?? "คุณลูกค้า"} น้องมะลิช่วยดูโปรไฟล์ลูกค้า MALIEV ได้ค่ะ\n\n{profileSummary}\n\nเปิดหน้าโปรไฟล์เมื่อต้องการแก้ไขข้อมูลติดต่อ บริษัท หรือภาษาที่ใช้ค่ะ"),
                actions);
            return;
        }

        if (ContainsAnyTerm(normalized, OrderIntentTerms))
        {
            var orders = await GetSignedInOrdersAsync();
            var orderSummary = BuildOrderSummary(orders);
            await AddAssistantMessageAsync(
                "assistant",
                Text(
                    $"Hi {displayName ?? "there"}, I can help with quote, order, receipt, and delivery questions tied to your signed-in customer account.\n\n{orderSummary}\n\nManufacturing quotes and production orders continue in the Quote Engine using the same customer identity.",
                    $"สวัสดีค่ะ {displayName ?? "คุณลูกค้า"} น้องมะลิช่วยเรื่องใบเสนอราคา คำสั่งซื้อ ใบเสร็จ และการจัดส่งที่ผูกกับบัญชีลูกค้าได้ค่ะ\n\n{orderSummary}\n\nงานใบเสนอราคาและคำสั่งผลิตจะต่อในระบบราคาโดยใช้ตัวตนลูกค้าเดียวกันค่ะ"),
                actions);
            return;
        }

        await AddAssistantMessageAsync(
            "assistant",
            Text(
                $"Hi {displayName ?? "there"}, you are signed in. I can help with your MALIEV account, profile, addresses, quotes, orders, receipts, and delivery status.",
                $"สวัสดีค่ะ {displayName ?? "คุณลูกค้า"} ตอนนี้คุณเข้าสู่ระบบแล้ว น้องมะลิช่วยเรื่องบัญชี โปรไฟล์ ที่อยู่ ใบเสนอราคา คำสั่งซื้อ ใบเสร็จ และสถานะจัดส่งของ MALIEV ได้ค่ะ"),
            actions);
    }

