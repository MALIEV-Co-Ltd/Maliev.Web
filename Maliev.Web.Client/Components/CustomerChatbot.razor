@using Ganss.Xss
@using Markdig
@using System.Security.Claims
@using System.Text.Json
@using System.Text.RegularExpressions
@implements IDisposable
@inject MalievApiClient ApiClient
@inject PreferenceService Preferences
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<aside class="customer-chatbot" aria-label="@Text("Mali customer assistant", "ผู้ช่วยลูกค้าน้องมะลิ")">
    @if (_isOpen)
    {
        <section class="customer-chatbot-panel" aria-live="polite">
            <header class="customer-chatbot-header">
                <div>
                    <span>@Text("Mali", "น้องมะลิ")</span>
                    <small>@Text("customer manufacturing assistant", "ผู้ช่วยงานผลิตสำหรับลูกค้า")</small>
                </div>
                <button type="button" class="customer-chatbot-close" aria-label="@Text("Close chat", "ปิดแชท")" @onclick="ToggleOpenAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </header>

            <div class="customer-chatbot-messages">
                @foreach (var message in _messages)
                {
                    <div class="@MessageClass(message.Role)">
                        <div class="customer-chatbot-message-rich">
                            @RenderMessageContent(message.Content)
                        </div>
                    </div>
                }

                @if (_isSending)
                {
                    <div class="customer-chatbot-message assistant pending">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                }
            </div>

            <div class="customer-chatbot-prompts" aria-label="@Text("Suggested topics", "หัวข้อแนะนำ")">
                @foreach (var prompt in SuggestedPrompts)
                {
                    <button type="button" @onclick="() => SendSuggestionAsync(prompt.Value.For(Preferences.Culture))" disabled="@_isSending">
                        @prompt.Label.For(Preferences.Culture)
                    </button>
                }
            </div>

            <div class="customer-chatbot-composer">
                <textarea @ref="_draftInput"
                          rows="1"
                          maxlength="1000"
                          placeholder="@Text("Ask Mali about materials or quotes", "ถามเรื่องวัสดุ ราคา หรือจัดส่ง")"
                          value="@_draft"
                          @oninput="OnDraftInputAsync"
                          disabled="@_isSending"></textarea>
                <button type="button" aria-label="@Text("Send message", "ส่งข้อความ")" @onclick="SendDraftAsync" disabled="@(!CanSend)">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                </button>
            </div>
        </section>
    }
    else if (_showPopout)
    {
        <button type="button" class="customer-chatbot-popout" @onclick="OpenFromPopoutAsync">
            <strong>@Text("Mali", "น้องมะลิ")</strong>
            <span>@_popoutMessage</span>
        </button>
    }

    <button type="button"
            class="@ToggleButtonClass"
            aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
            aria-label="@Text("Open Mali", "เปิดน้องมะลิ")"
            @onclick="ToggleOpenAsync">
        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Medium" />
        @if (_unreadCount > 0)
        {
            <span class="customer-chatbot-unread-badge" aria-label="@UnreadBadgeAriaLabel">@UnreadBadgeText</span>
        }
    </button>
</aside>

@code {
    private const string PersonalizationStoragePrefix = "maliev.chatbot.personalization.v1";
    private const int MaxStoredMessages = 24;
    private const int MaxStoredItems = 6;
    private static readonly JsonSerializerOptions StorageJson = new(JsonSerializerDefaults.Web);
    private static readonly Regex DangerousHtmlBlockPattern = new(
        @"<\s*(script|style|iframe|object|embed|svg|math)\b[^>]*>.*?<\s*/\s*\1\s*>",
        RegexOptions.IgnoreCase | RegexOptions.Singleline | RegexOptions.Compiled);
    private static readonly Regex DangerousHtmlTagPattern = new(
        @"<\s*/?\s*(script|style|iframe|object|embed|svg|math)\b[^>]*>",
        RegexOptions.IgnoreCase | RegexOptions.Compiled);
    private static readonly MarkdownPipeline MessageMarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();
    private static readonly HtmlSanitizer MessageHtmlSanitizer = CreateMessageHtmlSanitizer();

    private readonly List<CustomerChatMessage> _messages = [];
    private CustomerChatbotMemory _memory = new();
    private ElementReference _draftInput;
    private Guid? _sessionId;
    private string _draft = string.Empty;
    private string _storageKey = $"{PersonalizationStoragePrefix}:guest";
    private string _popoutMessage = string.Empty;
    private bool _isOpen;
    private bool _isSending;
    private bool _storageReady;
    private bool _showPopout;
    private bool _composerResizePending;
    private int _unreadCount;
    private CancellationTokenSource? _popoutCts;

    private bool CanSend => !_isSending && !string.IsNullOrWhiteSpace(_draft);
    private string ToggleButtonClass => _unreadCount > 0 ? "customer-chatbot-toggle has-unread" : "customer-chatbot-toggle";
    private string UnreadBadgeText => _unreadCount > 9 ? "9+" : _unreadCount.ToString(CultureInfo.InvariantCulture);
    private string UnreadBadgeAriaLabel => Text($"{_unreadCount} unread Mali messages", $"{_unreadCount} ข้อความจากน้องมะลิที่ยังไม่ได้อ่าน");

    private IReadOnlyList<CustomerChatPrompt> SuggestedPrompts =>
    [
        new(Localized("Materials", "วัสดุ"), Localized("Which material should I use for a heat-resistant prototype?", "ควรใช้วัสดุอะไรสำหรับต้นแบบที่ทนความร้อน")),
        new(Localized("Lead time", "ระยะเวลา"), Localized("What lead time should I expect for 3D printed parts?", "งานพิมพ์ 3D ใช้เวลาประมาณกี่วัน")),
        new(Localized("Molding", "เครื่องฉีด"), Localized("What is the difference between the 30g and 50g machine variants?", "รุ่น 30g และ 50g ต่างกันอย่างไร"))
    ];

    protected override void OnInitialized()
    {
        ResetDisplayedConversation(null, false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializePersonalizationAsync();
        }

        if (_composerResizePending && _isOpen)
        {
            _composerResizePending = false;
            await FitComposerAsync();
        }
    }

    private async Task InitializePersonalizationAsync()
    {
        await Preferences.InitializeAsync();
        var identity = await ResolveIdentityAsync();
        _storageKey = BuildStorageKey(identity);

        var storedMemory = await ReadMemoryAsync(_storageKey);
        if (storedMemory is null && identity.IsAuthenticated)
        {
            storedMemory = await ReadMemoryAsync($"{PersonalizationStoragePrefix}:guest");
        }

        _memory = NormalizeMemory(storedMemory ?? new CustomerChatbotMemory());
        ApplyIdentityToMemory(identity);
        await EnrichMemoryFromAccountAsync(identity);

        _sessionId = _memory.LastSessionId;
        _unreadCount = Math.Clamp(_memory.UnreadCount, 0, 99);
        _storageReady = true;
        var greetingName = GetPersonalGreetingName(identity);
        ResetDisplayedConversation(greetingName, _memory.Messages.Count > 0);
        await PersistMemoryAsync();

        if (!_isOpen)
        {
            _ = ShowPopoutTemporarilyAsync(CreatePopoutMessage(greetingName));
        }

        StateHasChanged();
    }

    private async Task ToggleOpenAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _showPopout = false;
            _composerResizePending = true;
            CancelPopoutTimer();
            _unreadCount = 0;
            _memory.UnreadCount = 0;
            await PersistMemoryAsync();
        }
    }

    private async Task OpenFromPopoutAsync()
    {
        if (!_isOpen)
        {
            await ToggleOpenAsync();
        }
    }

    private async Task FitComposerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("malievChatbot.fitComposer", _draftInput);
        }
        catch (InvalidOperationException)
        {
            // The textarea can disappear while the chat panel is closing.
        }
        catch (JSDisconnectedException)
        {
            // Ignore browser disconnects during shutdown or preview reloads.
        }
    }

    private async Task OnDraftInputAsync(ChangeEventArgs args)
    {
        _draft = args.Value?.ToString() ?? string.Empty;
        await FitComposerAsync();
    }

    private async Task SendDraftAsync()
    {
        var message = _draft;
        _draft = string.Empty;
        await FitComposerAsync();
        await SendAsync(message);
    }

    private Task SendSuggestionAsync(string message)
    {
        return SendAsync(message);
    }

    private async Task SendAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message) || _isSending)
        {
            return;
        }

        var trimmed = message.Trim();
        _messages.Add(new CustomerChatMessage("user", trimmed));
        LearnFromCustomerMessage(trimmed);
        _isSending = true;
        await PersistMemoryAsync();

        try
        {
            var response = await ApiClient.SendChatbotMessageAsync(new CustomerChatbotRequest
            {
                SessionId = _sessionId,
                Message = trimmed,
                CustomerContext = BuildCustomerContext(),
                Language = Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en"
            });
            _sessionId = response.SessionId ?? _sessionId;
            await AddAssistantMessageAsync(response.Role, response.Content);
        }
        catch (MalievApiException ex)
        {
            await AddAssistantMessageAsync("assistant", ex.Message);
        }
        finally
        {
            _isSending = false;
            await PersistMemoryAsync();
        }
    }

    private async Task AddAssistantMessageAsync(string role, string content)
    {
        _messages.Add(new CustomerChatMessage(role, content));
        if (!_isOpen)
        {
            _unreadCount = Math.Clamp(_unreadCount + 1, 0, 99);
            _memory.UnreadCount = _unreadCount;
            _ = ShowPopoutTemporarilyAsync(Text("Mali replied. Open the chat to continue.", "น้องมะลิตอบแล้ว เปิดแชทเพื่อคุยต่อได้ค่ะ"));
        }

        await PersistMemoryAsync();
    }

    private void ResetDisplayedConversation(string? name, bool hasPreviousMessages)
    {
        _messages.Clear();
        _messages.Add(new CustomerChatMessage("assistant", CreateGreeting(name, hasPreviousMessages), false));
        _messages.AddRange(_memory.Messages
            .Where(message => !IsGeneratedGreeting(message))
            .Select(message => new CustomerChatMessage(message.Role, message.Content)));
    }

    private string CreateGreeting(string? name, bool hasPreviousMessages)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            return hasPreviousMessages
                ? Text($"Hi {name}, I'm Mali. I saved your previous MALIEV chat so we can continue from there.", $"สวัสดีค่ะ {name} น้องมะลิบันทึกบทสนทนาเรื่อง MALIEV ไว้และคุยต่อได้ค่ะ")
                : Text($"Hi {name}, I'm Mali. How can I help with your MALIEV project today?", $"สวัสดีค่ะ {name} น้องมะลิอยู่ตรงนี้แล้วค่ะ วันนี้ให้ช่วยเรื่องโปรเจกต์ของ MALIEV ด้านไหนดีคะ");
        }

        return Text(
            "Hi, I'm Mali. How can I help with your MALIEV project today?",
            "สวัสดีค่ะ น้องมะลิอยู่ตรงนี้แล้วค่ะ วันนี้ให้ช่วยเรื่องโปรเจกต์ของ MALIEV ด้านไหนดีคะ");
    }

    private string CreatePopoutMessage(string? name)
    {
        if (_memory.Messages.Count > 0 && !string.IsNullOrWhiteSpace(name))
        {
            return Text($"Hi {name}, Mali can continue your previous MALIEV chat.", $"สวัสดีค่ะ {name} น้องมะลิคุยเรื่อง MALIEV ต่อจากครั้งก่อนได้ค่ะ");
        }

        return _memory.Messages.Count > 0
            ? Text("Mali can continue your previous MALIEV chat.", "น้องมะลิคุยเรื่อง MALIEV ต่อจากครั้งก่อนได้ค่ะ")
            : Text("Ask Mali about materials, pricing, lead time, or the right manufacturing process.", "ถามน้องมะลิเรื่องวัสดุ ราคา ระยะเวลา หรือกระบวนการผลิตที่เหมาะได้ค่ะ");
    }

    private async Task<CustomerChatbotIdentity> ResolveIdentityAsync()
    {
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated != true)
            {
                return new CustomerChatbotIdentity(false, null, null, null);
            }

            var email = CleanOneLine(user.FindFirstValue(ClaimTypes.Email) ?? user.FindFirstValue("email"), 120);
            var displayName = CleanOneLine(
                user.FindFirstValue(ClaimTypes.Name)
                ?? user.FindFirstValue("name")
                ?? user.FindFirstValue("given_name")
                ?? email,
                80);
            var key = user.FindFirstValue("customer_id")
                ?? user.FindFirstValue("principal_id")
                ?? user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? email;

            return new CustomerChatbotIdentity(true, CleanOneLine(key, 140), displayName, email);
        }
        catch (InvalidOperationException)
        {
            return new CustomerChatbotIdentity(false, null, null, null);
        }
    }

    private async Task EnrichMemoryFromAccountAsync(CustomerChatbotIdentity identity)
    {
        if (!identity.IsAuthenticated)
        {
            return;
        }

        try
        {
            var profile = await ApiClient.GetAccountProfileAsync();
            var displayName = FirstNonEmpty(profile.DisplayName, JoinName(profile.FirstName, profile.LastName), profile.Email, identity.DisplayName);
            if (!string.IsNullOrWhiteSpace(displayName))
            {
                _memory.Name = displayName;
            }

            if (!string.IsNullOrWhiteSpace(profile.Email))
            {
                _memory.Email = profile.Email;
            }

            if (!string.IsNullOrWhiteSpace(profile.CompanyName))
            {
                _memory.Company = profile.CompanyName;
            }
        }
        catch (Exception)
        {
            ApplyIdentityToMemory(identity);
        }

        try
        {
            var addresses = await ApiClient.GetAccountAddressesAsync();
            foreach (var address in addresses.Select(FormatAddress).Where(value => !string.IsNullOrWhiteSpace(value)))
            {
                AddDistinct(_memory.Addresses, address, MaxStoredItems, 180);
            }
        }
        catch (Exception)
        {
        }
    }

    private void ApplyIdentityToMemory(CustomerChatbotIdentity identity)
    {
        if (!identity.IsAuthenticated)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(identity.DisplayName))
        {
            _memory.Name = identity.DisplayName;
        }

        if (!string.IsNullOrWhiteSpace(identity.Email))
        {
            _memory.Email = identity.Email;
        }
    }

    private string? BuildCustomerContext()
    {
        var parts = new List<string>();
        AddContextPart(parts, "Name", _memory.Name);
        AddContextPart(parts, "Email", _memory.Email);
        AddContextPart(parts, "Company", _memory.Company);
        AddContextPart(parts, "Service interests", JoinList(_memory.ServiceInterests));
        AddContextPart(parts, "Preferences", JoinList(_memory.Preferences));
        AddContextPart(parts, "Known addresses", JoinList(_memory.Addresses.Take(3)));

        return parts.Count == 0
            ? null
            : string.Join("\n", parts);
    }

    private void LearnFromCustomerMessage(string message)
    {
        CaptureName(message);
        CaptureCompany(message);
        CaptureAddress(message);
        CaptureServiceInterests(message);
        CapturePreferences(message);
        _memory.LastUpdatedAt = DateTimeOffset.UtcNow;
    }

    private void CaptureName(string message)
    {
        var name = MatchFirst(message,
            @"\bmy name is\s+([A-Za-z][A-Za-z\s'.-]{1,50})(?:[,.]|$)",
            @"\b(?:i am|i'm)\s+([A-Z][A-Za-z\s'.-]{1,50})(?:\s+from|[,.]|$)",
            @"(?:ผมชื่อ|ฉันชื่อ|ดิฉันชื่อ|ชื่อ)\s*([^\s,.]{2,40})");
        if (!string.IsNullOrWhiteSpace(name))
        {
            _memory.Name = name;
        }
    }

    private void CaptureCompany(string message)
    {
        var company = MatchFirst(message,
            @"\b(?:my company is|company is|company name is|we are)\s+([A-Za-z0-9&.,'()\-\s]{2,80})(?:[,.]|$)",
            @"บริษัท\s*([ก-๙A-Za-z0-9&.,'()\-\s]{2,80})(?:[,.]|$)");
        if (!string.IsNullOrWhiteSpace(company))
        {
            _memory.Company = company;
        }
    }

    private void CaptureAddress(string message)
    {
        var normalized = message.ToLowerInvariant();
        var looksLikeAddress = normalized.Contains("address is", StringComparison.Ordinal)
            || normalized.Contains("ship to", StringComparison.Ordinal)
            || normalized.Contains("deliver to", StringComparison.Ordinal)
            || message.Contains("ที่อยู่", StringComparison.Ordinal)
            || message.Contains("ส่งที่", StringComparison.Ordinal);
        if (looksLikeAddress && message.Length >= 12)
        {
            AddDistinct(_memory.Addresses, message, MaxStoredItems, 180);
        }
    }

    private void CaptureServiceInterests(string message)
    {
        var normalized = message.ToLowerInvariant();
        AddInterestIfMatch(normalized, "3D printing", "3d print", "3d printing", "fdm", "sla", "resin", "mjf", "sls", "พิมพ์", "ปริ้น");
        AddInterestIfMatch(normalized, "CNC machining", "cnc", "machining", "milling", "turning", "ซีเอ็นซี", "กัด", "กลึง");
        AddInterestIfMatch(normalized, "3D scanning", "3d scan", "3d scanning", "scan", "inspection", "deviation", "สแกน");
        AddInterestIfMatch(normalized, "3D design and DFM", "cad", "design", "dfm", "ออกแบบ");
        AddInterestIfMatch(normalized, "Silicone or urethane casting", "silicone", "urethane", "casting", "ซิลิโคน", "ยูรีเทน", "หล่อ");
        AddInterestIfMatch(normalized, "Pneumatic injection molding", "injection", "molding", "pneumatic", "เครื่องฉีด");
    }

    private void CapturePreferences(string message)
    {
        var normalized = message.ToLowerInvariant();
        AddPreferenceIfMatch(normalized, "Prefers fast lead time", "urgent", "asap", "fast", "rush", "ด่วน", "เร็ว");
        AddPreferenceIfMatch(normalized, "Needs heat-resistant material", "heat", "temperature", "hot", "ความร้อน", "อุณหภูมิ");
        AddPreferenceIfMatch(normalized, "Needs outdoor or UV resistance", "outdoor", "uv", "sunlight", "กลางแจ้ง", "แดด");
        AddPreferenceIfMatch(normalized, "Needs chemical resistance", "chemical", "solvent", "oil", "สารเคมี", "น้ำมัน");
        AddPreferenceIfMatch(normalized, "Needs fit or tight tolerance support", "fit", "tolerance", "dimension", "assembly", "ประกอบ", "ขนาด");
        AddPreferenceIfMatch(normalized, "Budget-sensitive", "budget", "cheap", "low cost", "ราคา", "ประหยัด");
    }

    private void AddInterestIfMatch(string normalizedMessage, string interest, params string[] terms)
    {
        if (terms.Any(term => normalizedMessage.Contains(term, StringComparison.Ordinal)))
        {
            AddDistinct(_memory.ServiceInterests, interest, MaxStoredItems, 80);
        }
    }

    private void AddPreferenceIfMatch(string normalizedMessage, string preference, params string[] terms)
    {
        if (terms.Any(term => normalizedMessage.Contains(term, StringComparison.Ordinal)))
        {
            AddDistinct(_memory.Preferences, preference, MaxStoredItems, 100);
        }
    }

    private async Task<CustomerChatbotMemory?> ReadMemoryAsync(string key)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            return string.IsNullOrWhiteSpace(json)
                ? null
                : JsonSerializer.Deserialize<CustomerChatbotMemory>(json, StorageJson);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JsonException)
        {
            return null;
        }
    }

    private async Task PersistMemoryAsync()
    {
        if (!_storageReady)
        {
            return;
        }

        _memory.LastSessionId = _sessionId;
        _memory.Messages = _messages
            .Where(message => message.Persist && !IsGeneratedGreeting(message))
            .TakeLast(MaxStoredMessages)
            .Select(message => new StoredChatMessage { Role = message.Role, Content = message.Content })
            .ToList();
        _memory.UnreadCount = _unreadCount;
        _memory.LastUpdatedAt = DateTimeOffset.UtcNow;

        try
        {
            var json = JsonSerializer.Serialize(_memory, StorageJson);
            await JS.InvokeVoidAsync("localStorage.setItem", _storageKey, json);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
        }
    }

    private async Task ShowPopoutTemporarilyAsync(string message)
    {
        if (_isOpen || string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        CancelPopoutTimer();
        var cts = new CancellationTokenSource();
        _popoutCts = cts;
        _popoutMessage = message;
        _showPopout = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6), cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!cts.IsCancellationRequested)
        {
            _showPopout = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelPopoutTimer()
    {
        _popoutCts?.Cancel();
        _popoutCts?.Dispose();
        _popoutCts = null;
    }

    private static CustomerChatbotMemory NormalizeMemory(CustomerChatbotMemory memory)
    {
        memory.Name = CleanOneLine(memory.Name, 80);
        memory.Email = CleanOneLine(memory.Email, 120);
        memory.Company = CleanOneLine(memory.Company, 120);
        memory.Addresses = NormalizeList(memory.Addresses, MaxStoredItems, 180);
        memory.ServiceInterests = NormalizeList(memory.ServiceInterests, MaxStoredItems, 80);
        memory.Preferences = NormalizeList(memory.Preferences, MaxStoredItems, 100);
        memory.Messages = memory.Messages
            .Where(message => !string.IsNullOrWhiteSpace(message.Content))
            .Select(message => new StoredChatMessage
            {
                Role = string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase) ? "user" : "assistant",
                Content = CleanMultiline(message.Content, 1400)
            })
            .Where(message => !IsGeneratedGreeting(message))
            .TakeLast(MaxStoredMessages)
            .ToList();
        memory.UnreadCount = Math.Clamp(memory.UnreadCount, 0, 99);
        return memory;
    }

    private static List<string> NormalizeList(IEnumerable<string>? values, int limit, int maxLength)
    {
        return (values ?? [])
            .Select(value => CleanOneLine(value, maxLength))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(limit)
            .ToList();
    }

    private static void AddDistinct(List<string> list, string value, int limit, int maxLength)
    {
        var cleaned = CleanOneLine(value, maxLength);
        if (string.IsNullOrWhiteSpace(cleaned) || list.Any(item => string.Equals(item, cleaned, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        list.Insert(0, cleaned);
        if (list.Count > limit)
        {
            list.RemoveRange(limit, list.Count - limit);
        }
    }

    private static string? MatchFirst(string input, params string[] patterns)
    {
        foreach (var pattern in patterns)
        {
            var match = Regex.Match(input, pattern, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
            if (match.Success)
            {
                return CleanOneLine(match.Groups[1].Value, 80);
            }
        }

        return null;
    }

    private static string BuildStorageKey(CustomerChatbotIdentity identity)
    {
        if (!identity.IsAuthenticated || string.IsNullOrWhiteSpace(identity.UserKey))
        {
            return $"{PersonalizationStoragePrefix}:guest";
        }

        return $"{PersonalizationStoragePrefix}:{Uri.EscapeDataString(identity.UserKey.ToLowerInvariant())}";
    }

    private string? GetPersonalGreetingName(CustomerChatbotIdentity identity)
    {
        return FirstNonEmpty(_memory.Name, identity.DisplayName, identity.Email);
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        return values.Select(value => CleanOneLine(value, 120)).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
    }

    private static string JoinName(string firstName, string lastName)
    {
        return CleanOneLine($"{firstName} {lastName}", 100) ?? string.Empty;
    }

    private static string FormatAddress(CustomerAddressDto address)
    {
        return string.Join(", ", new[]
        {
            address.RecipientName,
            address.AddressLine1,
            address.AddressLine2,
            address.AddressLine3,
            address.District,
            address.City,
            address.StateProvince,
            address.PostalCode
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private static void AddContextPart(List<string> parts, string label, string? value)
    {
        var cleaned = CleanOneLine(value, 220);
        if (!string.IsNullOrWhiteSpace(cleaned))
        {
            parts.Add($"{label}: {cleaned}");
        }
    }

    private static string? JoinList(IEnumerable<string> values)
    {
        var joined = string.Join("; ", values.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(joined) ? null : joined;
    }

    private static string? CleanOneLine(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var cleaned = string.Join(" ", value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries))
            .Replace("\u0000", string.Empty, StringComparison.Ordinal)
            .Trim();
        return cleaned.Length > maxLength ? cleaned[..maxLength].Trim() : cleaned;
    }

    private static string CleanMultiline(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var cleaned = new string(value.Where(ch => !char.IsControl(ch) || ch is '\r' or '\n' or '\t').ToArray()).Trim();
        return cleaned.Length > maxLength ? cleaned[..maxLength].Trim() : cleaned;
    }

    private static string MessageClass(string role)
    {
        return string.Equals(role, "user", StringComparison.OrdinalIgnoreCase)
            ? "customer-chatbot-message user"
            : "customer-chatbot-message assistant";
    }

    private static MarkupString RenderMessageContent(string? content)
    {
        var cleaned = CleanMultiline(content, 4000);
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return new MarkupString(string.Empty);
        }

        cleaned = DangerousHtmlTagPattern.Replace(DangerousHtmlBlockPattern.Replace(cleaned, string.Empty), string.Empty);
        var html = Markdown.ToHtml(cleaned, MessageMarkdownPipeline);
        return new MarkupString(MessageHtmlSanitizer.Sanitize(html));
    }

    private static HtmlSanitizer CreateMessageHtmlSanitizer()
    {
        var sanitizer = new HtmlSanitizer
        {
            KeepChildNodes = true
        };

        sanitizer.AllowedTags.Clear();
        foreach (var tag in new[]
        {
            "a", "blockquote", "br", "code", "del", "div", "em", "h1", "h2", "h3", "h4", "h5", "h6",
            "hr", "li", "ol", "p", "pre", "span", "strong", "table", "tbody", "td", "th", "thead", "tr", "ul"
        })
        {
            sanitizer.AllowedTags.Add(tag);
        }

        sanitizer.AllowedAttributes.Clear();
        sanitizer.AllowedAttributes.Add("href");
        sanitizer.AllowedAttributes.Add("title");

        sanitizer.AllowedSchemes.Clear();
        sanitizer.AllowedSchemes.Add("http");
        sanitizer.AllowedSchemes.Add("https");
        sanitizer.AllowedSchemes.Add("mailto");
        sanitizer.AllowedSchemes.Add("tel");

        return sanitizer;
    }

    private static bool IsGeneratedGreeting(CustomerChatMessage message)
    {
        return IsGeneratedGreeting(message.Role, message.Content);
    }

    private static bool IsGeneratedGreeting(StoredChatMessage message)
    {
        return IsGeneratedGreeting(message.Role, message.Content);
    }

    private static bool IsGeneratedGreeting(string role, string? content)
    {
        if (!string.Equals(role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var cleaned = CleanOneLine(content, 320);
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return false;
        }

        return cleaned.StartsWith("Hi, I'm Mali.", StringComparison.OrdinalIgnoreCase)
            || (cleaned.StartsWith("Hi ", StringComparison.OrdinalIgnoreCase) && cleaned.Contains("I'm Mali.", StringComparison.OrdinalIgnoreCase))
            || cleaned.StartsWith("Mali can continue your previous MALIEV chat.", StringComparison.OrdinalIgnoreCase)
            || (cleaned.StartsWith("สวัสดีค่ะ", StringComparison.Ordinal) && cleaned.Contains("น้องมะลิ", StringComparison.Ordinal))
            || cleaned.StartsWith("น้องมะลิคุยเรื่อง MALIEV ต่อจากครั้งก่อนได้ค่ะ", StringComparison.Ordinal);
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private static LocalizedText Localized(string en, string th)
    {
        return new LocalizedText { En = en, Th = th };
    }

