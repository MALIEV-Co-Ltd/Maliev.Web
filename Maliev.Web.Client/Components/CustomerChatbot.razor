    private async Task ShowPopoutTemporarilyAsync(string message, CustomerChatbotContextHint? hint = null)
    {
        if (_isOpen || string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        CancelPopoutTimer();
        var cts = new CancellationTokenSource();
        _popoutCts = cts;
        _pendingContextHint = hint;
        _popoutKind = hint is null ? "notification" : "context";
        _popoutMessage = message;
        _showPopout = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6), cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!cts.IsCancellationRequested)
        {
            _showPopout = false;
            if (ReferenceEquals(_pendingContextHint, hint))
            {
                _pendingContextHint = null;
                _popoutKind = "notification";
            }

            await InvokeAsync(StateHasChanged);
        }
    }

