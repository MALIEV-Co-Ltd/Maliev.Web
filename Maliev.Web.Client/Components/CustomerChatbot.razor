    private string UnreadBadgeAriaLabel => Text($"{_unreadCount} unread assistant messages", $"{_unreadCount} ข้อความจากผู้ช่วยที่ยังไม่ได้อ่าน");
    private string LatestUnreadBadgeText => _latestUnreadCount > 9 ? "9+" : Math.Max(_latestUnreadCount, 1).ToString(CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializePersonalizationAsync();
            await JS.InvokeVoidAsync("malievChatbot.initFooterAwareFloat");
            Navigation.LocationChanged += OnLocationChanged;
            ScheduleContextHintForCurrentRoute();
        }

        if (_composerResizePending && _isOpen)
        {
            _composerResizePending = false;
            await FitComposerAsync();
        }

        if (_messageScrollPending && _isOpen)
        {
            var smooth = _messageScrollSmooth;
            _messageScrollPending = false;
            _messageScrollSmooth = false;
            await ScrollMessagesToBottomAsync(smooth);
        }
    }

    private async Task InitializePersonalizationAsync()
    {
        await Preferences.InitializeAsync();
        var identity = await ResolveFreshIdentityAsync();
        _identity = identity;
        _storageKey = BuildStorageKey(identity);

        var storedMemory = await ReadMemoryAsync(_storageKey);
        if (storedMemory is null && identity.IsAuthenticated)
        {
            storedMemory = await ReadMemoryAsync($"{PersonalizationStoragePrefix}:guest");
        }

        _memory = NormalizeMemory(storedMemory ?? new CustomerChatbotMemory());
        _memory.Messages.Clear();
        _memory.LastSessionId = null;
        _memory.UnreadCount = 0;
        ApplyIdentityToMemory(identity);
        await EnrichMemoryFromAccountAsync(identity);

        _sessionId = null;
        _unreadCount = 0;
        _storageReady = true;
        ResetDisplayedConversation();
        await ClearSharedSessionAsync();
        await PersistMemoryAsync();

        StateHasChanged();
    }

    private async Task ToggleOpenAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _showPopout = false;
            _composerResizePending = true;
            _showJumpToLatest = false;
            _latestUnreadCount = 0;
            QueueMessageScroll(false);
            CancelPopoutTimer();
            CancelContextHintTimer();
            _unreadCount = 0;
            _memory.UnreadCount = 0;
            await PersistMemoryAsync();
            await EnsureChatSessionStartedAsync();
        }
        else
        {
            ScheduleContextHintForCurrentRoute();
        }
    }

    private async Task OpenFromPopoutAsync()
    {
        var hint = _pendingContextHint;
        if (!_isOpen)
        {
            await ToggleOpenAsync();
        }

        if (hint is not null)
        {
            await ApplyContextHintAsync(hint);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(ScheduleContextHintForCurrentRoute);
    }

    private void ScheduleContextHintForCurrentRoute()
    {
        CancelContextHintTimer();
        ClearContextPopout();

        var hint = ResolveContextHint(Navigation.Uri);
        if (hint is null || !ShouldSurfaceContextHint(hint, Navigation.Uri))
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _contextHintCts = cts;
        _ = ShowContextHintAfterDwellAsync(hint, cts.Token);
    }

    private async Task ShowContextHintAfterDwellAsync(CustomerChatbotContextHint hint, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(ContextHintDwellDelay, cancellationToken);
            await InvokeAsync(async () =>
            {
                if (cancellationToken.IsCancellationRequested || !ShouldSurfaceContextHint(hint, Navigation.Uri))
                {
                    return;
                }

                _lastContextHintShownAt = DateTimeOffset.UtcNow;
                await ShowPopoutTemporarilyAsync(hint.Popup.For(Preferences.Culture), hint);
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private CustomerChatbotContextHint? ResolveContextHint(string absoluteUri)
    {
        var uri = Navigation.ToAbsoluteUri(absoluteUri);
        var path = string.IsNullOrWhiteSpace(uri.AbsolutePath)
            ? "/"
            : uri.AbsolutePath.TrimEnd('/').ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(path))
        {
            path = "/";
        }

        return ContextHints.FirstOrDefault(hint =>
            hint.ExactPath
                ? string.Equals(path, hint.Path, StringComparison.Ordinal)
                : path.StartsWith(hint.Path, StringComparison.Ordinal));
    }

    private bool ShouldSurfaceContextHint(CustomerChatbotContextHint hint, string absoluteUri)
    {
        if (_isOpen || _isSending || _showPopout || !_storageReady)
        {
            return false;
        }

        if (DateTimeOffset.UtcNow - _lastContextHintShownAt < ContextHintCooldown)
        {
            return false;
        }

        if (hint.HighIntent)
        {
            return true;
        }

        var uri = Navigation.ToAbsoluteUri(absoluteUri);
        var sample = (int)((uint)HashCode.Combine(uri.PathAndQuery, hint.AnalyticsKey) % 100);
        return sample < (int)(ContextHintShowProbability * 100);
    }

    private async Task ApplyContextHintAsync(CustomerChatbotContextHint hint)
    {
        _activeContextHint = hint;
        _pendingContextHint = null;
        _popoutKind = "notification";
        AddDistinct(_memory.ServiceInterests, hint.ServiceInterest, MaxStoredItems, 80);

        if (!string.Equals(_lastOpenedContextHintId, hint.Id, StringComparison.Ordinal))
        {
            _lastOpenedContextHintId = hint.Id;
            await AddAssistantMessageAsync("assistant", hint.OpeningMessage.For(Preferences.Culture));
        }

        await PersistMemoryAsync();
    }

    private void ClearContextPopout()
    {
        if (!string.Equals(_popoutKind, "context", StringComparison.Ordinal))
        {
            return;
        }

        CancelPopoutTimer();
        _pendingContextHint = null;
        _popoutKind = "notification";
        _showPopout = false;
    }

    private async Task FitComposerAsync()
    {
