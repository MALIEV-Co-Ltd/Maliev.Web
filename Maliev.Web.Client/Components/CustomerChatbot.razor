    private async Task JumpToLatestAsync()
    {
        _showJumpToLatest = false;
        _latestUnreadCount = 0;
        QueueMessageScroll(true);
        await ScrollMessagesToBottomAsync(true);
    }

    private async Task SendDraftAsync()
    {
        var message = _draft;
        _draft = string.Empty;
        await FitComposerAsync();
        await SendAsync(message);
    }

    private async Task ResetChatAsync()
    {
        CancelPopoutTimer();
        CancelContextHintTimer();
        CancelSignInMonitor();
        _memory = new CustomerChatbotMemory();
        _sessionId = null;
        _draft = string.Empty;
        _unreadCount = 0;
        _latestUnreadCount = 0;
        _showJumpToLatest = false;
        _showPopout = false;
        _pendingContextHint = null;
        _activeContextHint = null;
        _popoutKind = "notification";
        _isAwaitingSignIn = false;
        ResetDisplayedConversation();
        QueueMessageScroll(false);
        await ClearStoredChatAsync();
        await FitComposerAsync();
        if (_isOpen)
        {
            await EnsureChatSessionStartedAsync(forceNew: true);
        }
    }

    private async Task EnsureChatSessionStartedAsync(bool forceNew = false)
    {
        if (_isSending || (!forceNew && _sessionId.HasValue))
        {
            return;
        }

        BeginPendingState(isStartingSession: true);
        _showJumpToLatest = false;
        _latestUnreadCount = 0;
        QueueMessageScroll(false);
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await StartChatbotSessionForBrowserAsync(new CustomerChatbotStartRequest
            {
                Language = Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en"
            });

            if (!response.SessionId.HasValue || response.SessionId.Value == Guid.Empty)
            {
                await AddAssistantMessageAsync(
                    "assistant",
                    Text(
                        "The MALIEV assistant could not open a verified session yet. Please try again in a moment.",
                        "ผู้ช่วย MALIEV ยังเปิดเซสชันที่ยืนยันแล้วไม่ได้ค่ะ กรุณาลองอีกครั้งในอีกสักครู่"));
                return;
            }

            _sessionId = response.SessionId;
            var content = string.IsNullOrWhiteSpace(response.Content)
                ? Text(
                    "Hi, Mali here. I am connected and ready to help with your MALIEV project.",
                    "สวัสดีค่ะ น้องมะลิเชื่อมต่อแล้ว พร้อมช่วยเรื่องโปรเจกต์ MALIEV ค่ะ")
                : response.Content;
            await AddAssistantMessageAsync(response.Role, content, MapResponseActions(response.SuggestedActions));
        }
        catch (MalievApiException ex)
        {
            await AddAssistantMessageAsync("assistant", ex.Message);
        }
        finally
        {
            EndPendingState();
            if (_isOpen && !_showJumpToLatest)
            {
                QueueMessageScroll(true);
            }

            await PersistMemoryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message) || _isSending)
        {
            return;
        }

        if (!_sessionId.HasValue)
        {
            await EnsureChatSessionStartedAsync();
            if (!_sessionId.HasValue)
            {
                return;
            }
        }

        var trimmed = message.Trim();
        _messages.Add(new CustomerChatMessage("user", trimmed));
        LearnFromCustomerMessage(trimmed);
        BeginPendingState(isStartingSession: false);
        _showJumpToLatest = false;
        _latestUnreadCount = 0;
        QueueMessageScroll(true);
        await PersistMemoryAsync();
        await InvokeAsync(StateHasChanged);

        try
        {
            if (IsAccountSpecificIntent(trimmed))
            {
                var identity = await RefreshIdentityAsync();
                if (!identity.IsAuthenticated)
                {
                    await AddSignInRequiredMessagesAsync();
                    return;
                }

                await AddAuthenticatedAccountResponseAsync(trimmed, identity);
                return;
            }

            var response = await SendChatbotMessageForBrowserAsync(new CustomerChatbotRequest
            {
                SessionId = _sessionId,
                Message = trimmed,
                CustomerContext = BuildCustomerContext(),
                Language = Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en"
            });
            _sessionId = response.SessionId ?? _sessionId;
            await AddAssistantMessageAsync(response.Role, response.Content, MapResponseActions(response.SuggestedActions));
        }
        catch (MalievApiException ex)
        {
            await AddAssistantMessageAsync("assistant", ex.Message);
        }
        finally
        {
            EndPendingState();
            if (_isOpen && !_showJumpToLatest)
            {
                QueueMessageScroll(true);
            }

            await PersistMemoryAsync();
        }
    }

    private async Task AddAssistantMessageAsync(string role, string content, IReadOnlyList<CustomerChatAction>? actions = null)
    {
        var shouldAutoScroll = _isOpen && await IsMessagesNearBottomAsync();
        _messages.Add(new CustomerChatMessage(role, content) { Actions = actions ?? [] });
        if (!_isOpen)
        {
            _unreadCount = Math.Clamp(_unreadCount + 1, 0, 99);
            _memory.UnreadCount = _unreadCount;
            _ = ShowPopoutTemporarilyAsync(Text("The assistant replied. Open the chat to continue.", "ผู้ช่วยตอบแล้ว เปิดแชทเพื่อคุยต่อได้ค่ะ"));
        }
        else if (shouldAutoScroll)
        {
            _showJumpToLatest = false;
            _latestUnreadCount = 0;
            QueueMessageScroll(true);
        }
        else
        {
            _showJumpToLatest = true;
            _latestUnreadCount = Math.Clamp(_latestUnreadCount + 1, 1, 99);
        }

        await PersistMemoryAsync();
    }

    private Task<CustomerChatbotResponse> StartChatbotSessionForBrowserAsync(CustomerChatbotStartRequest request)
    {
        return PostChatbotJsonAsync("web/v1/chatbot/sessions", request);
    }

    private Task<CustomerChatbotResponse> SendChatbotMessageForBrowserAsync(CustomerChatbotRequest request)
    {
        return PostChatbotJsonAsync("web/v1/chatbot/messages", request);
    }

    private async Task<CustomerChatbotResponse> PostChatbotJsonAsync<TRequest>(string path, TRequest request)
    {
        BrowserJsonResponse? envelope;
        try
        {
            var rawEnvelope = await JS.InvokeAsync<string>(
                "malievChatbot.postJson",
                $"/{path.TrimStart('/')}",
                request,
                (int)AssistantRequestTimeout.TotalMilliseconds);
            envelope = string.IsNullOrWhiteSpace(rawEnvelope)
                ? null
                : JsonSerializer.Deserialize<BrowserJsonResponse>(rawEnvelope, StorageJson);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException or JsonException)
        {
            throw new MalievApiException(HttpStatusCode.ServiceUnavailable, Text(
                "The MALIEV assistant could not reach the website service. Please try again in a moment.",
                "ผู้ช่วย MALIEV ยังเชื่อมต่อบริการเว็บไซต์ไม่ได้ค่ะ กรุณาลองใหม่อีกครั้ง"));
        }

        if (envelope is null)
        {
            throw new MalievApiException(HttpStatusCode.ServiceUnavailable, Text(
                "The MALIEV assistant received an unreadable response. Please try again in a moment.",
                "ผู้ช่วย MALIEV ได้รับคำตอบที่อ่านไม่ได้ค่ะ กรุณาลองใหม่อีกครั้ง"));
        }

        if (!envelope.Ok)
        {
            var statusCode = envelope.Status > 0
                ? (HttpStatusCode)envelope.Status
                : HttpStatusCode.ServiceUnavailable;
            var detail = ReadProblemDetail(envelope.Body)
                ?? envelope.Error
                ?? Text(
                    "The MALIEV assistant could not complete the request. Please try again in a moment.",
                    "ผู้ช่วย MALIEV ยังทำรายการไม่สำเร็จค่ะ กรุณาลองใหม่อีกครั้ง");
            throw new MalievApiException(statusCode, detail);
        }

        try
        {
            return string.IsNullOrWhiteSpace(envelope.Body)
                ? new CustomerChatbotResponse()
                : JsonSerializer.Deserialize<CustomerChatbotResponse>(envelope.Body, StorageJson) ?? new CustomerChatbotResponse();
        }
        catch (JsonException)
        {
            throw new MalievApiException(HttpStatusCode.ServiceUnavailable, Text(
                "The MALIEV assistant received an unreadable response. Please try again in a moment.",
                "ผู้ช่วย MALIEV ได้รับคำตอบที่อ่านไม่ได้ค่ะ กรุณาลองใหม่อีกครั้ง"));
        }
    }

    private static string? ReadProblemDetail(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            var problem = JsonSerializer.Deserialize<BrowserProblemDetails>(json, StorageJson);
            return problem?.Detail ?? problem?.Title;
        }
        catch (JsonException)
        {
            return null;
        }
    }

