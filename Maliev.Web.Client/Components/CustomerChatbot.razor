    private async Task BeginChatSignInAsync(bool useGoogle)
    {
        if (_isAwaitingSignIn)
        {
            return;
        }

        _isAwaitingSignIn = true;
        CancelSignInMonitor();
        var signInUrl = useGoogle
            ? $"/auth/google?returnUrl={Uri.EscapeDataString(ChatbotCompleteReturnUrl)}"
            : $"/auth/sign-in?returnUrl={Uri.EscapeDataString(ChatbotCompleteReturnUrl)}";
        var popupOpened = false;

        try
        {
            popupOpened = await JS.InvokeAsync<bool>("malievChatbot.openSignInPopup", signInUrl);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException)
        {
            popupOpened = false;
        }

        if (popupOpened)
        {
            await AddAssistantMessageAsync(
                "assistant",
                Text(
                    "I opened a secure sign-in window. Keep this page open; I will continue the same conversation here after your identity is verified.",
                    "น้องมะลิเปิดหน้าต่างเข้าสู่ระบบที่ปลอดภัยแล้วค่ะ เปิดหน้านี้ค้างไว้ได้เลย หลังยืนยันตัวตนแล้วจะคุยต่อในแชทเดิมค่ะ"));
        }
        else
        {
            await AddAssistantMessageAsync(
                "assistant",
                Text(
                    "The browser blocked the sign-in window. Use one of these sign-in options, then return here and I will reconnect automatically.",
                    "เบราว์เซอร์บล็อกหน้าต่างเข้าสู่ระบบค่ะ เลือกวิธีเข้าสู่ระบบด้านล่าง แล้วกลับมาหน้านี้ น้องมะลิจะเชื่อมต่อให้อัตโนมัติค่ะ"));
            await AddSignInChoiceMessageAsync();
        }

        _signInPollCts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
        _ = MonitorSignInAsync(_signInPollCts.Token);
    }

    private async Task MonitorSignInAsync(CancellationToken cancellationToken)
    {
        try
        {
            for (var attempt = 0; attempt < SignInPollAttempts; attempt++)
            {
                await Task.Delay(SignInPollInterval, cancellationToken);
                CustomerChatbotIdentity? identity = null;
                await InvokeAsync(async () => { identity = await RefreshIdentityAsync(); });
                if (identity?.IsAuthenticated != true)
                {
                    continue;
                }

                _isAwaitingSignIn = false;
                await InvokeAsync(async () =>
                {
                    await AddAssistantMessageAsync(
                        "assistant",
                        Text(
                            $"Signed in as {GetPersonalGreetingName(identity) ?? identity.Email ?? "your MALIEV account"}. We can continue here without leaving this page.",
                            $"เข้าสู่ระบบเป็น {GetPersonalGreetingName(identity) ?? identity.Email ?? "บัญชี MALIEV ของคุณ"} แล้วค่ะ เราคุยต่อในหน้านี้ได้เลยโดยไม่ต้องออกจากหน้านี้"),
                        CreateAccountActions(string.Empty));
                    StateHasChanged();
                });
                return;
            }

            _isAwaitingSignIn = false;
            await InvokeAsync(async () =>
            {
                await AddAssistantMessageAsync(
                    "assistant",
                    Text(
                        "I did not see a completed sign-in yet. You can try again when you are ready.",
                        "น้องมะลิยังไม่เห็นสถานะเข้าสู่ระบบสำเร็จค่ะ กดเข้าสู่ระบบอีกครั้งได้เมื่อพร้อมค่ะ"));
                await AddSignInChoiceMessageAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task<CustomerChatbotIdentity> RefreshIdentityAsync()
    {
        var identity = await ResolveFreshIdentityAsync();
        _identity = identity;
        if (identity.IsAuthenticated)
        {
            ApplyIdentityToMemory(identity);
            await EnrichMemoryFromAccountAsync(identity);
        }

        var nextKey = BuildStorageKey(identity);
        if (!string.Equals(nextKey, _storageKey, StringComparison.Ordinal))
        {
            _storageKey = nextKey;
            await PersistMemoryAsync();
        }

        return identity;
    }

