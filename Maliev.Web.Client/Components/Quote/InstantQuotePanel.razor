@using System.Text.Json
@inject MalievApiClient Api
@inherits PreferenceAwareComponentBase

<section class="quote-panel" aria-label="Instant quote">
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="quote-empty">@_loadError</div>
    }
    else
    {
        <div class="quote-tabs" role="tablist">
            @foreach (var process in _reference.Processes)
            {
                <button class="@ProcessButtonClass(process.Code)" type="button" @onclick="() => SelectProcess(process.Code)">
                    <span>@process.Name.For(Preferences.Culture)</span>
                </button>
            }
        </div>
    }

    <label class="upload-zone">
        <InputFile OnChange="HandleFilesAsync" multiple accept=".stl,.step,.stp,.3mf,.obj,.igs,.iges,.gltf,.glb" disabled="@(!_reference.Processes.Any())" />
        <span class="upload-title">Drop or choose 3D model files</span>
        <span class="upload-meta">STL, STEP, STP, 3MF, OBJ, IGS, IGES, GLTF, and GLB. Large files can stay on this page while they upload.</span>
    </label>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="quote-empty">@_statusMessage</div>
    }

    @if (_parts.Count == 0)
    {
        <div class="quote-empty">No file selected yet. Add a model to configure materials and pricing.</div>
    }
    else
    {
        <div class="quote-parts">
            @foreach (var part in _parts)
            {
                <article class="quote-part">
                    <div class="quote-part-header">
                        <div>
                            <strong>@part.File.Name</strong>
                            <span>@FormatBytes(part.File.SizeBytes) · @(string.IsNullOrWhiteSpace(part.UploadId) ? "uploading" : "uploaded")</span>
                        </div>
                        <input type="number" min="1" max="999" @bind="part.Quantity" aria-label="Quantity" />
                    </div>

                    <div class="quote-config-section">
                        <span class="quote-config-label">Material</span>
                        <div class="quote-option-grid" role="radiogroup" aria-label="Material">
                            @foreach (var material in GetMaterials(part))
                            {
                                <button type="button"
                                        class="@OptionCardClass(IsMaterialSelected(part, material))"
                                        aria-pressed="@IsMaterialSelected(part, material)"
                                        @onclick="() => SelectMaterial(part, material)">
                                    <span class="quote-option-media">
                                        <MudIcon Class="quote-option-icon" Icon="@Icons.Material.Filled.BuildCircle" Size="Size.Medium" />
                                    </span>
                                    <span class="quote-option-name">@material.Name.For(Preferences.Culture)</span>
                                </button>
                            }
                        </div>
                    </div>

                    @if (GetSurfaceFinishes(part).Any())
                    {
                        <div class="quote-config-section">
                            <span class="quote-config-label">Surface finish</span>
                            <div class="quote-option-grid" role="radiogroup" aria-label="Surface finish">
                                @foreach (var finish in GetSurfaceFinishes(part))
                                {
                                    <button type="button"
                                            class="@OptionCardClass(IsSurfaceFinishSelected(part, finish))"
                                            aria-pressed="@IsSurfaceFinishSelected(part, finish)"
                                            @onclick="() => SelectSurfaceFinish(part, finish)">
                                        <span class="quote-option-media">
                                            <MudIcon Class="quote-option-icon" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" />
                                        </span>
                                        <span class="quote-option-name">@finish.Name.For(Preferences.Culture)</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @foreach (var option in GetVisualProcessOptions(part))
                    {
                        <div class="quote-config-section">
                            <span class="quote-config-label">@option.Label.For(Preferences.Culture)</span>
                            <div class="quote-option-grid" role="radiogroup" aria-label="@option.Label.For(Preferences.Culture)">
                                @if (IsToggleOption(option))
                                {
                                    @foreach (var enabled in ToggleChoices)
                                    {
                                        var value = enabled ? "true" : "false";
                                        <button type="button"
                                                class="@OptionCardClass(IsConfigOptionSelected(part, option, value))"
                                                aria-pressed="@IsConfigOptionSelected(part, option, value)"
                                                @onclick="() => SelectConfigOption(part, option, value)">
                                            <span class="quote-option-media">
                                                <MudIcon Class="quote-option-icon" Icon="@Icons.Material.Filled.BuildCircle" Size="Size.Medium" />
                                            </span>
                                            <span class="quote-option-name">@FormatOptionValue(option, value)</span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @foreach (var value in GetOptionChoices(option))
                                    {
                                        <button type="button"
                                                class="@OptionCardClass(IsConfigOptionSelected(part, option, value))"
                                                aria-pressed="@IsConfigOptionSelected(part, option, value)"
                                                @onclick="() => SelectConfigOption(part, option, value)">
                                            <span class="quote-option-media">
                                                <MudIcon Class="quote-option-icon" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" />
                                            </span>
                                            <span class="quote-option-name">@FormatOptionValue(option, value)</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <label class="ack">
                        <input type="checkbox" @bind="part.DfmAcknowledged" />
                        DFM checked
                    </label>
                </article>
            }
        </div>

        <div class="quote-actions">
            <select @bind="_leadTimeCode" aria-label="Lead time">
                @foreach (var leadTime in _reference.LeadTimeCodes)
                {
                    <option value="@leadTime">@leadTime</option>
                }
            </select>
            <button type="button" class="button primary" @onclick="EstimateAsync" disabled="@_isEstimating">Estimate</button>
        </div>
    }

    @if (_estimate is not null)
    {
        <div class="quote-total">
            <div>
                <span>Subtotal</span>
                <strong>@FormatCurrency(_estimate.Subtotal)</strong>
            </div>
            <div>
                <span>Bulk discount</span>
                <strong>-@FormatCurrency(_estimate.BulkDiscountTotal)</strong>
            </div>
            <div>
                <span>VAT estimate</span>
                <strong>@FormatCurrency(_estimate.TaxAmount)</strong>
            </div>
            <div class="grand-total">
                <span>Total</span>
                <strong>@FormatCurrency(_estimate.Total)</strong>
            </div>
            @if (_estimate.RequiresManualReview)
            {
                <p class="quote-warning">Manual review required before issuing a formal quotation.</p>
            }
        </div>
    }
</section>

@code {
    private const string DeburrEdgesConfigKey = "deburr_edges";
    private static readonly bool[] ToggleChoices = [true, false];

    private readonly List<QuotePartDraftDto> _parts = [];
    private QuoteReferenceDataDto _reference = new();
    private QuoteEstimateResponse? _estimate;
    private string? _loadError;
    private string? _statusMessage;
    private string _selectedProcess = "FDM";
    private string _leadTimeCode = "STANDARD";
    private bool _isEstimating;
    private readonly Guid _quoteSessionId = Guid.NewGuid();

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        try
        {
            _reference = await Api.GetQuoteReferenceDataAsync();
            _selectedProcess = _reference.Processes.FirstOrDefault()?.Code ?? _selectedProcess;
            _leadTimeCode = _reference.LeadTimeCodes.FirstOrDefault() ?? _leadTimeCode;
        }
        catch (MalievApiException ex)
        {
            _loadError = ex.Message;
        }
    }

    private void SelectProcess(string code)
    {
        _selectedProcess = code;
        foreach (var part in _parts)
        {
            part.ProcessCode = code;
            ApplyDefaults(part);
        }
    }

    private async Task HandleFilesAsync(InputFileChangeEventArgs args)
    {
        _statusMessage = null;
        foreach (var file in args.GetMultipleFiles(20))
        {
            var part = new QuotePartDraftDto
            {
                File = new QuoteFileDraftDto
                {
                    Name = file.Name,
                    SizeBytes = file.Size,
                    ContentType = file.ContentType
                },
                ProcessCode = _selectedProcess
            };
            ApplyDefaults(part);
            _parts.Add(part);

            try
            {
                var session = await Api.InitiateUploadAsync(new WebUploadInitiationRequest
                {
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    FileSize = file.Size,
                    QuoteSessionId = _quoteSessionId
                });
                var upload = await Api.UploadFileAsync(file, session);
                part.UploadId = upload.UploadId;
                part.FileId = upload.FileId;
                part.StoragePath = upload.StoragePath;
                var status = await Api.GetAnalysisStatusAsync(upload.UploadId);
                _statusMessage = status.Message;
            }
            catch (MalievApiException ex)
            {
                _statusMessage = ex.Message;
            }
        }
    }

    private async Task EstimateAsync()
    {
        _isEstimating = true;
        try
        {
            _statusMessage = null;
            _estimate = await Api.EstimateQuoteAsync(new QuoteEstimateRequest
            {
                Culture = Preferences.Culture,
                LeadTimeCode = _leadTimeCode,
                Parts = _parts
            });
        }
        catch (MalievApiException ex)
        {
            _statusMessage = ex.Message;
        }
        finally
        {
            _isEstimating = false;
        }
    }

    private void ApplyDefaults(QuotePartDraftDto part)
    {
        var process = _reference.Processes.FirstOrDefault(p => p.Code.Equals(part.ProcessCode, StringComparison.OrdinalIgnoreCase));
        part.ManufacturingProcessId = process?.Id;

        var material = GetMaterials(part).FirstOrDefault(m =>
            m.Code.Equals(part.MaterialCode, StringComparison.OrdinalIgnoreCase) ||
            m.Id == part.MaterialId) ?? GetMaterials(part).FirstOrDefault();
        if (material is not null)
        {
            SelectMaterial(part, material);
        }
        else
        {
            EnsureProcessOptions(part);
        }
    }

    private IEnumerable<MaterialOptionDto> GetMaterials(QuotePartDraftDto part)
    {
        return _reference.Materials.Where(material => material.ProcessCode.Equals(part.ProcessCode, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<SurfaceFinishOptionDto> GetSurfaceFinishes(QuotePartDraftDto part)
    {
        var finishes = _reference.SurfaceFinishes
            .Where(finish => finish.ProcessCode.Equals(part.ProcessCode, StringComparison.OrdinalIgnoreCase));

        return part.MaterialId.HasValue
            ? finishes.Where(finish => finish.CompatibleMaterialIds.Count == 0 || finish.CompatibleMaterialIds.Contains(part.MaterialId.Value))
            : finishes;
    }

    private IEnumerable<ProcessConfigOptionDto> GetVisualProcessOptions(QuotePartDraftDto part)
    {
        return _reference.ProcessOptions
            .Where(option => option.ProcessCode.Equals(part.ProcessCode, StringComparison.OrdinalIgnoreCase))
            .Where(IsVisualOption)
            .OrderBy(option => option.SortOrder);
    }

    private void SelectMaterial(QuotePartDraftDto part, MaterialOptionDto material)
    {
        part.MaterialId = material.Id;
        part.MaterialCode = material.Code;
        EnsureSurfaceFinish(part);
        EnsureProcessOptions(part);
    }

    private void SelectSurfaceFinish(QuotePartDraftDto part, SurfaceFinishOptionDto finish)
    {
        part.SurfaceFinishId = finish.Id;
        part.SurfaceFinishCode = finish.Code;
    }

    private void SelectConfigOption(QuotePartDraftDto part, ProcessConfigOptionDto option, string value)
    {
        part.ProcessOptionValues[option.ConfigKey] = value;
    }

    private void EnsureSurfaceFinish(QuotePartDraftDto part)
    {
        var finishes = GetSurfaceFinishes(part).ToList();
        if (finishes.Count == 0)
        {
            part.SurfaceFinishId = null;
            part.SurfaceFinishCode = string.Empty;
            return;
        }

        var selected = finishes.FirstOrDefault(finish =>
            finish.Code.Equals(part.SurfaceFinishCode, StringComparison.OrdinalIgnoreCase) ||
            finish.Id == part.SurfaceFinishId) ?? finishes[0];
        SelectSurfaceFinish(part, selected);
    }

    private void EnsureProcessOptions(QuotePartDraftDto part)
    {
        var currentOptions = _reference.ProcessOptions
            .Where(option => option.ProcessCode.Equals(part.ProcessCode, StringComparison.OrdinalIgnoreCase))
            .ToDictionary(option => option.ConfigKey, StringComparer.OrdinalIgnoreCase);

        foreach (var key in part.ProcessOptionValues.Keys.Where(key => !currentOptions.ContainsKey(key)).ToList())
        {
            part.ProcessOptionValues.Remove(key);
        }

        foreach (var option in currentOptions.Values)
        {
            if (!part.ProcessOptionValues.TryGetValue(option.ConfigKey, out var selectedValue) || string.IsNullOrWhiteSpace(selectedValue))
            {
                var defaultValue = ResolveDefaultValue(option);
                if (!string.IsNullOrWhiteSpace(defaultValue))
                {
                    part.ProcessOptionValues[option.ConfigKey] = defaultValue;
                }
            }
        }
    }

    private static string ResolveDefaultValue(ProcessConfigOptionDto option)
    {
        if (!string.IsNullOrWhiteSpace(option.DefaultValue))
        {
            return option.DefaultValue;
        }

        return IsToggleOption(option) ? "false" : GetOptionChoices(option).FirstOrDefault() ?? string.Empty;
    }

    private static bool IsMaterialSelected(QuotePartDraftDto part, MaterialOptionDto material)
    {
        return material.Code.Equals(part.MaterialCode, StringComparison.OrdinalIgnoreCase) || material.Id == part.MaterialId;
    }

    private static bool IsSurfaceFinishSelected(QuotePartDraftDto part, SurfaceFinishOptionDto finish)
    {
        return finish.Code.Equals(part.SurfaceFinishCode, StringComparison.OrdinalIgnoreCase) || finish.Id == part.SurfaceFinishId;
    }

    private static bool IsConfigOptionSelected(QuotePartDraftDto part, ProcessConfigOptionDto option, string value)
    {
        return part.ProcessOptionValues.TryGetValue(option.ConfigKey, out var selected) &&
            selected.Equals(value, StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsVisualOption(ProcessConfigOptionDto option)
    {
        return (IsDropdownOption(option) && IsVisualDropdown(option)) ||
            (IsToggleOption(option) &&
                (option.ConfigKey.Equals(DeburrEdgesConfigKey, StringComparison.OrdinalIgnoreCase) ||
                    option.ConfigKey.Contains("deburr", StringComparison.OrdinalIgnoreCase)));
    }

    private static bool IsVisualDropdown(ProcessConfigOptionDto option)
    {
        return option.ConfigKey.Contains("color", StringComparison.OrdinalIgnoreCase) ||
            option.ConfigKey.Contains("finish", StringComparison.OrdinalIgnoreCase) ||
            option.ConfigKey.Contains("post_processing", StringComparison.OrdinalIgnoreCase) ||
            option.ConfigKey.Contains("surface_finish", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDropdownOption(ProcessConfigOptionDto option)
    {
        return option.ConfigType.Equals("dropdown", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsToggleOption(ProcessConfigOptionDto option)
    {
        return option.ConfigType.Equals("toggle", StringComparison.OrdinalIgnoreCase);
    }

    private static IReadOnlyList<string> GetOptionChoices(ProcessConfigOptionDto option)
    {
        if (string.IsNullOrWhiteSpace(option.OptionsJson))
        {
            return [];
        }

        try
        {
            return JsonSerializer.Deserialize<List<string>>(option.OptionsJson) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static string OptionCardClass(bool selected)
    {
        return selected ? "quote-option-card active" : "quote-option-card";
    }

    private string ProcessButtonClass(string code)
    {
        return code == _selectedProcess ? "quote-tab active" : "quote-tab";
    }

    private static string FormatOptionValue(ProcessConfigOptionDto option, string value)
    {
        if (IsToggleOption(option))
        {
            return value.Equals("true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No";
        }

        var label = value.Replace('_', ' ').ToLowerInvariant();
        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(label);
    }

    private static string NormalizeCode(string value)
    {
        return value.Trim().ToUpperInvariant();
    }

    private static string FormatBytes(long bytes)
    {
        return bytes < 1024 * 1024 ? $"{bytes / 1024m:N0} KB" : $"{bytes / 1024m / 1024m:N1} MB";
    }

    private static string FormatCurrency(decimal amount)
    {
        return string.Create(CultureInfo.GetCultureInfo("th-TH"), $"฿{amount:N2}");
    }
}
