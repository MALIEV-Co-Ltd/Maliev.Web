@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="@WrapperClass">
    <input id="@InputId"
           class="landing-quote-dropzone-input"
           type="file"
           multiple
           accept="@SupportedFormatsAccept" />
    <div id="@DropzoneId"
         role="button"
         tabindex="0"
         class="@ButtonClass"
         aria-label="@AriaLabel"
         data-idle-label="@ActionText"
         data-opening-label="@OpeningText">
        <span class="landing-quote-dropzone-inner">
            <span class="landing-quote-dropzone-primary">
                <span class="landing-quote-dropzone-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Medium" />
                </span>
                <span class="landing-quote-dropzone-copy">
                    <strong>@Title</strong>
                    <small>@Description</small>
                </span>
            </span>
            <span class="landing-quote-dropzone-divider" aria-hidden="true"></span>
            <span class="landing-quote-dropzone-browse">
                <span id="@FormatsShellId" class="landing-quote-dropzone-format-shell" data-dropzone-interactive>
                    <button class="landing-quote-dropzone-format-button"
                            type="button"
                            aria-expanded="@FormatsExpanded"
                            aria-controls="@FormatsPanelId"
                            @onclick="ToggleFormats"
                            @onclick:stopPropagation="true"
                            @onpointerdown:stopPropagation="true">
                        @FormatsButtonText
                    </button>
                    @if (_isFormatsOpen)
                    {
                        <span id="@FormatsPanelId"
                              class="landing-quote-dropzone-format-popover"
                              role="list"
                              aria-label="@FormatsPanelLabel">
                            @foreach (var format in SupportedFormats)
                            {
                                <span class="landing-quote-dropzone-format-item" role="listitem">@format</span>
                            }
                        </span>
                    }
                </span>
                <span class="landing-quote-dropzone-action">
                    <span data-quote-dropzone-label>@ActionText</span>
                </span>
            </span>
        </span>
    </div>
</div>

@code {
    private readonly string DropzoneId = $"quote-dropzone-{Guid.NewGuid():N}";
    private readonly string InputId = $"quote-dropzone-input-{Guid.NewGuid():N}";
    private readonly string FormatsShellId = $"quote-dropzone-format-shell-{Guid.NewGuid():N}";
    private readonly string FormatsPanelId = $"quote-dropzone-formats-{Guid.NewGuid():N}";
    private static readonly string[] SupportedFormats = [".STL", ".STEP", ".STP", ".3MF", ".OBJ", ".IGS", ".IGES", ".GLTF", ".GLB"];
    private static readonly string SupportedFormatsAccept = string.Join(",", SupportedFormats.Select(format => format.ToLowerInvariant()));
    private DotNetObjectReference<QuoteDropzone>? _objectReference;
    private bool _isFormatsOpen;

    [Parameter]
    public string Href { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string ActionText { get; set; } = string.Empty;

    [Parameter]
    public string OrText { get; set; } = "OR";

    [Parameter]
    public string FormatsButtonText { get; set; } = "Supported formats";

    [Parameter]
    public string FormatsPanelLabel { get; set; } = "Supported QuoteEngine file formats";

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string OpeningText { get; set; } = "Opening quote engine";

    private string WrapperClass => string.IsNullOrWhiteSpace(Class)
        ? "landing-quote-dropzone-shell"
        : $"landing-quote-dropzone-shell {Class}";

    private string ButtonClass => string.IsNullOrWhiteSpace(Class)
        ? "landing-quote-dropzone"
        : $"landing-quote-dropzone {Class}";

    private string FormatsExpanded => _isFormatsOpen ? "true" : "false";

    private void ToggleFormats()
    {
        _isFormatsOpen = !_isFormatsOpen;
    }

    [JSInvokable]
    public Task CloseFormatsAsync()
    {
        if (!_isFormatsOpen)
        {
            return Task.CompletedTask;
        }

        _isFormatsOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Js.InvokeVoidAsync("malievQuoteDropzone.register", DropzoneId, InputId, Href);
        _objectReference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("malievQuoteDropzone.registerFormatDismissal", FormatsShellId, _objectReference);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("malievQuoteDropzone.unregisterFormatDismissal", FormatsShellId);
            await Js.InvokeVoidAsync("malievQuoteDropzone.unregister", DropzoneId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex) when (IsJsInteropUnavailable(ex))
        {
        }

        _objectReference?.Dispose();
    }

    private static bool IsJsInteropUnavailable(InvalidOperationException exception)
        => exception.Message.Contains("JavaScript interop calls cannot be issued", StringComparison.OrdinalIgnoreCase);
}
