@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="@WrapperClass">
    <input id="@InputId"
           class="landing-quote-dropzone-input"
           type="file"
           multiple
           accept=".stl,.step,.stp,.obj,.3mf,.iges,.igs" />
    <button id="@DropzoneId"
            type="button"
            class="@ButtonClass"
            aria-label="@AriaLabel"
            data-idle-label="@ActionText"
            data-opening-label="@OpeningText">
        <span class="landing-quote-dropzone-inner">
            <span class="landing-quote-dropzone-primary">
                <span class="landing-quote-dropzone-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Medium" />
                </span>
                <span class="landing-quote-dropzone-copy">
                    <strong>@Title</strong>
                    <small>@Description</small>
                </span>
            </span>
            <span class="landing-quote-dropzone-divider" aria-hidden="true"></span>
            <span class="landing-quote-dropzone-browse">
                <span class="landing-quote-dropzone-or">@OrText</span>
                <span class="landing-quote-dropzone-action">
                    <span data-quote-dropzone-label>@ActionText</span>
                </span>
            </span>
        </span>
    </button>
</div>

@code {
    private readonly string DropzoneId = $"quote-dropzone-{Guid.NewGuid():N}";
    private readonly string InputId = $"quote-dropzone-input-{Guid.NewGuid():N}";

    [Parameter]
    public string Href { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string ActionText { get; set; } = string.Empty;

    [Parameter]
    public string OrText { get; set; } = "OR";

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string OpeningText { get; set; } = "Opening quote engine";

    private string WrapperClass => string.IsNullOrWhiteSpace(Class)
        ? "landing-quote-dropzone-shell"
        : $"landing-quote-dropzone-shell {Class}";

    private string ButtonClass => string.IsNullOrWhiteSpace(Class)
        ? "landing-quote-dropzone"
        : $"landing-quote-dropzone {Class}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Js.InvokeVoidAsync("malievQuoteDropzone.register", DropzoneId, InputId, Href);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("malievQuoteDropzone.unregister", DropzoneId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex) when (IsJsInteropUnavailable(ex))
        {
        }
    }

    private static bool IsJsInteropUnavailable(InvalidOperationException exception)
        => exception.Message.Contains("JavaScript interop calls cannot be issued", StringComparison.OrdinalIgnoreCase);
}
