@implements IAsyncDisposable
@using System.Globalization
@inject IJSRuntime JS

<div class="@ContainerClass" aria-label="@AriaLabel">
    <canvas @ref="_canvas"
            class="manufacturing-gizmo-canvas"
            data-manufacturing-gizmo
            data-model-url="@ModelUrl"
            data-model-scale="@ModelScale.ToString(CultureInfo.InvariantCulture)"
            data-enable-hover-motion="@EnableHoverMotion.ToString().ToLowerInvariant()"
            data-use-plastic-material="@UsePlasticMaterial.ToString().ToLowerInvariant()"></canvas>
    <div class="manufacturing-gizmo-fallback" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
    </div>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Interactive 3D manufacturing preview";

    [Parameter]
    public string? ModelUrl { get; set; }

    [Parameter]
    public double ModelScale { get; set; } = 1.0;

    [Parameter]
    public bool EnableHoverMotion { get; set; }

    [Parameter]
    public bool UsePlasticMaterial { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private const string ModulePath = "/js/manufacturing-gizmo.js?v=20260518-babylon-frame";
    private string ContainerClass => string.IsNullOrWhiteSpace(Class)
        ? "manufacturing-gizmo is-loading"
        : $"manufacturing-gizmo is-loading {Class}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        await _module.InvokeVoidAsync(
            "mountManufacturingGizmo",
            _canvas,
            ModelUrl ?? string.Empty,
            EnableHoverMotion,
            UsePlasticMaterial,
            ModelScale);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("disposeManufacturingGizmo", _canvas);
        }
        catch (JSDisconnectedException)
        {
        }

        await _module.DisposeAsync();
    }
}
