@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@ContainerClass" aria-label="@AriaLabel">
    <canvas @ref="_canvas" class="manufacturing-gizmo-canvas"></canvas>
    <div class="manufacturing-gizmo-fallback" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
    </div>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Interactive 3D manufacturing preview";

    [Parameter]
    public string? ModelUrl { get; set; }

    [Parameter]
    public bool EnableHoverMotion { get; set; }

    [Parameter]
    public bool UsePlasticMaterial { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string ContainerClass => string.IsNullOrWhiteSpace(Class)
        ? "manufacturing-gizmo"
        : $"manufacturing-gizmo {Class}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/manufacturing-gizmo.js");
        await _module.InvokeVoidAsync(
            "mountManufacturingGizmo",
            _canvas,
            ModelUrl ?? string.Empty,
            EnableHoverMotion,
            UsePlasticMaterial);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("disposeManufacturingGizmo", _canvas);
        }
        catch (JSDisconnectedException)
        {
        }

        await _module.DisposeAsync();
    }
}
