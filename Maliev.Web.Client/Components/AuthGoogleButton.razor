@inject IJSRuntime JS

<div class="auth-google-official-host" @ref="_host">
    <div class="auth-google-official-button" aria-label="Sign in with Google"></div>
    <p class="auth-google-official-status" role="status" aria-live="polite" hidden></p>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public string ReturnUrl { get; set; } = "/account";

    private ElementReference _host;
    private bool _renderRequested;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _renderRequested)
        {
            return;
        }

        _renderRequested = true;
        try
        {
            await JS.InvokeVoidAsync("malievGoogleIdentity.renderButton", _host, ReturnUrl);
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSException or JSDisconnectedException)
        {
            _renderRequested = false;
        }
    }
}
