@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject PreferenceService Preferences
@inject CartState Cart
@inject NavigationManager Navigation

<MudThemeProvider Theme="@_malievTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="site-shell">
    <header class="site-header">
        <NavLink href="/" class="brand" Match="NavLinkMatch.All" aria-label="MALIEV home">
            <img class="brand-logo" src="/images/logo.svg" width="105" height="24" alt="" aria-hidden="true" />
        </NavLink>
        <nav class="nav-links" aria-label="Primary">
            <NavLink href="/services/3d-printing">@L["Services"]</NavLink>
            <NavLink href="/shop">@L["Shop"]</NavLink>
            <NavLink href="/contact">@L["Contact"]</NavLink>
        </nav>
        <div class="nav-actions">
            <select class="language-select" aria-label="@L["Language"]" @bind="_selectedCulture" @bind:after="ChangeCultureAsync">
                <option value="en-US">EN</option>
                <option value="th-TH">TH</option>
            </select>
            <MudBadge Content="@Cart.Count"
                      Color="Color.Info"
                      Overlap="true"
                      Bordered="false"
                      Elevation="0"
                      BadgeAriaLabel="@CartBadgeAriaLabel"
                      Class="nav-icon-badge">
                <MudIconButton Href="/cart"
                               Icon="@Icons.Material.Filled.ShoppingCart"
                               Variant="Variant.Text"
                               Color="Color.Inherit"
                               Size="Size.Medium"
                               Class="nav-icon-button"
                               aria-label="@L["Cart"]" />
            </MudBadge>
            <MudIconButton Href="/account/preferences"
                           Icon="@Icons.Material.Filled.AccountCircle"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Medium"
                           Class="nav-icon-button"
                           aria-label="@L["Account"]" />
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div>
            <strong>MALIEV Co., Ltd.</strong>
            <p>Nonthaburi, Thailand. Manufacturing services, machines, and production support.</p>
        </div>
        <div class="footer-links">
            <NavLink href="/faq">FAQ</NavLink>
            <NavLink href="/shipping-returns">Shipping</NavLink>
            <NavLink href="/privacy">Privacy</NavLink>
            <NavLink href="/terms">Terms</NavLink>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private readonly MudTheme _malievTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#171717",
            PrimaryContrastText = "#ffffff",
            Secondary = "#ffffff",
            SecondaryContrastText = "#171717",
            Tertiary = "#de1d8d",
            Info = "#0a72ef",
            InfoContrastText = "#ffffff",
            Error = "#ff5b4f",
            ErrorContrastText = "#ffffff",
            Dark = "#171717",
            DarkContrastText = "#ffffff",
            Surface = "#ffffff",
            Background = "#ffffff",
            BackgroundGray = "#fafafa",
            TextPrimary = "#171717",
            TextSecondary = "#4d4d4d",
            LinesDefault = "#ebebeb",
            AppbarBackground = "#ffffff",
            AppbarText = "#171717"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Geist", "Noto Sans Thai", "Segoe UI", "system-ui", "sans-serif"],
                FontSize = "1rem",
                FontWeight = "400",
                LineHeight = "1.5",
                LetterSpacing = "0"
            },
            Button = new ButtonTypography
            {
                FontFamily = ["Geist", "Noto Sans Thai", "Segoe UI", "system-ui", "sans-serif"],
                FontSize = ".875rem",
                FontWeight = "500",
                LineHeight = "1.43",
                LetterSpacing = "0",
                TextTransform = "none"
            },
            Caption = new CaptionTypography
            {
                FontFamily = ["Geist", "Noto Sans Thai", "Segoe UI", "system-ui", "sans-serif"],
                FontSize = ".75rem",
                FontWeight = "500",
                LineHeight = "1.33",
                LetterSpacing = "0"
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    private string _selectedCulture = SupportedCultures.DefaultCulture;
    private string CartBadgeAriaLabel => $"{L["Cart"]}: {Cart.Count.ToString(CultureInfo.InvariantCulture)}";

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        await Cart.InitializeAsync();
        await Preferences.InitializeAsync();
        _selectedCulture = Preferences.Culture;
    }

    private async Task ChangeCultureAsync()
    {
        await Preferences.SetCultureAsync(_selectedCulture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        Cart.Changed -= StateHasChanged;
    }
}
