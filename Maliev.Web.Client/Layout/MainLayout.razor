            AppbarText = "#f4f6f8"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["var(--maliev-font-sans)"],
                FontSize = "1rem",
                FontWeight = "400",
                LineHeight = "1.5",
                LetterSpacing = "0"
            },
            Button = new ButtonTypography
            {
                FontFamily = ["var(--maliev-font-sans)"],
                FontSize = ".875rem",
                FontWeight = "500",
                LineHeight = "1.43",
                LetterSpacing = "0",
                TextTransform = "none"
            },
            Caption = new CaptionTypography
            {
                FontFamily = ["var(--maliev-font-sans)"],
                FontSize = ".75rem",
