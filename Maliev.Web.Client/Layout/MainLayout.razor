@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject PreferenceService Preferences
@inject CartState Cart
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="site-shell">
    <header class="site-header">
        <NavLink href="/" class="brand" Match="NavLinkMatch.All" aria-label="MALIEV home">
            <span class="brand-mark">M</span>
            <span>MALIEV</span>
        </NavLink>
        <nav class="nav-links" aria-label="Primary">
            <NavLink href="/quote">@L["InstantQuote"]</NavLink>
            <NavLink href="/services/3d-printing">@L["Services"]</NavLink>
            <NavLink href="/shop">@L["Shop"]</NavLink>
            <NavLink href="/contact">@L["Contact"]</NavLink>
        </nav>
        <div class="nav-actions">
            <select class="language-select" aria-label="@L["Language"]" @bind="_selectedCulture" @bind:after="ChangeCultureAsync">
                <option value="en-US">EN</option>
                <option value="th-TH">TH</option>
            </select>
            <NavLink href="/cart" class="icon-link" title="Cart">Cart @Cart.Count</NavLink>
            <NavLink href="/account/preferences" class="icon-link">@L["Account"]</NavLink>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div>
            <strong>MALIEV Co., Ltd.</strong>
            <p>Nonthaburi, Thailand. Manufacturing services, machines, and production support.</p>
        </div>
        <div class="footer-links">
            <NavLink href="/faq">FAQ</NavLink>
            <NavLink href="/shipping-returns">Shipping</NavLink>
            <NavLink href="/privacy">Privacy</NavLink>
            <NavLink href="/terms">Terms</NavLink>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private string _selectedCulture = SupportedCultures.DefaultCulture;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        await Preferences.InitializeAsync();
        _selectedCulture = Preferences.Culture;
    }

    private async Task ChangeCultureAsync()
    {
        await Preferences.SetCultureAsync(_selectedCulture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        Cart.Changed -= StateHasChanged;
    }
}
