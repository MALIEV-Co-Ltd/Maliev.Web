@inherits LayoutComponentBase
@implements IDisposable
@inject PreferenceService Preferences
@inject CartState Cart

<MudThemeProvider Theme="@_malievTheme" IsDarkMode="@IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="site-shell">
    <header class="site-header">
        <NavLink href="/" class="brand" Match="NavLinkMatch.All" aria-label="MALIEV home">
            <img class="brand-logo" src="/images/logo.svg" width="118" height="27" alt="MALIEV" />
        </NavLink>
        <nav class="nav-links" aria-label="Primary navigation">
            <NavLink href="/services">@Text("Services", "บริการ")</NavLink>
            <NavLink href="/materials">@Text("Materials", "วัสดุ")</NavLink>
            <NavLink href="/shop">@Text("Shop", "ร้านค้า")</NavLink>
            <NavLink href="/case-studies">@Text("Case studies", "ผลงาน")</NavLink>
            <NavLink href="/blog">@Text("Journal", "บทความ")</NavLink>
            <NavLink href="/contact">@Text("Contact", "ติดต่อ")</NavLink>
        </nav>
        <div class="nav-actions">
            <div class="language-toggle" role="group" aria-label="@Text("Language", "ภาษา")">
                <button type="button" class="@LanguageButtonClass(SupportedCultures.DefaultCulture)" @onclick="() => ChangeCultureAsync(SupportedCultures.DefaultCulture)">EN</button>
                <button type="button" class="@LanguageButtonClass(SupportedCultures.ThaiCulture)" @onclick="() => ChangeCultureAsync(SupportedCultures.ThaiCulture)">TH</button>
            </div>
            <MudIconButton Icon="@ThemeIcon"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Medium"
                           Class="nav-icon-button theme-toggle-button"
                           aria-label="@ThemeToggleAriaLabel"
                           OnClick="ToggleThemeAsync" />
            <MudBadge Content="@Cart.Count"
                      Color="Color.Info"
                      Overlap="true"
                      Bordered="false"
                      Elevation="0"
                      BadgeAriaLabel="@CartBadgeAriaLabel"
                      Class="nav-icon-badge">
                <MudIconButton Href="/cart"
                               Icon="@Icons.Material.Filled.ShoppingCart"
                               Variant="Variant.Text"
                               Color="Color.Inherit"
                               Size="Size.Medium"
                               Class="nav-icon-button"
                               aria-label="@Text("Cart", "ตะกร้า")" />
            </MudBadge>
            <MudIconButton Href="/account"
                           Icon="@Icons.Material.Filled.AccountCircle"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Medium"
                           Class="nav-icon-button"
                           aria-label="@Text("Account", "บัญชี")" />
            <a class="nav-quote-link" href="@SiteContent.QuoteNewUrl">@Text("Get part price", "ดูราคาชิ้นงาน")</a>
            <button type="button"
                    class="mobile-menu-button"
                    aria-label="@Text("Open navigation", "เปิดเมนู")"
                    aria-expanded="@_mobileNavOpen.ToString().ToLowerInvariant()"
                    @onclick="ToggleMobileNav">
                <span></span>
                <span></span>
            </button>
        </div>
        <nav class="@MobileNavClass" aria-label="Mobile navigation">
            <NavLink href="/services" @onclick="CloseMobileNav">@Text("Services", "บริการ")</NavLink>
            <NavLink href="/materials" @onclick="CloseMobileNav">@Text("Materials", "วัสดุ")</NavLink>
            <NavLink href="/shop" @onclick="CloseMobileNav">@Text("Shop", "ร้านค้า")</NavLink>
            <NavLink href="/case-studies" @onclick="CloseMobileNav">@Text("Case studies", "ผลงาน")</NavLink>
            <NavLink href="/blog" @onclick="CloseMobileNav">@Text("Journal", "บทความ")</NavLink>
            <NavLink href="/contact" @onclick="CloseMobileNav">@Text("Contact", "ติดต่อ")</NavLink>
            <NavLink href="/account" @onclick="CloseMobileNav">@Text("Account", "บัญชี")</NavLink>
            <NavLink href="/cart" @onclick="CloseMobileNav">@Text("Cart", "ตะกร้า")</NavLink>
            <a href="@SiteContent.QuoteNewUrl">@Text("Get part price", "ดูราคาชิ้นงาน")</a>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer" aria-label="MALIEV footer">
        <div class="footer-brand">
            <img class="footer-logo" src="/images/logo.svg" width="118" height="27" alt="MALIEV" />
            <p>@Text("Rapid manufacturing, custom parts, workshop-made machines, and production support for engineering teams.", "งานผลิตรวดเร็ว ชิ้นงานเฉพาะแบบ เครื่องจักรที่เราผลิตเอง และการสนับสนุนงานผลิตสำหรับทีมวิศวกรรม")</p>
            <address>
                <span>MALIEV Co., Ltd.</span>
                <a href="https://www.google.com/maps/search/?api=1&query=36%2F1%20Moo%203%20Khlong%20Khoi%20Pak%20Kret%20Nonthaburi%2011120%20Thailand" target="_blank" rel="noopener noreferrer">
                    36/1 Moo 3, Khlong Khoi, Pak Kret, Nonthaburi 11120, Thailand
                </a>
            </address>
        </div>
        <nav class="footer-column" aria-label="Footer company links">
            <h2>@Text("Company", "บริษัท")</h2>
            <NavLink href="/about">@Text("About", "เกี่ยวกับเรา")</NavLink>
            <NavLink href="/contact">@Text("Contact", "ติดต่อ")</NavLink>
            <NavLink href="/services">@Text("Services", "บริการ")</NavLink>
            <NavLink href="/materials">@Text("Materials", "วัสดุ")</NavLink>
            <NavLink href="/blog">@Text("Journal", "บทความ")</NavLink>
            <NavLink href="/shop">@Text("Shop", "ร้านค้า")</NavLink>
        </nav>
        <nav class="footer-column" aria-label="Footer support links">
            <h2>@Text("Support", "ช่วยเหลือ")</h2>
            <NavLink href="/faq">FAQ</NavLink>
            <NavLink href="/shipping-returns">@Text("Shipping", "การจัดส่ง")</NavLink>
            <NavLink href="/refund-policy">@Text("Refunds", "การคืนเงิน")</NavLink>
            <NavLink href="/warranty-policy">@Text("Warranty", "การรับประกัน")</NavLink>
            <NavLink href="/account/orders">@Text("Track orders", "ติดตามคำสั่งซื้อ")</NavLink>
            <NavLink href="/privacy">@Text("Privacy", "ความเป็นส่วนตัว")</NavLink>
            <NavLink href="/cookie-policy">@Text("Cookies", "คุกกี้")</NavLink>
            <NavLink href="/terms">@Text("Terms", "เงื่อนไข")</NavLink>
        </nav>
        <div class="footer-column footer-connect">
            <h2>Connect</h2>
            <a href="mailto:info@maliev.com">info@maliev.com</a>
            <a href="tel:+66818030404">+66 81 803 0404</a>
            <a class="line-contact-link"
               href="https://page.line.me/maliev"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="@Text("Chat with MALIEV on LINE Official Account @maliev", "ติดต่อ MALIEV ทาง LINE Official Account @maliev")">
                <span class="line-contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M20.2 4.4C18.1 2.7 15.2 1.8 12 1.8S5.9 2.7 3.8 4.4C1.9 5.9.9 7.9.9 10.1c0 3.8 3.3 7.1 7.8 7.9.3.1.7.2.8.4.1.2.1.5 0 .8l-.1.8c-.1.5-.4 1.9 1.7.8 2.1-1.1 5.7-3.3 7.8-5.7 1.4-1.5 2.1-3.2 2.1-5 0-2.2-1-4.2-2.8-5.7Zm-12.9 8H5.5a.5.5 0 0 1-.5-.5V8.4c0-.3.2-.5.5-.5s.5.2.5.5v3h1.3c.3 0 .5.2.5.5s-.2.5-.5.5Zm2.1-.5c0 .3-.2.5-.5.5s-.5-.2-.5-.5V8.4c0-.3.2-.5.5-.5s.5.2.5.5v3.5Zm4.6 0c0 .2-.1.4-.3.5h-.2c-.2 0-.3-.1-.4-.2l-1.8-2.4v2.1c0 .3-.2.5-.5.5s-.5-.2-.5-.5V8.4c0-.2.1-.4.3-.5.2-.1.5 0 .6.2l1.8 2.4V8.4c0-.3.2-.5.5-.5s.5.2.5.5v3.5Zm3.2-2.5h-1.3v.5h1.3c.3 0 .5.2.5.5s-.2.5-.5.5h-1.3v.5h1.3c.3 0 .5.2.5.5s-.2.5-.5.5h-1.8a.5.5 0 0 1-.5-.5V8.4c0-.3.2-.5.5-.5h1.8c.3 0 .5.2.5.5s-.2.5-.5.5Z" />
                    </svg>
                </span>
                <span class="line-contact-copy">
                    <strong>@Text("Chat on LINE", "ติดต่อทาง LINE")</strong>
                    <small>Official Account @@maliev</small>
                </span>
            </a>
            <div class="footer-social" aria-label="Social media">
                <a class="social-link" href="https://www.facebook.com/maliev.manufacturing/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M22 12.06C22 6.49 17.52 2 11.95 2S2 6.49 2 12.06c0 5.03 3.66 9.2 8.45 9.94v-7.03H7.9v-2.91h2.55V9.84c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.91h2.78l-.44 2.91h-2.34V22A10.03 10.03 0 0 0 22 12.06Z" />
                    </svg>
                    <span class="sr-only">Facebook</span>
                </a>
                <a class="social-link" href="https://www.youtube.com/channel/UCCosquPSUed6UPlMcRCq0Ig" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21.58 7.19a2.51 2.51 0 0 0-1.76-1.77C18.26 5 12 5 12 5s-6.26 0-7.82.42a2.51 2.51 0 0 0-1.76 1.77C2 8.75 2 12 2 12s0 3.25.42 4.81a2.51 2.51 0 0 0 1.76 1.77C5.74 19 12 19 12 19s6.26 0 7.82-.42a2.51 2.51 0 0 0 1.76-1.77C22 15.25 22 12 22 12s0-3.25-.42-4.81ZM10 15.05v-6.1L15.25 12 10 15.05Z" />
                    </svg>
                    <span class="sr-only">YouTube</span>
                </a>
                <a class="social-link" href="https://www.instagram.com/maliev.manufacturing/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 4.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Zm0 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm4.75-3.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z" />
                    </svg>
                    <span class="sr-only">Instagram</span>
                </a>
            </div>
        </div>
        <div class="footer-legal">
            <span>@CopyrightText</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private readonly MudTheme _malievTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#171717",
            PrimaryContrastText = "#ffffff",
            Secondary = "#ffffff",
            SecondaryContrastText = "#171717",
            Tertiary = "#de1d8d",
            Info = "#0a72ef",
            InfoContrastText = "#ffffff",
            Error = "#ff5b4f",
            ErrorContrastText = "#ffffff",
            Dark = "#171717",
            DarkContrastText = "#ffffff",
            Surface = "#ffffff",
            Background = "#ffffff",
            BackgroundGray = "#fafafa",
            TextPrimary = "#171717",
            TextSecondary = "#4d4d4d",
            LinesDefault = "#ebebeb",
            AppbarBackground = "#ffffff",
            AppbarText = "#171717"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#f4f6f8",
            PrimaryContrastText = "#0d1015",
            Secondary = "#12161d",
            SecondaryContrastText = "#f4f6f8",
            Tertiary = "#f064b3",
            Info = "#4d9aff",
            InfoContrastText = "#07111f",
            Error = "#ff7b72",
            ErrorContrastText = "#170808",
            Dark = "#05070a",
            DarkContrastText = "#f4f6f8",
            Surface = "#12161d",
            Background = "#0d1015",
            BackgroundGray = "#151a21",
            TextPrimary = "#f4f6f8",
            TextSecondary = "#a6adba",
            LinesDefault = "#2b3038",
            AppbarBackground = "#0d1015",
            AppbarText = "#f4f6f8"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["var(--maliev-font-sans)"],
                FontSize = "1rem",
                FontWeight = "400",
                LineHeight = "1.5",
                LetterSpacing = "0"
            },
            Button = new ButtonTypography
            {
                FontFamily = ["var(--maliev-font-sans)"],
                FontSize = ".875rem",
                FontWeight = "500",
                LineHeight = "1.43",
                LetterSpacing = "0",
                TextTransform = "none"
            },
            Caption = new CaptionTypography
            {
                FontFamily = ["var(--maliev-font-sans)"],
                FontSize = ".75rem",
                FontWeight = "500",
                LineHeight = "1.33",
                LetterSpacing = "0"
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    private string _selectedCulture = SupportedCultures.DefaultCulture;
    private string _selectedTheme = PreferenceService.LightTheme;
    private bool _mobileNavOpen;
    private const int FoundingYear = 2018;
    private string CartBadgeAriaLabel => $"{Text("Cart", "ตะกร้า")}: {Cart.Count.ToString(CultureInfo.InvariantCulture)}";
    private static int CurrentYear => DateTime.Today.Year;
    private string CopyrightText => Text(
        $"© {FoundingYear}-{CurrentYear.ToString(CultureInfo.InvariantCulture)} MALIEV Co., Ltd. All rights reserved.",
        $"© {FoundingYear}-{CurrentYear.ToString(CultureInfo.InvariantCulture)} บริษัท มาลีฟ จำกัด สงวนลิขสิทธิ์");
    private string MobileNavClass => _mobileNavOpen ? "mobile-nav open" : "mobile-nav";
    private bool IsDarkMode => _selectedTheme.Equals(PreferenceService.DarkTheme, StringComparison.OrdinalIgnoreCase);
    private string ThemeIcon => IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode;
    private string ThemeToggleAriaLabel => IsDarkMode
        ? Text("Switch to light theme", "เปลี่ยนเป็นธีมสว่าง")
        : Text("Switch to dark theme", "เปลี่ยนเป็นธีมมืด");

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        Preferences.Changed += OnPreferencesChanged;
        await Cart.InitializeAsync();
        await Preferences.InitializeAsync();
        _selectedCulture = Preferences.Culture;
        _selectedTheme = Preferences.Theme;
    }

    private async Task ChangeCultureAsync(string culture)
    {
        await Preferences.SetCultureAsync(culture);
    }

    private async Task ToggleThemeAsync()
    {
        var nextTheme = IsDarkMode ? PreferenceService.LightTheme : PreferenceService.DarkTheme;
        await Preferences.SetThemeAsync(nextTheme);
    }

    private void OnPreferencesChanged()
    {
        _selectedCulture = Preferences.Culture;
        _selectedTheme = Preferences.Theme;
        _ = InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private string LanguageButtonClass(string culture)
    {
        return _selectedCulture == culture ? "active" : string.Empty;
    }

    private void ToggleMobileNav()
    {
        _mobileNavOpen = !_mobileNavOpen;
    }

    private void CloseMobileNav()
    {
        _mobileNavOpen = false;
    }

    public void Dispose()
    {
        Cart.Changed -= StateHasChanged;
        Preferences.Changed -= OnPreferencesChanged;
    }
}
