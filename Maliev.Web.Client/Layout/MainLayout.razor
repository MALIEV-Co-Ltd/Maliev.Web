    private string _selectedCulture = SupportedCultures.DefaultCulture;
    private string _selectedTheme = PreferenceService.LightTheme;
    private CookieConsentBanner? _cookieConsent;
    private bool _mobileNavOpen;
    private const int FoundingYear = 2018;
    private bool HasCartItems => Cart.Count > 0;
    private string CartBadgeAriaLabel => $"{Text("Cart", "ตะกร้า")}: {Cart.Count.ToString(CultureInfo.InvariantCulture)}";
    private static int CurrentYear => DateTime.Today.Year;
    private string CopyrightText => Text(
        $"© {FoundingYear}-{CurrentYear.ToString(CultureInfo.InvariantCulture)} MALIEV Co., Ltd.",
        $"© {FoundingYear}-{CurrentYear.ToString(CultureInfo.InvariantCulture)} บริษัท มาลีฟ จำกัด");
    private string MobileNavClass => _mobileNavOpen ? "mobile-nav open" : "mobile-nav";
    private bool IsDarkMode => _selectedTheme.Equals(PreferenceService.DarkTheme, StringComparison.OrdinalIgnoreCase);
    private string ThemeIcon => IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode;
    private string ThemeToggleAriaLabel => IsDarkMode
        ? Text("Switch to light theme", "เปลี่ยนเป็นธีมสว่าง")
        : Text("Switch to dark theme", "เปลี่ยนเป็นธีมมืด");

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        Preferences.Changed += OnPreferencesChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Cart.InitializeAsync();
        await Preferences.InitializeAsync();
        _selectedCulture = Preferences.Culture;
        _selectedTheme = Preferences.Theme;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("malievScroll.bindHeroHeaderBleed");
    }

    private async Task ChangeCultureAsync(string culture)
    {
        await Preferences.SetCultureAsync(culture);
    }

    private async Task ToggleThemeAsync()
    {
        var nextTheme = IsDarkMode ? PreferenceService.LightTheme : PreferenceService.DarkTheme;
        await Preferences.SetThemeAsync(nextTheme);
    }

    private void OnPreferencesChanged()
    {
        _selectedCulture = Preferences.Culture;
        _selectedTheme = Preferences.Theme;
        _ = InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string th)
    {
        return Preferences.Culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? th : en;
    }

    private string LanguageButtonClass(string culture)
    {
        return _selectedCulture == culture ? "active" : string.Empty;
    }

    private async Task NavigateToQuoteStart()
        => await JS.InvokeVoidAsync("window.location.assign", "/quote/start?returnUrl=%2Fquotes%2Fnew");

    private void ToggleMobileNav()
    {
        _mobileNavOpen = !_mobileNavOpen;
    }

    private void CloseMobileNav()
    {
        _mobileNavOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _mobileNavOpen = false;
        _ = InvokeAsync(ResetScrollForLocationChangeAsync);
    }

    private async Task ResetScrollForLocationChangeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("malievScroll.scrollToTopForNavigation");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task OpenCookieSettingsAsync()
    {
        return _cookieConsent?.ShowPreferencesAsync() ?? Task.CompletedTask;
    }

    public void Dispose()
    {
        Cart.Changed -= StateHasChanged;
        Preferences.Changed -= OnPreferencesChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed record LocalizedText(string English, string Thai)
    {
        public string For(string culture)
        {
            return culture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? Thai : English;
        }
    }

