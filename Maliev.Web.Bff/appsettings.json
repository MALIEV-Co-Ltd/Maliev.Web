{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Services": {
    "CustomerService": { "BaseUrl": null },
    "CommerceService": { "BaseUrl": null },
    "ContactService": { "BaseUrl": null },
    "ChatbotService": { "BaseUrl": null },
    "DeliveryService": { "BaseUrl": null },
    "MaterialService": { "BaseUrl": null },
    "OrderService": { "BaseUrl": null },
    "PaymentService": { "BaseUrl": null },
    "PricingService": { "BaseUrl": null },
    "UploadService": { "BaseUrl": null }
  },
  "Security": {
    "PasskeyRateLimiting": {
      "BeginPermitLimit": 6,
      "CompletePermitLimit": 12,
      "WindowSeconds": 60,
      "ConcurrencyPermitLimit": 16
    },
    "PublicIngressRateLimiting": {
      "WindowSeconds": 60,
      "ChatbotSessionPermitLimit": 6,
      "ChatbotMessagePermitLimit": 30,
      "ContactPermitLimit": 5,
      "QuoteEstimatePermitLimit": 12,
      "QuoteReferencePermitLimit": 30,
      "UploadInitiatePermitLimit": 20,
      "UploadStreamPermitLimit": 40,
      "UploadStreamConcurrencyPermitLimit": 2,
      "UploadFinalizePermitLimit": 40,
      "UploadHandoffPermitLimit": 10,
      "UploadStatusPermitLimit": 120,
      "CheckoutPermitLimit": 10,
      "ShippingRatePermitLimit": 20,
      "ShippingReadPermitLimit": 30
    }
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "AllowedHosts": "*"
}
