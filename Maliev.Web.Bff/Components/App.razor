@using System.Globalization
@using Maliev.Web.Shared.Localization

@{
    var currentCulture = SupportedCultures.Normalize(CultureInfo.CurrentUICulture.Name);
    var documentLanguage = currentCulture.StartsWith("th", StringComparison.OrdinalIgnoreCase) ? "th" : "en";
}

<!DOCTYPE html>
<html lang="@documentLanguage" data-culture="@currentCulture" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MALIEV customer website for instant manufacturing quotations, 3D printing, CNC machining, 3D scanning, design, and product ordering." />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["images/favicon.svg"]" />
    <script>
        (() => {
            const normalizeTheme = theme => theme && theme.toLowerCase() === 'dark' ? 'dark' : 'light';
            const systemTheme = () => window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            const cookie = document.cookie
                .split('; ')
                .find(row => row.startsWith('maliev.theme='));
            const stored = localStorage.getItem('maliev.theme');
            const theme = normalizeTheme(stored || (cookie ? decodeURIComponent(cookie.split('=')[1]) : systemTheme()));
            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;
        })();
    </script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://shop.maliev.com" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&family=Roboto:wght@500&display=swap" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <ReconnectModal />
    <Maliev.Web.Client.Routes @rendermode="InteractiveServer" />
    <script src="@Assets["js/maliev-culture.js"]"></script>
    <script src="@Assets["js/maliev-consent.js"]"></script>
    <script src="@Assets["js/maliev-cart.js"]"></script>
    <script src="@Assets["js/maliev-chatbot.js"]"></script>
    <script src="@Assets["js/maliev-reconnect.js"]"></script>
    <script src="@Assets["js/maliev-google-address-picker.js"]"></script>
    <script src="@Assets["js/maliev-quote-dropzone.js"]"></script>
    <script src="@Assets["js/maliev-scroll.js"]"></script>
    <script src="@Assets["js/maliev-typewriter.js"]"></script>
    <script src="@Assets["js/maliev-blog.js"]"></script>
    <script type="module" src="@Assets["js/maliev-countup.js"]"></script>
    <script type="module" src="@Assets["js/maliev-reveal.js"]"></script>
    <script type="module" src="@Assets["js/maliev-make-studio-hero.js"]"></script>
    <script type="module" src="@Assets["js/manufacturing-gizmo.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
